#!/bin/sh
# Provisions the native prerequisites Nupp builds against.
#
# Nupp asks for a C and a C++ compiler. Everything else it needs to build itself
# -- the LuaJIT the compiler runs on and the LPeg the documentation renderer
# parses with -- is fetched here from a pinned source, verified against a digest,
# built with that compiler pair, and cached.
#
# This is the only thing that builds those. A component is asked for by name and
# answers with the prefix it was installed under, so a caller composes paths
# rather than knowing the layout:
#
#     scripts/toolchain luajit          # -> /path/to/.nupp-cache/toolchain/<key>/luajit
#     scripts/toolchain --all           # everything, quietly, for a cache warm
#
# Building is idempotent and cached: the second call is a directory test. The
# cache is keyed by the compilers' own version output, so switching NUPP_CC from
# clang to gcc builds beside the old answer rather than over it.

set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
. "$ROOT/scripts/toolchain.pins"

# A pin's URL and directory are templates over its own version, so a bump moves
# them with it and the pins file stays the one place a source is named.
expand_pin() { eval "printf '%s' \"$1\""; }

# Names shared with the archive fetching the host build already had, so a CI job
# or an offline builder that supplies pinned archives keeps working unchanged.
SOURCE_DIR=${NUPP_HOST_SOURCE_DIR:-}
SOURCE_BASE_URL=${NUPP_HOST_SOURCE_BASE_URL:-}
OFFLINE=${NUPP_HOST_OFFLINE:-}

usage() {
    cat >&2 <<'USAGE'
usage: scripts/toolchain COMPONENT...
       scripts/toolchain --all
       scripts/toolchain --prefix

Components: luajit luarocks lpeg lpeg-source stage0 llvm wgpu
            wgpu-static [PLATFORM]
            browser-sources browser-emulator browser-guest
            native-provider FEATURES
            host FEATURES, host-library FEATURES
            kit FEATURES, kit-archive FEATURES OUTPUT
            codegen-library
            prebuilt-codegen [PLATFORM], prebuilt-kit [PLATFORM]
            codegen-archive OUTPUT
            archive DIRECTORY OUTPUT

Prints the install prefix of each component named, building it first when it is
not already cached. --all builds every component and prints nothing. --prefix
prints the root the components are installed under without building anything.

Environment:
  NUPP_CC                    the C compiler. Probed when unset.
  NUPP_CXX                   the C++ compiler, only for building LLVM from source.
                             Probed when unset.
  NUPP_PREBUILT_PROVIDER     1 to take native-provider from the pinned prebuilt
                             code generator archive, 0 never to. Without a
                             built compiler it is taken whenever one is pinned.
  NUPP_TOOLCHAIN_DIR         where to install. Defaults to the repository cache.
  NUPP_HOST_SOURCE_DIR       a directory of already-downloaded pinned archives.
  NUPP_HOST_SOURCE_BASE_URL  a flat mirror to fetch archives from.
  NUPP_HOST_OFFLINE          refuse to reach the network.
  NUPP_LLVM_PREFIX           an existing build of the pinned LLVM to use as is.

`llvm --available` prints the pinned LLVM's prefix if it is already built (or
named by NUPP_LLVM_PREFIX) and exits 1 otherwise, building nothing.
USAGE
    exit 2
}

note() { printf 'toolchain: %s\n' "$*" >&2; }
die() { printf 'toolchain: %s\n' "$*" >&2; exit 1; }

# --- toolchain selection ----------------------------------------------------

probe() {
    for candidate in "$@"; do
        [ -n "$candidate" ] || continue
        if command -v "$candidate" >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

UNAME=$(uname -s 2>/dev/null || echo unknown)
case "$UNAME" in
    Darwin*)              PLATFORM=darwin ;;
    MINGW*|MSYS*|CYGWIN*) PLATFORM=windows ;;
    FreeBSD*|DragonFly*)  PLATFORM=bsd ;;
    *)                    PLATFORM=posix ;;
esac

CC=${NUPP_CC:-}
CXX=${NUPP_CXX:-}
case "$PLATFORM" in
    # This driver uses the dependencies' GNU make builds. The hosted Windows
    # clang targets MSVC, where LuaJIT's makefile asks its linker for Unix
    # libraries such as `-lm`; the MinGW pair is the compatible default.
    windows)
        [ -n "$CC" ] || CC=$(probe gcc cc clang) \
            || die "no C compiler found. Name one with NUPP_CC"
        [ -n "$CXX" ] || CXX=$(probe g++ c++ clang++) || CXX=""
        ;;
    *)
        [ -n "$CC" ] || CC=$(probe clang cc gcc) \
            || die "no C compiler found. Name one with NUPP_CC"
        [ -n "$CXX" ] || CXX=$(probe clang++ c++ g++) || CXX=""
        ;;
esac

command -v "$CC" >/dev/null 2>&1 || die "NUPP_CC names $CC, which is not on PATH"
[ -z "${NUPP_CXX:-}" ] || command -v "$CXX" >/dev/null 2>&1 \
    || die "NUPP_CXX names $CXX, which is not on PATH"

# Nothing of Nupp's own is C++. The pinned LLVM is, so building it here, and
# linking the code generator library from it, are the two things that need a
# C++ compiler; a checkout that takes the prebuilt code generator never asks.
require_cxx() {
    [ -n "$CXX" ] \
        || die "$1 needs a C++ compiler. Name one with NUPP_CXX, or use the prebuilt code generator (scripts/toolchain prebuilt-codegen)"
}

case "$PLATFORM" in
    bsd) MAKE=${MAKE:-gmake} ;;
    *)   MAKE=${MAKE:-make} ;;
esac

# Paths printed to a caller can leave the MSYS shell and be handed directly to
# a native Windows process. Give those consumers the drive-letter spelling;
# Git Bash accepts it too. Tests that emulate Windows on another host have no
# cygpath and keep their host spelling.
native_path() {
    if [ "$PLATFORM" = windows ] && command -v cygpath >/dev/null 2>&1; then
        cygpath -m "$1"
    else
        printf '%s\n' "$1"
    fi
}

# --- digests ----------------------------------------------------------------

# Whichever of these the machine has. All three answer the same question and no
# platform reliably carries a particular one.
if command -v shasum >/dev/null 2>&1; then
    sha256_stdin() { shasum -a 256 | cut -d' ' -f1; }
elif command -v sha256sum >/dev/null 2>&1; then
    sha256_stdin() { sha256sum | cut -d' ' -f1; }
elif command -v openssl >/dev/null 2>&1; then
    sha256_stdin() { openssl dgst -sha256 | sed 's/.*= *//'; }
else
    die "no sha256 tool found; install one of shasum, sha256sum or openssl"
fi
sha256() { sha256_stdin < "$1"; }

# The pins that decide a native artifact, which is every pin but the stage-zero
# one. That one names a Nupp release and a bundle of Lua; no C compiler ever
# sees it, and keying LuaJIT, LPeg and every host on it would make the
# one-line pin bump a stage-zero move asks for a from-scratch native rebuild on
# machine that pulls it. The prebuilt code generator and kit published beside
# it are left out for the same reason: they are fetched, never compiled against.
# Assignments only, so a comment is documentation rather
# than a cache generation. A mirror list says where else the same bytes may be
# found, which changes no artifact either.
pins_digest() {
    grep '^[A-Z][A-Z0-9_]*=' "$ROOT/scripts/toolchain.pins" \
        | grep -v -e '^STAGE0_' -e '^PREBUILT_' -e '^BROWSER_' -e '^LLVM_' -e '^WGPU_' -e '^[A-Z0-9_]*_MIRRORS=' \
        | sha256_stdin
}

# Public embedding headers are staged beside the libraries rather than compiled
# into them. Give those staged SDKs their own content key so changing the public
# ABI refreshes the SDK without needlessly relinking a host.
embedding_headers_digest() {
    (cd "$ROOT" && find host/include -type f -name '*.h' 2>/dev/null) \
        | LC_ALL=C sort | while IFS= read -r file; do
            printf '%s ' "$file"
            sha256 "$ROOT/$file"
        done | sha256_stdin | cut -c1-16
}

# What a host is linked from beyond the native sources' own pins: this driver,
# the LuaJIT patch and the list of public exports. Kept apart from the public
# headers, so editing a header only restages the SDK.
host_sources_digest() {
    {
        # `scripts/toolchain.pins` is not in this list because it is folded in
        # below through `pins_digest`, which leaves out the stage-zero pin.
        for file in scripts/toolchain scripts/patches/luajit.patch host/include/nupp.exports; do
            [ -f "$ROOT/$file" ] && printf '%s\n' "$file"
        done
    } | LC_ALL=C sort | {
        while IFS= read -r file; do
            printf '%s ' "$file"
            sha256 "$ROOT/$file"
        done
        printf 'scripts/toolchain.pins %s\n' "$(pins_digest)"
    } | sha256_stdin | cut -c1-16
}
# --- where things go --------------------------------------------------------

# Beside the repository's common git directory, so every worktree of this
# checkout shares one build of LuaJIT rather than each paying for its own. A
# source archive with no git metadata falls back to the checkout.
if [ -n "${NUPP_TOOLCHAIN_DIR:-}" ]; then
    CACHE=$NUPP_TOOLCHAIN_DIR
else
    COMMON=$(git -C "$ROOT" rev-parse --git-common-dir 2>/dev/null || true)
    if [ -n "$COMMON" ]; then
        case "$COMMON" in
            /*|[A-Za-z]:*) ;;
            *) COMMON="$ROOT/$COMMON" ;;
        esac
        CACHE="$(dirname "$COMMON")/.nupp-cache/toolchain"
    else
        CACHE="$ROOT/build/toolchain"
    fi
fi

ARCHIVES="$CACHE/archives"
SOURCES="$CACHE/sources"

# What the answer depends on: the C compiler, its version, the machine, and
# these provisioning rules. Several change without a native source changing;
# ignoring one can return an artifact built with another compiler or link line.
key_material() {
    printf '%s\n' "$CC"
    "$CC" --version 2>&1 | head -n 2 || true
    printf '%s %s\n' "$UNAME" "$(uname -m 2>/dev/null || echo unknown)"
    sha256 "$ROOT/scripts/toolchain"
    sha256 "$ROOT/scripts/patches/luajit.patch"
    pins_digest
}
KEY=$(key_material | sha256_stdin | cut -c1-16)
PREFIX="$CACHE/$KEY"

# --- fetching ---------------------------------------------------------------

download() {
    url=$1 destination=$2
    if command -v curl >/dev/null 2>&1; then
        curl --fail --location --silent --show-error --output "$destination" "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget --quiet --output-document "$destination" "$url"
    else
        die "no downloader found; install curl or wget"
    fi
}

offline() {
    case "$OFFLINE" in
        1|true|yes|on|TRUE|YES|ON) return 0 ;;
        ""|0|false|no|off|FALSE|NO|OFF) return 1 ;;
        *) die "NUPP_HOST_OFFLINE must be one of 1, true, yes, on, 0, false, no or off" ;;
    esac
}

# One pinned archive, in the cache, verified. A digest is checked before a byte
# is unpacked, so a mirror that served something else is refused rather than
# compiled.
#
# The URL is where to look first, not what is trusted. A pin may name mirrors
# after it, tried in order when the one before could not be downloaded or did not
# have the pinned digest; each answer is held to the same digest, so a mirror adds
# a place to look and nothing else. An origin that was unreachable for an
# afternoon otherwise failed every CI job whose cache happened to miss.
archive() {
    name=$1 url=$2 digest=$3 suffix=${4:-.tar.gz} mirrors=${5:-}
    file="$ARCHIVES/$name$suffix"
    if [ -f "$file" ] && [ "$(sha256 "$file")" = "$digest" ]; then
        printf '%s\n' "$file"
        return 0
    fi

    mkdir -p "$ARCHIVES"
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name$suffix" ]; then
        cp "$SOURCE_DIR/$name$suffix" "$file.$$"
        verified "$file.$$" "$name" "$digest" || die "$refusal"
    elif offline; then
        die "NUPP_HOST_OFFLINE is set and $name$suffix is not cached; put the pinned archive in NUPP_HOST_SOURCE_DIR"
    else
        if [ -n "$SOURCE_BASE_URL" ]; then
            url="${SOURCE_BASE_URL%/}/$name$suffix"
        fi
        fetch_verified "$file.$$" "$name" "$digest" "$url" $mirrors
    fi
    mv "$file.$$" "$file"
    printf '%s\n' "$file"
}

# Whether a download has the pinned digest, removing it and saying why when it
# does not. The refusal names both digests, so a stale pin reads differently from
# a bad download.
refusal=""
verified() {
    candidate=$1 label=$2 expected=$3
    found=$(sha256 "$candidate")
    [ "$found" = "$expected" ] && return 0
    rm -f "$candidate"
    refusal="$label has digest $found, expected $expected; refusing to cache or compile it"
    return 1
}

# The first of these URLs to answer with the pinned digest. Every failure is
# reported on the way past it, and the last one is what the build stops with.
fetch_verified() {
    destination=$1 label=$2 expected=$3
    shift 3
    refusal=""
    for candidate in "$@"; do
        [ -n "$refusal" ] && note "$refusal; trying $candidate"
        note "fetching $label"
        if ! download "$candidate" "$destination"; then
            rm -f "$destination"
            refusal="cannot download $candidate"
            continue
        fi
        verified "$destination" "$label" "$expected" && return 0
    done
    die "$refusal"
}

# One pinned file, verified. Not every source is an archive: a single-header
# library is a handful of loose files, and unpacking one would mean requiring an
# archive tool this does not otherwise need.
pinned_file() {
    name=$1 url=$2 digest=$3
    file="$ARCHIVES/$name"
    if [ -f "$file" ] && [ "$(sha256 "$file")" = "$digest" ]; then
        printf '%s\n' "$file"
        return 0
    fi
    mkdir -p "$ARCHIVES"
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name" ]; then
        cp "$SOURCE_DIR/$name" "$file.$$"
        verified "$file.$$" "$name" "$digest" || die "$refusal"
    elif offline; then
        die "NUPP_HOST_OFFLINE is set and $name is not cached; put the pinned file in NUPP_HOST_SOURCE_DIR"
    else
        if [ -n "$SOURCE_BASE_URL" ]; then
            url="${SOURCE_BASE_URL%/}/$name"
        fi
        fetch_verified "$file.$$" "$name" "$digest" "$url"
    fi
    mv "$file.$$" "$file"
    printf '%s\n' "$file"
}

# One extracted source tree. Extraction is into a temporary sibling and renamed,
# so a killed run never leaves a half-unpacked tree a later one trusts.
source_tree() {
    name=$1 url=$2 digest=$3 marker=$4 suffix=${5:-.tar.gz} mirrors=${6:-}
    tree="$SOURCES/$name"
    if [ -f "$tree/$marker" ]; then
        printf '%s\n' "$tree"
        return 0
    fi

    file=$(archive "$name" "$url" "$digest" "$suffix" "$mirrors")
    mkdir -p "$SOURCES"
    staging="$SOURCES/.$name.$$"
    rm -rf "$staging"
    mkdir -p "$staging"
    case "$suffix" in
        *.bz2) tar xjf "$file" -C "$staging" ;;
        *)     tar xzf "$file" -C "$staging" ;;
    esac
    [ -f "$staging/$name/$marker" ] \
        || die "$name$suffix did not extract the expected $name/$marker"
    rm -rf "$tree"
    mv "$staging/$name" "$tree"
    rm -rf "$staging"
    printf '%s\n' "$tree"
}

# --- the stage-zero compiler ------------------------------------------------

# The compiler that compiles this tree's Nupp before this tree has a compiler.
#
# It is the previous release's own compiler, lowered to one Lua file and
# published as an asset of that release, and it is fetched here the way every
# other pinned source is. What makes it different from LuaJIT or LPeg is that it
# is neither built nor platform-specific: one file of Lua, good on every machine
# that has a LuaJIT new enough to parse generated Nupp, which the pins above
# already guarantee. So it is cached by its own digest rather than under the
# compiler-pair key, and every worktree of every checkout on this machine that
# pins the same release shares the one copy.
#
# This is fetched rather than committed, and the pin says why the digest is of
# the decompressed file.
stage0_runtime() {
    stage0_verified_file=$1
    stage0_runtime_root="$ROOT/build/stage0/$STAGE0_SHA256"
    stage0_runtime_digest=$(sha256 "$ROOT/scripts/stage0-runtime.lua")
    stage0_runtime_file="$stage0_runtime_root/nupp-$stage0_runtime_digest.lua"
    stage0_verified_copy="$stage0_runtime_root/verified.lua"
    build_luajit
    mkdir -p "$stage0_runtime_root/scripts" "$stage0_runtime_root/bin"
    [ -f "$stage0_verified_copy" ] || cp "$stage0_verified_file" "$stage0_verified_copy"
    stage0_driver=$(printf '%s' "$ROOT/scripts/toolchain" | sed "s/'/'\\\\''/g")
    printf '#!/bin/sh\nexec '\''%s'\'' "$@"\n' "$stage0_driver" > "$stage0_runtime_root/scripts/toolchain"
    chmod +x "$stage0_runtime_root/scripts/toolchain"
    stage0_entry=$(printf '%s' "$stage0_runtime_file" | sed "s/'/'\\\\''/g")
    printf '#!/bin/sh\nexec luajit '\''%s'\'' "$@"\n' "$stage0_entry" > "$stage0_runtime_root/bin/nupp"
    chmod +x "$stage0_runtime_root/bin/nupp"
    stage0_runtime_stamp="$stage0_runtime_root/.runtime-$stage0_runtime_digest.complete"
    take_lock "stage0-runtime-$STAGE0_SHA256" "$stage0_runtime_stamp" || return 0
    "$PREFIX/luajit/bin/luajit" \
        "$(native_path "$ROOT/scripts/stage0-runtime.lua")" \
        "$(native_path "$stage0_verified_file")" \
        "$(native_path "$stage0_runtime_file")" \
        "$(native_path "$stage0_runtime_root")" \
        "$(native_path "$stage0_runtime_stamp")"
    release_lock
}

stage0() {
    out="$CACHE/stage0/$STAGE0_SHA256"
    file="$out/nupp.lua"
    # Checked again rather than believed for being there. It went in whole and
    # verified, but a disk can still damage it afterwards, and a damaged one was
    # either run as the compiler or failed every bootstrap with a parse error in
    # a file nothing said to delete. Fetched again like a missing one instead.
    if [ -f "$file" ]; then
        if [ "$(sha256 "$file")" = "$STAGE0_SHA256" ]; then
            stage0_runtime "$file"
            native_path "$stage0_runtime_file"
            return 0
        fi
        note "the cached $STAGE0_TAG stage-zero compiler does not have the pinned digest; fetching it again"
        rm -f "$file"
    fi

    name="nupp-stage0-$STAGE0_TAG.lua"
    mkdir -p "$CACHE/stage0"
    staged="$out.$$"
    rm -rf "$staged"
    mkdir -p "$staged"
    # shellcheck disable=SC2064
    trap "rm -rf '$staged'" EXIT HUP INT TERM

    # An offline builder supplies either spelling: the asset as published, or
    # the plain bundle, which is what the digest is of and so the easier one to
    # check by hand.
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name" ]; then
        cp "$SOURCE_DIR/$name" "$staged/nupp.lua"
    elif [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name.gz" ]; then
        cp "$SOURCE_DIR/$name.gz" "$staged/nupp.lua.gz"
        gunzip "$staged/nupp.lua.gz" || die "$name.gz did not decompress"
    elif offline; then
        die "NUPP_HOST_OFFLINE is set and the $STAGE0_TAG stage-zero compiler is not cached; put $name.gz in NUPP_HOST_SOURCE_DIR"
    else
        # The pin says where to look and the digest says what is acceptable.
        url=$(expand_pin "$STAGE0_URL")
        if [ -n "$SOURCE_BASE_URL" ]; then
            url="${SOURCE_BASE_URL%/}/$name.gz"
        fi
        note "fetching the $STAGE0_TAG stage-zero compiler"
        download "$url" "$staged/nupp.lua.gz" \
            || die "cannot download $url"
        gunzip "$staged/nupp.lua.gz" || die "$name.gz did not decompress"
    fi

    found=$(sha256 "$staged/nupp.lua")
    if [ "$found" != "$STAGE0_SHA256" ]; then
        rm -rf "$staged"
        trap - EXIT HUP INT TERM
        die "the $STAGE0_TAG stage-zero compiler has digest $found, expected $STAGE0_SHA256; refusing to cache or run it"
    fi
    # Renamed into place whole, so a killed fetch never leaves a truncated
    # compiler behind for the next command to run, and the digest directory is
    # created only once its one file has been verified.
    mkdir -p "$out"
    mv "$staged/nupp.lua" "$file.$$"
    mv "$file.$$" "$file"
    rm -rf "$staged"
    trap - EXIT HUP INT TERM
    stage0_runtime "$file"
    native_path "$stage0_runtime_file"
}

# --- the code generator -----------------------------------------------------

# The code generator is LLVM and lld, linked statically and reached by the
# compiler through LuaJIT's FFI (src/nupp/compiler/aot/llvm/codegen.nupp). It
# is linked into one of two places: a shared library of its own, which a
# checkout stages beside its native provider and a release publishes as the
# prebuilt code generator, or a Nupp host built with `native-codegen`. Either
# way the only names exported are the `nuppcg_*` aliases native/codegen/symbols
# lists, each for an LLVM or lld name that stays local: a process that loads
# another LLVM, as Mesa's llvmpipe Vulkan driver does, must never have its
# calls bound to this one.

# LLVM's component libraries the code generator links.
CODEGEN_COMPONENTS="passes irreader object option lto bitwriter bitreader profiledata
    debuginfodwarf textapi objcarcopts cgdata dtlto debuginfocodeview debuginfomsf
    debuginfopdb libdriver windowsdriver windowsmanifest aarch64codegen
    aarch64asmparser aarch64disassembler x86codegen x86asmparser x86disassembler
    webassemblycodegen webassemblyasmparser webassemblydisassembler mcdisassembler"

codegen_library_filename() {
    case "$PLATFORM" in
        darwin)  printf '%s\n' libnupp_codegen.dylib ;;
        windows) printf '%s\n' nupp_codegen.dll ;;
        *)       printf '%s\n' libnupp_codegen.so ;;
    esac
}

# `ALIAS TARGET`, one export per line, for this platform.
codegen_symbols() {
    while IFS= read -r cs_line; do
        cs_line=$(printf '%s' "$cs_line" | tr -d '\r')
        case "$cs_line" in
            ''|'#'*) continue ;;
        esac
        # shellcheck disable=SC2086 # split into the line's fields
        set -- $cs_line
        case "${3:-}" in
            '') ;;
            darwin) [ "$PLATFORM" = darwin ] || continue ;;
            '!darwin') [ "$PLATFORM" != darwin ] || continue ;;
            *) die "native/codegen/symbols names an unknown platform: $3" ;;
        esac
        printf '%s %s\n' "$1" "$2"
    done < "$ROOT/native/codegen/symbols"
}

# What exports each alias for its target and pulls the target out of LLVM's
# archives, one argument per line. Windows gives the aliases in a module
# definition file instead (codegen_definitions), and needs only the pull.
codegen_alias_flags() {
    codegen_symbols | while read -r ca_alias ca_target; do
        case "$PLATFORM" in
            darwin) printf '%s\n' "-Wl,-u,_$ca_target" "-Wl,-alias,_$ca_target,_$ca_alias" ;;
            windows) printf '%s\n' "-Wl,--undefined=$ca_target" ;;
            *) printf '%s\n' "-Wl,--undefined=$ca_target" "-Wl,--defsym=$ca_alias=$ca_target" ;;
        esac
    done
}

# The aliases as module-definition exports, for a Windows link.
codegen_definitions() {
    codegen_symbols | while read -r cd_alias cd_target; do
        printf '    %s=%s\n' "$cd_alias" "$cd_target"
    done
}

# The static LLVM and lld libraries, then what they need from the system, one
# argument per line. NUPP_LLVM_LIBS (with NUPP_LLVM_SYSTEM_LIBS) lists them for
# a cross-built tree whose llvm-config cannot run here. `library` links the C++
# runtime statically, so the code generator library depends on nothing a
# machine might lack; `host` links it the way the host's other C++ does.
codegen_libraries() {
    cl_mode=$1
    build_llvm
    printf '%s\n' "-L$(native_path "$LLVM_OUT/lib")"
    # lld's libraries before LLVM's: they depend on it, not the reverse.
    for cl_library in lldMinGW lldCOFF lldELF lldMachO lldWasm lldCommon; do
        printf '%s\n' "-l$cl_library"
    done
    if [ -n "${NUPP_LLVM_LIBS:-}" ]; then
        cl_libraries=$NUPP_LLVM_LIBS
        cl_system=${NUPP_LLVM_SYSTEM_LIBS:-}
    else
        cl_config="$LLVM_OUT/bin/llvm-config"
        # shellcheck disable=SC2086 # one argument per component
        cl_libraries=$("$cl_config" --link-static --libs $CODEGEN_COMPONENTS) \
            || die "llvm-config could not list LLVM's libraries"
        cl_system=$("$cl_config" --link-static --system-libs) \
            || die "llvm-config could not list LLVM's system libraries"
    fi
    for cl_library in $cl_libraries $cl_system; do
        cl_name=${cl_library#-l}
        cl_name=${cl_name%.lib}
        [ -n "$cl_name" ] && printf '%s\n' "-l$cl_name"
    done
    case "$PLATFORM:$cl_mode" in
        darwin:*) printf '%s\n' -lc++ ;;
        *:library) printf '%s\n' -static-libstdc++ -static-libgcc -lpthread ;;
        windows:host) printf '%s\n' -Wl,-Bstatic -lstdc++ -Wl,-Bdynamic ;;
        *:host) printf '%s\n' -lstdc++ ;;
    esac
}

# What the code generator is built from, for the key of anything it is linked
# into. Builds or finds the pinned LLVM.
codegen_material() {
    build_llvm
    printf 'llvm %s %s %s symbols %s\n' "$LLVM_VERSION" "$LLVM_SHA256" "$LLVM_OUT" \
        "$(sha256 "$ROOT/native/codegen/symbols")"
}

macos_deployment_floor() {
    case "$(uname -m 2>/dev/null)" in
        x86_64) printf '%s\n' 10.14 ;;
        *) printf '%s\n' 11.0 ;;
    esac
}

# The code generator library for this machine, linked from the pinned LLVM.
# Sets CODEGEN_LIBRARY_OUT.
CODEGEN_LIBRARY_OUT=""
build_codegen_library() {
    build_llvm
    cg_material=$(codegen_material)
    cg_digest=$(printf '%s|%s|%s' nupp-codegen "$cg_material" "$KEY" | sha256_stdin | cut -c1-16)
    cg_out="$PREFIX/codegen/$cg_digest"
    cg_filename=$(codegen_library_filename)
    CODEGEN_LIBRARY_OUT="$cg_out/$cg_filename"
    take_lock "codegen-$cg_digest" "$cg_out/.complete" || return 0
    [ -f "$cg_out/.complete" ] && [ -f "$CODEGEN_LIBRARY_OUT" ] && { release_lock; return 0; }
    require_cxx "linking the code generator library"
    note "linking the code generator library"
    rm -rf "$cg_out"
    mkdir -p "$cg_out"
    set -- "$CXX" -shared -o "$CODEGEN_LIBRARY_OUT"
    case "$PLATFORM" in
        darwin)
            codegen_symbols | sed 's/ .*//; s/^/_/' > "$cg_out/exports"
            set -- "$@" -Wl,-x "-Wl,-exported_symbols_list,$cg_out/exports" \
                "-Wl,-install_name,@rpath/$cg_filename" "-mmacosx-version-min=$(macos_deployment_floor)"
            ;;
        windows)
            {
                printf 'EXPORTS\n'
                codegen_definitions
            } > "$cg_out/exports.def"
            set -- "$@" "$(native_path "$cg_out/exports.def")"
            ;;
        *)
            {
                printf '{\n  global:\n'
                codegen_symbols | sed 's/^\([^ ]*\) .*$/    \1;/'
                printf '  local: *;\n};\n'
            } > "$cg_out/exports.map"
            # -Bsymbolic binds the library's references to its own LLVM even
            # where a name happens to be visible from another.
            set -- "$@" "-Wl,--version-script=$cg_out/exports.map" -Wl,-Bsymbolic -Wl,--gc-sections
            ;;
    esac
    while IFS= read -r cg_flag; do
        [ -z "$cg_flag" ] || set -- "$@" "$cg_flag"
    done <<EOF
$(codegen_alias_flags)
$(codegen_libraries library)
EOF
    "$@" >&2 || die "cannot link the code generator library"
    printf 'done\n' > "$cg_out/.complete"
    release_lock
}

# --- the prebuilt code generator and link kit -------------------------------

# What a clean checkout links a native program with before it has built LLVM:
# the previous release's code generator and link kit, published per platform
# beside its stage zero and pinned here by digest. Like stage zero they are
# fetched, not built, so they are cached by their own digest rather than under
# the compiler-pair key, and a checkout that builds its own LLVM never asks.
#
# The code generator archive carries two shared libraries: the code generator
# library (`codegen-library`), which the compiler loads for LLVM and lld, and
# the release's native provider, which a checkout with no compiler yet starts
# the compiler on (the prebuilt native provider, below). The kit is the same
# archive `kit-archive` writes, so a release publishes one file for both a
# catalog and a checkout.

# The pin suffix and archive members for a platform's prebuilt assets, which
# is this machine's own unless one is named. Sets PREBUILT_TARGET, the provider
# and code generator library names, and the two digests, which are empty for a
# platform nothing is pinned for.
prebuilt_pins() {
    PREBUILT_TARGET=${1:-$(kit_target)}
    case "$PREBUILT_TARGET" in
        x86_64-unknown-linux-gnu)
            prebuilt_suffix=LINUX_X86_64; prebuilt_library=libnupp_native.so
            prebuilt_codegen=libnupp_codegen.so ;;
        aarch64-apple-darwin)
            prebuilt_suffix=MACOS_AARCH64; prebuilt_library=libnupp_native.dylib
            prebuilt_codegen=libnupp_codegen.dylib ;;
        x86_64-pc-windows-msvc|x86_64-pc-windows-gnu)
            PREBUILT_TARGET=x86_64-pc-windows-msvc
            prebuilt_suffix=WINDOWS_X86_64; prebuilt_library=nupp_native.dll
            prebuilt_codegen=nupp_codegen.dll ;;
        *) prebuilt_suffix=""; prebuilt_library=""; prebuilt_codegen="" ;;
    esac
    prebuilt_codegen_digest=""
    prebuilt_kit_digest=""
    if [ -n "$prebuilt_suffix" ]; then
        eval "prebuilt_codegen_digest=\${PREBUILT_CODEGEN_SHA256_$prebuilt_suffix:-}"
        eval "prebuilt_kit_digest=\${PREBUILT_KIT_SHA256_$prebuilt_suffix:-}"
    fi
}

# One verified, unpacked prebuilt asset: `codegen` or `kit`. Sets PREBUILT_OUT
# to the code generator archive's provider library or the kit directory. A platform with no pin, or a
# pin with no tag, is refused with what is missing rather than fetched.
PREBUILT_OUT=""
build_prebuilt() {
    prebuilt_kind=$1
    prebuilt_pins "${2:-}"
    case "$prebuilt_kind" in
        codegen)
            prebuilt_digest=$prebuilt_codegen_digest
            prebuilt_url=${PREBUILT_CODEGEN_URL:-}
            prebuilt_marker=$prebuilt_library
            prebuilt_label="prebuilt code generator"
            ;;
        kit)
            prebuilt_digest=$prebuilt_kit_digest
            prebuilt_url=${PREBUILT_KIT_URL:-}
            prebuilt_marker=kit.json
            prebuilt_label="prebuilt link kit"
            ;;
    esac
    [ -n "${PREBUILT_TAG:-}" ] && [ -n "$prebuilt_digest" ] && [ -n "$prebuilt_marker" ] \
        || die "no $prebuilt_label is pinned for $PREBUILT_TARGET (scripts/toolchain.pins)"
    out="$CACHE/prebuilt/$prebuilt_kind/$prebuilt_digest"
    PREBUILT_OUT="$out/$prebuilt_marker"
    [ "$prebuilt_kind" = kit ] && PREBUILT_OUT=$out
    [ -f "$out/.complete" ] && [ -f "$out/$prebuilt_marker" ] && return 0
    take_lock "prebuilt-$prebuilt_kind-$prebuilt_digest" "$out/.complete" || return 0
    if [ -f "$out/.complete" ] && [ -f "$out/$prebuilt_marker" ]; then
        release_lock
        return 0
    fi
    # Named as the release publishes it, so NUPP_HOST_SOURCE_DIR and a flat
    # NUPP_HOST_SOURCE_BASE_URL mirror hold the assets under their own names.
    file=$(archive "nupp-$prebuilt_kind-$PREBUILT_TARGET" "$(expand_pin "$prebuilt_url")" "$prebuilt_digest")
    staging="$out.$$"
    rm -rf "$staging"
    mkdir -p "$staging"
    # From standard input: tar reads a drive-letter path as a remote host.
    tar xzf - -C "$staging" < "$file" \
        || { rm -rf "$staging"; die "the $PREBUILT_TAG $prebuilt_label for $PREBUILT_TARGET did not unpack"; }
    [ -f "$staging/$prebuilt_marker" ] \
        || { rm -rf "$staging"; die "the $PREBUILT_TAG $prebuilt_label for $PREBUILT_TARGET has no $prebuilt_marker"; }
    rm -rf "$out"
    mkdir -p "$(dirname "$out")"
    mv "$staging" "$out"
    printf '%s %s %s\n' "$PREBUILT_TAG" "$prebuilt_kind" "$PREBUILT_TARGET" > "$out/.complete"
    release_lock
}

# The code generator library in the unpacked code generator archive, after
# `build_prebuilt codegen`. Sets PREBUILT_OUT to it. An archive from before the
# code generator was a library of its own carries none, and is refused by name.
prebuilt_codegen_library() {
    pcl_dir=$(dirname "$PREBUILT_OUT")
    [ -f "$pcl_dir/$prebuilt_codegen" ] \
        || die "the $PREBUILT_TAG prebuilt code generator for $PREBUILT_TARGET has no $prebuilt_codegen; it predates the code generator library, so pin a later release (scripts/toolchain.pins)"
    PREBUILT_OUT="$pcl_dir/$prebuilt_codegen"
}

# The features the archive's provider is built with. They are the ones
# bin/nupp's own provider asks for, so a checkout without a compiler yet starts
# it on the provider its first compiler would have built.
PREBUILT_PROVIDER_FEATURES=base

# The archive a release publishes as this machine's prebuilt code generator:
# the code generator library, linked from the pinned LLVM (built first if it
# must be), and the provider built with PREBUILT_PROVIDER_FEATURES. The feature
# list travels beside the provider, so a checkout can tell what it carries.
codegen_archive() {
    build_llvm
    build_codegen_library
    # A checkout that takes this provider has no compiler yet to build its own.
    [ -f "$ROOT/build/nupp/tools/main.lua" ] \
        || die "the code generator archive carries this checkout's provider; build the compiler first (./bin/nupp --version)"
    build_native_provider "$PREBUILT_PROVIDER_FEATURES" || die "cannot compile the native provider"
    prebuilt_pins
    [ -n "$prebuilt_library" ] || die "no prebuilt code generator is published for $PREBUILT_TARGET"
    codegen_staging=$(mktemp -d "${TMPDIR:-/tmp}/nupp-codegen.XXXXXX") || die "cannot stage the code generator"
    cp "$NATIVE_PROVIDER_OUT" "$codegen_staging/$prebuilt_library"
    cp "$CODEGEN_LIBRARY_OUT" "$codegen_staging/$prebuilt_codegen"
    printf '%s\n' "$PREBUILT_PROVIDER_FEATURES" > "$codegen_staging/features"
    deterministic_archive "$codegen_staging" "$1" || { rm -rf "$codegen_staging"; die "cannot archive the code generator"; }
    rm -rf "$codegen_staging"
}

# --- the prebuilt native provider -------------------------------------------

# The compiler's own native provider, for a checkout with no compiler yet to
# build one with: the one in the pinned prebuilt code generator archive, built
# with PREBUILT_PROVIDER_FEATURES. `native-provider` answers with it until there is
# a compiler, or whenever NUPP_PREBUILT_PROVIDER=1 asks for it. That is how
# bin/nupp and the stage-zero compiler both start: each asks `native-provider` for
# a provider, and neither knows where the answer came from. The library is the
# release's, not this tree's, so a checkout whose provider sources have moved
# past the pin runs the provider the pin names until its first compiler builds
# its own.

# Sets PREBUILT_OUT to the prebuilt provider when it carries every feature in
# the list.
prebuilt_provider() {
    requested=$(normalize_features "${1:-}")
    build_prebuilt codegen
    provider_dir=$(dirname "$PREBUILT_OUT")
    [ -f "$provider_dir/features" ] \
        || die "the $PREBUILT_TAG prebuilt code generator carries no provider features; pin a later release (scripts/toolchain.pins)"
    carried=",$(tr -d ' \r\n' < "$provider_dir/features"),"
    for feature in $(printf '%s' "$requested" | tr ',' ' '); do
        case "$carried" in
            *",$feature,"*) ;;
            *) die "the prebuilt native provider has no $feature feature" ;;
        esac
    done
    note "using the $PREBUILT_TAG prebuilt native provider"
}

# --- notices ----------------------------------------------------------------

# Each of these is MIT, and MIT asks that its notice travel with the copies. The
# sources are fetched rather than committed, so the only copy this repository
# ships is the one in `host/notices` -- and a copy that has drifted from the
# source it claims to reproduce is a false statement about what was distributed.
# Bumping a pin fails here until the notice beside it is updated too.
verify_notice() {
    noticeSource=$1 notice=$2
    committed="$ROOT/host/notices/$notice"
    [ -f "$noticeSource" ] \
        || die "the pinned source has no $noticeSource to check $notice against"
    [ -f "$committed" ] || die "host/notices/$notice is missing"
    if ! cmp -s "$noticeSource" "$committed"; then
        die "host/notices/$notice is not what $noticeSource says any more. Copy it across: the pinned source is what is distributed, and the notice beside it is what says so."
    fi
}

# LPeg ships its licence inside its manual rather than as a file, so the notice
# beside it is checked for the clauses instead of byte for byte.
verify_embedded_notice() {
    noticeSource=$1 notice=$2
    committed="$ROOT/host/notices/$notice"
    for text in '2007-2023 Lua.org, PUC-Rio' 'Permission is hereby granted' 'THE SOFTWARE IS PROVIDED'; do
        grep -qF "$text" "$noticeSource" && grep -qF "$text" "$committed" \
            || die "host/notices/$notice no longer agrees with $noticeSource"
    done
}

# --- one build at a time ----------------------------------------------------

# Two commands wanting the same component start together often enough -- a test
# suite runs the launcher many times -- and they would otherwise be two makes
# writing one source tree. `mkdir` is the lock because it is atomic wherever
# this runs; the pid in it tells a held lock from one a killed build left.
LOCK=""
HOST_OUT=""
NATIVE_OUT=""
NATIVE_PROVIDER_OUT=""
NUPP_EMBED_OUT=""
release_lock() { [ -n "$LOCK" ] && rm -rf "$LOCK"; LOCK=""; return 0; }

# Says that this run is waiting and on whom: once after a short grace, then
# once a minute. Waiting in silence read as a hang for as long as the other
# build took -- a quarter of an hour, several times over, with nothing to say
# why. Said on standard error whether or not it is a terminal: the runs that
# waited longest were a test suite's and an agent's, whose standard error is
# captured, and captured is exactly where a stall needs explaining. Callers
# read only standard output, so the answer they take is unchanged.
say_waiting() {
    [ "$3" -eq 3 ] || [ $(($3 % 60)) -eq 0 ] || return 0
    note "waiting for $1, which pid $2 is building (${3}s so far)"
}

take_lock() {
    lock="$CACHE/.lock-$1"
    waited=0
    mkdir -p "$CACHE"
    while ! mkdir "$lock" 2>/dev/null; do
        holder=$(cat "$lock/pid" 2>/dev/null || true)
        if [ -z "$holder" ] || ! kill -0 "$holder" 2>/dev/null; then
            rm -rf "$lock"
            continue
        fi
        # Whoever holds it is building what this one wants, so their answer is
        # this one's answer.
        [ -f "$2" ] && return 1
        sleep 1
        waited=$((waited + 1))
        say_waiting "$1" "$holder" "$waited"
        if [ "$waited" -ge 1800 ]; then
            note "another run has held $lock for ${waited}s; building without it"
            return 0
        fi
    done
    printf '%s\n' "$$" > "$lock/pid"
    LOCK=$lock
    trap 'release_lock' EXIT
    trap 'release_lock; exit 130' INT
    trap 'release_lock; exit 143' TERM
    return 0
}

# --- components -------------------------------------------------------------

normalize_features() {
    raw=${1:-}
    case "$raw" in
        *[!A-Za-z0-9_,-]*) die "invalid feature list $raw" ;;
    esac
    features=$(printf '%s' "$raw" | tr ',' ' ')
    for feature in $features; do
        case "$feature" in
            *[!A-Za-z0-9_-]*) die "invalid feature $feature" ;;
        esac
    done
    printf '%s\n' $features | sed '/^$/d' | LC_ALL=C sort -u \
        | tr '\n' ',' | sed 's/,$//'
}

native_provider_filename() {
    case "$PLATFORM" in
        darwin)  printf '%s\n' libnupp_native.dylib ;;
        windows) printf '%s\n' nupp_native.dll ;;
        *)       printf '%s\n' libnupp_native.so ;;
    esac
}

# Whether a host's code generator is built in: when the pinned LLVM is already
# built, or when NUPP_REQUIRE_CODEGEN=1 asks for it (a release, which builds
# LLVM if it must). Otherwise the build goes ahead without it, the way
# bin/nupp's own does, so a checkout or CI shard that never compiles AOT code
# never waits an hour for LLVM. `@aot` then says what is missing.
codegen_wanted() {
    [ "${NUPP_REQUIRE_CODEGEN:-}" = 1 ] && return 0
    (build_llvm available) >/dev/null 2>&1 && return 0
    note "building without the code generator: the pinned LLVM is not built (scripts/toolchain llvm)"
    return 1
}

# --- the native provider -----------------------------------------------------

# The provider, `nupp_native`, is a Nupp native program (native/provider) with
# the AOT runtime LLVM-compiled Lua builders call (native/aotruntime) compiled
# in. This checkout's compiler builds it into the shared library the
# compiler's runtime loads and the static archive a host links. That compiler
# runs on a provider too, so the first one a checkout runs is the pinned
# prebuilt one ("the prebuilt native provider"), and bin/nupp builds its own
# once there is a compiler to build it with.

# Checks a provider feature list. Every provider carries `base`, and nothing
# else is left to select.
provider_features() {
    for pf_feature in $(normalize_features "${1:-}" | tr ',' ' '); do
        [ "$pf_feature" = base ] || die "the native provider has no $pf_feature feature"
    done
}

# Whether `native-provider` answers with the pinned prebuilt provider rather than
# this checkout's: when NUPP_PREBUILT_PROVIDER=1 asks for it, and otherwise
# while there is no compiler to build one with.
prebuilt_provider_wanted() {
    [ "${NUPP_PREBUILT_PROVIDER:-}" = 1 ] && return 0
    [ "${NUPP_PREBUILT_PROVIDER:-}" = 0 ] && return 1
    [ ! -f "$ROOT/build/nupp/tools/main.lua" ]
}

# Whether a prebuilt provider is pinned for this machine, to fall back on.
prebuilt_provider_pinned() {
    prebuilt_pins
    [ -n "${PREBUILT_TAG:-}" ] && [ -n "$prebuilt_codegen_digest" ]
}

# The provider's own inputs: its sources and the runtime's, and the parts of
# the compiler that decide what a native program lowers and links to.
native_provider_digest() {
    {
        (cd "$ROOT" && find native/provider native/aotruntime -type f -name '*.nupp' 2>/dev/null) || true
        for file in scripts/toolchain src/nupp/compiler/aot/llvm/native.nupp src/nupp/tools/build/program.nupp \
            src/nupp/tools/build/aotllvm.nupp src/nupp/tools/cli/aot.nupp; do
            [ -f "$ROOT/$file" ] && printf '%s\n' "$file"
        done
    } | LC_ALL=C sort | while IFS= read -r file; do
        printf '%s ' "$file"
        sha256 "$ROOT/$file"
    done | sha256_stdin | cut -c1-16
}

# What the platform decides for the runtime: size_t's width, and the size of
# LuaJIT's luaL_Buffer, whose buffer the C library's BUFSIZ sets.
write_aot_runtime_build() {
    ar_probe=$(printf '#include <stdio.h>\nKS_BUFSIZ BUFSIZ\nKS_POINTER __SIZEOF_POINTER__\n' \
        | "$CC" -E -P - 2>/dev/null) || die "cannot ask $CC for BUFSIZ"
    ar_bufsiz=$(printf '%s\n' "$ar_probe" | sed -n 's/^KS_BUFSIZ[^0-9]*\([0-9][0-9]*\).*/\1/p' | tail -n 1)
    ar_pointer=$(printf '%s\n' "$ar_probe" | sed -n 's/^KS_POINTER[^0-9]*\([0-9][0-9]*\).*/\1/p' | tail -n 1)
    [ -n "$ar_bufsiz" ] && [ -n "$ar_pointer" ] || die "$CC answered no BUFSIZ or pointer size"
    # LUAL_BUFFERSIZE, behind a char *, an int and a lua_State *.
    [ "$ar_bufsiz" -gt 16384 ] && ar_bufsiz=8192
    ar_size=uint64
    ar_header=24
    ar_convert='n as uint64'
    if [ "$ar_pointer" = 4 ]; then
        ar_size=uint32
        ar_header=12
        ar_convert='math.u32.wrap(n)'
    fi
    {
        printf -- '--- What the platform decides for the AOT runtime: generated by scripts/toolchain.\n'
        printf 'module ksrt.build\n\n'
        printf 'export type Size = %s\n' "$ar_size"
        printf 'export const STRING_BUFFER_BYTES = %s\n\n' "$((ar_header + ar_bufsiz))"
        printf -- '--- A byte count as a size_t.\n'
        printf '@visibility("hidden")\n'
        printf 'export function ksSize(n: integer): Size\n'
        printf '    return %s\n' "$ar_convert"
        printf 'end\n'
    } > "$1/ksrt/build.nupp"
}

# Sets NATIVE_PROVIDER_OUT and NATIVE_PROVIDER_STATIC_OUT to the provider and
# its static archive, compiling them with this checkout's compiler the first
# time. Returns 1 when that compiler cannot, for want of a code generator.
build_native_provider() {
    provider_features "${1:-}"
    [ -f "$ROOT/build/nupp/tools/main.lua" ] \
        || die "the native provider is built by this checkout's compiler; build it first (./bin/nupp --version)"
    np_digest=$(printf '%s|%s|%s\n' nupp-native "$(native_provider_digest)" "$KEY" | sha256_stdin | cut -c1-16)
    np_out="$PREFIX/native-provider/$np_digest"
    NATIVE_PROVIDER_OUT="$np_out/$(native_provider_filename)"
    NATIVE_PROVIDER_STATIC_OUT="$np_out/libnupp_native.a"
    take_lock "native-provider-$np_digest" "$np_out/.complete" || return 0
    [ -f "$np_out/.complete" ] && [ -f "$NATIVE_PROVIDER_OUT" ] && [ -f "$NATIVE_PROVIDER_STATIC_OUT" ] \
        && { release_lock; return 0; }

    note "building the native provider"
    rm -rf "$np_out"
    mkdir -p "$np_out/src/ksrt"
    # The compiler resolves a relative include against the manifest's own
    # directory, and on Windows wants a drive-qualified path.
    printf 'return { include = { ".", "%s", "%s", "%s" } }\n' "$(native_path "$ROOT/native/provider")" \
        "$(native_path "$ROOT/native/aotruntime/common")" "$(native_path "$ROOT/native/aotruntime/bound")" \
        > "$np_out/src/nupp.lua"
    printf 'module main\n\nlocal _ = require("nuppnative.provider")\n' > "$np_out/src/main.nupp"
    write_aot_runtime_build "$np_out/src"
    printf '%s\n' nuppNativeAbiVersion nuppNativeFeatures nuppNativeLastError nuppNativeBytesCopy \
        nuppNativeBytesRelease nuppNativeAvailableParallelism nuppAotRuntime > "$np_out/src/exports"
    # The compiler runs on this checkout's provider, which may be the one
    # being replaced, so it is told to run on the one staged rather than
    # build another.
    np_main=$(native_path "$np_out/src/main.nupp")
    if ! NUPP_NATIVE_PROVIDER_BUILD=1 "$ROOT/bin/nupp" aot --emit shared-library \
            --exports "$(native_path "$np_out/src/exports")" \
            --output "$(native_path "$NATIVE_PROVIDER_OUT")" "$np_main" >&2 \
        || ! NUPP_NATIVE_PROVIDER_BUILD=1 "$ROOT/bin/nupp" aot --emit static-library \
            --output "$(native_path "$NATIVE_PROVIDER_STATIC_OUT")" "$np_main" >&2; then
        rm -rf "$np_out"
        release_lock
        return 1
    fi
    printf 'done\n' > "$np_out/.complete"
    release_lock
}

select_host_features() {
    host_feature_words=$(printf '%s' "${1:-}" | tr ',' ' ')
    host_feature_words=$(printf '%s\n' $host_feature_words | LC_ALL=C sort -u | tr '\n' ' ')
    host_features=""
    host_lpeg_prefix=""
    for feature in $host_feature_words; do
        case "$feature" in
            lpeg)
                host_lpeg_prefix=$(build_lpeg; printf '%s' "$PREFIX/lpeg")
                host_features="$host_features,lpeg"
                ;;
            workers) host_features="$host_features,workers" ;;
            native-files|files|filesystem)
                host_features="$host_features,native-files"
                ;;
            native-net|net) host_features="$host_features,native-net" ;;
            native-tls|tls) host_features="$host_features,native-tls" ;;
            native-process|process)
                host_features="$host_features,native-process"
                ;;
            native-compression|compression)
                host_features="$host_features,native-compression"
                ;;
            native-codegen|codegen)
                if codegen_wanted; then
                    host_features="$host_features,native-codegen"
                fi
                ;;
            base|native-checksum|native-time) ;;
            *) die "unknown host feature $feature" ;;
        esac
    done
    host_features=$(normalize_features "${host_features#,}")
}

# A host that links libnupp.a is an executable, and LuaJIT's ffi.C finds the
# provider's nuppNative* symbols only among what that executable exports. macOS
# executables export them already; a Linux one needs -rdynamic, and a Windows
# (GNU toolchain) one --export-all-symbols.
static_host_export_flags() {
    [ "$UNAME" = Linux ] && printf '%s\n' -rdynamic
    [ "$PLATFORM" = windows ] && printf '%s\n' -Wl,--export-all-symbols
    return 0
}

embedding_library_filename() {
    case "$PLATFORM" in
        darwin) printf '%s\n' libnupp.dylib ;;
        windows) printf '%s\n' nupp.dll ;;
        *) printf '%s\n' libnupp.so ;;
    esac
}

# Builds the C embedding SDK for one normalized feature list into
# NUPP_EMBED_OUT: libnupp.a (the Nupp embedding library, the native provider,
# LuaJIT and LPeg), the shared library linked from it and, on Windows, its
# import library. The library is a native Nupp program,
# host/program/common/nuppembed, compiled the way the host is.
build_nupp_embedding() {
    ne_luajit=$1
    ne_features=${2:-}
    ne_lpeg=${3:-}
    build_native_provider base || die "cannot compile the native provider"
    ne_provider_archive=$NATIVE_PROVIDER_STATIC_OUT
    ne_digest=$(printf '%s|%s|%s|%s|%s' \
        nupp-embedding "$ne_features" "$(host_program_digest)" "$ne_provider_archive" "$KEY" \
        | sha256_stdin | cut -c1-16)
    ne_out="$PREFIX/nupp-embedding/$ne_digest"
    NUPP_EMBED_OUT=$ne_out
    ne_dynamic=$(embedding_library_filename)

    take_lock "nupp-embedding-$ne_digest" "$ne_out/.complete" || return 0
    if [ -f "$ne_out/.complete" ] && [ -f "$ne_out/libnupp.a" ] && [ -f "$ne_out/$ne_dynamic" ]; then
        [ "$PLATFORM" != windows ] || [ -f "$ne_out/libnupp.dll.a" ] \
            || die "the cached Windows embedding SDK has no import library"
        release_lock
        return 0
    fi

    note "building the Nupp embedding library"
    rm -rf "$ne_out"
    mkdir -p "$ne_out/src"
    write_host_program "$ne_out/src" "$ne_features" "$ne_luajit"
    {
        printf 'module embed\n\n'
        printf 'const {nupp_config_init} = require("nuppembed.abi")\n\n'
        printf -- '--- Names the embedding ABI, whose exports are the library.\n'
        printf 'export function nuppEmbedAbi(): voidptr\n'
        printf '    return nupp_config_init as voidptr\n'
        printf 'end\n'
    } > "$ne_out/src/embed.nupp"
    "$ROOT/bin/nupp" aot --emit static-library --output "$(native_path "$ne_out/libnuppembed.a")" \
        "$(native_path "$ne_out/src/embed.nupp")" >&2 \
        || die "cannot compile the Nupp embedding library"
    set -- "$ne_out/libnuppembed.a" "$ne_provider_archive" "$ne_luajit/lib/libluajit-5.1.a"
    [ -z "$ne_lpeg" ] || set -- "$@" "$ne_lpeg/lib/liblpeg.a"
    merge_static_archives "$ne_out/libnupp.a" "$@"
    rm -f "$ne_out/libnuppembed.a"

    # The shared library exports host/include/nupp.exports for this feature
    # list and nothing else.
    ne_exports="$ne_out/nupp.exports"
    host_stub_exports "$ne_features" "$ne_luajit" embedding > "$ne_exports"
    [ -s "$ne_exports" ] || die "the embedding build resolved no exports"
    case "$PLATFORM" in
        darwin)
            sed 's/^/_/' "$ne_exports" > "$ne_out/nupp.exports.darwin"
            set -- "$CC" -dynamiclib -o "$ne_out/$ne_dynamic" "-Wl,-force_load,$ne_out/libnupp.a" \
                "-Wl,-exported_symbols_list,$ne_out/nupp.exports.darwin" \
                -Wl,-install_name,@rpath/libnupp.dylib "-Wl,-oso_prefix,$ne_out/"
            ;;
        windows)
            # The provider's import members go after the system libraries, as
            # for the host, so MinGW's own import libraries answer first.
            stage_application_archive "$ne_out/libnupp.a" "$ne_out/libnupp-dll.a" \
                "$ne_out/libnupp-dll-imports.a"
            {
                printf 'EXPORTS\n'
                sed 's/^/    /' "$ne_exports"
            } > "$ne_out/nupp.def"
            set -- "$CC" -shared -o "$ne_out/$ne_dynamic" \
                -Wl,--whole-archive "$ne_out/libnupp-dll.a" -Wl,--no-whole-archive \
                "$(native_path "$ne_out/nupp.def")" \
                "-Wl,--out-implib,$(native_path "$ne_out/libnupp.dll.a")"
            ;;
        *)
            # Each export is also an undefined reference, which is what pulls
            # its member out of the archive.
            {
                printf '{\n  global:\n'
                sed 's/.*/    &;/' "$ne_exports"
                printf '  local: *;\n};\n'
            } > "$ne_out/nupp.map"
            set -- "$CC" -shared -o "$ne_out/$ne_dynamic" \
                -Wl,-soname,libnupp.so "-Wl,--version-script=$ne_out/nupp.map"
            while IFS= read -r ne_symbol; do
                set -- "$@" "-Wl,--undefined=$ne_symbol"
            done < "$ne_exports"
            set -- "$@" "$ne_out/libnupp.a"
            ;;
    esac
    while IFS= read -r ne_flag; do
        [ -z "$ne_flag" ] || set -- "$@" "$ne_flag"
    done <<EOF
$(host_system_flags "$ne_features")
EOF
    [ "$PLATFORM" != windows ] || set -- "$@" "$ne_out/libnupp-dll-imports.a"
    "$@" >&2 || die "cannot link the Nupp embedding library"
    rm -f "$ne_out/libnupp-dll.a" "$ne_out/libnupp-dll-imports.a"
    [ "$PLATFORM" != windows ] || [ -f "$ne_out/libnupp.dll.a" ] \
        || die "the Windows embedding link wrote no import library"
    printf 'done\n' > "$ne_out/.complete"
    release_lock
}

shared_flags() {
    case "$PLATFORM" in
        darwin)  printf '%s' "-bundle -undefined dynamic_lookup" ;;
        windows) printf '%s' "-shared" ;;
        *)       printf '%s' "-shared" ;;
    esac
}

module_extension() {
    case "$PLATFORM" in
        windows) printf '%s' ".dll" ;;
        *)       printf '%s' ".so" ;;
    esac
}

# The receipt the install leaves beside the interpreter. `scripts/luajit.sh`
# reads the same one to decide whether a LuaJIT on the PATH is this one.
luajit_receipt() {
    cksum < "$ROOT/scripts/patches/luajit.patch"
    cksum < "$1/bin/luajit"
}

# Finished and still what was installed. The marker alone was believed, so an
# interpreter damaged afterwards was handed to every command, which the kernel
# then killed before it printed anything.
luajit_intact() {
    [ -f "$1/.complete" ] && [ -f "$1/.nupp-runtime-patch" ] || return 1
    [ "$(luajit_receipt "$1" 2>/dev/null)" = "$(cat "$1/.nupp-runtime-patch")" ]
}

build_luajit() {
    out="$PREFIX/luajit"
    take_lock luajit "$out/.complete" || return 0
    luajit_intact "$out" && { release_lock; return 0; }
    [ -f "$out/.complete" ] && note "the cached LuaJIT is not what was installed; building it again"

    directory=$(expand_pin "$LUAJIT_DIRECTORY")
    url=$(expand_pin "$LUAJIT_URL")
    luajit_source=$(source_tree "$directory" "$url" "$LUAJIT_SHA256" "$LUAJIT_MARKER")
    verify_notice "$luajit_source/COPYRIGHT" LuaJIT-COPYRIGHT.txt

    # Shared verified sources are immutable inputs. Patch and compile a fresh
    # private copy, so another compiler key cannot observe either change.
    luajit_build="$PREFIX/.luajit-source"
    rm -rf "$luajit_build"
    mkdir -p "$luajit_build"
    cp -R "$luajit_source/." "$luajit_build/"
    patch -f -p1 -d "$luajit_build" < "$ROOT/scripts/patches/luajit.patch" >&2
    tree=$luajit_build

    note "building LuaJIT with $CC"
    rm -rf "$out"
    # LuaJIT bakes its module search paths in at compile time, so the prefix has
    # to be the one it is installed under rather than one it is copied to. It
    # also refuses to guess an Apple deployment target, preferring to stop over
    # producing something that runs here and nowhere else.
    if [ "$PLATFORM" = darwin ] && [ -z "${MACOSX_DEPLOYMENT_TARGET:-}" ]; then
        case "$(uname -m 2>/dev/null)" in
            x86_64) MACOSX_DEPLOYMENT_TARGET=10.14 ;;
            *)      MACOSX_DEPLOYMENT_TARGET=11.0 ;;
        esac
        export MACOSX_DEPLOYMENT_TARGET
    fi
    "$MAKE" -C "$tree" clean >/dev/null 2>&1 || true
    "$MAKE" -C "$tree" PREFIX="$out" CC="$CC" HOST_CC="$CC" XCFLAGS=-fPIC >&2
    "$MAKE" -C "$tree" PREFIX="$out" install >&2

    # LuaJIT's top-level install recipe only knows the Unix artifact names.
    # Its Windows build is deliberately dynamic so C modules bind to the same
    # VM as the interpreter, but that leaves lua51.dll and its import library
    # in the source tree. Stage both, then make the static archive separately:
    # standalone Nupp hosts carry their VM and cannot depend on a sibling DLL.
    if [ "$PLATFORM" = windows ]; then
        [ -f "$tree/src/lua51.dll" ] \
            || die "LuaJIT's Windows build produced no lua51.dll"
        [ -f "$tree/src/libluajit-5.1.dll.a" ] \
            || die "LuaJIT's Windows build produced no import library"
        cp "$tree/src/lua51.dll" "$out/bin/lua51.dll"
        cp "$tree/src/luajit.exe" "$out/bin/luajit.exe"
        cp "$tree/src/libluajit-5.1.dll.a" \
            "$out/lib/libluajit-5.1.dll.a"
        cp "$tree/src/libluajit-5.1.dll.a" \
            "$out/lib/liblua51.a"

        "$MAKE" -C "$tree" clean >/dev/null 2>&1 || true
        "$MAKE" -C "$tree" PREFIX="$out" CC="$CC" HOST_CC="$CC" \
            XCFLAGS=-fPIC BUILDMODE=static >&2
        [ -f "$tree/src/libluajit.a" ] \
            || die "LuaJIT's Windows static build produced no archive"
        cp "$tree/src/libluajit.a" "$out/lib/libluajit-5.1.a"

        # The same Unix-only install recipe leaves the interpreter's own Lua
        # modules behind. `jit.vmdef` is what the bytecode reader loads and
        # `jit.zone` is what the profiler does, so without them every question
        # about a trace answered "module not found" rather than answering.
        #
        # Beside the executable, because that is where this interpreter looks:
        # the Unix build compiles in a prefix and finds `share/luajit-2.1`, and
        # the Windows one searches `<exedir>\lua\?.lua`. Staged under the
        # prefix as well, for anything reading the tree rather than running it.
        for jit_dir in "$out/bin/lua/jit" "$out/share/luajit-2.1/jit"; do
            mkdir -p "$jit_dir"
            cp "$tree/src/jit/"*.lua "$jit_dir/"
            [ -f "$jit_dir/vmdef.lua" ] \
                || die "LuaJIT's Windows build staged no jit/vmdef.lua"
        done
    else
        # The prefix baked in above is for this interpreter. The static archive
        # is what a host carries into every stamped binary, where the prefix
        # named this machine's cache in package.path -- a directory no user of
        # a released nupp has, and different bytes from every other checkout.
        # Build the archive with LuaJIT's stock paths instead; the host preloads
        # the jit.* modules it needs.
        "$MAKE" -C "$tree" clean >/dev/null 2>&1 || true
        "$MAKE" -C "$tree" PREFIX=/usr/local CC="$CC" HOST_CC="$CC" XCFLAGS=-fPIC >&2
        [ -f "$tree/src/libluajit.a" ] \
            || die "LuaJIT's static build produced no archive"
        cp "$tree/src/libluajit.a" "$out/lib/libluajit-5.1.a"
    fi

    # `luajit` itself is a versioned name plus a symlink upstream only makes on
    # some platforms, and everything here runs the plain one.
    if [ ! -x "$out/bin/luajit" ]; then
        for candidate in "$out"/bin/luajit-*; do
            [ -x "$candidate" ] || continue
            ln -sf "$(basename "$candidate")" "$out/bin/luajit"
            break
        done
    fi
    [ -x "$out/bin/luajit" ] || die "LuaJIT installed no interpreter under $out/bin"

    # Where the headers landed, which is a versioned directory, said once here so
    # nothing downstream has to know the version.
    include=$(find "$out/include" -maxdepth 1 -type d -name 'luajit-*' | head -n 1)
    [ -n "$include" ] || include="$out/include"
    native_path "$include" > "$out/.include"
    luajit_receipt "$out" > "$out/.nupp-runtime-patch"
    rm -rf "$luajit_build"
    printf 'done\n' > "$out/.complete"
    release_lock
}

luajit_include() {
    build_luajit
    cat "$PREFIX/luajit/.include"
}

build_luarocks() {
    out="$PREFIX/luarocks"
    luajit=$(build_luajit; printf '%s' "$PREFIX/luajit")
    include=$(cat "$luajit/.include")
    take_lock luarocks "$out/.complete" || return 0
    [ -f "$out/.complete" ] && { release_lock; return 0; }

    directory=$(expand_pin "$LUAROCKS_DIRECTORY")
    url=$(expand_pin "$LUAROCKS_URL")
    tree=$(source_tree "$directory" "$url" "$LUAROCKS_SHA256" "$LUAROCKS_MARKER")

    note "installing LuaRocks"
    rm -rf "$out"
    if [ "$PLATFORM" = windows ]; then
        outWindows=$(cygpath -w "$out")
        rocksWindows=$(cygpath -w "$ROOT/.rocks")
        binWindows=$(cygpath -w "$luajit/bin")
        includeWindows=$(cygpath -w "$include")
        libWindows=$(cygpath -w "$luajit/lib")
        # Git Bash otherwise rewrites switches such as /P and /TREE as paths
        # before the batch installer sees them.
        (cd "$tree" && MSYS2_ARG_CONV_EXCL='*' cmd.exe /d /c call install.bat \
            /P "$outWindows" /TREE "$rocksWindows" \
            /LV 5.1 /INC "$includeWindows" /LIB "$libWindows" \
            /BIN "$binWindows" /MW /Q /F /NOREG /NOADMIN \
            /FORCECONFIG) >&2
    else
        (cd "$tree" && ./configure \
            --prefix="$out" \
            --rocks-tree="$ROOT/.rocks" \
            --lua-version=5.1 \
            --with-lua-bin="$luajit/bin" \
            --with-lua-include="$include" \
            --with-lua-lib="$luajit/lib" \
            --with-lua-interpreter=luajit \
            --force-config && "$MAKE" install) >&2
        if [ "$PLATFORM" = darwin ]; then
            # LuaRocks takes the first 32 hex characters from the checker's
            # output. OpenSSL prints the filename first, so commit-hash archive
            # names are mistaken for their digest. BSD md5's quiet form prints
            # only the digest, regardless of the filename.
            cat >> "$out/etc/luarocks/config-5.1.lua" <<'EOF'
variables = variables or {}
variables.MD5SUM = "/sbin/md5 -q"
EOF
        fi
    fi
    case "$PLATFORM" in
        windows) executable="$out/luarocks.bat" ;;
        *) executable="$out/bin/luarocks" ;;
    esac
    [ -f "$executable" ] || die "LuaRocks installed no executable under $out"
    native_path "$executable" > "$out/.executable"
    printf 'done\n' > "$out/.complete"
    release_lock
}

# LPeg is built straight from its sources. It is a handful of files against the
# Lua headers, and naming them is shorter than teaching its build system where
# the staged LuaJIT is.
build_lua_module() {
    name=$1 out=$2 tree=$3 include=$4
    shift 4
    objects=""
    for file in "$@"; do
        object="$out/objects/$(basename "$file" .c).o"
        mkdir -p "$out/objects"
        "$CC" -c -O2 -fPIC -w -DNDEBUG -I"$include" -o "$object" "$tree/$file" >&2
        objects="$objects $object"
    done
    mkdir -p "$out/lib"
    # Both shapes, because both are wanted: a loadable module for an interpreter
    # that requires it, and an archive for a host that links it in.
    # shellcheck disable=SC2086
    luaLibrary=""
    if [ "$PLATFORM" = windows ]; then
        luaLibrary="$PREFIX/luajit/lib/libluajit-5.1.dll.a"
    fi
    "$CC" $(shared_flags) -o "$out/lib/$name$(module_extension)" \
        $objects $luaLibrary >&2
    # shellcheck disable=SC2086
    ar rcs "$out/lib/lib$name.a" $objects
}

# The pinned, verified LPeg source tree. A caller that compiles LPeg with a
# compiler of its own -- the playground's Emscripten host links it into the
# application VM, where a loadable C module is not a thing that exists -- wants
# the sources rather than this machine's build of them, and wants them fetched
# through the same pin and the same notice check.
lpeg_source() {
    directory=$(expand_pin "$LPEG_DIRECTORY")
    url=$(expand_pin "$LPEG_URL")
    mirrors=$(expand_pin "$LPEG_MIRRORS")
    tree=$(source_tree "$directory" "$url" "$LPEG_SHA256" "$LPEG_MARKER" .tar.gz "$mirrors")
    verify_embedded_notice "$tree/lpeg.html" LPeg-LICENSE.txt
    printf '%s\n' "$tree"
}

build_lpeg() {
    out="$PREFIX/lpeg"
    # Before the lock, not inside it: these locks do not nest, and building
    # LuaJIT under the LPeg lock would release the LPeg one on its way out.
    include=$(luajit_include)
    tree=$(lpeg_source)
    take_lock lpeg "$out/.complete" || return 0
    [ -f "$out/.complete" ] && { release_lock; return 0; }

    note "building LPeg with $CC"
    rm -rf "$out"
    build_lua_module lpeg "$out" "$tree" "$include" \
        lpvm.c lpcap.c lptree.c lpcode.c lpprint.c lpcset.c
    # The official frontend is Lua, and a caller that wants `re` wants it beside
    # the module it parses with.
    mkdir -p "$out/share"
    cp "$tree/re.lua" "$out/share/re.lua"
    printf 'done\n' > "$out/.complete"
    release_lock
}

# --- the host ------------------------------------------------------------

# A Rust staticlib flattens its dependency rlibs. On Windows GNU that includes
# import thunk members from windows-targets, sometimes under the same archive
# member name more than once. Non-Windows application hosts are force-loaded
# because provider exports are reached only through LuaJIT FFI. Windows keeps
# those exports in one selected codegen unit and uses a sanitized archive with
# an unmodified companion linked through ordinary archive
# selection after MinGW's system import libraries: the latter then supplies
# only Rust std imports which those libraries do not expose, without selecting
# flattened duplicate thunks for symbols MinGW already owns.
stage_application_archive() {
    source=$1
    destination=$2
    imports_archive=${3:-}
    cp "$source" "$destination"
    [ "$PLATFORM" = windows ] || return 0
    [ -n "$imports_archive" ] || die "the Windows application archive needs an import companion"
    cp "$source" "$imports_archive"

    archive_tool=${AR:-ar}
    members="$destination.members.$$"
    imports="$destination.imports.$$"
    "$archive_tool" t "$destination" > "$members"
    : > "$imports"
    while IFS= read -r member; do
        member=$(printf '%s' "$member" | tr -d '\r')
        case "$member" in
            *.dlls[0-9]*.o|*.dllh.o|*.dllt.o)
                printf '%s\n' "$member" >> "$imports"
                ;;
        esac
    done < "$members"
    if [ -s "$imports" ]; then
        # GNU ar processes every response-file argument in memory and writes
        # the archive once. Repeated names in this list therefore remove each
        # duplicate instance without rewriting the large Rust staticlib once
        # per member.
        imports_native=$(native_path "$imports")
        "$archive_tool" d "$destination" "@$imports_native"
    fi
    "$archive_tool" s "$destination"
    "$archive_tool" t "$destination" > "$members"
    while IFS= read -r member; do
        member=$(printf '%s' "$member" | tr -d '\r')
        case "$member" in
            *.dlls[0-9]*.o|*.dllh.o|*.dllt.o)
                rm -f "$members" "$imports"
                die "the staged Windows application archive retains import member $member"
                ;;
        esac
    done < "$members"
    rm -f "$members" "$imports"
}

# System dependencies needed by consumers of the flattened Rust static archive.
# Keep the application linker and the embedding SDK's machine-readable contract
# on the same feature-specific list.
host_system_flags() {
    case "$PLATFORM" in
        darwin)
            printf '%s\n' -lm -lpthread -framework CoreFoundation -framework Security
            ;;
        windows)
            printf '%s\n' -lpthread -lpsapi -luser32 -ladvapi32 -liphlpapi -luserenv \
                -lws2_32 -ldbghelp -lole32 -lshell32 -lbcrypt -lcrypt32 -lntdll \
                -lkernel32 -lsecur32 -lncrypt
            ;;
        *) printf '%s\n' -lm -lpthread -ldl ;;
    esac
}

# --- The Nupp host ------------------------------------------------------------

# The host executable and the kit's runtime archive are a native Nupp program,
# host/program: modules every platform shares, and one `nupphost.sys` per
# platform beside them. A build generates the entry and `nupphost.build`, the
# module that says which features this host was built with, and compiles them
# with this tree's compiler into a static archive.

host_program_platform() {
    case "$PLATFORM-$UNAME" in
        darwin-*) echo darwin ;;
        windows-*) echo windows ;;
        posix-Linux) echo linux ;;
        *) die "no Nupp host for $PLATFORM on $UNAME" ;;
    esac
}

# The Nupp host's own inputs: its sources, and the parts of the compiler that
# decide what a native program lowers and links to.
host_program_digest() {
    {
        (cd "$ROOT" && find host/program -type f -name '*.nupp' 2>/dev/null) || true
        for file in scripts/toolchain host/include/nupp.exports \
            src/nupp/compiler/aot/llvm/native.nupp src/nupp/tools/build/program.nupp \
            src/nupp/tools/build/aotllvm.nupp src/nupp/tools/cli/aot.nupp; do
            [ -f "$ROOT/$file" ] && printf '%s\n' "$file"
        done
    } | LC_ALL=C sort | while IFS= read -r file; do
        printf '%s ' "$file"
        sha256 "$ROOT/$file"
    done | sha256_stdin | cut -c1-16
}

# LuaJIT's own `jit/NAME.lua`, which every host preloads.
host_jit_module() {
    for candidate in "$1/share/luajit-2.1/jit/$2.lua" "$1/bin/lua/jit/$2.lua"; do
        [ -f "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
    done
    die "the staged LuaJIT at $1 has no jit/$2.lua"
}

# A file's text as one Nupp string literal.
host_string_literal() {
    printf '"'
    sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' "$1" | awk '{ printf "%s\\n", $0 }'
    printf '"'
}

# Writes the generated half of a host program into DIRECTORY: its manifest, its
# entry, which defines the C `main`, and `nupphost.build`. The features are the
# host's feature names as `select_host_features` normalized them.
write_host_program() {
    hp_directory=$1
    hp_features=$2
    hp_luajit=$3
    hp_platform=$(host_program_platform)
    mkdir -p "$hp_directory/nupphost"
    # The compiler resolves a relative include against the manifest's own
    # directory, and on Windows wants a drive-qualified path.
    hp_common=$(native_path "$ROOT/host/program/common")
    hp_system=$(native_path "$ROOT/host/program/$hp_platform")
    printf 'return { include = { ".", "%s", "%s" } }\n' "$hp_common" "$hp_system" > "$hp_directory/nupp.lua"
    {
        printf 'module main\n\n'
        printf 'const {nuppHostCliMain as run} = require("nupphost.cli")\n\n'
        printf 'export function main(argc: int32, argv: cstring*): int32\n'
        printf '    return run(argc, argv)\n'
        printf 'end\n'
    } > "$hp_directory/main.nupp"
    hp_list="native-checksum,native-time"
    hp_lpeg=false
    hp_workers=false
    for hp_feature in $(printf '%s' "$hp_features" | tr ',' ' '); do
        case "$hp_feature" in
            lpeg) hp_lpeg=true; hp_list="$hp_list,lpeg" ;;
            workers) hp_workers=true ;;
            *) hp_list="$hp_list,$hp_feature" ;;
        esac
    done
    {
        printf -- '--- What this host was built with: generated by scripts/toolchain.\n'
        printf 'module nupphost.build\n\n'
        [ "$hp_lpeg" = false ] || printf 'cdef function luaopen_lpeg(borrows L: voidptr): int32\n\n'
        printf 'export const FEATURES = "%s"\n' "$hp_list"
        printf 'export const LPEG = %s\n' "$hp_lpeg"
        printf 'export const WORKERS = %s\n\n' "$hp_workers"
        printf 'export function nuppHostBuildOpenLpeg(L: voidptr): int32\n'
        if [ "$hp_lpeg" = true ]; then
            printf '    return luaopen_lpeg(L)\n'
        else
            printf '    return 0\n'
        fi
        printf 'end\n\n'
        printf 'export const VMDEF = '
        host_string_literal "$(host_jit_module "$hp_luajit" vmdef)"
        printf '\nexport const ZONE = '
        host_string_literal "$(host_jit_module "$hp_luajit" zone)"
        printf '\nexport const BC = '
        host_string_literal "$(host_jit_module "$hp_luajit" bc)"
        printf '\n'
    } > "$hp_directory/nupphost/build.nupp"
}

# Merges static archives into one, members whole, with the platform's own
# archiver: libtool on macOS, an ar MRI script elsewhere.
merge_static_archives() {
    ma_output=$1
    shift
    rm -f "$ma_output"
    if [ "$PLATFORM" = darwin ]; then
        libtool -static -o "$ma_output" "$@" 2>/dev/null >&2 \
            || die "cannot merge the host's static archives"
        return 0
    fi
    ma_script="$ma_output.mri"
    {
        printf 'create %s\n' "$(native_path "$ma_output")"
        for ma_archive in "$@"; do
            printf 'addlib %s\n' "$(native_path "$ma_archive")"
        done
        printf 'save\nend\n'
    } > "$ma_script"
    "${AR:-ar}" -M < "$ma_script" >&2 || die "cannot merge the host's static archives"
    rm -f "$ma_script"
    "${AR:-ar}" s "$ma_output" || die "cannot index the host's static archive"
}

# The symbols the stub executable exports by name, one per line: the LuaJIT C
# API and the native provider, which LuaJIT's FFI resolves in its own process.
# That is host/include/nupp.exports for this feature list, less the embedding
# API, which only the embedding SDK defines; given a third argument, it is the
# embedding SDK's own list, that API included. The code generator's aliases are
# added by host_stub_export_flags, from native/codegen/symbols.
host_stub_exports() {
    hx_features=$1
    hx_luajit=$2
    hx_embedding=${3:-}
    hx_include=$(cat "$hx_luajit/.include")
    hx_version=$(sed -n 's/^#define LUAJIT_VERSION_SYM[ 	]*//p' "$hx_include/luajit.h" | tr -d '\r')
    hx_applies=false
    while IFS= read -r hx_line; do
        hx_line=$(printf '%s' "$hx_line" | tr -d '\r' | sed 's/^[ 	]*//; s/[ 	]*$//')
        case "$hx_line" in
            ''|'#'*) continue ;;
            '['*']')
                hx_applies=false
                for hx_section in $(printf '%s' "$hx_line" | tr -d '[]'); do
                    case ",always,$hx_features," in
                        *,"$hx_section",*) hx_applies=true ;;
                    esac
                done
                continue
                ;;
            nupp_*) [ -n "$hx_embedding" ] || continue ;;
        esac
        [ "$hx_applies" = true ] || continue
        [ "$hx_line" = LUAJIT_VERSION_SYM ] && hx_line=$hx_version
        printf '%s\n' "$hx_line"
    done < "$ROOT/host/include/nupp.exports"
}

# What the stub executable exports, and nothing of LLVM, lld or C++: exported,
# those cost a symbol table the size of the rest of the binary, and every one
# of their functions kept live against dead stripping. macOS and Windows are
# given the list itself; a PE image also holds at most 65535 exports, which
# LLVM's alone would pass. Linux hides by pattern instead.
host_stub_export_flags() {
    he_out=$1
    he_features=$2
    he_luajit=$3
    he_codegen=false
    case ",$he_features," in *,native-codegen,*) he_codegen=true ;; esac
    case "$PLATFORM" in
        darwin)
            {
                host_stub_exports "$he_features" "$he_luajit"
                [ "$he_codegen" = false ] || codegen_symbols | sed 's/ .*//'
            } | sed 's/^/_/' > "$he_out/nupp-host.exports"
            # macOS also drops local symbols; Linux keeps them, because a
            # crashed worker's core dump is read back through them.
            printf '%s\n' -Wl,-x "-Wl,-exported_symbols_list,$he_out/nupp-host.exports"
            ;;
        windows)
            {
                printf 'EXPORTS\n'
                host_stub_exports "$he_features" "$he_luajit" | sed 's/^/    /'
                [ "$he_codegen" = false ] || codegen_definitions
            } > "$he_out/nupp-host.def"
            native_path "$he_out/nupp-host.def"
            ;;
        *)
            # C++, Rust and LLVM's C API. Exported, LLVM would also take the
            # place of the one a dlopen()ed library brings: Mesa's llvmpipe
            # Vulkan driver then calls this LLVM and crashes in vkCreateDevice.
            printf '%s\n' '{ global: *; local: _Z*; _R*; LLVM*; llvm_*; };' > "$he_out/nupp-host.map"
            printf '%s\n' -Wl,-E "-Wl,--version-script=$he_out/nupp-host.map"
            ;;
    esac
}

# Builds the Nupp host for one normalized feature list into NUPP_HOST_OUT: the
# static archive the kit's runtime is (the host with its C `main`, the native
# provider, LuaJIT and LPeg) and the stub executable linked from it.
build_nupp_host() {
    nh_features=$1
    nh_lpeg=$2
    nh_luajit=$3
    # The code generator is linked into the stub itself, from the pinned LLVM.
    nh_codegen=""
    case ",$nh_features," in
        *,native-codegen,*)
            build_llvm
            nh_codegen=$(codegen_material)
            ;;
    esac
    build_native_provider base || die "cannot compile the native provider"
    nh_provider_archive=$NATIVE_PROVIDER_STATIC_OUT
    nh_digest=$(printf '%s|%s|%s|%s|%s|%s' \
        nupp-host "$nh_features" "$(host_program_digest)" "$nh_provider_archive" "$KEY" "$nh_codegen" \
        | sha256_stdin | cut -c1-16)
    nh_out="$PREFIX/nupp-host/$nh_digest"
    NUPP_HOST_OUT=$nh_out
    nh_stub=nupp-host
    [ "$PLATFORM" = windows ] && nh_stub=nupp-host.exe
    take_lock "nupp-host-$nh_digest" "$nh_out/.complete" || return 0
    [ -f "$nh_out/.complete" ] && [ -f "$nh_out/$nh_stub" ] && { release_lock; return 0; }

    note "building the Nupp host"
    rm -rf "$nh_out"
    mkdir -p "$nh_out/src"
    write_host_program "$nh_out/src" "$nh_features" "$nh_luajit"
    "$ROOT/bin/nupp" aot --emit static-library --output "$(native_path "$nh_out/libnupphost.a")" \
        "$(native_path "$nh_out/src/main.nupp")" >&2 \
        || die "cannot compile the Nupp host"
    set -- "$nh_out/libnupphost.a" "$nh_provider_archive" "$nh_luajit/lib/libluajit-5.1.a"
    [ -z "$nh_lpeg" ] || set -- "$@" "$nh_lpeg/lib/liblpeg.a"
    merge_static_archives "$nh_out/libnupp-host-merged.a" "$@"
    stage_application_archive "$nh_out/libnupp-host-merged.a" "$nh_out/libnupp-host.a" \
        "$nh_out/libnupp-host-imports.a"
    rm -f "$nh_out/libnupp-host-merged.a" "$nh_out/libnupphost.a"

    if [ "$PLATFORM" = darwin ]; then
        # ld64 hashes the debug map's object paths, which name this build's
        # directory, into LC_UUID.
        set -- "$CC" -o "$nh_out/$nh_stub" "-Wl,-force_load,$nh_out/libnupp-host.a" \
            "-Wl,-oso_prefix,$nh_out/"
    else
        set -- "$CC" -o "$nh_out/$nh_stub" -Wl,--whole-archive "$nh_out/libnupp-host.a" -Wl,--no-whole-archive
        [ "$PLATFORM" = windows ] && set -- "$@" "$nh_out/libnupp-host-imports.a"
    fi
    while IFS= read -r nh_flag; do
        [ -z "$nh_flag" ] || set -- "$@" "$nh_flag"
    done <<EOF
$(host_system_flags "$nh_features")
$([ -z "$nh_codegen" ] || { codegen_alias_flags; codegen_libraries host; })
$(host_stub_export_flags "$nh_out" "$nh_features" "$nh_luajit")
EOF
    "$@" >&2 || die "cannot link the Nupp host"
    if [ "$PLATFORM" = darwin ]; then
        codesign --force --sign - --identifier nupp-host "$nh_out/$nh_stub" >&2 \
            || die "cannot sign $nh_out/$nh_stub"
    fi
    printf 'done\n' > "$nh_out/.complete"
    release_lock
}

# Stages the Nupp executable and static application entry, or the embedding
# SDK, for one exact compiler-selected feature set.
build_host() {
    kind=$1
    features=${2:-}
    select_host_features "$features"
    selected_features=$host_features
    selected_lpeg_prefix=$host_lpeg_prefix
    # The embedding SDK carries no code generator: a program embedding the
    # compiler finds the code generator library the way a checkout does.
    case "$kind:,$selected_features," in
        library:*,native-codegen,*)
            note "the embedding library is built without the code generator"
            selected_features=$(printf '%s\n' "$selected_features" | tr ',' '\n' \
                | grep -v '^native-codegen$' | tr '\n' ',' | sed 's/,$//')
            ;;
    esac
    digest=$(printf '%s|%s|%s|%s' \
        "$kind" "$selected_features" "$(embedding_headers_digest)" "$(host_sources_digest)" \
        | sha256_stdin | cut -c1-16)
    out="$PREFIX/host/$digest"
    HOST_OUT="$out"
    stage_out=$out
    stage_digest=$digest
    luajit_prefix=$(build_luajit; printf '%s' "$PREFIX/luajit")

    if [ "$kind" = library ]; then
        build_nupp_embedding "$luajit_prefix" "$selected_features" "$selected_lpeg_prefix"
        embedding=$NUPP_EMBED_OUT
        dynamic_name=$(embedding_library_filename)
        digest=$(printf '%s|%s' "$stage_digest" "$(basename "$embedding")" | sha256_stdin | cut -c1-16)
        out="$PREFIX/host/$digest"
        HOST_OUT=$out

        take_lock "host-$digest" "$out/.complete" || return 0
        [ -f "$out/.complete" ] && [ -f "$out/libnupp.a" ] \
            && [ -f "$out/$dynamic_name" ] && { release_lock; return 0; }
        note "staging the embedding SDK"
        rm -rf "$out"
        mkdir -p "$out"
        cp "$embedding/libnupp.a" "$out/libnupp.a"
        cp "$embedding/$dynamic_name" "$out/$dynamic_name"
        if [ "$PLATFORM" = windows ]; then
            cp "$embedding/libnupp.dll.a" "$out/libnupp.dll.a"
        fi
        cp "$ROOT/host/include/nupp.h" "$out/nupp.h"
        {
            printf '{\n  "schemaVersion": 1,\n'
            printf '  "features": "%s",\n' "$selected_features"
            printf '  "header": "nupp.h",\n'
            printf '  "static": "libnupp.a",\n'
            printf '  "staticLinkFlags": ['
            separator=''
            while IFS= read -r flag; do
                [ -n "$flag" ] || continue
                printf '%s"%s"' "$separator" "$flag"
                separator=', '
            done <<EOF
$(host_system_flags "$selected_features")
$(static_host_export_flags)
EOF
            printf '],\n'
            if [ "$PLATFORM" = windows ]; then
                printf '  "dynamic": "%s",\n' "$dynamic_name"
                printf '  "import": "libnupp.dll.a"\n}\n'
            else
                printf '  "dynamic": "%s"\n}\n' "$dynamic_name"
            fi
        } > "$out/link.json"
        printf 'done\n' > "$out/.complete"
        release_lock
        HOST_OUT=$out
        return 0
    fi

    build_nupp_host "$selected_features" "$selected_lpeg_prefix" "$luajit_prefix"
    nupp_host=$NUPP_HOST_OUT
    digest=$(printf '%s|%s' "$stage_digest" "$(basename "$nupp_host")" | sha256_stdin | cut -c1-16)
    out="$PREFIX/host/$digest"
    HOST_OUT=$out

    take_lock "host-$digest" "$out/.complete" || return 0
    if [ -f "$out/.complete" ] && [ -f "$out/nupp-host" ] \
        && [ -f "$out/libnupp-host.a" ]; then
        if [ "$PLATFORM" != windows ] || [ -f "$out/libnupp-host-imports.a" ]; then
            release_lock
            return 0
        fi
    fi
    note "staging the application host"
    rm -rf "$out"
    mkdir -p "$out"
    if [ "$PLATFORM" = windows ]; then
        cp "$nupp_host/nupp-host.exe" "$out/nupp-host"
        cp "$nupp_host/libnupp-host-imports.a" "$out/libnupp-host-imports.a"
    else
        cp "$nupp_host/nupp-host" "$out/nupp-host"
    fi
    cp "$nupp_host/libnupp-host.a" "$out/libnupp-host.a"
    chmod +x "$out/nupp-host" 2>/dev/null || true
    printf 'done\n' > "$out/.complete"
    release_lock
    HOST_OUT="$out"
}

# --- Link kits ----------------------------------------------------------------

# What AOT objects may reference from the C library beyond what the runtime
# does: the libm functions the backend emits, and the memory functions LLVM
# lowers copies to. A kit's C-library stubs carry them whether or not the
# runtime itself uses them.
KIT_AOT_SYMBOLS="sin cos tan asin acos atan atan2 sinh cosh tanh exp log pow fmod expf fma fmaf
floor ceil trunc round sqrt memcpy memmove memset bzero memcmp bcmp memchr strtod"
# Windows has no `bzero` or `bcmp`, and LLVM emits neither for it.
KIT_AOT_SYMBOLS_WINDOWS="sin cos tan asin acos atan atan2 sinh cosh tanh exp log pow fmod expf fma
fmaf floor ceil trunc round sqrt memcpy memmove memset memcmp memchr strtod"

# Stages the link kit for one host feature set: the runtime archive, stubs for
# every system library it and AOT code bind to, and kit.json naming them, so
# `nupp` links a standalone program with lld and nothing else. The stubs name
# symbols and install names only, taken from a probe link against this
# machine's SDK; no SDK file is copied.
# The public Nupp platform a kit built on this machine links for.
kit_target() {
    case "$PLATFORM-$(uname -s)-$(uname -m 2>/dev/null)" in
        windows-*-x86_64) echo x86_64-pc-windows-msvc ;;
        darwin-*-arm64) echo aarch64-apple-darwin ;;
        darwin-*-x86_64) echo x86_64-apple-darwin ;;
        posix-Linux-x86_64) echo x86_64-unknown-linux-gnu ;;
        posix-Linux-aarch64|posix-Linux-arm64) echo aarch64-unknown-linux-gnu ;;
        *) die "no link kit target for $PLATFORM on $(uname -m)" ;;
    esac
}

# The oldest macOS a kit's programs run on: LuaJIT's deployment floor.
kit_minimum() {
    case "$(uname -m 2>/dev/null)" in
        x86_64) echo 10.14 ;;
        *) echo 11.0 ;;
    esac
}

# A gzip'd POSIX tar of a directory's files whose bytes are a function of
# their names and contents alone. A release records the kit archive's digest
# in every nupp it builds, and tar otherwise writes the building user's name,
# the build's clock and its umask into each header.
deterministic_archive() {
    archive_source=$1
    archive_output=$2
    archive_staging=$(mktemp -d "${TMPDIR:-/tmp}/nupp-archive.XXXXXX") || return 1
    cp -R "$archive_source/." "$archive_staging/" || { rm -rf "$archive_staging"; return 1; }
    rm -f "$archive_staging/.complete"
    chmod -R u+rwX,go+rX,go-w "$archive_staging"
    find "$archive_staging" -exec env TZ=UTC touch -h -t 198001010000 {} +
    case "$(tar --version 2>/dev/null)" in
        *GNU*) archive_owner="--owner=0 --group=0 --numeric-owner" ;;
        *) archive_owner="--uid 0 --gid 0 --numeric-owner" ;;
    esac
    # shellcheck disable=SC2086 # the owner options are separate words
    (cd "$archive_staging" && find . -type f | LC_ALL=C sort | sed 's|^\./||' \
        | COPYFILE_DISABLE=1 tar --format ustar $archive_owner -cf - -T - \
        | gzip -9n > "$archive_output")
    archive_status=$?
    rm -rf "$archive_staging"
    return $archive_status
}

# The system libraries wgpu-native's static library calls into on macOS: the
# native static libraries rustc reports for it, which are also what the
# release's shared library loads.
KIT_WGPU_LIBRARIES_DARWIN="-framework QuartzCore -framework Metal -framework Foundation
-framework CoreFoundation -lobjc -liconv"

build_kit() {
    features=${1:-}
    build_host stub "$features"
    host_out=$HOST_OUT
    kit_wgpu=""
    case "$PLATFORM" in
        # Before the kit's lock: a run holds one lock at a time.
        darwin) build_wgpu_static; kit_wgpu=$WGPU_STATIC ;;
    esac
    # Public feature sets can share a host but advertise different kit metadata.
    digest=$(printf 'kit-7|%s|%s|%s' "$(basename "$host_out")" "$features" "${kit_wgpu:+$WGPU_VERSION}" \
        | sha256_stdin | cut -c1-16)
    out="$PREFIX/kits/$digest"
    KIT_OUT=$out
    take_lock "kit-$digest" "$out/.complete" || return 0
    [ -f "$out/.complete" ] && { release_lock; return 0; }
    case "$PLATFORM-$(uname -s)" in
        darwin-*) ;;
        posix-Linux) build_kit_linux "$features" "$host_out" "$out"; release_lock; return 0 ;;
        windows-*)
            build_kit_windows "$features" "$host_out" "$out" "$selected_features"
            release_lock
            return 0
            ;;
        *) die "link kits are built on macOS, Linux and Windows" ;;
    esac
    note "staging the link kit"
    rm -rf "$out"
    mkdir -p "$out/sdk"
    cp "$host_out/libnupp-host.a" "$out/libnupp-runtime.a"
    cp "$PREFIX/luajit/lib/libluajit-5.1.a" "$out/libluajit-5.1.a"

    probe="$out/probe"
    {
        for name in $KIT_AOT_SYMBOLS; do printf 'extern char %s[];\n' "$name"; done
        printf 'void *nupp_kit_probe[] = {\n'
        for name in $KIT_AOT_SYMBOLS; do printf '    %s,\n' "$name"; done
        printf '};\n'
    } > "$probe-aot.c"
    "$CC" -c -w -fno-builtin -o "$probe-aot.o" "$probe-aot.c"
    set -- "$CC" -o "$probe" "-Wl,-force_load,$out/libnupp-runtime.a" "-Wl,-force_load,$probe-aot.o"
    host_system_flags "$features" > "$probe-flags"
    while IFS= read -r flag; do
        [ -z "$flag" ] || set -- "$@" "$flag"
    done < "$probe-flags"
    set -- "$@" -Wl,-export_dynamic
    "$@" >&2

    # A second probe links wgpu-native's static library in as well, keeping
    # every entry point it exports, so the stubs also carry what a standalone
    # GPU program binds. The libraries only it needs are recorded apart from
    # the kit's own, so a program without GPU never loads Metal.
    nm -m "$probe" | sed -n 's/^ *(undefined) [a-z ]*external \([^ ]*\) (from \([^)]*\)).*/\2 \1/p' \
        > "$out/binds"
    otool -L "$probe" | sed -n '2,$p' > "$out/libraries"
    : > "$out/gpu-libraries"
    if [ -n "$kit_wgpu" ]; then
        set -- "$CC" -o "$probe-gpu" "-Wl,-force_load,$out/libnupp-runtime.a" "-Wl,-force_load,$probe-aot.o"
        while IFS= read -r flag; do
            [ -z "$flag" ] || set -- "$@" "$flag"
        done < "$probe-flags"
        set -- "$@" "$kit_wgpu"
        for symbol in $(nm -gUj "$kit_wgpu" | grep '^_wgpu' | LC_ALL=C sort -u); do
            set -- "$@" "-Wl,-u,$symbol"
        done
        # shellcheck disable=SC2086 # one flag per word
        set -- "$@" $KIT_WGPU_LIBRARIES_DARWIN -Wl,-export_dynamic
        "$@" >&2
        nm -m "$probe-gpu" | sed -n 's/^ *(undefined) [a-z ]*external \([^ ]*\) (from \([^)]*\)).*/\2 \1/p' \
            >> "$out/binds"
        otool -L "$probe-gpu" | sed -n '2,$p' | while read -r path rest; do
            grep -qF "$path " "$out/libraries" || printf '\t%s %s\n' "$path" "$rest"
        done > "$out/gpu-libraries"
        cat "$out/gpu-libraries" >> "$out/libraries"
    fi
    LC_ALL=C sort -u -o "$out/binds" "$out/binds"

    # Which library each symbol binds to, and what each library is.
    : > "$out/flags"
    : > "$out/gpu-flags"
    while read -r path rest; do
        name=$(basename "$path")
        listed="$out/flags"
        ! grep -qF "$path " "$out/gpu-libraries" || listed="$out/gpu-flags"
        case "$path" in
            */Frameworks/*.framework/*)
                short=$name
                stub="$out/sdk/System/Library/Frameworks/$name.framework/$name.tbd"
                printf '%s\n' "-framework" "$name" >> "$listed"
                ;;
            *)
                short=$(printf '%s' "$name" | sed 's/\.dylib$//; s/\.[A-Z0-9]*$//')
                stub="$out/sdk/usr/lib/$short.tbd"
                printf '%s\n' "-l${short#lib}" >> "$listed"
                ;;
        esac
        compatibility=$(printf '%s' "$rest" | sed -n 's/.*compatibility version \([0-9.]*\).*/\1/p')
        current=$(printf '%s' "$rest" | sed -n 's/.*current version \([0-9.]*\).*/\1/p')
        mkdir -p "$(dirname "$stub")"
        {
            printf -- '--- !tapi-tbd\ntbd-version: 4\ntargets: [ arm64-macos, x86_64-macos ]\n'
            printf "install-name: '%s'\n" "$path"
            printf 'current-version: %s\ncompatibility-version: %s\n' "$current" "$compatibility"
            printf 'exports:\n  - targets: [ arm64-macos, x86_64-macos ]\n    symbols: [ '
            awk -v lib="$short" '$1 == lib { printf "%s\x27%s\x27", (n++ ? ", " : ""), $2 }' "$out/binds"
            # The lazy-binding helper a linker binds itself, never named.
            [ "$short" != libSystem ] || printf ", 'dyld_stub_binder'"
            printf ' ]\n...\n'
        } > "$stub"
    done < "$out/libraries"

    {
        printf '{\n  "schemaVersion": 1,\n  "platform": "macos",\n  "target": "%s",\n' "$(kit_target)"
        printf '  "minimum": "%s",\n' "$(kit_minimum)"
        printf '  "features": "%s",\n  "runtime": "libnupp-runtime.a",\n  "luajit": "libluajit-5.1.a",\n' "$features"
        printf '  "syslibroot": "sdk",\n'
        printf '  "libraries": ['
        awk '{ printf "%s\"%s\"", (NR > 1 ? ", " : ""), $0 }' "$out/flags"
        printf ']'
        if [ -n "$kit_wgpu" ]; then
            # What a standalone program linking a provider statically adds.
            printf ',\n  "providers": {"wgpu": ['
            awk '{ printf "%s\"%s\"", (NR > 1 ? ", " : ""), $0 }' "$out/gpu-flags"
            printf ']}'
        fi
        printf '\n}\n'
    } > "$out/kit.json"
    rm -f "$probe" "$probe-gpu" "$probe-aot.c" "$probe-aot.o" "$probe-flags" "$out/binds" "$out/libraries" \
        "$out/gpu-libraries" "$out/flags" "$out/gpu-flags"
    printf 'ok\n' > "$out/.complete"
    release_lock
}

# The Windows (MinGW) kit: the link the C compiler's driver would run for a
# program, recorded with every object and library it names copied into the
# kit -- the CRT startup objects, the MinGW and libgcc archives, and the
# system DLLs' import libraries, all MinGW-w64's own -- so lld's MinGW driver
# replays it with the program's objects in place of the probe's.
build_kit_windows() {
    features=$1
    host_out=$2
    out=$3
    host_features=$4
    note "staging the link kit"
    rm -rf "$out"
    mkdir -p "$out/lib"
    cp "$host_out/libnupp-host.a" "$out/libnupp-runtime.a"
    cp "$PREFIX/luajit/lib/libluajit-5.1.a" "$out/libluajit-5.1.a"
    cp "$host_out/libnupp-host-imports.a" "$out/lib/libnupp-host-imports.a"
    # A program linked from the kit's runtime exports what the stub host
    # exports, so LuaJIT's FFI finds the provider in its own process. The list
    # also pulls the provider's members out of the runtime archive, which none
    # of the program's own references reach.
    {
        printf 'EXPORTS\n'
        host_stub_exports "$host_features" "$PREFIX/luajit" | sed 's/^/    /'
    } > "$out/nupp-runtime.def"
    # A native program linked as a DLL starts from the CRT's DLL startup
    # object where the recorded link has the program's.
    dllcrt=$("$CC" -print-file-name=dllcrt2.o)
    [ -f "$dllcrt" ] || die "the C compiler has no dllcrt2.o"
    cp "$dllcrt" "$out/lib/dllcrt2.o"

    probe="$out/probe"
    {
        for name in $KIT_AOT_SYMBOLS_WINDOWS; do printf 'extern char %s[];\n' "$name"; done
        printf 'void *nupp_kit_probe[] = {\n'
        for name in $KIT_AOT_SYMBOLS_WINDOWS; do printf '    %s,\n' "$name"; done
        printf '};\n'
    } > "$probe-aot.c"
    "$CC" -c -w -fno-builtin -o "$probe-aot.o" "$probe-aot.c"
    set -- "$CC" -v -o "$probe.exe" "$probe-aot.o" "$out/libnupp-runtime.a"
    while IFS= read -r flag; do
        set -- "$@" "$flag"
    done <<EOF
$(host_system_flags "$features")
EOF
    set -- "$@" "$out/lib/libnupp-host-imports.a" -Wl,--export-all-symbols
    "$@" > "$out/probe.log" 2>&1 || { tail -n 40 "$out/probe.log" >&2; die "the kit's probe link failed"; }
    line=$(grep -E '(collect2|ld)(\.exe)?"? ' "$out/probe.log" | tail -n 1)
    [ -n "$line" ] || die "the C compiler's driver did not say how it links"

    # One argument per line: the linker itself dropped, search directories
    # used to find each -l, then dropped; the probe's own inputs replaced by
    # placeholders; each object or library copied in and named relative to
    # the kit. Argument order is the link's, which one-pass archives need.
    : > "$out/dirs"
    for word in $line; do
        case "$word" in -L*) printf '%s\n' "${word#-L}" >> "$out/dirs" ;; esac
    done
    : > "$out/argv"
    first=1
    for word in $line; do
        word=${word%\"}
        word=${word#\"}
        if [ "$first" = 1 ]; then first=0; continue; fi
        case "$word" in
            -plugin|-plugin-opt=*|--sysroot=*|-L*) continue ;;
            */liblto_plugin*) continue ;;
            # By name: the driver prints its arguments as Windows paths.
            probe.exe|*/probe.exe|*\\probe.exe) printf '{output}\n' >> "$out/argv" ;;
            */probe-aot.o|*\\probe-aot.o) printf '{archives}\n' >> "$out/argv" ;;
            */libnupp-runtime.a|*\\libnupp-runtime.a) printf '{runtime}\n' >> "$out/argv" ;;
            */libnupp-host-imports.a|*\\libnupp-host-imports.a)
                printf '{kit}/lib/libnupp-host-imports.a\n' >> "$out/argv"
                ;;
            -l*)
                name=${word#-l}
                found=""
                while IFS= read -r dir; do
                    for candidate in "$dir/lib$name.a" "$dir/lib$name.dll.a" "$dir/$name.lib"; do
                        if [ -z "$found" ] && [ -f "$candidate" ]; then found=$candidate; fi
                    done
                done < "$out/dirs"
                [ -n "$found" ] || die "the probe link names -l$name, which no search directory holds"
                base=$(basename "$found")
                [ -f "$out/lib/$base" ] || cp "$found" "$out/lib/$base"
                printf '{kit}/lib/%s\n' "$base" >> "$out/argv"
                ;;
            *.o|*.obj|*.a)
                base=$(basename "$word")
                [ -f "$out/lib/$base" ] || cp "$word" "$out/lib/$base"
                printf '{kit}/lib/%s\n' "$base" >> "$out/argv"
                ;;
            *) printf '%s\n' "$word" >> "$out/argv" ;;
        esac
    done
    grep -q '^{archives}$' "$out/argv" || die "the probe link did not name the probe object"

    {
        printf '{\n  "schemaVersion": 1,\n  "platform": "windows",\n  "target": "%s",\n' "$(kit_target)"
        printf '  "features": "%s",\n  "runtime": "libnupp-runtime.a",\n' "$features"
        printf '  "luajit": "libluajit-5.1.a",\n'
        printf '  "exports": "nupp-runtime.def",\n'
        printf '  "argv": ['
        awk '{ gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "%s\"%s\"", (NR > 1 ? ", " : ""), $0 }' "$out/argv"
        printf ']\n}\n'
    } > "$out/kit.json"
    rm -f "$probe.exe" "$probe-aot.c" "$probe-aot.o" "$out/probe.log" "$out/dirs" "$out/argv"
    printf 'ok\n' > "$out/.complete"
}

# The Linux (glibc) kit: the runtime, the C runtime's startup objects and
# libgcc, and a stub for every shared library the probe link needs -- same
# SONAME, each symbol at the version the probe bound it to, data objects at
# their real size -- so lld links against glibc's ABI without glibc's files.
build_kit_linux() {
    features=$1
    host_out=$2
    out=$3
    note "staging the link kit"
    rm -rf "$out"
    mkdir -p "$out/lib" "$out/stubs"
    cp "$host_out/libnupp-host.a" "$out/libnupp-runtime.a"
    cp "$PREFIX/luajit/lib/libluajit-5.1.a" "$out/libluajit-5.1.a"
    for object in Scrt1.o crti.o crtbeginS.o crtendS.o crtn.o; do
        found=$("$CC" -print-file-name="$object")
        [ -f "$found" ] || die "the C compiler has no $object"
        cp "$found" "$out/lib/$object"
    done
    cp "$("$CC" -print-libgcc-file-name)" "$out/lib/libgcc.a"

    probe="$out/probe"
    {
        for name in $KIT_AOT_SYMBOLS; do printf 'extern char %s[];\n' "$name"; done
        printf 'void *nupp_kit_probe[] = {\n'
        for name in $KIT_AOT_SYMBOLS; do printf '    %s,\n' "$name"; done
        printf '};\n'
    } > "$probe-aot.c"
    "$CC" -c -w -fno-builtin -fPIC -o "$probe-aot.o" "$probe-aot.c"
    set -- "$CC" -pie -o "$probe" -Wl,--whole-archive "$out/libnupp-runtime.a" "$probe-aot.o" -Wl,--no-whole-archive
    host_system_flags "$features" > "$probe-flags"
    while IFS= read -r flag; do
        [ -z "$flag" ] || set -- "$@" "$flag"
    done < "$probe-flags"
    set -- "$@" -Wl,-E
    "$@" >&2

    # NEEDED libraries and the dynamic linker. libm joins them whether or not
    # the probe bound anything there: a native program links the kit's LuaJIT,
    # which needs it.
    readelf -d "$probe" | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p' > "$out/needed"
    grep -qx 'libm\.so\.6' "$out/needed" || printf 'libm.so.6\n' >> "$out/needed"
    interpreter=$(readelf -l "$probe" | sed -n 's/.*Requesting program interpreter: \(.*\)]/\1/p')
    : > "$out/flags"
    while IFS= read -r soname; do
        real=$("$CC" -print-file-name="$soname")
        [ -f "$real" ] || real=$(ldconfig -p 2>/dev/null | awk -v n="$soname" '$1 == n { print $NF; exit }')
        [ -f "$real" ] || die "the probe link needs $soname, which the C compiler cannot find"
        stub="$out/stubs/$soname"
        # Every symbol the library exports at a public default version, data at
        # its real size: a native program may call whatever the platform's
        # library has, not only what the host's probe happened to bind.
        readelf --dyn-syms -W "$real" | awk '
            $7 != "UND" && $7 != "ABS" && ($5 == "GLOBAL" || $5 == "WEAK") && index($8, "@@") > 0 {
                split($8, parts, "@@")
                if (parts[2] !~ /PRIVATE/) print parts[2], $4, parts[1], $3
            }
        ' | LC_ALL=C sort -u > "$stub.exports"
        [ -s "$stub.exports" ] || die "$real exports no versioned symbols to stub"
        : > "$stub.map"
        for version in $(awk '{ print $1 }' "$stub.exports" | LC_ALL=C sort -u); do
            printf '%s {\n' "$version" >> "$stub.map"
            awk -v v="$version" '$1 == v { printf "  %s;\n", $3 }' "$stub.exports" >> "$stub.map"
            printf '};\n' >> "$stub.map"
        done
        # A function is defined under a name of its own and given the export's
        # through an asm label: some exports are compiler builtins with fixed
        # types, as aarch64's libgcc_s `__clear_cache` is to clang, which
        # -fno-builtin does not stop it from checking a definition against.
        awk '{
            size = ($4 == "0") ? 8 : $4
            if ($2 == "TLS") printf "__thread char %s[%s];\n", $3, size
            else if ($2 == "OBJECT") printf "char %s[%s];\n", $3, size
            else printf "void nupp_stub_%d(void) __asm__(\"%s\");\nvoid nupp_stub_%d(void) {}\n", NR, $3, NR
        }' "$stub.exports" > "$stub.c"
        "$CC" -shared -nostdlib -fPIC -w -fno-builtin -o "$out/lib/$soname" "$stub.c" \
            -Wl,--version-script="$stub.map" -Wl,-soname,"$soname"
        printf '%s\n' "$soname" >> "$out/flags"
    done < "$out/needed"

    {
        printf '{\n  "schemaVersion": 1,\n  "platform": "linux",\n  "target": "%s",\n' "$(kit_target)"
        printf '  "features": "%s",\n  "runtime": "libnupp-runtime.a",\n' "$features"
        printf '  "luajit": "libluajit-5.1.a",\n'
        printf '  "interpreter": "%s",\n' "$interpreter"
        printf '  "startup": ["lib/Scrt1.o", "lib/crti.o", "lib/crtbeginS.o"],\n'
        printf '  "finish": ["lib/libgcc.a", "lib/crtendS.o", "lib/crtn.o"],\n'
        printf '  "libraries": ['
        awk '{ printf "%s\"lib/%s\"", (NR > 1 ? ", " : ""), $0 }' "$out/flags"
        printf ']\n}\n'
    } > "$out/kit.json"
    rm -rf "$probe" "$probe-aot.c" "$probe-aot.o" "$probe-flags" "$out/needed" "$out/flags" "$out/stubs"
    printf 'ok\n' > "$out/.complete"
}

# --- LLVM ---------------------------------------------------------------------

# The configuration of the pinned LLVM. Every line decides what the libraries
# contain, so the list is part of the cache key: change a line and the next
# request builds beside the old tree rather than over it.
llvm_cmake_options() {
    cat <<'OPTIONS'
-DCMAKE_BUILD_TYPE=MinSizeRel
-DLLVM_TARGETS_TO_BUILD=AArch64;X86;WebAssembly
-DLLVM_ENABLE_PROJECTS=lld
-DLLD_BUILD_TOOLS=OFF
-DLLVM_BUILD_TOOLS=OFF
-DLLVM_INCLUDE_TESTS=OFF
-DLLVM_INCLUDE_EXAMPLES=OFF
-DLLVM_INCLUDE_BENCHMARKS=OFF
-DLLVM_INCLUDE_DOCS=OFF
-DLLVM_INCLUDE_UTILS=OFF
-DLLVM_ENABLE_BINDINGS=OFF
-DLLVM_ENABLE_ASSERTIONS=OFF
-DLLVM_ENABLE_ZLIB=OFF
-DLLVM_ENABLE_ZSTD=OFF
-DLLVM_ENABLE_LIBXML2=OFF
-DLLVM_ENABLE_LIBEDIT=OFF
-DLLVM_ENABLE_TERMINFO=OFF
-DLLVM_ENABLE_Z3_SOLVER=OFF
OPTIONS
    # The deployment floor LuaJIT is built for; the libraries link into the
    # same binary and must not ask for a newer macOS than it does.
    if [ "$PLATFORM" = darwin ]; then
        case "$(uname -m 2>/dev/null)" in
            x86_64) printf '%s\n' -DCMAKE_OSX_DEPLOYMENT_TARGET=10.14 ;;
            *)      printf '%s\n' -DCMAKE_OSX_DEPLOYMENT_TARGET=11.0 ;;
        esac
    fi
    # MinGW's runtime DLLs are whichever PATH finds first, and on a runner
    # that is often another toolchain's: tablegen then dies at load
    # (0xC0000139). Tools linked statically carry their own.
    if [ "$PLATFORM" = windows ]; then
        printf '%s\n' -DCMAKE_EXE_LINKER_FLAGS=-static
    fi
}

llvm_key() {
    {
        printf '%s\n%s\n' "$LLVM_VERSION" "$LLVM_SHA256"
        llvm_cmake_options
        printf '%s\n%s\n' "$CC" "$CXX"
        "$CC" --version 2>&1 | head -n 2 || true
        "$CXX" --version 2>&1 | head -n 2 || true
        printf '%s %s\n' "$UNAME" "$(uname -m 2>/dev/null || echo unknown)"
    } | sha256_stdin | cut -c1-16
}

# A usable tree answers llvm-config and carries lld's libraries.
llvm_complete() {
    tree=$1
    [ -f "$tree/.complete" ] || [ -n "${NUPP_LLVM_PREFIX:-}" ] || return 1
    [ -x "$tree/bin/llvm-config" ] || [ -x "$tree/bin/llvm-config.exe" ] || return 1
    for library in lldCommon lldMachO lldELF lldCOFF lldMinGW lldWasm; do
        [ -f "$tree/lib/lib$library.a" ] || return 1
    done
    return 0
}

# The version a tree was configured as, read from the header its configure step
# generated rather than from `llvm-config`, which a cross-built tree cannot run.
llvm_tree_version() {
    sed -n 's/^#define LLVM_VERSION_STRING "\(.*\)"$/\1/p' \
        "$1/include/llvm/Config/llvm-config.h" 2>/dev/null
}

# The pins spell their templates the way the other components' do.
LLVM_DIRECTORY=$(expand_pin "$LLVM_DIRECTORY")
LLVM_URL=$(expand_pin "$LLVM_URL")

# The source, extracted once per machine beside the other pinned sources.
llvm_source() {
    tree="$SOURCES/$LLVM_DIRECTORY"
    if [ -f "$tree/llvm/CMakeLists.txt" ] && [ -f "$tree/lld/CMakeLists.txt" ]; then
        printf '%s\n' "$tree"
        return 0
    fi
    file=$(archive "$LLVM_DIRECTORY" "$LLVM_URL" "$LLVM_SHA256" .tar.xz)
    mkdir -p "$SOURCES"
    staging="$SOURCES/.$LLVM_DIRECTORY.$$"
    rm -rf "$staging"
    mkdir -p "$staging"
    # mlgo-utils holds symlinks MSYS2 cannot create, and nothing builds from it.
    tar -xJf "$file" -C "$staging" --exclude='*/mlgo-utils' \
        "$LLVM_DIRECTORY/llvm" "$LLVM_DIRECTORY/cmake" "$LLVM_DIRECTORY/third-party" \
        "$LLVM_DIRECTORY/libc" "$LLVM_DIRECTORY/lld" "$LLVM_DIRECTORY/libunwind/include" \
        || die "$LLVM_DIRECTORY.tar.xz did not extract"
    [ -f "$staging/$LLVM_DIRECTORY/llvm/CMakeLists.txt" ] \
        || die "$LLVM_DIRECTORY.tar.xz did not extract llvm/CMakeLists.txt"
    rm -rf "$tree"
    mv "$staging/$LLVM_DIRECTORY" "$tree"
    rm -rf "$staging"
    printf '%s\n' "$tree"
}

# The pinned LLVM, as a build tree: `bin/llvm-config`, `lib/*.a`, generated
# headers under `include`, and the source's headers found through llvm-config.
# NUPP_LLVM_PREFIX names an existing tree to use as is (it is checked, not
# built). Sets LLVM_OUT.
build_llvm() {
    if [ -n "${NUPP_LLVM_PREFIX:-}" ]; then
        llvm_complete "$NUPP_LLVM_PREFIX" \
            || die "NUPP_LLVM_PREFIX names $NUPP_LLVM_PREFIX, which has no llvm-config or lld libraries"
        # Named outright is still not a licence to be another LLVM. A tree left
        # from before a pin bump used to be linked as though it were the pinned
        # one, and the artifact key recorded the pin rather than what was linked.
        llvm_found=$(llvm_tree_version "$NUPP_LLVM_PREFIX")
        [ "$llvm_found" = "$LLVM_VERSION" ] \
            || die "NUPP_LLVM_PREFIX names $NUPP_LLVM_PREFIX, which is LLVM ${llvm_found:-of no recorded version}, not the pinned $LLVM_VERSION"
        LLVM_OUT=$NUPP_LLVM_PREFIX
        return 0
    fi
    out="$CACHE/llvm/$(llvm_key)"
    LLVM_OUT=$out
    LLVM_SOURCE="$SOURCES/$LLVM_DIRECTORY"
    llvm_complete "$out" && return 0
    [ "${1:-}" = available ] && return 1
    for tool in cmake ninja; do
        command -v "$tool" >/dev/null 2>&1 \
            || die "building LLVM needs $tool on PATH (and Python 3)"
    done
    take_lock "llvm-$(llvm_key)" "$out/.complete" || return 0
    llvm_complete "$out" && { release_lock; return 0; }
    source=$(llvm_source)
    LLVM_SOURCE=$source
    # Every release archive carries these two notices for what `nupp` links,
    # and they were copied by hand. Held to the source they describe, as
    # LuaJIT's and LPeg's are, before an hour goes into building it.
    verify_notice "$source/llvm/LICENSE.TXT" LLVM-LICENSE.txt
    verify_notice "$source/lld/LICENSE.TXT" LLD-LICENSE.txt
    jobs=${NUPP_LLVM_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || echo 4)}
    require_cxx "building LLVM"
    note "building LLVM $LLVM_VERSION with $CC/$CXX, $jobs jobs (this takes a while)"
    rm -rf "$out"
    mkdir -p "$out"
    set -- cmake -G Ninja -S "$(native_path "$source/llvm")" -B "$(native_path "$out")" \
        -DCMAKE_C_COMPILER="$CC" -DCMAKE_CXX_COMPILER="$CXX"
    while IFS= read -r option; do
        set -- "$@" "$option"
    done <<EOF
$(llvm_cmake_options)
EOF
    started=$(date +%s)
    "$@" > "$out/configure.log" 2>&1 \
        || { tail -n 40 "$out/configure.log" >&2; die "configuring LLVM failed; see $out/configure.log"; }
    # llvm-config is a tool, outside `all` when LLVM_BUILD_TOOLS is off.
    ninja -C "$(native_path "$out")" -j "$jobs" all llvm-config > "$out/build.log" 2>&1 \
        || { tail -n 40 "$out/build.log" >&2; die "building LLVM failed; see $out/build.log"; }
    printf 'LLVM %s built in %ss with %s jobs\n' "$LLVM_VERSION" "$(( $(date +%s) - started ))" "$jobs" \
        > "$out/.complete"
    note "$(cat "$out/.complete")"
    release_lock
}

# --- wgpu-native ------------------------------------------------------------

# The pinned prebuilt WebGPU library for this machine, or for the platform a
# cross-platform build names by its target key. It is fetched rather than built,
# so it is keyed by its own digest instead of the compiler pair, and every
# worktree that pins the same release shares one copy. WGPU_LIBRARY is the
# shared library a GPU program loads; nothing links against it. The Windows
# x86_64 build is the GNU one, which needs nothing beyond the system's own DLLs.
WGPU_LIBRARY=""
build_wgpu() {
    wgpu_platform=${1:-}
    if [ -z "$wgpu_platform" ]; then
        machine=$(uname -m 2>/dev/null || echo unknown)
        case "$PLATFORM:$machine" in
            posix:x86_64|posix:amd64)    wgpu_platform=x86_64-unknown-linux-gnu ;;
            posix:aarch64|posix:arm64)   wgpu_platform=aarch64-unknown-linux-gnu ;;
            darwin:arm64|darwin:aarch64) wgpu_platform=aarch64-apple-darwin ;;
            darwin:x86_64)               wgpu_platform=x86_64-apple-darwin ;;
            windows:x86_64|windows:amd64) wgpu_platform=x86_64-pc-windows-msvc ;;
            windows:aarch64|windows:arm64) wgpu_platform=aarch64-pc-windows-msvc ;;
            *) die "wgpu-native $WGPU_VERSION publishes no library for $UNAME $machine" ;;
        esac
    fi
    case "$wgpu_platform" in
        x86_64-unknown-linux-gnu)
            WGPU_TARGET=linux-x86_64; wgpu_digest=$WGPU_SHA256_LINUX_X86_64; wgpu_file=libwgpu_native.so
            wgpu_static_file=libwgpu_native.a ;;
        aarch64-unknown-linux-gnu)
            WGPU_TARGET=linux-aarch64; wgpu_digest=$WGPU_SHA256_LINUX_AARCH64; wgpu_file=libwgpu_native.so
            wgpu_static_file=libwgpu_native.a ;;
        aarch64-apple-darwin)
            WGPU_TARGET=macos-aarch64; wgpu_digest=$WGPU_SHA256_MACOS_AARCH64; wgpu_file=libwgpu_native.dylib
            wgpu_static_file=libwgpu_native.a ;;
        x86_64-apple-darwin)
            WGPU_TARGET=macos-x86_64; wgpu_digest=$WGPU_SHA256_MACOS_X86_64; wgpu_file=libwgpu_native.dylib
            wgpu_static_file=libwgpu_native.a ;;
        x86_64-pc-windows-msvc|x86_64-pc-windows-gnu)
            WGPU_TARGET=windows-x86_64-gnu; wgpu_digest=$WGPU_SHA256_WINDOWS_X86_64_GNU; wgpu_file=wgpu_native.dll
            wgpu_static_file=libwgpu_native.a ;;
        aarch64-pc-windows-msvc)
            WGPU_TARGET=windows-aarch64-msvc; wgpu_digest=$WGPU_SHA256_WINDOWS_AARCH64_MSVC; wgpu_file=wgpu_native.dll
            wgpu_static_file=wgpu_native.lib ;;
        *) die "wgpu-native $WGPU_VERSION publishes no library for $wgpu_platform" ;;
    esac
    out="$CACHE/wgpu/$wgpu_digest"
    WGPU_LIBRARY="$out/$wgpu_file"
    wgpu_name="wgpu-$WGPU_TARGET-$WGPU_VERSION"
    [ -f "$out/.complete" ] && [ -f "$WGPU_LIBRARY" ] && return 0
    take_lock "wgpu-$wgpu_digest" "$out/.complete" || return 0
    if [ -f "$out/.complete" ] && [ -f "$WGPU_LIBRARY" ]; then
        release_lock
        return 0
    fi
    command -v unzip >/dev/null 2>&1 || die "unpacking wgpu-native needs unzip"
    name=$wgpu_name
    file=$(archive "$name" "$(expand_pin "$WGPU_URL")" "$wgpu_digest" .zip)
    staging="$out.$$"
    rm -rf "$staging"
    mkdir -p "$staging"
    unzip -q -o "$file" "lib/$wgpu_file" -d "$staging" \
        || die "$name.zip did not contain lib/$wgpu_file"
    rm -rf "$out"
    mkdir -p "$out"
    mv "$staging/lib/$wgpu_file" "$WGPU_LIBRARY"
    rm -rf "$staging"
    printf 'wgpu-native %s %s\n' "$WGPU_VERSION" "$WGPU_TARGET" > "$out/.complete"
    release_lock
}

# The same release's static library, which a standalone program links in
# rather than loading the shared one. It carries its own copy of Rust's
# standard library, whose symbols are hashed apart from the runtime's except
# for one: the unwinder's personality routine, which both define unmangled. The
# staged copy has that name replaced everywhere it appears, byte for byte at
# the same length, so wgpu-native unwinds through its own routine and the link
# sees one definition of each.
WGPU_STATIC=""
build_wgpu_static() {
    build_wgpu "${1:-}"
    wgpu_out=$out
    WGPU_STATIC="$wgpu_out/$wgpu_static_file"
    [ -f "$wgpu_out/.static-complete" ] && [ -f "$WGPU_STATIC" ] && return 0
    # Before the lock: a run holds one lock at a time.
    build_luajit
    take_lock "wgpu-static-$wgpu_digest" "$wgpu_out/.static-complete" || return 0
    if [ -f "$wgpu_out/.static-complete" ] && [ -f "$WGPU_STATIC" ]; then
        release_lock
        return 0
    fi
    file=$(archive "$wgpu_name" "$(expand_pin "$WGPU_URL")" "$wgpu_digest" .zip)
    staging="$wgpu_out.static.$$"
    rm -rf "$staging"
    mkdir -p "$staging"
    unzip -q -o "$file" "lib/$wgpu_static_file" -d "$staging" \
        || die "$wgpu_name.zip did not contain lib/$wgpu_static_file"
    WGPU_STATIC_IN=$(native_path "$staging/lib/$wgpu_static_file") \
        WGPU_STATIC_OUT=$(native_path "$staging/$wgpu_static_file") \
        "$PREFIX/luajit/bin/luajit" -e '
            local input = assert(io.open(os.getenv("WGPU_STATIC_IN"), "rb"))
            local bytes = input:read("*a")
            input:close()
            local output = assert(io.open(os.getenv("WGPU_STATIC_OUT"), "wb"))
            assert(output:write((bytes:gsub("rust_eh_personality", "nupp_wgpu_eh_person"))))
            assert(output:close())
        ' || die "cannot stage the static library from $wgpu_name.zip"
    mv "$staging/$wgpu_static_file" "$WGPU_STATIC"
    rm -rf "$staging"
    printf 'wgpu-native %s %s static\n' "$WGPU_VERSION" "$WGPU_TARGET" > "$wgpu_out/.static-complete"
    release_lock
}

# --- entry ------------------------------------------------------------------

[ "$#" -ge 1 ] || usage

case "$1" in
    --prefix) native_path "$PREFIX"; exit 0 ;;
    --all)
        build_luajit
        build_luarocks
        build_lpeg
        # A checkout with no compiler needs this before it can run one, and a
        # warm is the moment to pay for it: an ordinary command in a built tree
        # never asks.
        stage0 >/dev/null
        exit 0
        ;;
    wgpu)
        # A provider driver is handed its features, which mean nothing to a
        # prebuilt library; a cross-platform build hands it the target key.
        case "${2:-}" in
            *-*) build_wgpu "$2" ;;
            *)   build_wgpu ;;
        esac
        native_path "$WGPU_LIBRARY"
        exit 0
        ;;
    wgpu-static)
        case "${2:-}" in
            *-*) build_wgpu_static "$2" ;;
            *)   build_wgpu_static ;;
        esac
        native_path "$WGPU_STATIC"
        exit 0
        ;;
    native-provider)
        if ! prebuilt_provider_wanted; then
            if build_native_provider "${2:-}"; then
                native_path "$NATIVE_PROVIDER_OUT"
                exit 0
            fi
            [ "${NUPP_PREBUILT_PROVIDER:-}" != 0 ] && prebuilt_provider_pinned \
                || die "cannot compile the native provider"
            note "cannot compile the native provider; falling back on the prebuilt one"
        fi
        prebuilt_provider_pinned \
            || die "no prebuilt native provider is pinned for $PREBUILT_TARGET, and there is no compiler yet to build one with"
        prebuilt_provider "${2:-}"
        native_path "$PREBUILT_OUT"
        exit 0
        ;;
    host)
        build_host stub "${2:-}"
        native_path "$HOST_OUT/nupp-host"
        exit 0
        ;;
    host-library)
        build_host library "${2:-}"
        native_path "$HOST_OUT"
        exit 0
        ;;
    kit)
        build_kit "${2:-}"
        native_path "$KIT_OUT"
        exit 0
        ;;
    kit-archive)
        # The kit as a release carries it: a gzip'd POSIX tar of the kit's
        # files, which nupp unpacks itself after checking the catalog's digest.
        [ "$#" -eq 3 ] || die "usage: scripts/toolchain kit-archive FEATURES OUTPUT"
        build_kit "$2"
        output=$(cd "$(dirname "$3")" && pwd)/$(basename "$3")
        deterministic_archive "$KIT_OUT" "$output" || die "cannot archive the link kit"
        native_path "$output"
        exit 0
        ;;
    codegen-library)
        build_llvm
        build_codegen_library
        native_path "$CODEGEN_LIBRARY_OUT"
        exit 0
        ;;
    prebuilt-codegen|prebuilt-kit)
        # A provider driver hands over a feature list, which a prebuilt asset
        # has no use for; a platform is named by its target key.
        case "${2:-}" in
            *-*) build_prebuilt "${1#prebuilt-}" "$2" ;;
            *)   build_prebuilt "${1#prebuilt-}" ;;
        esac
        [ "$1" = prebuilt-kit ] || prebuilt_codegen_library
        native_path "$PREBUILT_OUT"
        exit 0
        ;;
    codegen-archive)
        # This machine's prebuilt code generator as a release publishes it.
        [ "$#" -eq 2 ] || die "usage: scripts/toolchain codegen-archive OUTPUT"
        output=$(cd "$(dirname "$2")" && pwd)/$(basename "$2")
        codegen_archive "$output"
        native_path "$output"
        exit 0
        ;;
    archive)
        # Any directory as a release carries it: the same archive as a kit's,
        # so a rebuild of a tag reproduces the digest its release published.
        [ "$#" -eq 3 ] && [ -d "$2" ] || die "usage: scripts/toolchain archive DIRECTORY OUTPUT"
        output=$(cd "$(dirname "$3")" && pwd)/$(basename "$3")
        deterministic_archive "$2" "$output" || die "cannot archive $2"
        native_path "$output"
        exit 0
        ;;
    browser-sources|browser-emulator|browser-guest)
        browser_component=$1
        shift
        exec "${NUPP_PYTHON:-python3}" "$ROOT/scripts/browser-toolchain.py" "$browser_component" "$CACHE" "$@"
        ;;
    llvm)
        if [ "${2:-}" = --available ]; then
            build_llvm available || exit 1
        else
            build_llvm
        fi
        native_path "$LLVM_OUT"
        exit 0
        ;;
    -h|--help) usage ;;
esac

for component in "$@"; do
    case "$component" in
        luajit)   build_luajit;   native_path "$PREFIX/luajit" ;;
        luarocks) build_luarocks; native_path "$PREFIX/luarocks" ;;
        lpeg)     build_lpeg;     native_path "$PREFIX/lpeg" ;;
        # Assigned first: a substitution inside an argument loses its status,
        # and a refused archive printed an empty prefix and succeeded.
        lpeg-source) lpeg_tree=$(lpeg_source); native_path "$lpeg_tree" ;;
        llvm)     build_llvm;     native_path "$LLVM_OUT" ;;
        stage0)   stage0 ;;
        *) note "unknown component $component"; usage ;;
    esac
done
