#!/bin/sh
# Regenerates src/nupp/compiler/aot/llvm/lua/runtime-i686.ll: the AOT runtime
# (native/aotruntime) as LLVM IR for the browser guest.
#
#   scripts/guest-runtime
#
# The guest runs LuaJIT on i386 musl inside v86, with no native provider to
# hand a compiled module the runtime's table, so a module built for it links
# the runtime in, beside the VM that exports the Lua API: its `ksrt.api` calls
# the API directly (native/aotruntime/direct) rather than binding it. The
# string accumulator is LuaJIT's `luaL_Buffer`, whose size is the C library's
# BUFSIZ, and musl's is 1024. The IR is committed; nothing about this runs when
# Nupp is built or used.
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUTPUT="$ROOT/src/nupp/compiler/aot/llvm/lua/runtime-i686.ll"
native_path() {
    if command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s\n' "$1"; fi
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/ksrt"
printf 'return { include = { ".", "%s", "%s" } }\n' \
    "$(native_path "$ROOT/native/aotruntime/common")" "$(native_path "$ROOT/native/aotruntime/direct")" \
    > "$WORK/nupp.lua"
printf 'module main\n\nlocal _ = require("ksrt.runtime")\n' > "$WORK/main.nupp"
{
    printf -- '--- What the browser guest decides for the AOT runtime: generated by scripts/guest-runtime.\n'
    printf 'module ksrt.build\n\n'
    printf 'export type Size = uint32\n'
    # LUAL_BUFFERSIZE, behind a char *, an int and a lua_State *.
    printf 'export const STRING_BUFFER_BYTES = 1036\n\n'
    printf -- '--- A byte count as a size_t.\n'
    printf '@visibility("hidden")\n'
    printf 'export function ksSize(n: integer): Size\n'
    printf '    return math.u32.wrap(n)\n'
    printf 'end\n'
} > "$WORK/ksrt/build.nupp"
"$ROOT/bin/nupp" aot --emit llvm-library --triple i686-unknown-linux-gnu \
    --output "$(native_path "$WORK/runtime.ll")" "$(native_path "$WORK/main.nupp")"

# The digest of every source the IR was compiled from, which a test holds the
# committed file to.
inputs=$(cd "$ROOT" && find native/aotruntime/common native/aotruntime/direct -type f -name '*.nupp' \
    | LC_ALL=C sort)
digest=$(cd "$ROOT" && for file in $inputs; do tr -d '\r' < "$file"; done | shasum -a 256 | cut -d ' ' -f 1)
{
    echo "; The AOT runtime (native/aotruntime) for the i686 browser guest, generated"
    echo "; by scripts/guest-runtime. Do not edit: rerun the script."
    echo "; Inputs: native/aotruntime common and direct, sha256 $digest."
    cat "$WORK/runtime.ll"
} > "$OUTPUT"
echo "wrote $OUTPUT"
