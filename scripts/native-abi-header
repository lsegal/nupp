#!/bin/sh
# Writes the C header for the native provider ABI, generated by `nupp export-c`
# from its definition, native/abi/nuppnative.nupp: every constant and C
# function the definition declares, in the order it declares them.
#
#   scripts/native-abi-header OUTPUT
#
# Nothing commits the header: a C consumer generates it, and rustabitest
# compiles it and calls the provider through it.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
[ $# -eq 1 ] || { echo "usage: scripts/native-abi-header OUTPUT" >&2; exit 2; }
OUTPUT=$1
DEFINITION="$ROOT/native/abi/nuppnative.nupp"
native_path() {
    if command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s\n' "$1"; fi
}

set --
for name in $(sed -n -e 's/^export const \([A-Z0-9_]*\) = .*/\1/p' \
    -e 's/^cdef function \([A-Za-z0-9_]*\)(.*/\1/p' "$DEFINITION"); do
    set -- "$@" "native.abi.nuppnative.$name"
done
"$ROOT/bin/nupp" export-c --output "$(native_path "$OUTPUT")" "$(native_path "$DEFINITION")" "$@" >/dev/null
# export-c names the include guard after the path it was given; a consumer
# includes the header by its file name, so the guard is named after that.
generated=$(sed -n '1s/^#ifndef //p' "$OUTPUT")
guard=$(basename "$OUTPUT" | tr 'a-z.-' 'A-Z__')
sed "s/$generated/$guard/g" "$OUTPUT" > "$OUTPUT.tmp" && mv -f "$OUTPUT.tmp" "$OUTPUT"
