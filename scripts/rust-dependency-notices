#!/bin/sh
# Refreshes or verifies a committed notice for all locked Cargo packages.
#
# `nupp` (the default) covers this workspace's Cargo.lock. `wgpu-native` covers
# the lock file of the wgpu-native release pinned as WGPU_VERSION, whose
# prebuilt library statically carries that graph beside GPU programs.

set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
CARGO_ABOUT=${CARGO_ABOUT:-cargo-about}
CARGO=${CARGO:-cargo}
EXPECTED_CARGO_ABOUT='cargo-about 0.9.2'

usage() {
    printf '%s\n' 'usage: scripts/rust-dependency-notices --write|--check [nupp|wgpu-native]' >&2
    exit 2
}

case "${1:-}" in
    --write) mode=write ;;
    --check) mode=check ;;
    *) usage ;;
esac

target=${2:-nupp}
case "$target" in
    nupp)
        notice=Rust-dependencies.html
        command='scripts/rust-dependency-notices --write'
        ;;
    wgpu-native)
        notice=wgpu-native-Rust-dependencies.html
        command='scripts/rust-dependency-notices --write wgpu-native'
        ;;
    *) usage ;;
esac
OUTPUT=$ROOT/host/notices/$notice

actual_cargo_about=$("$CARGO_ABOUT" --version 2>/dev/null || true)
[ "$actual_cargo_about" = "$EXPECTED_CARGO_ABOUT" ] || {
    printf 'rust-dependency-notices: expected %s, found %s\n' \
        "$EXPECTED_CARGO_ABOUT" "${actual_cargo_about:-no cargo-about}" >&2
    exit 1
}

temporary=$(mktemp -d "${TMPDIR:-/tmp}/nupp-rust-notices.XXXXXX")
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
report=$temporary/report.html
inventory=$temporary/inventory.html
generated=$temporary/generated.html

if [ "$target" = nupp ]; then
    manifest=$ROOT/Cargo.toml
    config=$ROOT/about.toml
    template=$ROOT/scripts/rust-dependency-notices.hbs
else
    # The release is a prebuilt library, so its lock file is only in the source
    # archive of the same tag. The notice names that tag, and the test suite
    # holds it to the pin, so a bump without a refresh fails there.
    version=$(sed -n 's/^WGPU_VERSION=//p' "$ROOT/scripts/toolchain.pins")
    [ -n "$version" ] || {
        printf '%s\n' 'rust-dependency-notices: scripts/toolchain.pins has no WGPU_VERSION' >&2
        exit 1
    }
    curl -fsSL "https://github.com/gfx-rs/wgpu-native/archive/refs/tags/$version.tar.gz" \
        -o "$temporary/wgpu-native.tar.gz"
    mkdir "$temporary/wgpu-native"
    tar -xzf "$temporary/wgpu-native.tar.gz" -C "$temporary/wgpu-native" --strip-components=1
    manifest=$temporary/wgpu-native/Cargo.toml
    config=$ROOT/scripts/rust-dependency-notices-wgpu-native.toml
    "$CARGO" fetch --manifest-path "$manifest" --locked >/dev/null
    template=$temporary/template.hbs
    sed "s/@@WGPU_VERSION@@/$version/g" \
        "$ROOT/scripts/rust-dependency-notices-wgpu-native.hbs" > "$template"
fi

"$CARGO_ABOUT" generate \
    --manifest-path "$manifest" \
    --config "$config" \
    --workspace \
    --all-features \
    --frozen \
    --fail \
    --output-file "$report" \
    "$template"

RUSTC=${RUSTC:-rustc} "$CARGO" vendor \
    --manifest-path "$manifest" \
    --locked \
    --offline \
    "$temporary/vendor" >/dev/null

escape_html() {
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}

find "$temporary/vendor" -mindepth 1 -maxdepth 1 -type d -print \
    | LC_ALL=C sort \
    | while IFS= read -r package; do
        manifest=$package/Cargo.toml
        name=$(sed -n 's/^name = "\([^"]*\)"$/\1/p' "$manifest" | sed -n '1p')
        version=$(sed -n 's/^version = "\([^"]*\)"$/\1/p' "$manifest" | sed -n '1p')
        license=$(sed -n 's/^license = "\([^"]*\)"$/\1/p' "$manifest" | sed -n '1p')
        repository=$(sed -n 's/^repository = "\([^"]*\)"$/\1/p' "$manifest" | sed -n '1p')
        [ -n "$license" ] || license=$(sed -n 's/^license-file = "\([^"]*\)"$/license file: \1/p' "$manifest" | sed -n '1p')
        [ -n "$license" ] || license='see license texts below'
        [ -n "$repository" ] || repository="https://crates.io/crates/$name"
        escaped_name=$(printf '%s' "$name" | escape_html)
        escaped_version=$(printf '%s' "$version" | escape_html)
        escaped_license=$(printf '%s' "$license" | escape_html)
        escaped_repository=$(printf '%s' "$repository" | escape_html)
        printf '    <li data-crate="%s@%s"><a href="%s">%s %s</a> — %s</li>\n' \
            "$escaped_name" "$escaped_version" "$escaped_repository" \
            "$escaped_name" "$escaped_version" "$escaped_license"
    done > "$inventory"

awk -v inventory="$inventory" '
    /^@@NUPP_LOCKED_PACKAGES@@$/ {
        while ((getline line < inventory) > 0) print line
        close(inventory)
        next
    }
    { sub(/\r$/, ""); sub(/[[:blank:]]+$/, ""); print }
' "$report" > "$generated"

if [ "$mode" = write ]; then
    cp "$generated" "$OUTPUT"
elif ! cmp -s "$generated" "$OUTPUT"; then
    printf '%s\n' \
        "host/notices/$notice is stale; run $command" >&2
    exit 1
fi
