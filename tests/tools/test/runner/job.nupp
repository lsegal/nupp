module job

-- Runs suites from the run's queue on one thread of the pool, in a Lua state of
-- its own. Environment lookups are state-local Lua calls even though the
-- underlying process environment is shared, so each thread can retain its own
-- compiler cache without mutating process-wide state.
export function run(
    argument: string,
    cacheDir: string,
    progressFd: integer?,
    verbose: boolean,
    colorMode: string,
    suiteCatalog: string,
    gcPause: integer?,
    runningDir: string?,
    executable: string?
): any
    -- The host publishes its executable only to the state it starts the payload
    -- in. Suites that build projects find the compiler's own build from it (#389).
    if rawget(_G, "__NUPP_EXECUTABLE") == nil then
        rawset(_G, "__NUPP_EXECUTABLE", executable)
    end
    rawset(_G, "__NUPP_TEST_EMBEDDED", true)
    rawset(_G, "__NUPP_TEST_PROGRESS_FD", progressFd)
    rawset(_G, "__NUPP_TEST_LANE_CACHE", cacheDir)
    rawset(_G, "__NUPP_TEST_SUITE_CATALOG", suiteCatalog)
    rawset(_G, "__NUPP_TEST_GC_PAUSE", gcPause)
    rawset(_G, "__NUPP_TEST_RUNNING", runningDir)

    -- A case that starts a program does so from this thread. `io.popen` is the
    -- runtime's own spawn -- posix_spawn, or CreateProcessW with an explicit
    -- handle list -- which is safe to call from several threads at once, so
    -- spawning is something a suite does here rather than a reason to run it
    -- somewhere else.

    local getenv = os.getenv
    os.getenv = function(name)
        if name == "NUPP_CACHE_DIR" then
            -- The run's one store when the run named it, which is what every
            -- command a case starts inherits; this lane's only otherwise.
            local named = getenv(name)
            return named ~= nil and named ~= "" and named or cacheDir
        elseif name == "NUPP_COMPTIME_WORKER_CHILD" then
            -- This Lua state is already isolated on a Nupp worker lane. A
            -- second long-lived compiler subprocess adds no isolation and can
            -- outlive the task that opened it; evaluate directly in this state.
            return "1"
        end

        return getenv(name)
    end

    -- Refill the original raw argv table so aliases keep observing each job.
    local arg = io.cli.args
    for index in pairs<integer, string>(arg) do
        rawset(arg, index, nil)
    end
    arg[0] = "tests/run.lua"
    arg[1] = "--json"
    arg[2] = argument
    arg[3] = "--color=" .. colorMode
    if verbose then
        arg[#arg + 1] = "--verbose"
    end

    const execute = assert(loadfile(arg[0]))

    return execute()
end
