--[[
Staging compiler-provided native features.

This consumes effects recorded by the checker.  It deliberately does not read
the manifest: project dependencies and compiler-native features have different
owners and must not be conflated.
]]
module nupp.tools.build.native

const {type Config} = require("nupp.tools.build.manifest")
const {type Target} = require("nupp.tools.build.manifest")

local envMod = require("nupp.compiler.project.env")
local native = require("nupp.compiler.native")
local check = require("nupp.compiler.check")
local parser = require("nupp.compiler.syntax.parser")
local fs = require("nupp.compiler.fs")
local process = require("nupp.compiler.process")
local deps = require("nupp.tools.build.deps")

local stage = {}

local join = fs.join
local windows = package.config:sub(1, 1) == "\\"

--- Finds native effects in an external Lua module by checking it under Nupp's ordinary
--- prelude. Bundled rock modules are not project source files and do not pass through
--- the project's incremental checker.
function stage.sourceEffects(source: string, filename: string, env: {[string]: any}?): {[string]: any}
    local parsed: any = parser.parse(source, filename)
    if #parsed.errors > 0 then
        return {}
    end
    check.check(parsed, filename, env, {strict = false})

    return parsed.effects or {}
end

--- Runs the toolchain driver and returns the path it printed.
---
--- The driver decides where a build lands and how it is cached, keyed by the
--- compiler this machine has, so nothing here names a directory. Its progress
--- goes to standard error and its answer to standard output; the capture merges
--- them, so the answer is the last line that says anything.
local function driven(compilerRoot: string, what: string, features: {string}): (string?, string)
    local driver = join(compilerRoot, "scripts/toolchain")
    -- os.execute reaches cmd.exe on Windows, which does not interpret a
    -- shebang. The driver belongs to the Git Bash environment used to launch
    -- Nupp, so name its shell explicitly there.
    local argv = windows and {"sh.exe", driver, what, table.concat(features, ",")}
        or {driver, what, table.concat(features, ",")}
    local code, text = process.capture(argv)
    if code ~= 0 then
        return nil, text
    end
    local answer = nil
    for line in text:gmatch("[^\r\n]+") do
        if line:match("%S") then
            answer = line
        end
    end
    if not answer then
        return nil, "the toolchain driver built " .. what .. " but named no file"
    end

    return answer, ""
end

--- Adds effects found in the Lua modules selected from rock dependencies.
function stage.dependencyEffects(
    root: string,
    config: Config,
    target: Target?,
    effects: {[string]: any}?
): {[string]: any}
    local resolved = {}
    for effect in pairs(effects or {}) do
        resolved[effect] = true
    end
    local env = envMod.new(root, {config = config})
    for _, module in ipairs(deps.rockModules(root, config, target)) do
        local source = fs.readFile(module.path)
        if source then
            for effect in pairs(stage.sourceEffects(source, module.path, env as {[string]: any})) do
                resolved[effect] = true
            end
        end
    end

    return resolved
end

function stage.resolve(effects: {[string]: any}?, overrides: {[string]: boolean}?): {[string]: boolean}
    return native.resolve(effects, overrides)
end

--- Builds the compiler-owned binary host with exactly the host features in the resolved
--- effect set. A path-valued third-party stub remains its owner's artifact.
function stage.hostStub(root: string, outDir: string, target: Target, effects: {[string]: any}?): string?, string?
    if target.stub ~= "nupp" then
        return target.stub
    end
    if target.platforms then
        local required = native.requiredHostFeatureNames(effects)
        local stubs = require("nupp.tools.build.stubs")
        local record, recordErr = target._stubRecord, nil
        if not record then
            record, recordErr = stubs.record(assert(target.layoutTarget))
        end
        if not record then
            return nil, recordErr
        end
        return stubs.acquire(root, record, required)
    end
    local compilerRoot = envMod.compilerRoot()
    if not compilerRoot then
        return nil, "the compiler-owned Nupp stub needs compiler source; "
            .. "use a source checkout or name a prebuilt stub path"
    end
    local featureNames = native.hostFeatureNames(effects)
    local built, problem = driven(compilerRoot, "host", featureNames)
    if not built then
        return nil, "cannot build the compiler-owned Nupp host:\n" .. problem
    end

    return built
end

--- The link arguments for each prebuilt provider a standalone binary links in
--- rather than stages: the platform's static library, read like any other
--- archive, and the provider's entry points kept, because the provider finds
--- them by name in the process and nothing in the link refers to them. Every
--- kit's link exports what it keeps, which is where LuaJIT's `ffi.C` looks.
--- A macOS link also names the system frameworks the provider calls into,
--- which the kit at `kit` stubs apart from its own libraries.
function stage.linkedProviders(effects: {[string]: any}?, platform: string, kit: string?): ({string}?, string?)
    local flags: {string} = {}
    local compilerRoot = envMod.compilerRoot()
    local macos = platform:find("apple-darwin", 1, true) ~= nil
    for _, feature in ipairs(native.features(effects)) do
        local symbols = feature.linkedSymbols
        if symbols then
            local libraries: {string}? = nil
            if macos then
                if kit ~= nil then
                    local kits = require("nupp.tools.build.kits")
                    libraries = kits.providerLibraries(kit as string, tostring(feature.providerDriver))
                end
                if libraries == nil then
                    return nil, (
                        "standalone binary for %s cannot link native feature %s; "
                        .. "its link kit has no stubs for the system frameworks the provider needs"
                    ):format(platform, feature.name)
                end
            end
            if not compilerRoot then
                return nil, "native feature "
                    .. feature.name
                    .. " needs compiler source to link statically; use a source checkout to build this target"
            end
            local archive, problem = driven(compilerRoot as string, tostring(feature.providerDriver) .. "-static", {
                platform
            })
            if not archive then
                return nil, ("cannot build native facilities %s:\n%s"):format(feature.name, problem)
            end
            flags[#flags + 1] = archive as string
            for _, symbol in ipairs(symbols as {string}) do
                -- Mach-O names carry a leading underscore and ld64 spells
                -- the option its own way.
                if macos then
                    flags[#flags + 1] = "-u"
                    flags[#flags + 1] = "_" .. symbol
                else
                    flags[#flags + 1] = "--undefined=" .. symbol
                end
            end
            for _, library in ipairs(libraries or {}) do
                flags[#flags + 1] = library
            end
        end
    end

    return flags, nil
end

--- Relinks the current-platform compiler host with an application's static
--- native closure. The driver force-loads archives because FFI symbol lookups
--- do not create ordinary undefined references for an archive linker to see.
function stage.linkHost(
    root: string,
    target: Target,
    effects: {[string]: any}?,
    output: string,
    archives: {string},
    flags: {string}
): (string?, string?)
    local selected = target.layoutTarget
    local host = require("nupp.tools.build.platform").hostKey()
    local aotllvm = require("nupp.tools.build.aotllvm")
    local compilerRoot = envMod.compilerRoot()
    local featureNames = native.hostFeatureNames(effects)
    local linked = selected or host
    if linked == nil then
        return nil, "standalone native linking needs a target platform"
    end
    if require("nupp.compiler.aot.llvm.profile").of(linked as string) == nil then
        return nil, "standalone native linking has no link kit for " .. tostring(linked)
    end
    -- The link is lld's, from a link kit: the runtime and stubs for the
    -- system libraries, and no C toolchain or SDK, for this machine's
    -- platform or another's.
    local available, availableErr = aotllvm.selected()
    if available ~= true then
        return nil, tostring(availableErr)
    end
    local build: (function(): (string?, string?))? = nil
    if compilerRoot ~= nil and linked == host then
        build = function(): (string?, string?)
            return driven(compilerRoot as string, "kit", featureNames)
        end
    end
    local kit, kitErr = require("nupp.tools.build.kits").resolve(linked as string, featureNames, build)
    if kit == nil then
        return nil, kitErr
    end
    local linkedFlags, linkedErr = stage.linkedProviders(effects, linked as string, kit as string)
    if linkedFlags == nil then
        return nil, linkedErr
    end
    local allFlags: {string} = {}
    for _, flag in ipairs(flags) do
        allFlags[#allFlags + 1] = flag
    end
    for _, flag in ipairs(linkedFlags as {string}) do
        allFlags[#allFlags + 1] = flag
    end
    local linkErr = aotllvm.linkStandalone(kit as string, output, archives, allFlags)
    if linkErr ~= nil then
        return nil, linkErr
    end

    return output, nil
end

--- The link kit a native program for `triple` links against, or nil and why
--- not. A source checkout links with the pinned prebuilt kit for its own
--- platform, and builds its own when none is pinned.
function stage.programKit(triple: string): (string?, string?)
    local host = require("nupp.tools.build.platform").hostKey()
    local compilerRoot = envMod.compilerRoot()
    local build: (function(): (string?, string?))? = nil
    if compilerRoot ~= nil and triple == host then
        build = function(): (string?, string?)
            -- A native program needs only the kit's LuaJIT, so the previous
            -- release's kit serves this tree's programs as well as its own.
            local kit = require("nupp.tools.build.prebuilt").fetch("kit", triple)
            if kit ~= nil then
                return kit, nil
            end

            return driven(compilerRoot as string, "kit", {})
        end
    end

    return require("nupp.tools.build.kits").resolve(triple, {}, build)
end

--- Compiles a native program's LLVM IR `ir` for `triple` and links it into
--- the executable `output` against the static LuaJIT of that platform's link
--- kit.
function stage.linkProgram(triple: string, output: string, ir: string): (string?, string?)
    local aotllvm = require("nupp.tools.build.aotllvm")
    local available, availableErr = aotllvm.selected()
    if available ~= true then
        return nil, tostring(availableErr)
    end
    local kit, kitErr = stage.programKit(triple)
    if kit == nil then
        return nil, kitErr
    end
    local linkErr = aotllvm.program(ir, triple, kit as string, output)
    if linkErr ~= nil then
        return nil, linkErr
    end

    return output, nil
end

local libraryFile = deps.sharedLibraryName

--- Builds and stages every native feature in `effects`, returning its files.
function stage.build(
    root: string,
    outDir: string,
    effects: {[string]: any}?,
    selectedPlatform: string?,
    availableOutputs: {[string]: boolean}?,
    standalone: boolean?
): {[string]: boolean}?, string?
    local outputs = {}
    local providers: {[string]: {
        provider: string,
        driver: string,
        library: string,
        names: {string},
        providerFeatures: {string},
        platform: string?
    }} = {}
    local providerKeys: {string} = {}
    for _, feature in ipairs(native.features(effects)) do
        if feature.provider then
            if standalone and (feature.host or feature.linkedSymbols) then
                -- The relinked host contains this provider; no loadable sidecar
                -- is part of a standalone binary's runtime closure.
                goto continue
            end
            if standalone and not feature.host then
                return nil, "standalone binary needs sidecar-only native feature "
                    .. feature.name
                    .. "; no static host implementation exists"
            end
            if selectedPlatform and feature.host then
                -- The compiler-owned catalog stub carries this implementation. A
                -- current-machine sidecar beside a foreign executable is invalid.
                goto continue
            end
            -- A prebuilt provider exists for every platform, so a foreign
            -- target stages its own copy rather than this machine's.
            local foreign = selectedPlatform and feature.providerDriver == "wgpu" and selectedPlatform or nil
            if selectedPlatform and not feature.host and not foreign then
                return nil, (
                    "binary target %s needs sidecar-only native feature %s; no %s provider artifact exists"
                ):format(tostring(selectedPlatform), feature.name, tostring(selectedPlatform))
            end
            local libraryName = feature.library as string
            local driver = feature.providerDriver or "native"
            local key = driver .. "\0" .. feature.provider .. "\0" .. libraryName .. "\0" .. (foreign or "")
            local provider = providers[key]
            if not provider then
                provider = {
                    provider = feature.provider,
                    driver = driver,
                    library = libraryName,
                    names = {},
                    providerFeatures = {},
                    platform = foreign,
                }
                providers[key] = provider
                providerKeys[#providerKeys + 1] = key
            end
            provider.names[#provider.names + 1] = feature.name
            if feature.providerFeature then
                provider.providerFeatures[#provider.providerFeatures + 1] = feature.providerFeature
            end
        end
        ::continue::
    end
    local compilerRoot = envMod.compilerRoot()
    table.sort(providerKeys)
    for _, key in ipairs(providerKeys) do
        local provider = assert(providers[key])
        if not compilerRoot then
            return nil, "native facilities need compiler source; use a source checkout to build this target"
        end
        table.sort(provider.names)
        table.sort(provider.providerFeatures)
        local built, problem = driven(
            compilerRoot,
            provider.driver,
            provider.platform and {provider.platform as string} or provider.providerFeatures
        )
        if not built then
            return nil, ("cannot build native facilities %s:\n%s"):format(table.concat(provider.names, ", "), problem)
        end
        local filename = libraryFile(provider.library)
        -- The sidecar has one public name on POSIX. Windows' loader appends
        -- `.dll` to an extensionless path, so keep that suffix there while
        -- leaving the provider name stable everywhere else. A foreign target
        -- is named for the system it runs on.
        local windowsTarget = jit.os == "Windows"
        if provider.platform then
            windowsTarget = (provider.platform as string):find("windows", 1, true) ~= nil
            filename = provider.library .. ".dll"
        end
        local staged = windowsTarget and filename or provider.library
        local output = join(root, join(outDir, join("lib", staged)))
        local copied, err = fs.copyFile(built, output)
        if not copied then
            return nil, (
                "cannot stage native facilities %s: %s"
            ):format(table.concat(provider.names, ", "), tostring(err))
        end
        outputs[output] = true
    end

    -- A compiler-provided Nupp module a facility needs at run time. A target whose
    -- own source set contains that module has already compiled the exact artifact
    -- it asked for; replacing it with the compiler checkout's differently configured
    -- artifact breaks both that contract and the next build's content check. Otherwise
    -- stage the compiler's build so an application need not compile the runtime again.
    for _, feature in ipairs(native.features(effects)) do
        local moduleName = feature.runtimeModule
        if moduleName then
            local relative = (moduleName:gsub("%.", "/")) .. ".lua"
            local output = join(root, join(outDir, relative))
            if not availableOutputs or not availableOutputs[output] then
                if not compilerRoot then
                    return nil, ("the %s runtime was not staged from the installed compiler"):format(feature.name)
                end
                local built = join(compilerRoot, join("build", relative))
                local copied, err = fs.copyFile(built, output)
                if not copied then
                    return nil, ("cannot stage the %s runtime: %s"):format(feature.name, tostring(err))
                end
            end
            outputs[output] = true
        end
    end

    return outputs
end

export = stage
