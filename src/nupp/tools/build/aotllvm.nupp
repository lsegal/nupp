--[[
The AOT build's code generator: emitting a unit as LLVM IR, compiling it in
process, and linking the objects with lld. A build that needs it on a `nupp`
built without it is refused.
]]
module nupp.tools.build.aotllvm

local codegen = require("nupp.compiler.aot.llvm.codegen")
local facts = require("nupp.compiler.aot.llvm.facts")
local fs = require("nupp.compiler.fs")
local llvmDetector = require("nupp.compiler.aot.llvm.detector")
local llvmProgram = require("nupp.compiler.aot.llvm.program")
local llvmProfile = require("nupp.compiler.aot.llvm.profile")
local scalarIR = require("nupp.compiler.aot.scalar")
local toolruns = require("nupp.tools.build.toolruns")

local aotllvm = {}

--- What produced an artifact, for its key: the backend, the code generator's
--- version, and the lowering's.
const aotllvm.BACKEND = "llvm"

--- Whether the pinned prebuilt code generator has been asked for yet, and
--- why it could not be had when that is worth saying.
local askedPrebuilt = false

local prebuiltProblem: string? = nil

--- A source checkout whose provider was built without LLVM links with the
--- prebuilt code generator `scripts/toolchain.pins` names, fetched and
--- verified once per machine. Asked once per process, and only by a build
--- that needs the code generator.
local function prebuilt(): nil
    if askedPrebuilt or codegen.available() then
        return
    end
    askedPrebuilt = true
    local path, problem = require("nupp.tools.build.prebuilt").fetch("codegen")
    if path == nil then
        -- Nothing pinned for this platform is the ordinary state of a
        -- checkout, not a failure to report.
        if problem ~= nil and not tostring(problem):find("is pinned for", 1, true) then
            prebuiltProblem = problem
        end

        return
    end
    prebuiltProblem = codegen.useLibrary(path as string)
end

--- Whether this nupp can compile AOT code: true, or nil and why not (it was
--- built without the code generator, or NUPP_AOT_FACTS is malformed).
function aotllvm.selected(): (boolean?, string?)
    prebuilt()
    local available, why = codegen.available()
    if not available then
        if prebuiltProblem ~= nil then
            return nil, tostring(why) .. "; the prebuilt code generator is unavailable: " .. tostring(prebuiltProblem)
        end

        return nil, tostring(why)
    end
    local _, factsErr = aotllvm.facts()
    if factsErr ~= nil then
        return nil, "NUPP_AOT_FACTS: " .. tostring(factsErr)
    end

    return true, nil
end

--- The proved facts this build states: `NUPP_AOT_FACTS`, `all` when unset
--- (see `nupp.compiler.aot.llvm.facts`), or nil and why the value is wrong.
function aotllvm.facts(): (facts.Facts?, string?)
    return facts.parse(os.getenv("NUPP_AOT_FACTS") or "all")
end

--- The fact selection as it goes into an artifact's key.
function aotllvm.factsKey(): string
    local selected = aotllvm.facts()

    return selected ~= nil and facts.key(selected as facts.Facts) or "all"
end

--- Whether independent Wasm entries call their kernels' unoptimized scalar
--- twins (`NUPP_AOT_WASM_ORACLE=1`): the reference build the Wasm SIMD
--- suites compare the optimized one against.
function aotllvm.wasmOracle(): boolean
    return os.getenv("NUPP_AOT_WASM_ORACLE") == "1"
end

--- The code generator, facts and oracle switch a build lowers with, as text
--- a remembered build is compared against.
function aotllvm.selection(): string
    return "llvm " .. aotllvm.version() .. " facts=" .. aotllvm.factsKey() .. (
        aotllvm.wasmOracle() and " wasm-oracle" or ""
    )
end

--- The code generator's identity, which every LLVM artifact is keyed on, or
--- `unavailable` in a nupp built without it: a build that compiles nothing on
--- the CPU needs none, and one that does says so where it would compile.
function aotllvm.version(): string
    prebuilt()
    if not codegen.available() then
        return "unavailable"
    end

    return codegen.version()
end

--- Appends a line to the report NUPP_AOT_LLVM_REPORT names, if any: each
--- unit the code generator compiled, and where the time went.
function aotllvm.note(line: string): nil
    local path = os.getenv("NUPP_AOT_LLVM_REPORT")
    if path == nil or path == "" then
        return
    end
    local file = io.open(path as string, "a")
    if file ~= nil then
        file:write(line, "\n")
        file:close()
    end
end

--- A unit's programs as LLVM IR, or nil and why this backend cannot emit
--- them (the build then fails, naming the unit). `logical` keeps each entry's
--- logical symbol rather than its tier's, the way an inspection names them,
--- and `sourceFile` gives the unit line tables pointing into that file.
--- @raises string when emission fails for a reason other than coverage: a
---   defect in the backend, which must not be reported as a missing feature
function aotllvm.emit(
    programs: {scalarIR.Program},
    tier: string,
    triple: string,
    logical: boolean?,
    sourceFile: string?,
    exports: boolean?
): (string?, string?)
    local selected, profileErr = llvmProfile.of(triple)
    if selected == nil then
        return nil, profileErr
    end
    local cpu: {scalarIR.Program} = {}
    for _, program in ipairs(programs) do
        if program.executionTarget ~= "gpu" then
            cpu[#cpu + 1] = program
        end
    end
    -- A Wasm module's entries are numbered by position among all of the
    -- unit's programs, as the bridge metadata the loaders read numbers them.
    local bridges: {[string]: integer} = {}
    for position, program in ipairs(programs) do
        bridges[program.symbol] = position
    end
    local ok, module = pcall(
        llvmProgram.module,
        cpu,
        tier,
        selected as llvmProfile.Profile,
        (aotllvm.facts()),
        sourceFile,
        logical,
        bridges,
        aotllvm.wasmOracle(),
        exports
    )
    if not ok then
        if llvmProgram.isUnsupported(module) then
            return nil, tostring(module)
        end
        error(module, 0)
    end

    return module as string, nil
end

--- The baseline feature detector as LLVM IR, or nil when this backend has no
--- profile for `triple` (the build then fails).
function aotllvm.detector(triple: string): string?
    local selected = llvmProfile.of(triple)
    if selected == nil then
        return nil
    end

    return llvmDetector.module((selected as llvmProfile.Profile).functionAttributes)
end

--- Whether a library built for `triple` is handed the provider's runtime table
--- when it loads. A target whose libraries link the runtime in (the browser
--- guest, which has no provider) is not.
function aotllvm.takesRuntime(triple: string?): boolean
    local selected = triple ~= nil and llvmProfile.of(triple as string) or nil

    return selected == nil or (selected as llvmProfile.Profile).linkedRuntime == nil
end

--- The options a tier's unit is compiled with, as the strings its key holds.
function aotllvm.flags(triple: string, tier: string): {string}
    local selected = llvmProfile.of(triple)
    if selected == nil then
        return {"triple=" .. triple, "tier=" .. tier}
    end
    local options = llvmProfile.options(selected as llvmProfile.Profile, tier)
    local keys: {string} = {}
    for key in pairs(options) do
        keys[#keys + 1] = key
    end
    table.sort(keys)
    local flags: {string} = {}
    for _, key in ipairs(keys) do
        flags[#flags + 1] = key .. "=" .. (options[key] as string)
    end

    return flags
end

--- A unit's programs as target assembly, or nil and why not: the IR
--- this backend emits for them, compiled as a build would.
function aotllvm.assembly(
    programs: {scalarIR.Program},
    tier: string,
    triple: string,
    sourceFile: string?
): (string?, string?)
    local ir, why = aotllvm.emit(programs, tier, triple, true, sourceFile)
    if ir == nil then
        return nil, why
    end
    local selected = llvmProfile.of(triple) as llvmProfile.Profile
    local options = llvmProfile.options(selected, tier)
    options.assembly = "1"
    local compiled, err = codegen.compile(ir as string, "<aot>", options)
    if compiled == nil or compiled.assembly == nil then
        return nil, "compiling the LLVM IR failed: " .. tostring(err)
    end

    return compiled.assembly as string, nil
end

--- An emitted unit to compile: its IR file, and the object to install.
record aotllvm.Unit
    ir: string
    triple: string
    tier: string
    object: string
end

--- Compiles `units` side by side, each isolated so that LLVM ending on an
--- internal error fails that unit rather than the build's process.
--- @return nil, or the first unit's failure
function aotllvm.compileMany(units: {aotllvm.Unit}): string?
    local jobs: {codegen.Job} = {}
    for position, unit in ipairs(units) do
        local selected, profileErr = llvmProfile.of(unit.triple)
        if selected == nil then
            return profileErr
        end
        jobs[
            position
        ] = codegen.Job(
            ir = unit.ir,
            object = unit.object .. ".tmp",
            options = llvmProfile.options(selected as llvmProfile.Profile, unit.tier)
        )
    end
    local outcomes, err = codegen.compileFiles(jobs, toolruns.width(#jobs))
    if outcomes == nil then
        return "compiling the LLVM units failed: " .. tostring(err)
    end
    local failure: string? = nil
    for position, outcome in ipairs(outcomes as {codegen.Outcome}) do
        local unit = units[position]
        if outcome.error ~= nil then
            os.remove(jobs[position].object)
            failure = failure or "compiling " .. unit.ir .. " with LLVM failed: " .. tostring(outcome.error)
        else
            local timings = (tostring(outcome.report):match("^(.-)object%-bytes") or ""):gsub("\n", " ")
            aotllvm.note(("compile\t%s\t%s"):format(unit.ir, timings))
            local installed, installErr = fs.installStaged(jobs[position].object, unit.object)
            if not installed then
                failure = failure or tostring(installErr)
            end
        end
    end

    return failure
end

--- The object of the runtime a `selected` library links in, compiled once
--- per runtime and code generator into `directory`, or nil when the target
--- has a provider to hand modules the runtime.
--- @return the object's path, or nil and why not
local function linkedRuntime(selected: llvmProfile.Profile, directory: string): (string?, string?)
    local carried = selected.linkedRuntime
    if carried == nil then
        return nil, nil
    end
    local text = require("nupp.compiler.bundled").source(carried as string)
    if text == nil then
        return nil, "this compiler carries no runtime " .. tostring(carried)
    end
    local digest = require("nupp.compiler.hash").digest((text as string) .. "\0" .. aotllvm.version())
    local object = directory .. "/runtime." .. digest:sub(1, 16) .. ".o"
    if fs.exists(object) then
        return object, nil
    end
    local ir = directory .. "/runtime." .. digest:sub(1, 16) .. ".ll"
    local wrote, writeErr = fs.writeFile(ir, text as string)
    if not wrote then
        return nil, tostring(writeErr)
    end
    local err = aotllvm.compileMany({
        aotllvm.Unit(ir = ir, triple = selected.public, tier = "baseline", object = object)
    })
    os.remove(ir)
    if err ~= nil then
        return nil, err
    end

    return object, nil
end

--- What a Windows DLL links beside its units (`nupp.compiler.aot.llvm.coff`):
--- the binding object and the import libraries, made once per code generator
--- into `directory`.
--- @return the files to link, or nil and why not
local function windowsGlue(selected: llvmProfile.Profile, directory: string): ({string}?, string?)
    local coff = require("nupp.compiler.aot.llvm.coff")
    local names = require("nupp.compiler.aot.llvm.lua.runtime").apiNames()
    local ir = coff.binding(selected.llvmTriple, names)
    local digest = require(
        "nupp.compiler.hash"
    ).digest(
        ir .. "\0" .. table.concat(coff.CRT, ",") .. "\0" .. table.concat(coff.UCRT, ",") .. "\0" .. aotllvm.version()
    )
        :sub(1, 16)
    local object = directory .. "/luabind." .. digest .. ".o"
    local crt = directory .. "/msvcrt." .. digest .. ".a"
    local kernel32 = directory .. "/kernel32." .. digest .. ".a"
    local ucrt = directory .. "/ucrtmath." .. digest .. ".a"
    if not fs.exists(object) then
        local source = directory .. "/luabind." .. digest .. ".ll"
        local wrote, writeErr = fs.writeFile(source, ir)
        if not wrote then
            return nil, tostring(writeErr)
        end
        local err = aotllvm.compileMany({
            aotllvm.Unit(ir = source, triple = selected.public, tier = "baseline", object = object)
        })
        os.remove(source)
        if err ~= nil then
            return nil, err
        end
    end
    for _, library in ipairs({
        {"msvcrt.dll", crt, coff.CRT},
        {coff.UCRT_MODULE, ucrt, coff.UCRT},
        {"kernel32.dll", kernel32, coff.KERNEL32}
    }) do
        if not fs.exists(library[2] as string) then
            local entries: {{string}} = {}
            for _, name in ipairs(library[3] as {string}) do
                entries[#entries + 1] = {name}
            end
            local err = codegen.importLibrary(library[1] as string, library[2] as string, entries)
            if err ~= nil then
                return nil, "cannot write the import library for " .. tostring(library[1]) .. ": " .. err
            end
        end
    end

    return {object, crt, ucrt, kernel32}, nil
end

--- Links `objects` into the shared library `output` with lld. `root`, the
--- project's directory, is left out of the object paths a Mach-O debug map
--- records, so the library does not depend on where the project is checked out.
--- `exports` names everything the library publishes; nothing else is.
--- @return nil, or what went wrong
function aotllvm.link(triple: string, objects: {string}, output: string, root: string?, exports: {string}?): string?
    local selected, profileErr = llvmProfile.of(triple)
    if selected == nil then
        return profileErr
    end
    -- A DLL records the file name it was linked as, so a Windows library is
    -- staged under its own name beside the objects, in the build's own
    -- directory, rather than beside itself with a suffix.
    local staged = output .. ".tmp"
    if (selected as llvmProfile.Profile).format == "coff" and objects[1] ~= nil then
        staged = fs.dirname(objects[1]) .. "/" .. fs.basename(output)
    end
    os.remove(staged)
    -- Absolute objects, spelled as `root` is below: the debug map records the
    -- path each object was given as, and a prefix spelled through a different
    -- symlink would strip nothing.
    local linked: {string} = {}
    for _, object in ipairs(objects) do
        linked[#linked + 1] = root ~= nil and fs.absolute(object) or object
    end
    local runtimeObject, runtimeErr = linkedRuntime(selected as llvmProfile.Profile, fs.dirname(objects[1] or output))
    if runtimeErr ~= nil then
        return runtimeErr
    end
    if runtimeObject ~= nil then
        linked[#linked + 1] = runtimeObject as string
    end
    local strip = root ~= nil and fs.absolute(root as string):gsub("/*$", "/") or nil
    local listed: string? = nil
    if exports ~= nil then
        listed = fs.dirname(objects[1] or output) .. "/" .. fs.basename(output) .. ".exports"
        local wrote, writeErr = fs.writeFile(
            listed as string,
            llvmProfile.exportList(selected as llvmProfile.Profile, exports as {string})
        )
        if not wrote then
            return tostring(writeErr)
        end
    end
    local argv = llvmProfile.sharedLink(
        selected as llvmProfile.Profile,
        staged,
        linked,
        fs.basename(output),
        strip,
        listed
    )
    if (selected as llvmProfile.Profile).format == "coff" then
        local glue, glueErr = windowsGlue(selected as llvmProfile.Profile, fs.dirname(objects[1] or output))
        if glue == nil then
            return glueErr
        end
        for position, argument in ipairs(argv) do
            if argument == "/noentry" then
                argv[position] = "/entry:" .. require("nupp.compiler.aot.llvm.coff").ENTRY
            end
        end
        for _, file in ipairs(glue as {string}) do
            argv[#argv + 1] = file
        end
    end
    local _, err = codegen.link(argv)
    if listed ~= nil then
        os.remove(listed as string)
    end
    if err ~= nil then
        os.remove(staged)

        return "linking the LLVM objects failed: " .. tostring(err)
    end
    local installed, installErr = fs.installStaged(staged, output)
    if not installed then
        return tostring(installErr)
    end

    return nil
end

--- Archives `objects` into the static library `output`, indexed, in the
--- format the target's linkers read.
--- @return nil, or what went wrong
function aotllvm.archive(triple: string, objects: {string}, output: string): string?
    local selected, profileErr = llvmProfile.of(triple)
    if selected == nil then
        return profileErr
    end
    local staged = output .. ".tmp"
    os.remove(staged)
    local format = (selected as llvmProfile.Profile).format == "macho" and "darwin" or "gnu"
    local err = codegen.archive(staged, objects, format)
    if err ~= nil then
        os.remove(staged)

        return "archiving the LLVM objects failed: " .. tostring(err)
    end
    local installed, installErr = fs.installStaged(staged, output)
    if not installed then
        return tostring(installErr)
    end

    return nil
end

--- The Wasm libm's object under `directory`, compiled once per libm and
--- code generator: its name carries the digest of both.
--- @return the object's path, or nil and why not
function aotllvm.wasmLibm(directory: string): (string?, string?)
    local text = require("nupp.compiler.bundled").source("/aot/llvm/wasm/libm.ll")
    if text == nil then
        return nil, "this compiler carries no Wasm libm"
    end
    local digest = require("nupp.compiler.hash").digest((text as string) .. "\0" .. aotllvm.version())
    local object = directory .. "/libm." .. digest:sub(1, 16) .. ".o"
    if fs.exists(object) then
        return object, nil
    end
    local ir = directory .. "/libm." .. digest:sub(1, 16) .. ".ll"
    local wrote, writeErr = fs.writeFile(ir, text as string)
    if not wrote then
        return nil, tostring(writeErr)
    end
    local err = aotllvm.compileMany({
        aotllvm.Unit(ir = ir, triple = "wasm32-unknown-emscripten", tier = "scalar", object = object)
    })
    os.remove(ir)
    if err ~= nil then
        return nil, err
    end

    return object, nil
end

--- Links one Wasm object into the independent module `output` with lld:
--- no entry point, exactly `exports` plus the allocator exported, and the
--- memory the loaders expect -- 4 MiB to start, growable to 64 MiB.
--- @return nil, or what went wrong
function aotllvm.linkWasm(object: string, output: string, exports: {string}, libm: string?): string?
    -- The reference build's unoptimized twins keep every vector on the
    -- stack, so they start with 32 MiB rather than 4.
    local oracle = aotllvm.wasmOracle()
    local argv: {
        string
    } = {
        "wasm-ld",
        "--no-entry",
        oracle and "--initial-memory=33554432" or "--initial-memory=4194304",
        "--max-memory=67108864",
        "-z",
        oracle and "stack-size=16777216" or "stack-size=65536",
        "--export=malloc",
        "--export=free",
    }
    for _, name in ipairs(exports) do
        argv[#argv + 1] = "--export=" .. name
    end
    argv[#argv + 1] = "-o"
    argv[#argv + 1] = output
    argv[#argv + 1] = object
    if libm ~= nil then
        argv[#argv + 1] = libm as string
    end
    local _, err = codegen.link(argv)
    if err ~= nil then
        os.remove(output)

        return "linking the Wasm module failed: " .. tostring(err)
    end

    return nil
end

--- What `link` makes: an executable, or with `shared` a shared library, and
--- the file of `exports`, when there is one, naming all either exports.
local record LinkMode
    shared: boolean
    exports: string?
end

--- The ELF half of `link`: a position-independent executable from the kit's
--- startup objects, `runtime` and `archives` whole, the kit's library stubs,
--- and libgcc, bound to the dynamic linker the kit names. A shared library
--- leaves out the executable's startup object and the dynamic linker.
local function linkLinux(
    kit: string,
    manifest: any,
    machine: string,
    output: string,
    runtime: string,
    archives: {string},
    flags: {string},
    mode: LinkMode
): string?
    local argv: {
        string
    } = {"ld.lld", "-m", machine, "--eh-frame-hdr", "-z", "noexecstack", "--hash-style=gnu", "--build-id",}
    if mode.shared then
        argv[#argv + 1] = "-shared"
        argv[#argv + 1] = "-soname"
        argv[#argv + 1] = fs.basename(output)
    else
        argv[#argv + 1] = "-pie"
        argv[#argv + 1] = "-dynamic-linker"
        argv[#argv + 1] = tostring(manifest.interpreter)
    end
    argv[#argv + 1] = "-o"
    argv[#argv + 1] = output
    for _, object in ipairs(manifest.startup) do
        local name = fs.basename(tostring(object))
        if not mode.shared or name ~= "Scrt1.o" and name ~= "crt1.o" then
            argv[#argv + 1] = kit .. "/" .. tostring(object)
        end
    end
    argv[#argv + 1] = "--whole-archive"
    argv[#argv + 1] = runtime
    for _, archive in ipairs(archives) do
        argv[#argv + 1] = archive
    end
    argv[#argv + 1] = "--no-whole-archive"
    for _, library in ipairs(manifest.libraries) do
        argv[#argv + 1] = kit .. "/" .. tostring(library)
    end
    for _, flag in ipairs(flags) do
        argv[#argv + 1] = flag
    end
    for _, object in ipairs(manifest.finish) do
        argv[#argv + 1] = kit .. "/" .. tostring(object)
    end
    -- The program's native code finds the runtime's entry points by name; a
    -- shared library exports its definitions without being asked.
    if not mode.shared then
        argv[#argv + 1] = "--export-dynamic"
    end
    if mode.exports ~= nil then
        argv[#argv + 1] = "--version-script=" .. (mode.exports as string)
    end
    local _, err = codegen.link(argv)
    if err ~= nil then
        os.remove(output)

        return "linking the standalone program failed: " .. tostring(err)
    end

    return nil
end

--- A Windows kit records the link MinGW's driver ran for a probe program;
--- lld's MinGW driver replays it with this program's archives, loaded whole,
--- where the probe's object was. A DLL starts from the CRT's DLL startup object
--- in place of the program's, and an export list replaces the probe's export
--- of everything. `runtimeExports`, the kit's module definition for its
--- runtime, adds the runtime's exports to everything else the link exports.
local function linkWindows(
    kit: string,
    manifest: any,
    output: string,
    runtime: string,
    archives: {string},
    flags: {string},
    mode: LinkMode,
    runtimeExports: string?
): string?
    if type(manifest.argv) ~= "table" then
        return "the link kit at " .. kit .. " records no link"
    end
    local argv: {string} = {"ld.lld"}
    if mode.shared then
        if not fs.exists(kit .. "/lib/dllcrt2.o") then
            return "the link kit at " .. kit .. " has no DLL startup object; rebuild it with scripts/toolchain kit"
        end
        argv[#argv + 1] = "--shared"
    end
    for _, token in ipairs(manifest.argv as {string}) do
        if mode.shared and token == "{kit}/lib/crt2.o" then
            argv[#argv + 1] = kit .. "/lib/dllcrt2.o"
        elseif mode.exports ~= nil and token == "--export-all-symbols" then
            -- The list names what is exported instead.
        elseif token == "{output}" then
            argv[#argv + 1] = output
        elseif token == "{runtime}" then
            argv[#argv + 1] = runtime
        elseif token == "{archives}" then
            argv[#argv + 1] = "--whole-archive"
            for _, archive in ipairs(archives) do
                argv[#argv + 1] = archive
            end
            argv[#argv + 1] = "--no-whole-archive"
            for _, flag in ipairs(flags) do
                argv[#argv + 1] = flag
            end
        elseif token:sub(1, 6) == "{kit}/" then
            argv[#argv + 1] = kit .. token:sub(6)
        else
            argv[#argv + 1] = token
        end
    end
    -- lld's MinGW driver reads a `.def` input as the module definition.
    if mode.exports ~= nil then
        argv[#argv + 1] = mode.exports as string
    elseif runtimeExports ~= nil then
        argv[#argv + 1] = runtimeExports as string
    end
    local _, err = codegen.link(argv)
    if err ~= nil then
        os.remove(output)

        return "linking the standalone program failed: " .. tostring(err)
    end

    return nil
end

--- Links `output` from the link kit at `kit`: the archive its manifest names
--- under `runtime` and `archives` loaded whole (a program reaches native code
--- by name, which no archive scan sees), against the kit's stubs for the
--- system libraries, with lld in process. `mode` is what is linked; an
--- executable exporting whatever the kit's link exports when none is given.
local function link(
    kit: string,
    output: string,
    runtime: string,
    archives: {string},
    flags: {string},
    mode: LinkMode?
): string?
    local how = mode or LinkMode(shared = false)
    local text = fs.readFile(kit .. "/kit.json")
    if text == nil then
        return "the link kit at " .. kit .. " has no kit.json"
    end
    local json = require("serde.json")
    local manifest = json.decodevalue(text as string, json.NULL)
    if type(manifest) ~= "table" or manifest.schemaVersion ~= 1 then
        return "the link kit at " .. kit .. " has an unreadable kit.json"
    end
    -- The kit says what it links for; the host running nupp has no say.
    local selected = type(manifest.target) == "string" and llvmProfile.of(manifest.target as string) or nil
    if selected == nil then
        return "the link kit at " .. kit .. " names no target this nupp can link for"
    end
    local named = (manifest as {[string]: any})[runtime]
    if type(named) ~= "string" then
        return "the link kit at "
            .. kit
            .. " carries no "
            .. runtime
            .. " archive; rebuild it with scripts/toolchain kit"
    end
    local archive = kit .. "/" .. (named as string)
    local machine = (selected as llvmProfile.Profile).machine
    if manifest.platform == "linux" then
        return linkLinux(kit, manifest, machine, output, archive, archives, flags, how)
    elseif manifest.platform == "windows" then
        -- The runtime archive is not loaded whole, so its provider is linked
        -- and exported only for the names the kit's definition file lists.
        local definition: string? = nil
        if runtime == "runtime" and type(manifest.exports) == "string" then
            definition = kit .. "/" .. (manifest.exports as string)
        end
        return linkWindows(kit, manifest, output, archive, archives, flags, how, definition)
    elseif manifest.platform ~= "macos" then
        return "the link kit at " .. kit .. " is for " .. tostring(manifest.platform) .. ", which this nupp cannot link"
    end
    local minimum = tostring(manifest.minimum)
    local argv: {
        string
    } = {
        "ld64.lld",
        "-arch",
        machine,
        "-platform_version",
        "macos",
        minimum,
        minimum,
        "-syslibroot",
        kit .. "/" .. tostring(manifest.syslibroot),
        "-o",
        output,
    }
    if how.shared then
        argv[#argv + 1] = "-dylib"
        argv[#argv + 1] = "-install_name"
        argv[#argv + 1] = "@rpath/" .. fs.basename(output)
    end
    argv[#argv + 1] = "-force_load"
    argv[#argv + 1] = archive
    for _, linked in ipairs(archives) do
        argv[#argv + 1] = "-force_load"
        argv[#argv + 1] = linked
    end
    for _, library in ipairs(manifest.libraries) do
        argv[#argv + 1] = tostring(library)
    end
    for _, flag in ipairs(flags) do
        argv[#argv + 1] = flag
    end
    -- A native program may call anything libSystem has, and the kit's stubs
    -- name only what the host bound. The rest binds when the program loads.
    if runtime == "luajit" then
        argv[#argv + 1] = "-undefined"
        argv[#argv + 1] = "dynamic_lookup"
    end
    -- The program's native code finds the runtime's entry points by name.
    argv[#argv + 1] = "-export_dynamic"
    if how.exports ~= nil then
        argv[#argv + 1] = "-exported_symbols_list"
        argv[#argv + 1] = how.exports as string
    end
    local _, err = codegen.link(argv)
    if err ~= nil then
        os.remove(output)

        return "linking the standalone program failed: " .. tostring(err)
    end

    return nil
end

--- Links a standalone program `output` from the link kit at `kit`: its
--- runtime and `archives`, against the kit's stubs for the system libraries.
--- @return nil, or what went wrong
function aotllvm.linkStandalone(kit: string, output: string, archives: {string}, flags: {string}): string?
    return link(kit, output, "runtime", archives, flags)
end

--- Links a native program `output` whose `main` is in `objects`, from the
--- link kit at `kit`: the objects and the kit's static LuaJIT, exporting the
--- Lua C API so a C module the program's Lua state loads binds against it.
--- @return nil, or what went wrong
function aotllvm.linkProgram(kit: string, output: string, objects: {string}): string?
    return link(kit, output, "luajit", objects, {})
end

--- The members of the static archive at `path`, each written beside `prefix`
--- under a name of its own, in archive order; its symbol tables are left out.
--- Reads the GNU and BSD formats, which are what the targets' archivers write.
--- @return the members' files, or nil and why not
local function members(path: string, prefix: string): ({string}?, string?)
    local data = fs.readFile(path)
    if data == nil then
        return nil, "cannot read the archive " .. path
    end
    local bytes = data as string
    if bytes:sub(1, 8) ~= "!<arch>\n" then
        return nil, path .. " is not a static archive"
    end
    local files: {string} = {}
    local longNames = ""
    local at = 9
    while at + 60 <= #bytes + 1 do
        local header = bytes:sub(at, at + 59)
        local name = (header:sub(1, 16)):gsub("%s+$", "")
        local size = tonumber((header:sub(49, 58)):match("%d+"))
        if size == nil or header:sub(59, 60) ~= "`\n" then
            return nil, path .. " has a damaged member header"
        end
        local length = size as integer
        local start = at + 60
        local body = bytes:sub(start, start + length - 1)
        local bsd = name:match("^#1/(%d+)$")
        if bsd ~= nil then
            local nameLength = tonumber(bsd) as integer
            name = (body:sub(1, nameLength)):gsub("%z+$", "")
            body = body:sub(nameLength + 1)
        end
        if name == "//" then
            longNames = body
        elseif name ~= "/" and name ~= "/SYM64/" and name:sub(1, 9) ~= "__.SYMDEF" then
            local offset = name:match("^/(%d+)$")
            if offset ~= nil then
                name = longNames:sub((tonumber(offset) as integer) + 1):match("^([^\n]-)/?\n") or name
            end
            name = fs.basename((name:gsub("/$", "")))
            local file = ("%s.%d-%s"):format(prefix, #files + 1, name)
            local wrote, writeErr = fs.writeFile(file, body)
            if not wrote then
                for _, written in ipairs(files) do
                    os.remove(written)
                end
                return nil, tostring(writeErr)
            end
            files[#files + 1] = file
        end
        at = start + length + length % 2
    end

    return files, nil
end

--- How a native program is linked.
record aotllvm.NativeLink
    --- "executable", "static" or "shared".
    linkage: string

    --- Static archives linked in whole, or for a static archive, merged in.
    archives: {string}

    --- Every symbol the executable or shared library exports, and all it
    --- exports; nil leaves what the kit's link exports.
    exports: {string}?
end

--- Compiles the LLVM IR `ir` of a native program for `triple` into `output`:
--- an executable or a shared library linked from the link kit at `kit`, or a
--- static archive, which needs no kit, of the program's object and the
--- members of `how.archives`.
--- @return nil, or what went wrong
function aotllvm.nativeProgram(
    ir: string,
    triple: string,
    kit: string?,
    output: string,
    how: aotllvm.NativeLink
): string?
    local selected, profileErr = llvmProfile.of(triple)
    if selected == nil then
        return profileErr
    end
    local options = llvmProfile.options(selected as llvmProfile.Profile, "baseline")
    options.verify = "1"
    local compiled, err = codegen.compile(ir, "<native>", options)
    if compiled == nil then
        return "compiling the native program failed: " .. tostring(err)
    end
    local object = output .. ".o"
    local wrote, writeErr = fs.writeFile(object, (compiled as codegen.Compiled).object)
    if not wrote then
        return tostring(writeErr)
    end
    if how.linkage == "static" then
        local inputs: {string} = {object}
        local extracted: {string} = {}
        local problem: string? = nil
        for _, archive in ipairs(how.archives) do
            if problem == nil then
                local files, membersErr = members(archive, output)
                if files == nil then
                    problem = membersErr
                else
                    for _, file in ipairs(files as {string}) do
                        inputs[#inputs + 1] = file
                        extracted[#extracted + 1] = file
                    end
                end
            end
        end
        if problem == nil then
            problem = aotllvm.archive(triple, inputs, output)
        end
        for _, file in ipairs(extracted) do
            os.remove(file)
        end
        os.remove(object)

        return problem
    end
    if kit == nil then
        os.remove(object)

        return "linking a native program needs a link kit for " .. triple
    end
    local listed: string? = nil
    if how.exports ~= nil then
        -- lld's MinGW driver knows a module definition by its suffix.
        listed = output .. ((selected as llvmProfile.Profile).format == "coff" and ".def" or ".exports")
        local listWrote, listErr = fs.writeFile(
            listed as string,
            llvmProfile.exportList(selected as llvmProfile.Profile, how.exports as {string}, llvmProfile.publicData(ir))
        )
        if not listWrote then
            os.remove(object)

            return tostring(listErr)
        end
    end
    local objects: {string} = {object}
    for _, archive in ipairs(how.archives) do
        objects[#objects + 1] = archive
    end
    local linkErr = link(
        kit as string,
        output,
        "luajit",
        objects,
        {},
        LinkMode(shared = how.linkage == "shared", exports = listed)
    )
    os.remove(object)
    if listed ~= nil then
        os.remove(listed as string)
    end

    return linkErr
end

--- Compiles the LLVM IR `ir` of a native program for `triple` and links it
--- into the executable `output` from the link kit at `kit`.
--- @return nil, or what went wrong
function aotllvm.program(ir: string, triple: string, kit: string, output: string): string?
    return aotllvm.nativeProgram(ir, triple, kit, output, aotllvm.NativeLink(linkage = "executable", archives = {}))
end

export = aotllvm
