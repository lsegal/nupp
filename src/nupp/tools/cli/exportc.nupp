module nupp.tools.cli.exportc

-- `nupp export-c`: canonical C declarations for ordinary Nupp structs, and
-- prototypes for the C functions a Nupp library imports or exports.

local usageError = require("nupp.tools.cli.error").forCommand("export-c")
local cliModule = require("io.cli")
local report = require("nupp.tools.cli.report")

local REPORT_SCHEMA = {
    type = "object",
    properties = {
        ok = report.OK,
        output = {type = "string"},
        target = {type = "string"},
        declarations = {type = "array", items = {type = "string"}},
        diagnostics = report.DIAGNOSTICS,
    },
    required = {"ok", "target", "declarations", "diagnostics"},
}

-- Every node of one tree, with whatever the visitor needs carried alongside rather
-- than captured. That is what lets the visitor be written once above the loop over the
-- files: a function built inside a loop is one LuaJIT never compiles.
local function walk(node: any, visit: function(any, any): nil, context: any)
    if not node or require("nupp.compiler.syntax.cst").isToken(node) then
        return
    end
    visit(node, context)
    for _, child in ipairs(node) do
        walk(child, visit, context)
    end
end

-- The C type of each scalar IR value type an `@aot` entry passes or returns.
-- Read from the lowered program rather than the source, so an `integer`
-- crosses as whatever lowering made of it, which is what the entry takes.
local ENTRY_VALUES: {
    [string]: string
} = {
    f64 = "number",
    f32 = "float",
    i32 = "int32",
    u32 = "uint32",
    i64 = "int64",
    u64 = "uint64",
    bool = "boolean",
}

-- The physical storage types a span element may name, which a span holds as
-- written rather than as its value type.
local SPAN_STORAGE: {
    [string]: boolean
} = {
    number = true,
    float = true,
    int8 = true,
    int16 = true,
    int32 = true,
    int64 = true,
    uint8 = true,
    uint16 = true,
    uint32 = true,
    uint64 = true,
    boolean = true,
}

local function entryValue(typeName: any): any?
    local tag = ENTRY_VALUES[tostring(typeName)]

    return tag and {tag = tag} or nil
end

-- What one element of a span is stored as, by the same rule the code
-- generator's `types.storage` uses: the source type when it names a storage
-- type, the value type otherwise.
local function spanElement(param: any): any?
    if param.sourceType and SPAN_STORAGE[param.sourceType] then
        return {tag = param.sourceType}
    end

    return entryValue(param.type)
end

-- A name for an entry parameter a C reader can follow. A SoA view's columns
-- are lowered under private names, so each is spelled `<view>_<field>`.
local function parameterName(param: any): string
    if param.soa then
        return param.soa.view .. "_" .. param.soa.field
    end

    return param.name
end

-- The C signature an `@aot(export = ...)` entry is published with, or nil and
-- why it has none. Written from the lowered program, which is what the code
-- generator lays the entry out from: span pointers and uniforms in parameter
-- order, then the span counts as `size_t` (one per span when the counts are
-- independent, one shared count otherwise), then a pointer to the struct
-- several results are written to.
local function exportedSignature(program: any): (any?, string?)
    if program.executionTarget == "gpu" then
        return nil, "it is a GPU entry"
    end
    if program.entryMode ~= "kernel" then
        return nil, "its entry takes or returns Lua values"
    end
    local scalarIR = require("nupp.compiler.aot.scalar")
    local params: {any} = {}
    local taken: {[string]: boolean} = {}
    local function add(name: string, t: any): nil
        while taken[name] do
            name = name .. "_"
        end
        taken[name] = true
        params[#params + 1] = {name = name, type = t, mode = "plain"}
    end
    for _, param in ipairs(program.params) do
        taken[parameterName(param)] = true
    end
    local spans: {any} = {}
    for _, param in ipairs(program.params) do
        local name = parameterName(param)
        taken[name] = nil
        if scalarIR.isSpan(param) then
            local element = spanElement(param)
            if not element then
                return nil, ("span parameter %q does not hold numbers, booleans or fixed-width integers"):format(name)
            end
            if param.kind == "read_span" then
                element = {tag = "const", inner = element}
            end
            add(name, {tag = "ptr", elem = element})
            spans[#spans + 1] = param
        elseif param.kind == "uniform" then
            local t = entryValue(param.type)
            if not t then
                return nil, ("parameter %q is not a number, float, boolean or fixed-width integer"):format(name)
            end
            add(name, t)
        else
            return nil, ("parameter %q is not a span or a uniform"):format(name)
        end
    end
    local size = {tag = "size_t"}
    if scalarIR.independentCounts(program) then
        for _, param in ipairs(spans) do
            if param.soa == nil or param.soa.ordinal == 1 then
                add("count_" .. (param.soa and param.soa.view or param.name), size)
            end
        end
    else
        add("count", size)
    end
    local results = program.resultTypes or {}
    local result, resultStruct = nil, nil
    if #results == 1 then
        result = entryValue(results[1])
        if not result then
            return nil, "its result is not a number, float, boolean or fixed-width integer"
        end
    elseif #results > 1 then
        local tag = tostring(program.exportName) .. "_result"
        local fields: {any} = {}
        for position, resultType in ipairs(results) do
            local t = entryValue(resultType)
            if not t then
                return nil, ("result %d is not a number, float, boolean or fixed-width integer"):format(position)
            end
            fields[position] = {name = "r" .. tostring(position), type = t}
        end
        resultStruct = {tag = tag, fields = fields}
        add("result", {tag = "ptr", elem = {tag = "nominal", declKind = "struct", cdefKind = "struct", cdefName = tag}})
    end
    local signature = require("nupp.compiler.cinterop.cabi").functionRecord(
        tostring(program.exportName),
        params,
        result,
        false,
        "c"
    )
    signature.resultStruct = resultStruct

    return signature, nil
end

-- The C signature of every `@aot(export = ...)` entry of one checked file, by
-- C name, or nil and why the file's entries could not be lowered.
local function exportedSignatures(source: string, path: string, parsed: any): ({[string]: any}?, {[string]: string}?, string?)
    local programs, problems = require("nupp.compiler.aot.compile").lower(source, path, parsed, nil)
    if #problems > 0 then
        local first = problems[1]
        return nil, nil, ("lowering refused it (%s:%d:%d: %s)"):format(first.file, first.line, first.column, first.message)
    end
    local signatures: {[string]: any} = {}
    local refusals: {[string]: string} = {}
    for _, program in ipairs(programs) do
        if program.exportName ~= nil then
            local signature, why = exportedSignature(program)
            if signature then
                signatures[program.exportName] = signature
            else
                refusals[program.exportName] = tostring(why)
            end
        end
    end

    return signatures, refusals, nil
end

local function diagnostic(path: string, node: any, code: string, message: string, help: string?): any
    local token = node and (node.name or node[1]) or nil
    return {
        filename = path,
        line = token and token.line or 1,
        col = token and token.col or 1,
        offset = token and token.offset or 0,
        length = token and #(token.text or "") or 1,
        severity = "error",
        code = code,
        msg = message,
        help = help,
    }
end

local function run(options: any): integer
    local positional: {string} = options.inputs
    local fs = require("nupp.compiler.fs")
    local paths: {string}, selections: {string} = {}, {}
    for _, value in ipairs(positional as {string}) do
        if fs.exists(value) then
            paths[#paths + 1] = value
        else
            selections[#selections + 1] = value
        end
    end
    if #paths == 0 or #selections == 0 then
        return usageError("at least one source file and one selected declaration are required")
    end
    local output = options.output
    if not output then
        return usageError("-o FILE is required")
    end

    -- Refused before anything is exported: under `--json` as the one document the
    -- reader was promised, with the reason coded, and otherwise as a line of text.
    local function refuse(code: string, message: string): integer
        if options.format == "json" then
            return report.failure(REPORT_SCHEMA, {report.runDiagnostic(code, message, nil, "nupp.lua")}, {
                declarations = selections
            })
        end
        io.stderr:write(require("nupp.tools.cli.error").message(message) .. "\n")

        return 1
    end

    local manifest = require("nupp.tools.build.manifest")
    local config, configErr = manifest.load(".")
    if not config then
        return refuse(report.MANIFEST, tostring(configErr))
    end
    local target, targetErr = require("nupp.tools.build.tasks").targetConfig(config, options.target)
    if not target then
        return refuse(report.UNKNOWN_NAME, tostring(targetErr))
    end
    config._target = target
    local targetLayout = require("nupp.compiler.targetlayout")
    local layoutKey = target.layoutTarget or targetLayout.hostKey()
    if not layoutKey then
        return refuse(report.MANIFEST, "the compiler host has no modeled C layout; configure build.layoutTarget")
    end

    local envMod = require("nupp.compiler.project.env")
    local env = envMod.new(".", {config = config})
    local parser = require("nupp.compiler.syntax.parser")
    local checker = require("nupp.compiler.check")
    local allDiagnostics: {any} = {}
    local types, functions, sites = {}, {}, {}
    -- Selection -> why that `@aot(export)` function has no C signature.
    local unexportable: {[string]: string} = {}
    local unexportableFiles: {[string]: string} = {}

    -- A struct type does not say which of its fields are bitfields, but the field's
    -- declaration does, and the checker names each field by that declaration's token.
    local bitfields: {[any]: any} = {}
    local bitfieldFiles: {[any]: string} = {}

    local function collectCdefFunction(node: any, context: any): nil
        local moduleName = context.moduleName
        if node.kind == "cdefFunc" and node.name and node.cAbiSignature then
            local qualified = (moduleName and moduleName .. "." or "") .. node.name.text
            functions[qualified], sites[qualified] = node.cAbiSignature, node
        elseif node.kind == "localFuncStmt" and node.name and node.body and node.body.aotExport then
            local qualified = (moduleName and moduleName .. "." or "") .. node.name.text
            sites[qualified] = node
            context.exports[#context.exports + 1] = {qualified = qualified, cName = node.body.aotExport}
        elseif node.kind == "fieldDecl" and node.name and node.bitWidth then
            bitfields[node.name] = node.bitWidth
            bitfieldFiles[node.name] = context.path
        end
    end

    for _, path in ipairs(paths) do
        local source, readErr = fs.readFile(path)
        if not source then
            allDiagnostics[
                #allDiagnostics + 1
            ] = report.fileDiagnostic(path, tostring(readErr), "check that the path exists and is readable")
        else
            local result = parser.parse(source, path)
            for _, one in ipairs(result.errors) do
                allDiagnostics[#allDiagnostics + 1] = one
            end
            if #result.errors == 0 then
                local moduleName = envMod.moduleNameForPath(env, path)
                local diagnostics, _, exports = checker.check(result, path, env as {[string]: any}, {
                    moduleName = moduleName
                })
                for _, one in ipairs(diagnostics) do
                    allDiagnostics[#allDiagnostics + 1] = one
                end
                for name, t in pairs(exports and exports.types or {}) do
                    local qualified = (moduleName and moduleName .. "." or "") .. name
                    types[qualified], sites[qualified] = t, exports.typeDefs[name]
                end
                local context = {moduleName = moduleName, path = path, exports = {}}
                walk(result.root, collectCdefFunction, context)
                -- An export's prototype is what lowering made of it, so a file
                -- with any is lowered, once, after it checks cleanly.
                local fatal = false
                for _, one in ipairs(diagnostics) do
                    fatal = fatal or require("nupp.compiler.diagnostics").isFatal(one)
                end
                if #context.exports > 0 and not fatal then
                    local signatures, refusals, why = exportedSignatures(source as string, path, result)
                    for _, entry in ipairs(context.exports) do
                        local signature = signatures and signatures[entry.cName] or nil
                        if signature then
                            functions[entry.qualified] = signature
                        else
                            unexportable[entry.qualified] = refusals and refusals[entry.cName]
                                or why
                                or "lowering published no entry for it"
                            unexportableFiles[entry.qualified] = path
                        end
                    end
                end
            end
        end
    end

    local reportMod = require("nupp.tools.cli.report")
    local failed = false
    for _, one in ipairs(allDiagnostics) do
        if require("nupp.compiler.diagnostics").isFatal(one) then
            failed = true
        end
    end
    local cabi = require("nupp.compiler.cinterop.cabi")
    local aggregateDescriptions, functionSignatures = {}, {}
    local described = {}

    local function describe(t: any, selection: string): boolean
        if described[t] then
            return true
        end
        for _, name in ipairs(t.fieldOrder or {}) do
            local definition = t.fieldDefs and t.fieldDefs[name] or nil
            local width = definition and bitfields[definition.token] or nil
            if width then
                allDiagnostics[
                    #allDiagnostics + 1
                ] = diagnostic(
                    bitfieldFiles[definition.token] or paths[1],
                    {width},
                    "NUPP2203",
                    (
                        "cannot export %s to C: field %q is a bitfield, which the C layout target does not model"
                    ):format(selection, name),
                    "drop the width, or keep this struct out of the exported header"
                )
                failed = true
                return false
            end
        end
        local description, why = cabi.aggregate(t, layoutKey)
        if not description then
            local site = sites[selection]
            allDiagnostics[
                #allDiagnostics + 1
            ] = diagnostic(
                site and site.filename or paths[1],
                site and site.token or site,
                "NUPP2203",
                ("cannot export %s to C: %s"):format(selection, tostring(why)),
                "select a reified struct representable by the configured layout target"
            )
            failed = true
            return false
        end
        described[t] = true
        for _, dependency in ipairs(description.dependencies or {}) do
            if not describe(dependency, cabi.identity(dependency)) then
                return false
            end
        end
        for _, dependency in ipairs(description.pointerDependencies or {}) do
            if not describe(dependency, cabi.identity(dependency)) then
                return false
            end
        end
        aggregateDescriptions[#aggregateDescriptions + 1] = description

        return true
    end

    -- What a parameter or result ultimately points at. `T*?` resolves to a
    -- two-member union with nil whose pointer cabi still renders, so the union is
    -- stripped alongside the pointer wrappers: otherwise a nullable struct
    -- pointer's struct would never be described and the header would name a
    -- typedef it does not declare.
    local function pointedAt(t: any): any?
        while t do
            if t.tag == "ptr" or t.tag == "const" or t.tag == "carray" then
                t = t.elem or t.inner
            elseif t.tag == "union" and t.hasNil and #(t.members or {}) == 2 then
                local first, second = t.members[1], t.members[2]
                t = first and first.tag == "nil" and second or first
            else
                break
            end
        end

        return t
    end

    for _, selection in ipairs(selections) do
        if types[selection] then
            describe(types[selection], selection)
        elseif functions[selection] then
            functionSignatures[#functionSignatures + 1] = functions[selection]
            for _, parameter in ipairs(functions[selection].params or {}) do
                local t = pointedAt(parameter.type)
                if t and t.tag == "nominal" and t.declKind == "struct" and not t.cdefName then
                    describe(t, cabi.identity(t))
                end
            end
            local t = pointedAt(functions[selection].result)
            if t and t.tag == "nominal" and t.declKind == "struct" and not t.cdefName then
                describe(t, cabi.identity(t))
            end
        elseif unexportable[selection] then
            allDiagnostics[
                #allDiagnostics + 1
            ] = diagnostic(
                unexportableFiles[selection] as string,
                sites[selection],
                "NUPP2203",
                ("cannot export %s to C: %s"):format(selection, unexportable[selection] as string),
                "export a function whose parameters are scalars or spans of them, and whose results are scalars"
            )
            failed = true
        else
            allDiagnostics[
                #allDiagnostics + 1
            ] = diagnostic(
                paths[1],
                nil,
                "NUPP2101",
                "selected C export does not exist: " .. selection,
                "select a module-qualified exported struct, cdef function or @aot(export) function from the named sources"
            )
            failed = true
        end
    end

    local text = nil
    if not failed then
        local rendered, why = cabi.header(aggregateDescriptions, functionSignatures, output)
        if not rendered then
            allDiagnostics[
                #allDiagnostics + 1
            ] = diagnostic(paths[1], nil, "NUPP2203", "cannot export C header: " .. tostring(why))
            failed = true
        else
            text = rendered
        end
    end
    if text then
        local written, writeErr = fs.writeFileIfChanged(output, text)
        if not written then
            allDiagnostics[
                #allDiagnostics + 1
            ] = report.fileDiagnostic(output, tostring(writeErr), "check that the output path is writable")
            failed = true
        end
    end

    if options.format == "json" then
        reportMod.write({
            ok = not failed,
            output = not failed and output or nil,
            target = layoutKey,
            declarations = selections,
            diagnostics = reportMod.diagnosticValues(allDiagnostics),
        })
    else
        require("nupp.compiler.diagnostics").report(allDiagnostics)
        if not failed then
            io.write(output .. "\n")
        end
    end

    return failed and 1 or 0
end

--- Export canonical C declarations for Nupp structs and C functions.
---
--- Examples:
---
---     nupp export-c -o include/game.h src/game.nupp game.Position
---     nupp export-c -o include/game.h src/game.nupp game.add
---     nupp export-c --target library -o include/library.h src/library.nupp library.Widget
---     nupp export-c --json -o include/game.h src/game.nupp game.Position
@cli("export-c")
@derive(cliModule.command)
local record ExportC
    --- Write the generated header to this file.
    @cli(short = "o", value = "FILE")
    output: string

    --- Use a named manifest build target.
    @cli(value = "NAME")
    target: string?

    --- Select the report representation.
    @cli(value = "FORMAT", constantaliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    --- Source files and declarations to export.
    @cli(positional = "INPUT")
    inputs: {string}

    function run(self): integer
        return run(self)
    end
end

function ExportC.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = ExportC}
