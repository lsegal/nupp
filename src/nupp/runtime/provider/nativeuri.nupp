@!internal
--[[
Native URI parser for `host.uri` API 1.

The native runtime parses an absolute URI as the WHATWG URL Standard does, with
the [](nupp.io.uri.whatwg) parser and the UTS #46 mapping of
[](nupp.io.uri.idna) for special-scheme hosts, so it gives the results the
`url` crate it replaces gave, IDNA included. It needs no native library.

Components land in the canonical UriParts record declared by
[](io.internal.contracts), preserving absent components separately from present
empty strings. Parsing errors return `nil, message`. [](io) owns the public URI
type and operations; this adapter preserves that URI identity.
]]
module nupp.runtime.provider.nativeuri

local contracts = require("io.internal.contracts")
const whatwg = require("nupp.io.uri.whatwg")
const idna = require("nupp.io.uri.idna")
local provider = {}

function provider.parse(text: string): (contracts.UriParts?, string?)
    return whatwg.parse(text, nil, false, idna.toascii)
end

local checked: contracts.UriProvider = {parse = provider.parse}
export = checked
