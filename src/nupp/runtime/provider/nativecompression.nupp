@!internal
--[[Gzip, zlib, and raw DEFLATE provider for compression API 1.

The fixed catalog adapts the Nupp DEFLATE codec in [](nupp.compression.deflate)
and [](nupp.compression.inflate) to span-based steps. Each encoder and decoder
owns its codec state; a malformed stream fails its step with the codec's reason,
and the decoder keeps failing once it has.
]]
module nupp.runtime.provider.nativecompression

const contract = require("nupp.compression.contracts")
const deflate = require("nupp.compression.deflate")
const inflate = require("nupp.compression.inflate")
const span = require("bytes.span")
const ffi = require("ffi")

local function text(borrows input: span.Span<uint8>): string
    local count = #input
    if count == 0 then
        return ""
    end
    return ffi.string(input:ref() as any, count)
end

local record Encoder is contract.Encoder
    @private state: deflate.Encoder

    function close(takes self): nil
    end

    function write(
        exclusive self,
        borrows input: span.Span<uint8>,
        exclusive output: span.ByteWriteSpan
    ): (integer?, integer?, integer?, string?)
        local consumed, written, status = deflate.write(self.state, text(input), output:ref() as any, #output)
        return consumed, written, status, nil
    end

    function flush(exclusive self, exclusive output: span.ByteWriteSpan): (integer?, integer?, string?)
        local written, status = deflate.flush(self.state, output:ref() as any, #output)
        return written, status, nil
    end

    function finish(exclusive self, exclusive output: span.ByteWriteSpan): (integer?, integer?, string?)
        local written, status = deflate.finish(self.state, output:ref() as any, #output)
        return written, status, nil
    end
end

local record Decoder is contract.Decoder
    @private state: inflate.Decoder

    function close(takes self): nil
    end

    function read(
        exclusive self,
        borrows input: span.Span<uint8>,
        exclusive output: span.ByteWriteSpan
    ): (integer?, integer?, integer?, string?)
        local consumed, written, status, problem = inflate.read(self.state, text(input), output:ref() as any, #output)
        if problem ~= nil then
            return nil, nil, nil, "compression decode failed: " .. problem
        end
        return consumed, written, status, nil
    end

    function finishinput(exclusive self, exclusive output: span.ByteWriteSpan): (integer?, integer?, string?)
        local written, status, problem = inflate.finishinput(self.state, output:ref() as any, #output)
        if problem ~= nil then
            return nil, nil, "compression decode failed: " .. problem
        end
        return written, status, nil
    end
end

local record Format is contract.Format
    @readonly name: string
    @private id: integer

    function createencoder(self, options: contract.FormatOptions?): contract.Encoder
        local level = options ~= nil and options.level or 6
        return Encoder(state = deflate.create(self.id, level))
    end

    function createdecoder(self, options: contract.FormatOptions?): contract.Decoder
        local concatenatedMembers = self.name == "gzip" and (options == nil or options.concatenatedmembers ~= false)
        return Decoder(state = inflate.create(self.id, concatenatedMembers))
    end
end

local formats: {[string]: contract.Format} = {}
for name, id in pairs(contract.formatids) do
    formats[name] = Format(name = name, id = id)
end

local provider: contract.Provider = {formats = formats}
export = provider
