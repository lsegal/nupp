@!internal
--[[Native implementation of [](nupp.runtime.contracts).

A fresh temporary byte allocation is filled from the operating system's secure
random source. The result is copied into an owned Lua string; no pointer escapes.
Counts are bounded to one MiB, and zero returns an empty string without asking
the system. Failure raises with the system's diagnostic. This module is carried
only by native targets and is selected by the private entropy service for
`os.randombytes`.
]]
module nupp.runtime.provider.nativecrypto

const ffi = require("ffi")
const platform = require("nupp.runtime.provider.nativeplatform")

--- Returns cryptographically secure random bytes from the operating system.
--- @param count the requested byte count, from zero through 1048576
--- @return the generated raw bytes
--- @raises string when the count is invalid or the system cannot supply randomness
export function randombytes(count: integer): string
    if count < 0 or count ~= math.floor(count) or count > 1048576 then
        error("random byte count must be an integer between 0 and 1048576", 2)
    end
    if count == 0 then
        return ""
    end
    local output = ffi.new("uint8_t[?]", count)
    platform.fillrandom(output, count)

    return ffi.string(output, count)
end
