@!internal
--[[
`nupp.runtime.provider.nativefiles` is the native filesystem provider behind the
`os` filesystem functions and `io.open`. It calls the operating system itself
through LuaJIT's FFI -- the Win32 wide-character functions on Windows and the C
library elsewhere -- by way of `nativefswindows` and `nativefsposix`.

Metadata, listing and cursor operations run on the caller's thread. Whole-file
transfers run through `nativefslane` in bounded steps on the Lua thread, and the
lane is bounded three ways: how many transfers may be live, how many bytes they
may hold between them, and how large one may be. Past any of the three a
submission returns a reason rather than queueing, because a queue that grows with
its callers eventually takes the process with it. `pendingTransfers` reports what
the lane is holding. A transfer waits by suspending, so a `@nosuspend` region may
describe, list and rename paths but not copy or write whole files.
]]
module nupp.runtime.provider.nativefiles

const {type Span} = require("bytes.span")

local valueType: function(borrows value: any): string = type as any

const systeminfo = require("nupp.runtime.systeminfo")

----------------------------------------------------------------------------
-- The operating system
----------------------------------------------------------------------------

const ffi = require("ffi")
const suspension = require("nupp.suspension")
const paths = require("io.internal.path")
const io = require("io")
local scalarAdapters = require("nupp.io.internal.scalars")
local privateIo = require("nupp.io")
const span = require("bytes.span")
const messages = require("io.internal.files.messages")
const appPaths = require("io.internal.files.path")
const lane = require("nupp.runtime.provider.nativefslane")
const globbing = require("nupp.runtime.provider.nativefsglob")

local windows = (ffi as any).os == "Windows"
local darwin = (ffi as any).os == "OSX"
local system: any = windows and require("nupp.runtime.provider.nativefswindows")
    or require("nupp.runtime.provider.nativefsposix")

-- The provider numbers what a path is, how a file is opened, and what a seek is
-- measured from. Each of these is its side of one of those enumerations.
local KINDS = {[1] = "file", [2] = "directory", [3] = "other", [4] = "symlink",}
local MODES = {r = 0, w = 1, a = 2, ["r+"] = 3, ["w+"] = 4, ["a+"] = 5,}
local ORIGINS = {set = 0, current = 1, ["end"] = 2,}

local READ_SIZE: integer = 65536
local MAX_EXACT_INTEGER: integer = 9007199254740991
local PENDING: integer = lane.PENDING
local READY: integer = lane.READY
local CANCELED: integer = lane.CANCELED
local TEMPORARY_ATTEMPTS = 64
local EXACT_RANGE = "the file cursor exceeds Nupp's exact integer range"

-- The readiness pump this module registers with whoever is handling suspensions.
-- Its poll moves every pending transfer on by one step, so it answers progress
-- while any transfer can move and a driver never sleeps past one.
local SOURCE = "nupp-files"
local SOURCE_PRIORITY = 20

----------------------------------------------------------------------------
-- What the filesystem answers with
----------------------------------------------------------------------------

--- What a path refers to. A `symlink` answer only ever comes from a query that
--- does not follow links.
--- @export
export type FileKind = messages.FileKind

--- How an open file may be used. The three update modes read and write: `r+` needs an
--- existing file, `w+` truncates one, and `a+` appends.
--- @export
export type Mode = messages.Mode

--- What a seek offset is measured from.
--- @export
export type Origin = messages.Origin

----------------------------------------------------------------------------
-- Owners and argument checks
----------------------------------------------------------------------------

-- Declared ahead of the records because their methods reach them, and defined below
-- because they name the records. The types are the contract either way.
local scratch: function(borrows self: File, count: integer): any

--- @raises string when value is neither a path nor a string
local function named(value: any, what: string, level: integer): string
    if valueType(value) == "string" then
        return value as string
    end
    if valueType(value) == "table" and (value as any).tostring ~= nil then
        return (value as paths.Path):tostring()
    end
    error("nupp: os " .. what .. " must be a path or a string", level)
end

--- @raises string when value is not an integer
local function whole(value: any, what: string, level: integer): integer
    if valueType(value) ~= "number"
        or value ~= math.floor(value as number)
        or math.abs(value as number) > MAX_EXACT_INTEGER
    then
        error("nupp: io " .. what .. " must be an integer", level)
    end

    return value as integer
end

--- @raises string when value is not a positive integer
local function positive(value: any, what: string, level: integer): integer
    local answer = whole(value, what, level + 1)
    if answer < 1 then
        error("nupp: io " .. what .. " must be positive", level)
    end

    return answer
end

----------------------------------------------------------------------------
-- The cursor
----------------------------------------------------------------------------

-- A file keeps its own cursor and reads and writes at it, so a read after an
-- append, or a seek past the end, means what it does on every platform. Positions
-- stay inside the exact integer range, where a cursor is still a number.

-- Reads up to `count` bytes at `position`.
local function readAt(handle: any, position: integer, into: any, count: integer): (integer?, string?)
    local remaining = MAX_EXACT_INTEGER - position
    if remaining == 0 then
        local size = system.fileSize(handle)
        if size ~= nil and (size as integer) > position then
            return nil, EXACT_RANGE
        end
    end
    local got, reason = system.fileRead(handle, into, math.min(count, remaining), position)
    if got == nil then
        return nil, reason
    end

    return got as integer, nil
end

-- Writes every byte at `position`, or at the end when appending, and answers how
-- many moved and where the cursor lands.
local function writeAt(
    handle: any,
    appending: boolean,
    position: integer,
    from: any,
    count: integer
): (integer?, integer?, string?)
    local start = position
    if appending then
        local size, reason = system.fileSize(handle)
        if size == nil then
            return nil, nil, reason
        end
        start = size as integer
    end
    if start + count > MAX_EXACT_INTEGER then
        return nil, nil, "the file cursor would exceed Nupp's exact integer range"
    end
    local written: integer = 0
    while written < count do
        local wrote, reason = system.fileWrite(
            handle,
            from + written,
            count - written,
            (not appending) and (start + written) or nil
        )
        if wrote == nil then
            return nil, nil, reason
        elseif wrote == 0 then
            return nil, nil, "failed to write the complete file buffer"
        end
        written = written + (wrote as integer)
    end
    if appending then
        -- Append mode writes at the then-current end whatever the cursor said, so the
        -- cursor moves to where the write landed.
        local size, reason = system.fileSize(handle)
        if size == nil then
            return nil, nil, reason
        end
        return written, size as integer, nil
    end

    return written, start + written, nil
end

-- The same two calls for a checked span's storage, which may only be lent to a
-- callee that says it borrows it.
local readBorrowed: function(
    handle: any,
    position: integer,
    borrows destination: uint8[?],
    count: integer
): (integer?, string?) = readAt as any
local writeBorrowed: function(
    handle: any,
    appending: boolean,
    position: integer,
    borrows source: const uint8[?],
    count: integer
): (integer?, integer?, string?) = writeAt as any

----------------------------------------------------------------------------
-- Open files
----------------------------------------------------------------------------

--- An open file, and the obligation to close it.
---
--- A file is itself a `Reader` and a `Writer`, both moving one shared cursor, so
--- it goes wherever a byte stream does.
--- @export
export record File is io.Reader, io.Writer
    --- Takes this file and adds scalar reads and writes at its shared cursor.
    --- @param self the file to take
    --- @return the scalar stream, owned by the caller
    function scalar(takes self): affine(io.ScalarStream)
        return scalarAdapters.duplex(self)
    end

    @private _handle: any
    @private _closed: boolean
    @private _scratch: any
    @private _capacity: integer
    @private _position: integer
    @private _appending: boolean

    --- Reads up to `count` bytes at the cursor.
    ---
    --- An empty answer is the end of the file.
    --- @param self this file
    --- @param count the most bytes to read
    --- @return the bytes, or nil when the file is closed
    --- @return why it could not read, when unsuccessful
    --- @raises string when count is not a positive integer
    function read(exclusive self, count: integer): (string?, string?)
        if self._closed then
            return nil, "the file is closed"
        end
        local wanted = positive(count, "File:read count", 2)
        local into = scratch(self, wanted)
        local got, reason = readAt(self._handle, self._position, into, wanted)
        if got == nil then
            return nil, reason
        end
        self._position = self._position + (got as integer)
        if got == 0 then
            return "", nil
        end

        return ffi.string(into, got as integer), nil
    end

    --- Reads at the cursor directly into a checked writable span.
    --- @param self this file
    --- @param destination the positive-sized range to fill
    --- @return how many bytes were read, or nil when the file is closed
    --- @return why it could not read, when unsuccessful
    function readspan(exclusive self, exclusive destination: span.ByteWriteSpan): (integer?, string?)
        if self._closed then
            return nil, "the file is closed"
        end
        local wanted = positive(#destination, "File:readspan destination length", 2)
        local got, reason = readBorrowed(self._handle, self._position, destination:ref(), wanted)
        if got == nil then
            return nil, reason
        end
        self._position = self._position + (got as integer)

        return got, nil
    end

    --- Writes bytes at the cursor.
    --- @param self this file
    --- @param bytes the bytes to write
    --- @return whether they were written
    --- @return why they were not, when unsuccessful
    --- @raises string when bytes is not a string
    function write(exclusive self, bytes: string): (boolean, string?)
        if self._closed then
            return false, "the file is closed"
        end
        if valueType(bytes) ~= "string" then
            error("nupp: io File:write needs a string", 2)
        end
        if #bytes == 0 then
            return true, nil
        end
        local from: any = ffi.cast("const uint8_t *", bytes)
        local wrote, landed, reason = writeAt(self._handle, self._appending, self._position, from, #bytes)
        if wrote == nil then
            return false, reason
        end
        self._position = landed as integer

        return true, nil
    end

    --- Writes bytes from a checked shared span at the cursor.
    --- @param self this file
    --- @param source bytes valid for the duration of the call
    --- @return how many bytes moved, or nil on failure
    --- @return why it could not, when unsuccessful
    function writespan(exclusive self, borrows source: span.Span<uint8>): (integer?, string?)
        if self._closed then
            return nil, "the file is closed"
        end
        local count = #source
        if count == 0 then
            return 0, nil
        end
        local wrote, landed, reason = writeBorrowed(self._handle, self._appending, self._position, source:ref(), count)
        if wrote == nil then
            return nil, reason
        end
        self._position = landed as integer

        return wrote, nil
    end

    --- Returns the file's byte length without moving the cursor.
    --- @param self this file
    --- @return the byte length, or nil on failure
    --- @return a failure reason, when unsuccessful
    --- @raises string when the file is closed
    function size(borrows self): (integer?, io.Error?)
        if self._closed then
            error("nupp: io File is closed", 2)
        end
        local length, reason = system.fileSize(self._handle)
        if length == nil then
            return nil, privateIo.toError(reason)
        end
        if (length as integer) > MAX_EXACT_INTEGER then
            return nil, privateIo.toError("file size exceeds Nupp's exact integer range")
        end

        return length as integer, nil
    end

    --- Moves the cursor and returns where it landed.
    --- @param self this file
    --- @param offset the distance to move
    --- @param origin what the offset is measured from, defaulting to the start
    --- @return the new position, or nil on failure
    --- @return a failure reason, when unsuccessful
    --- @raises string when origin names no seek origin
    function seek(exclusive self, offset: integer?, origin: Origin?): (integer?, io.Error?)
        if self._closed then
            error("nupp: io File is closed", 2)
        end
        local whence = ORIGINS[origin or "set"]
        if whence == nil then
            error("nupp: io has no seek origin named " .. tostring(origin), 2)
        end
        local distance = whole(offset or 0, "seek offset", 2)
        local base: integer = 0
        if whence == 1 then
            base = self._position
        elseif whence == 2 then
            local length, reason = system.fileSize(self._handle)
            if length == nil then
                return nil, privateIo.toError(reason)
            end
            base = length as integer
        end
        local landed = base + distance
        if landed < 0 or landed > MAX_EXACT_INTEGER then
            return nil, privateIo.toError("the file cursor would be outside Nupp's exact integer range")
        end
        self._position = landed

        return landed, nil
    end

    --- Returns the cursor's current position.
    --- @param self this file
    --- @return the position, or nil on failure
    --- @return a failure reason, when unsuccessful
    function position(exclusive self): (integer?, io.Error?)
        return self:seek(0, "current")
    end

    --- Pushes buffered writes at the operating system, and reports a write that
    --- failed to land.
    ---
    --- Writes go straight to the operating system, so there is nothing buffered here
    --- to push; this deliberately does not force the data to the device.
    --- @param self this file
    --- @return whether the flush succeeded
    --- @return a failure reason, when unsuccessful
    function flush(borrows self): (boolean, string?)
        if self._closed then
            return false, "the file is closed"
        end

        return true, nil
    end

    --- Whether this file has been closed.
    --- @param self this file
    --- @return whether it is closed
    function isreleased(borrows self): boolean
        return self._closed
    end

    --- Closes the file as an ownership terminal.
    ---
    --- Repeated calls are safe. A write that failed to land is reported by `flush`,
    --- which is the call to make before closing when that matters. Declared rather
    --- than written inline because the cleanup contract needs the `@nosuspend`, and
    --- an inline method cannot carry one.
    --- @param self this file, spent by the call
    close: @nosuspend function(takes self: File): nil
end

require("nupp.io.internal.bytes").readercompat(File as table)

function File.close(takes self: File): nil
    local state = @unsafe own.release(self)
    if state._closed then
        return
    end
    state._closed = true
    local handle = state._handle
    state._handle = nil
    state._scratch = nil
    state._capacity = 0
    system.fileClose(handle)
end

----------------------------------------------------------------------------
-- Temporary paths
----------------------------------------------------------------------------

--- A created temporary path, and the obligation to settle it.
---
--- Closing removes it. `persist` moves it somewhere permanent instead and discharges
--- the obligation, which is the whole reason to make one: write to a name nobody else
--- can take, then put it where it belongs.
--- @export
export record TemporaryPath is own.Closeable
    @private _text: string
    @private _directory: boolean
    @private _closed: boolean

    --- Returns the created path's text.
    --- @param self this temporary path
    --- @return the path text
    function tostring(self): string
        return self._text
    end

    --- Returns the created path as a path value.
    --- @param self this temporary path
    --- @return the path
    function path(self): paths.Path
        return paths.newpath(self._text)
    end

    --- Moves this path to a permanent destination, replacing what is there.
    --- @param self this temporary path
    --- @param destination where to move it
    --- @return whether the move happened
    --- @return a failure reason, when unsuccessful
    function persist(self, destination: string | paths.Path): (boolean, io.Error?)
        if self._closed then
            return false, privateIo.toError("the temporary path is released", "closed")
        end
        local to = named(destination, "destination path", 2)
        local moved, reason = system.rename(self._text, to)
        if not moved then
            return false, privateIo.toError(reason)
        end
        self._closed = true

        return true, nil
    end

    --- Whether this path has been removed or persisted.
    --- @param self this temporary path
    --- @return whether it is settled
    function isreleased(self): boolean
        return self._closed
    end

    --- Removes the path as an ownership terminal.
    ---
    --- Repeated calls, and a call after `persist`, are safe and do nothing. Declared
    --- rather than written inline because the cleanup contract needs the `@nosuspend`,
    --- and an inline method cannot carry one.
    --- @param self this temporary path, spent by the call
    close: @nosuspend function(takes self: TemporaryPath): nil

    metamethod __tostring: function(borrows self: TemporaryPath): string
end

----------------------------------------------------------------------------
-- Closing
----------------------------------------------------------------------------

function TemporaryPath.close(takes self: TemporaryPath): nil
    local state = @unsafe own.release(self)
    if state._closed then
        return
    end
    state._closed = true
    system.remove(state._text, state._directory)
end

    ;
(TemporaryPath as {[string]: any}).__tostring = function(borrows self: TemporaryPath): string
    return self:tostring()
end

-- Grown by doubling with a floor at one read, so a caller that asks for one byte at a
-- time does not reallocate for each of them.
scratch = function(borrows self: File, count: integer): any
    local state = self as any
    if count > (state._capacity as integer) then
        local size = (state._capacity as integer) * 2
        if size < count then
            size = count
        end
        if size < READ_SIZE then
            size = READ_SIZE
        end
        state._scratch = ffi.new<uint8[?]>(size)
        state._capacity = size
    end

    return state._scratch
end

----------------------------------------------------------------------------
-- Driving the request loop
----------------------------------------------------------------------------

-- Every whole-file transfer a caller is waiting for.
local waits: {any} = {}

-- Moves every pending transfer on by one step, then resumes whoever was waiting for
-- one that settled. Answers the steps taken plus the waits settled: either is
-- progress, which is what tells a driver to poll again rather than sleep.
local function harvest(): integer
    local moved: integer = lane.step()
    local index = #waits
    while index > 0 do
        local entry = waits[index]
        if lane.status(entry.transfer) ~= PENDING then
            waits[index] = waits[#waits]
            waits[#waits] = nil
            moved = moved + 1
            entry.resume(true)
        end
        index = index - 1
    end

    return moved
end

-- Nothing here ever needs a sleep: a pending transfer moves on the next poll, and
-- with none pending there is nothing of this source's to wait for.
local function idle(_waitMs: integer): integer
    return 0
end

local function forget(entry: any): nil
    for index = 1, #waits do
        if waits[index] == entry then
            waits[index] = waits[#waits]
            waits[#waits] = nil

            return
        end
    end
end

-- A transfer that settled on submission is not waited for at all, so the common
-- small read never reaches the suspension machinery.
local function await(transfer: any): nil
    if lane.status(transfer) ~= PENDING then
        return
    end
    suspension.suspend("file transfer", function(resume: function(boolean), context: any): function()?
        local entry = {transfer = transfer, resume = resume,}
        context:source(SOURCE, SOURCE_PRIORITY, harvest, idle)
        waits[#waits + 1] = entry
        -- Settled between the status check above and the subscription: resume now and
        -- answer no cancellation, which is what a subscription that did not park owes.
        if lane.status(transfer) ~= PENDING then
            forget(entry)
            resume(true)

            return nil
        end

        -- Cancellation raises out of the suspension, so `settled` never runs to
        -- release this transfer; releasing it here is what gives the lane its request
        -- and byte budget back. An abandoned park is cancelled twice by design, and the
        -- first call releases the transfer, so the second finds nothing to do.
        local cancelled = false

        return function(): nil
            if cancelled then
                return
            end
            cancelled = true
            forget(entry)
            lane.cancel(transfer)
            lane.release(transfer)
        end
    end)
end

-- Waits for one submitted transfer and answers what it produced: the bytes of a
-- read, the empty string for anything else, or why it did not finish.
local function settled(transfer: any, reason: string?): (string?, string?)
    if transfer == nil then
        return nil, reason
    end
    await(transfer)
    local state, failure = lane.status(transfer)
    if state ~= READY then
        lane.release(transfer)

        return nil, failure or (state == CANCELED and "file transfer was cancelled" or "file transfer failed")
    end
    local bytes, problem = lane.take(transfer)
    lane.release(transfer)

    return bytes, problem
end

local function transferred(transfer: any, reason: string?): (boolean, string?)
    local answer, problem = settled(transfer, reason)

    return answer ~= nil, problem
end

----------------------------------------------------------------------------
-- Naming a temporary
----------------------------------------------------------------------------

--- @raises string when value is neither nil nor a string
local function fragment(value: any, what: string, level: integer): string
    if value == nil then
        return ""
    end
    if valueType(value) ~= "string" then
        error("nupp: os temporary " .. what .. " must be a string", level)
    end

    return value as string
end

local function separated(text: string): boolean
    return text:find("/", 1, true) ~= nil or (windows and text:find("\\", 1, true) ~= nil)
end

local function randomName(): (string?, string?)
    local random, reason = system.randomBytes(8)
    if random == nil then
        return nil, "cannot create a temporary name: " .. tostring(reason)
    end
    local digits: {string} = {}
    for index = 8, 1, -1 do
        digits[#digits + 1] = ("%02x"):format((random as string):byte(index))
    end

    return table.concat(digits), nil
end

--- @raises string when an argument is not a string, or the directory not a path
local function temporary(directory: boolean, prefix: any, suffix: any, within: any, level: integer): (string?, string?)
    local root = within ~= nil and named(within, "temporary directory", level + 1) or ""
    local before = fragment(prefix, "prefix", level + 1)
    local after = fragment(suffix, "suffix", level + 1)
    if separated(before) or separated(after) then
        return nil, "temporary name fragments must not contain a path separator"
    end
    if root == "" then
        root = system.temporaryDirectory()
    end
    local collision: string? = nil
    for _ = 1, TEMPORARY_ATTEMPTS do
        local stamp, problem = randomName()
        if stamp == nil then
            return nil, problem
        end
        local candidate = system.join(root, before .. (stamp as string) .. after)
        local made: boolean
        local reason: string?
        local taken: boolean
        if directory then
            local why: string?
            made, reason, why = system.makeDirectory(candidate, true)
            taken = why == "exists"
        else
            local file, failure, exists = system.createFile(candidate, true)
            made = file ~= nil
            reason = failure
            taken = exists == true
            if file ~= nil then
                system.fileClose(file)
            end
        end
        if made then
            if windows then
                return (candidate:gsub("\\", "/")), nil
            end
            return candidate, nil
        end
        if not taken then
            return nil, reason
        end
        collision = reason
    end

    return nil, collision or "no unused temporary name was found"
end

local spanText: function(
    borrows source: const uint8[?],
    count: integer
): string = require("nupp.runtime.storage").string as any

local function payloadOf(borrows bytes: string | span.Span<uint8>): string
    if valueType(bytes) == "string" then
        return tostring(bytes)
    end
    local source = bytes as span.Span<uint8>;

    return spanText(source:ref(), #source)
end

----------------------------------------------------------------------------
-- Asking about a path
----------------------------------------------------------------------------

--- Describes a path: its kind, byte size, modification time in milliseconds since
--- the Unix epoch, and whether the platform refuses writes to it.
--- @param path the path to describe
--- @param follow whether to describe what a symbolic link points at
--- @return the kind, or nil when the path cannot be described
--- @return the byte size
--- @return the modification time
--- @return whether writes are refused
--- @return a failure reason, when unsuccessful
--- @export
export function stat(path: string | paths.Path, follow: boolean): (FileKind?, integer?, number?, boolean?, string?)
    local text = named(path, "path", 2)
    local kind, size, modified, readonly, reason = system.info(text, follow and true or false)
    if kind == nil then
        return nil, nil, nil, nil, reason
    end
    if (size as integer) > MAX_EXACT_INTEGER then
        return nil, nil, nil, nil, "file size exceeds Nupp's exact integer range"
    end

    -- The system answers seconds; `os` answers the milliseconds the clock does.

    return (KINDS[kind as integer] or "other") as FileKind, size as integer, (modified as number) * 1000, readonly, nil
end

--- Whether a path resolves, following symbolic links. A lookup that cannot tell,
--- such as a refused permission, is a reason rather than `false`.
--- @param path the path to test
--- @return whether it resolves, or nil when the lookup failed
--- @return a failure reason, when unsuccessful
--- @export
export function exists(path: string | paths.Path): (boolean?, string?)
    local text = named(path, "path", 2)

    return system.exists(text)
end

--- Reads a symbolic link's target without resolving it.
--- @param path the link to read
--- @return the target, or nil on failure
--- @return a failure reason, when unsuccessful
--- @export
export function readLink(path: string | paths.Path): (paths.Path?, string?)
    local text = named(path, "path", 2)
    local target, reason = system.readLink(text)
    if target == nil then
        return nil, reason
    end

    return paths.newpath(target), nil
end

--- Creates a symbolic link.
---
--- `kind` selects Windows's directory link and is ignored elsewhere, because only
--- Windows distinguishes the two.
--- @param target what the link points at
--- @param link where to create the link
--- @param kind the link kind, defaulting to a file link
--- @return whether the link was created
--- @return a failure reason, when unsuccessful
--- @raises string when kind names neither a file nor a directory link
--- @export
export function createSymlink(
    target: string | paths.Path,
    link: string | paths.Path,
    kind: ("file" | "directory")?
): (boolean, string?)
    local to = named(target, "symlink target", 2)
    local at = named(link, "symlink path", 2)
    if kind ~= nil and kind ~= "file" and kind ~= "directory" then
        error("nupp: os symlink kind must be 'file' or 'directory'", 2)
    end

    return system.createSymlink(to, at, kind == "directory")
end

--- Sets or clears a path's read-only state: its write permission bits on POSIX and
--- its read-only attribute on Windows.
--- @param path the path to change
--- @param readOnly whether writes should be refused
--- @return whether the change happened
--- @return a failure reason, when unsuccessful
--- @export
export function setReadOnly(path: string | paths.Path, readOnly: boolean): (boolean, string?)
    local text = named(path, "path", 2)

    return system.setReadOnly(text, readOnly and true or false)
end

local makeTree: function(path: string, depth: integer): (boolean, string?)

-- Creates a directory and every missing parent, the way Rust's `create_dir_all`
-- does: an existing directory succeeds, and a parent another caller made in between
-- is not a failure.
makeTree = function(path: string, depth: integer): (boolean, string?)
    local made, reason, why = system.makeDirectory(path, false)
    if made then
        return true, nil
    end
    if why ~= "missing" then
        if system.isDirectory(path) then
            return true, nil
        end
        return false, reason
    end
    local parent = system.parent(path)
    if parent == path or depth == 0 then
        return false, "failed to create whole tree"
    end
    local parentMade, problem = makeTree(parent, depth - 1)
    if not parentMade then
        return false, problem
    end
    made, reason = system.makeDirectory(path, false)
    if made or system.isDirectory(path) then
        return true, nil
    end

    return false, reason
end

--- Creates a directory and every missing parent.
---
--- An existing directory succeeds.
--- @param path the directory to create
--- @return whether the directory exists afterwards
--- @return a failure reason, when unsuccessful
--- @export
export function createDirectory(path: string | paths.Path): (boolean, string?)
    local text = named(path, "path", 2)
    if text == "" then
        return false, "the directory name is empty"
    end

    return makeTree(text, globbing.MAX_WALK_DEPTH * 8)
end

--- Removes a file, a symbolic link, or a directory.
---
--- A recursive remove never follows a link: a link inside the tree is removed as
--- the link it is, so the walk cannot reach outside the tree it was asked to remove.
--- @param path the path to remove
--- @param recursive whether to remove a directory's contents with it
--- @return whether the path was removed
--- @return a failure reason, when unsuccessful
--- @export
export function remove(path: string | paths.Path, recursive: boolean?): (boolean, string?)
    local text = named(path, "path", 2)
    if recursive ~= nil and type(recursive) ~= "boolean" then
        error("nupp: os recursive must be a boolean", 2)
    end

    return system.remove(text, recursive and true or false)
end

--- Renames a path, replacing an existing destination.
--- @param from the path to rename
--- @param to the new path
--- @return whether the rename happened
--- @return a failure reason, when unsuccessful
--- @export
export function rename(from: string | paths.Path, to: string | paths.Path): (boolean, string?)
    local source = named(from, "source path", 2)
    local destination = named(to, "destination path", 2)

    return system.rename(source, destination)
end

--- Yields a directory's immediate children, then nil.
--- @export
export type Entries = function(): (string?, FileKind)

--- Reads a directory's immediate children one at a time.
---
--- Each name has no directory part, and each kind describes the entry itself, so a
--- link inside a listing reads as `symlink`. The order is the platform's. A listing
--- abandoned before its end keeps its directory open until the collector reaches it,
--- the way an unfinished `io.lines` keeps its file.
--- @param path the directory to list
--- @return an iterator over the names and kinds, or nil on failure
--- @return a failure reason, when unsuccessful
--- @raises string when an entry after the first cannot be read
--- @export
export function list(path: string | paths.Path): (Entries?, string?)
    local text = named(path, "path", 2)
    local listing, reason = system.openDirectory(text)
    if listing == nil then
        return nil, reason
    end
    local open: any = listing

    return function(): (string?, FileKind)
        if open == nil then
            return nil, nil as any
        end
        local name, kind, problem = system.readDirectory(open)
        if problem ~= nil then
            system.closeDirectory(open)
            open = nil
            error(text .. ": " .. tostring(problem), 2)
        end
        if name == nil then
            system.closeDirectory(open)
            open = nil
            return nil, nil as any
        end

        return name, (KINDS[kind as integer] or "other") as FileKind
    end, nil
end

--- Expands a filesystem pattern into matching paths.
---
--- `*` and `?` match within a path component, character classes use `[abc]` or
--- `[!abc]`, and `**` crosses directory boundaries. The returned paths are sorted, and
--- no matches is an empty list.
---
--- @param pattern the filesystem pattern to expand
--- @return the matching paths, or nil when the pattern or walk fails
--- @return a failure reason, when unsuccessful
--- @export
export function glob(pattern: string): ({paths.Path}?, string?)
    if type(pattern) ~= "string" then
        error("nupp: os glob pattern must be a string", 2)
    end
    if pattern:find("\0", 1, true) ~= nil then
        return nil, "pattern contains an embedded NUL"
    end
    local found, reason = globbing.expand(pattern, system, windows)
    if found == nil then
        return nil, reason
    end
    local matches: {paths.Path} = {}
    for index, text in ipairs(found as {string}) do
        matches[index] = paths.newpath(text)
    end

    return matches, nil
end

--- Reads a whole file.
---
--- #### Examples
---
--- Read a file's bytes, or report why not:
---
--- ```nupp
--- local file = assert(io.open("nupp.lua", "rb"))
--- local text = assert(file:read("*a"))
--- ```
--- @param path the file to read
--- @return the contents, or nil on failure
--- @return a failure reason, when unsuccessful
--- @export
export function read(path: string | paths.Path): (string?, string?)
    local text = named(path, "path", 2)

    return settled(lane.submitRead(text))
end

--- Writes a whole file, replacing its contents.
--- @param path the file to write
--- @param bytes the contents
--- @return whether the write succeeded
--- @return a failure reason, when unsuccessful
--- @export
export function write(path: string | paths.Path, borrows bytes: string | Span<uint8>): (boolean, string?)
    local text = named(path, "path", 2)

    return transferred(lane.submitWrite(text, payloadOf(bytes), "replace"))
end

--- Adds to the end of a file, creating it when it does not exist.
--- @param path the file to extend
--- @param bytes what to add
--- @return whether the write succeeded
--- @return a failure reason, when unsuccessful
--- @export
export function append(path: string | paths.Path, borrows bytes: string | Span<uint8>): (boolean, string?)
    local text = named(path, "path", 2)

    return transferred(lane.submitWrite(text, payloadOf(bytes), "append"))
end

--- Writes a whole file through a temporary beside it, so an interrupted write leaves
--- the destination as it was rather than half replaced.
---
--- Prefer this to `write` wherever a reader may be looking at the destination
--- while it is being replaced, since `write` truncates in place.
--- @param path the file to write
--- @param bytes the contents
--- @return whether the write succeeded
--- @return a failure reason, when unsuccessful
--- @export
export function writeAtomic(path: string | paths.Path, borrows bytes: string | Span<uint8>): (boolean, string?)
    local text = named(path, "path", 2)

    return transferred(lane.submitWrite(text, payloadOf(bytes), "atomic"))
end

--- Copies a file's contents over a destination.
--- @param from the file to copy
--- @param to where to copy it
--- @return whether the copy succeeded
--- @return a failure reason, when unsuccessful
--- @export
export function copy(from: string | paths.Path, to: string | paths.Path): (boolean, string?)
    local source = named(from, "source path", 2)
    local destination = named(to, "destination path", 2)

    return transferred(lane.submitCopy(source, destination))
end

--- How many whole-file transfers this program is still holding.
---
--- Whole-file reads, writes and copies move in bounded steps, and the lane that
--- runs them is bounded. This returns what it holds, which is what a program that
--- submitted more than it consumed needs to see.
--- @return the number of live transfers
--- @export
export function pendingTransfers(): integer
    return lane.pending()
end

----------------------------------------------------------------------------
-- Opening and reading
----------------------------------------------------------------------------

--- Opens a file and hands over the obligation to close it.
---
--- #### Examples
---
--- Read a header without holding the whole file:
---
--- ```nupp
--- local file = assert(io.open("image.png"))
--- print(file:read(8))
--- ```
--- @param path the file to open
--- @param mode how it may be used, defaulting to reading
--- @return the open file, or nil on failure
--- @return a failure reason, when unsuccessful
--- @raises string when mode names no open mode
--- @export
export function open(path: string | paths.Path, mode: Mode?): (affine(File?), string?)
    local text = named(path, "path", 2)
    local selected = MODES[mode or "r"]
    if selected == nil then
        error("nupp: io has no mode named " .. tostring(mode), 2)
    end
    local handle, reason = system.openFile(text, selected)
    if handle == nil then
        return nil, reason
    end

    return File(
        _handle = handle,
        _closed = false,
        _scratch = nil,
        _capacity = 0,
        _position = 0,
        _appending = selected == 2 or selected == 5
    ), nil
end

--- Creates a uniquely named empty file or directory and hands over the obligation
--- to remove or persist it.
---
--- The path is created rather than merely proposed, so no second caller can take the
--- name in between. Closing the returned owner removes it; `persist` settles it
--- instead, which is what makes the pair a replacement for writing over a destination
--- in place.
--- @param directory whether to create a directory rather than a file
--- @param prefix a separator-free fragment before the generated part of the name
--- @param suffix a separator-free fragment after it
--- @param within the directory to create it in, defaulting to the platform's
--- @return the created path, or nil on failure
--- @return a failure reason, when unsuccessful
--- @export
export function createTemporary(
    directory: boolean,
    prefix: string?,
    suffix: string?,
    within: any?
): (affine(TemporaryPath?), string?)
    local text, reason = temporary(directory, prefix, suffix, within, 2)
    if text == nil then
        return nil, reason
    end

    return TemporaryPath(_text = text as string, _directory = directory, _closed = false), nil
end

--- Reports the complete native filesystem surface.
export function capabilities(): messages.FsCaps
    return systeminfo.filesystem()
end

----------------------------------------------------------------------------
-- Where things live
----------------------------------------------------------------------------

local function configured(name: string): string?
    local value = os.getenv(name)
    if value == nil or value == "" then
        return nil
    end

    return value
end

local function slashed(text: string): string
    if windows then
        return (text:gsub("\\", "/"))
    end

    return text
end

local function home(): (string?, string?)
    local value = configured(system.HOME)
    if value == nil then
        return nil, "the home directory is not set"
    end

    return value, nil
end

--- The platform base an application's configuration (0), durable data (1) or
--- disposable cache (2) lives under, without requiring it to exist. The three never
--- alias: each is handed out as its own directory, and a recursive remove of one
--- must not reach into another.
---
--- Windows uses roaming application data for configuration and local application
--- data for the other two, macOS the Library folders, and everything else the XDG
--- variables, falling back to their defaults beneath the home directory.
--- @param which which base
--- @param platform `windows`, `apple` or `xdg`, defaulting to the running system's
--- @param environment reads a variable, defaulting to the process environment
--- @return the base, or nil when the environment does not say
--- @return a failure reason, when unsuccessful
--- @export
export function applicationBase(
    which: integer,
    platform: ("windows" | "apple" | "xdg")?,
    environment: (function(string): string?)?
): (string?, string?)
    local chosen = platform or (windows and "windows" or (darwin and "apple" or "xdg"))
    local lookup = environment or os.getenv

    local function setting(name: string): string?
        local value = lookup(name)
        if value == nil or value == "" then
            return nil
        end

        return value
    end

    local function homeDirectory(): (string?, string?)
        local value = setting(chosen == "windows" and "USERPROFILE" or "HOME")
        if value == nil then
            return nil, "the home directory is not set"
        end

        return value, nil
    end

    if which ~= 0 and which ~= 1 and which ~= 2 then
        return nil, "unknown application base"
    end
    local folders = {[0] = "Library/Preferences", [1] = "Library/Application Support", [2] = "Library/Caches",}
    local variables = {[0] = "XDG_CONFIG_HOME", [1] = "XDG_DATA_HOME", [2] = "XDG_CACHE_HOME",}
    local fallbacks = {[0] = ".config", [1] = ".local/share", [2] = ".cache",}
    if chosen == "windows" then
        -- Roaming carries settings between machines, local does not, which is the
        -- same split configuration and data already mean.
        if which == 0 then
            local roaming = setting("APPDATA")
            if roaming == nil then
                return nil, "APPDATA is not set"
            end
            return (roaming:gsub("\\", "/")), nil
        end
        local localData = setting("LOCALAPPDATA")
        if localData == nil then
            return nil, "LOCALAPPDATA is not set"
        end
        local base = localData:gsub("\\", "/")
        if which == 2 then
            return base:gsub("/$", "") .. "/Temp", nil
        end
        return base, nil
    elseif chosen == "apple" then
        local base, reason = homeDirectory()
        if base == nil then
            return nil, reason
        end
        return (base as string):gsub("/$", "") .. "/" .. folders[which], nil
    else
        local value = setting(variables[which])
        if value ~= nil and value:sub(1, 1) == "/" then
            return value, nil
        end
        local base, reason = homeDirectory()
        if base == nil then
            return nil, reason
        end
        return (base as string):gsub("/$", "") .. "/" .. fallbacks[which], nil
    end
end

local APP_BASES = {configuration = 0, data = 1, cache = 2,}

export function apppath(kind: string, organization: string, app: string): (paths.Path?, string?)
    local code = APP_BASES[kind]
    if code == nil then
        return nil, "unknown app path kind"
    end
    local base, reason = applicationBase(code as integer, nil, nil)
    if base == nil then
        return nil, reason
    end
    local value = appPaths.native(base, organization, app)
    local made, failure = createDirectory(value:tostring())
    if not made then
        return nil, failure
    end

    return value, nil
end

-- Which folder each user folder number names: its XDG variable, its macOS name, and
-- its name everywhere else.
local USER_FOLDERS = {
    [1] = {"XDG_DOCUMENTS_DIR", "Documents", "Documents"},
    [2] = {"XDG_DOWNLOAD_DIR", "Downloads", "Downloads"},
    [3] = {"XDG_DESKTOP_DIR", "Desktop", "Desktop"},
    [4] = {"XDG_PICTURES_DIR", "Pictures", "Pictures"},
    [5] = {"XDG_MUSIC_DIR", "Music", "Music"},
    [6] = {"XDG_VIDEOS_DIR", "Movies", "Videos"},
}

--- One of the user's folders: home (0), documents (1), downloads (2), desktop (3),
--- pictures (4), music (5) or videos (6). Linux honours the XDG user-directory
--- variables; a folder that is not there is a reason.
--- @param which which folder
--- @return the folder, or nil when the platform has none
--- @return a failure reason, when unsuccessful
--- @export
export function userFolder(which: integer): (string?, string?)
    local base, reason = home()
    if base == nil then
        return nil, reason
    end
    if which == 0 then
        return slashed(base as string), nil
    end
    local names = USER_FOLDERS[which]
    if names == nil then
        return nil, "unknown user folder"
    end
    local folder: string? = nil
    if not windows and not darwin then
        folder = configured(names[1])
    end
    if folder == nil then
        folder = system.join(base, darwin and names[2] or names[3])
    end
    if not system.isDirectory(folder) then
        return nil, "the platform has no such folder"
    end

    return slashed(folder as string), nil
end

--- The running executable's path.
--- @return the path, or nil when the platform cannot say
--- @return a failure reason, when unsuccessful
--- @export
export function executablePath(): (string?, string?)
    return system.executablePath()
end

export function requestPersistentStorage(): (boolean, string?)
    return true, nil
end
