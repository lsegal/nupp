@!internal

--[[
Native filesystem environment for `host.path` API 1.

This module supplies the host separator, process working directory, and
canonicalization, asking the operating system through LuaJIT's FFI by way of
`nativefswindows` or `nativefsposix`. Canonicalization may fail for
inaccessible or missing paths and returns `nil, message`.

Lexical path operations live in [](io). This provider supplies
only environmental facts and filesystem resolution to [](io). It does
not register a second Path type or retain filesystem handles in returned paths.
]]
module nupp.runtime.provider.nativepath

const ffi = require("ffi")

local system: any = (ffi as any).os == "Windows" and require("nupp.runtime.provider.nativefswindows")
    or require("nupp.runtime.provider.nativefsposix")

export function sep(): string
    return package.config:sub(1, 1)
end

export function cwd(): (string?, string?)
    return system.currentDirectory()
end

export function canonicalize(path: string): (string?, string?)
    return system.canonicalize(path)
end
