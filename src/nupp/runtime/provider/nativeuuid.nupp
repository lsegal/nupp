@!internal

--[[
Native implementation of [](nupp.runtime.contracts).

Version 4 uses system randomness; version 7 combines time ordering with
randomness. Both functions return the canonical lowercase, hyphenated UUID
spelling and raise if the operating system cannot supply randomness.

The [](nupp.runtime.uuidprovider) facade retains the selected functions once.
Each call returns a fresh Lua string and leaves no owned native handle with the
caller. Provider selection is state-local; UUID randomness is supplied by the
operating system rather than Lua's random seed.
]]
module nupp.runtime.provider.nativeuuid

const platform = require("nupp.runtime.provider.nativeplatform")

--- Generates a random version 4 UUID.
---
--- @return the UUID, hyphenated and lowercase
--- @raises string when the system has no randomness to draw on
export function uuid4(): string
    return platform.uuid4()
end

--- Generates a time-ordered version 7 UUID.
---
--- @return the UUID, hyphenated and lowercase
--- @raises string when the system has no randomness to draw on
export function uuid7(): string
    return platform.uuid7()
end
