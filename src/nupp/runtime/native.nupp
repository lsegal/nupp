@!internal

--[[
The loader for the versioned Rust-native provider.
]]
module nupp.runtime.native

local ffi = require("ffi")

ffi.cdef[[
uint32_t nuppNativeAbiVersion(void);
uint64_t nuppNativeFeatures(void);
const char *nuppNativeLastError(void);
int32_t nuppNativeBytesCopy(
    uint64_t handle,
    uint8_t *outputData,
    size_t capacity,
    size_t *outputLength
);
int32_t nuppNativeBytesRelease(uint64_t handle);
]]

local native = {}

--- The FFI used to declare feature-specific symbols.
--- @export
native.ffi = ffi

const ABI_VERSION = 2
const LIBRARY_KEY = "__nuppNativeLibrary"

--- The status a copy returns when its output is short, a size query included.
--- @export
native.BUFFER_TOO_SMALL = 6

-- Keeps a loaded provider mapped until the process exits.
--
-- `ffi.load` unloads its library when the namespace is collected, and closing a
-- Lua state collects everything in no particular order. A finalizer that calls
-- into the provider -- a handle's release -- can then run after the library is
-- gone and jump into unmapped code. Taking one more reference that nothing ever
-- releases keeps the provider's code there for every finalizer, whatever order
-- the state closes in. Best effort: a platform that
-- cannot be asked keeps the old behaviour.
local function pin(loaded: any): any
    local library: any = ffi
    pcall(function(): nil
        local C: any = library.C
        local address: any = library.cast("const void *", loaded.nuppNativeAbiVersion)
        if library.os == "Windows" then
            library.cdef("int GetModuleHandleExA(uint32_t, const void *, void **);")
            -- GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN
            C.GetModuleHandleExA(5, address, library.new("void *[1]"))
        else
            library.cdef(
                [[
            struct nupp_native_dl_info { const char *fname; void *fbase; const char *sname; void *saddr; };
            int dladdr(const void *, struct nupp_native_dl_info *);
            void *dlopen(const char *, int);
            ]]
            )
            local info: any = library.new("struct nupp_native_dl_info")
            if C.dladdr(address, info) ~= 0 and info.fname ~= nil then
                -- RTLD_NOW. The handle is never closed, which is the point.
                C.dlopen(info.fname, 2)
            end
        end
    end)

    return loaded
end

local function open(): any
    local wanted = os.getenv("NUPP_NATIVE_LIBRARY")
    if wanted then
        return pin(ffi.load(wanted))
    end
    local source = debug.getinfo(1, "S").source
    local root = source:match("^@(.+)/[^/]+$") or "."
    local library = ffi.os == "Windows" and "/lib/nupp_native.dll" or "/lib/nupp_native"
    for _, base in ipairs({root, root .. "/..", root .. "/../.."}) do
        local found, value = pcall(ffi.load, base .. library)
        if found then
            return pin(value)
        end
    end

    -- A compiler-owned binary links the host implementations it needs, but its
    -- selected provider may also contain sidecar-only facilities. Prefer that
    -- exact-feature provider over the necessarily partial process namespace.
    -- A standalone binary has no sidecar and falls through to its complete,
    -- statically linked provider here.
    local linked = pcall(function(): any
        return ffi.C.nuppNativeAbiVersion
    end)
    if linked then
        return ffi.C
    end

    -- Repeat the canonical location outside pcall so the loader's diagnostic is
    -- retained when neither a packaged nor a statically linked provider exists.

    return pin(ffi.load(root .. library))
end

-- The state's registry, when the debug library is present. A global alone does
-- not keep the provider loaded: code that puts `_G` back the way it found it
-- drops the library while cached symbols and handle finalizers still point
-- into it, and LuaJIT finalizes the library before a cdata finalizer collected
-- with it, so such a finalizer called into an unloaded DLL. Anchored here, both
-- live until the state closes, which runs cdata finalizers first.
local registry: any = do
    local debugLibrary: any = rawget(_G, "debug")
    yield debugLibrary and debugLibrary.getregistry and debugLibrary.getregistry() or nil
end

local function stateValue(key: string): any
    local value: any = rawget(_G, key)
    if value == nil and registry ~= nil then
        value = registry[key]
        if value ~= nil then
            rawset(_G, key, value)
        end
    end

    return value
end

local function setStateValue(key: string, value: any): nil
    rawset(_G, key, value)
    if registry ~= nil then
        registry[key] = value
    end
end

local function library(): any
    local value: any = stateValue(LIBRARY_KEY)
    if value == nil then
        local opened: any = open()
        local version = opened.nuppNativeAbiVersion()
        if version ~= ABI_VERSION then
            error(
                (
                    "nupp: Rust native ABI mismatch: runtime needs %d, provider has %s"
                ):format(ABI_VERSION, tostring(version)),
                3
            )
        end
        setStateValue(LIBRARY_KEY, opened)
        value = opened
    end

    return value
end

--- Lazily resolved versioned symbols.
--- @export
native.C = setmetatable({}, {
    __index = function(self: any, symbol: string): any
        local found = library()[symbol]
        rawset(self, symbol, found)

        return found
    end,
}) as any

--- Raises the provider's copied thread-local error for a nonzero status.
--- @export
--- @raises string when status is nonzero
function native.succeeded(status: integer, level: integer): nil
    if status ~= 0 then
        error("nupp: " .. ffi.string(native.C.nuppNativeLastError()), level)
    end
end

--- Verifies that the selected versioned provider implements one facility.
--- @export
--- @raises string when the provider lacks the feature bit
function native.requireFeature(bit: integer, name: string): nil
    if native.C.nuppNativeFeatures() & bit == 0 then
        error("nupp: the Rust native provider was built without " .. name, 3)
    end
end

--- Takes an owned byte result from the provider and releases its handle.
--- @export
--- @raises string when the result cannot be copied or released
function native.bytes(handle: any): string
    local length = ffi.new("size_t[1]")
    local status = native.C.nuppNativeBytesCopy(handle, nil, 0, length)
    local count = (tonumber(length[0]) or 0) as integer
    if count == 0 then
        local released = native.C.nuppNativeBytesRelease(handle)
        native.succeeded(status, 3)
        native.succeeded(released, 3)

        return ""
    end
    -- Capacity is the expected result of probing a nonempty value.
    if status ~= 2 then
        local released = native.C.nuppNativeBytesRelease(handle)
        native.succeeded(status, 3)
        native.succeeded(released, 3)
    end

    local buffer = ffi.new("uint8_t[?]", count)
    status = native.C.nuppNativeBytesCopy(handle, buffer, count, length)
    local released = native.C.nuppNativeBytesRelease(handle)
    native.succeeded(status, 3)
    native.succeeded(released, 3)

    return ffi.string(buffer, count)
end

----------------------------------------------------------------------------
-- Readiness
----------------------------------------------------------------------------

-- Every native family is Nupp running on its Lua state's own thread, so one
-- generation per state is what every native wait sleeps on: a family advances
-- it when something a caller could be waiting for changes, and a program
-- waiting on a socket, an HTTP response and a child at once wakes for
-- whichever moves first.
--
-- One snapshot serves every native readiness check in a pass. The first check
-- after a sleep takes it, before it looks at anything, and the next sleep
-- waits from it, so an edge any family reports after the first check of the
-- pass returns the sleep at once. A snapshot older than that only wakes the
-- sleep early, which costs one more pass and loses nothing.
--
-- The generation and the wake handle are kept with the state rather than in
-- this module, so that two copies of the module loaded into one state still
-- share them.

const windows = ffi.os == "Windows"
const READINESS_KEY = "__nuppNativeReadiness"
const WAKE_KEY = "__nuppNativeWake"

-- The names are this module's own, so they cannot collide with a provider that
-- declares the same functions under their plain names.
if windows then
    pcall(
        ffi.cdef,
        [[
    void *nupp_native_create_event(void *, int32_t, int32_t, const uint16_t *) __asm__("CreateEventW");
    int32_t nupp_native_set_event(void *) __asm__("SetEvent");
    int32_t nupp_native_close_handle(void *) __asm__("CloseHandle");
    void nupp_native_sleep(uint32_t) __asm__("Sleep");
    ]]
    )
else
    pcall(
        ffi.cdef,
        [[
    int nupp_native_pipe(int *) __asm__("pipe");
    int nupp_native_fcntl(int, int, ...) __asm__("fcntl");
    intptr_t nupp_native_write(int, const void *, size_t) __asm__("write");
    int nupp_native_close(int) __asm__("close");
    int nupp_native_poll(void *, unsigned long, int) __asm__("poll");
    ]]
    )
end
local C: any = ffi.C

local function readiness(): any
    local state: any = stateValue(READINESS_KEY)
    if state == nil then
        state = {generation = 0, snapshot = 0, taken = false}
        setStateValue(READINESS_KEY, state)
    end

    return state
end

-- Signals an open wake handle: an event set, or a byte down the pipe. A full
-- pipe is already signalled, so a refused byte loses nothing.
local function signal(cell: any): nil
    if windows then
        C.nupp_native_set_event(ffi.cast("void *", cell.handle))
    else
        C.nupp_native_write(cell.write, cell.byte, 1)
    end
end

--- Where a native readiness source runs in a pass.
--- @export
native.READINESS_PRIORITY = 20

--- Records that something a caller could be waiting for changed, and signals
--- the wake handle.
--- @export
function native.advance(): nil
    local state = readiness()
    state.generation = state.generation + 1
    local cell: any = stateValue(WAKE_KEY)
    if cell then
        signal(cell)
    end
end

--- Records the readiness generation ahead of a readiness check, unless a check
--- since the last sleep already did.
--- @export
function native.snapshot(): nil
    local state = readiness()
    if not state.taken then
        state.snapshot = state.generation
        state.taken = true
    end
end

--- Sleeps until any native family reports a change since the snapshot, or
--- `waitMs` passes. Without a snapshot it takes one and returns at once, since
--- a check has to come between the two.
--- @export
--- @param waitMs the longest sleep, in milliseconds
--- @return zero: a sleep settles nothing, the check after it does
function native.sleep(waitMs: integer): integer
    local state = readiness()
    if not state.taken then
        native.snapshot()

        return 0
    end
    state.taken = false
    -- Only this state's thread advances its generation, so nothing can move it
    -- while that thread sleeps.
    if waitMs > 0 and state.generation == state.snapshot then
        if windows then
            C.nupp_native_sleep(waitMs)
        else
            C.nupp_native_poll(nil, 0, waitMs)
        end
    end

    return 0
end

-- Opens the state's wake handle: a manual-reset event on Windows, and the
-- nonblocking, close-on-exec ends of a pipe elsewhere. Nil when the system
-- refuses one.
local function openWake(): any?
    if windows then
        local event = C.nupp_native_create_event(nil, 1, 0, nil)
        if event == nil then
            return nil
        end
        local cell: any = {handle = ffi.cast("uint64_t", ffi.cast("uintptr_t", event))}
        cell.guard = ffi.gc(ffi.new("uint8_t[1]"), function(_: any): nil
            C.nupp_native_close_handle(event)
        end)

        return cell
    end
    local ends = ffi.new("int[2]")
    if C.nupp_native_pipe(ends) ~= 0 then
        return nil
    end
    local read: integer = ends[0]
    local write: integer = ends[1]
    local F_GETFL: integer = 3
    local F_SETFL: integer = 4
    local F_SETFD: integer = 2
    local FD_CLOEXEC: integer = 1
    local O_NONBLOCK: integer = ffi.os == "OSX" and 0x4 or 0x800
    for _, descriptor in ipairs({read, write}) do
        local flags = C.nupp_native_fcntl(descriptor, F_GETFL, ffi.new("int", 0))
        if
            flags < 0
            or C.nupp_native_fcntl(descriptor, F_SETFL, ffi.new("int", flags | O_NONBLOCK)) ~= 0
            or C.nupp_native_fcntl(descriptor, F_SETFD, ffi.new("int", FD_CLOEXEC)) ~= 0
        then
            C.nupp_native_close(read)
            C.nupp_native_close(write)

            return nil
        end
    end
    local cell: any = {handle = ffi.cast("uint64_t", read), write = write, byte = ffi.new("uint8_t[1]", 1)}
    cell.guard = ffi.gc(ffi.new("uint8_t[1]"), function(_: any): nil
        C.nupp_native_close(read)
        C.nupp_native_close(write)
    end)

    return cell
end

--- The handle every readiness advance signals, for a source that sleeps on
--- operating-system handles of its own as well: a manual-reset event on
--- Windows and a nonblocking pipe's read end elsewhere, as a `uint64_t`. Reset
--- it -- `ResetEvent`, or read the pipe dry -- before `settle`. One serves the
--- whole Lua state and closes with it. Nil when the system cannot open one.
--- @export
function native.wake(): any?
    local cell: any = stateValue(WAKE_KEY)
    if cell == nil then
        cell = openWake() or false
        setStateValue(WAKE_KEY, cell)
    end
    if not cell then
        return nil
    end

    return cell.handle
end

--- Ends a pass the way `sleep` does, for a source sleeping on the `wake` handle
--- instead: called after resetting that handle, it answers whether the
--- generation still holds the snapshot's value, so that sleeping on the handle
--- cannot miss an edge. Without a snapshot it takes one and answers false,
--- since a check has to come between the two.
--- @export
--- @return whether the caller may sleep
function native.settle(): boolean
    local state = readiness()
    if not state.taken then
        native.snapshot()

        return false
    end
    state.taken = false

    return state.generation == state.snapshot
end

--- A native family's readiness pump, as the poll and wait of a suspension
--- source: the poll snapshots the generation and then checks, and the wait
--- sleeps on the generation.
---
--- ```nupp:fragment
--- context:source("nupp-files", native.READINESS_PRIORITY, native.pump(harvest))
--- ```
--- @export
--- @param check returns how many waits it settled, without blocking
--- @return the source's poll
--- @return the source's wait
function native.pump(check: function(): integer): (function(): integer, function(integer): integer)
    return function(): integer
        native.snapshot()

        return check()
    end, native.sleep
end

const AOT_RUNTIME_FEATURE = 4096

local aotRuntime: string? = nil

--- The AOT runtime's table address, as pointer-width native-endian bytes.
---
--- An LLVM-compiled Lua-builder module reaches the runtime its entries call
--- through this table rather than through symbols, and its registrar calls
--- this to find it: that keeps the module free of anything a loader would
--- have to resolve, and it lets the loaders and the host's archive
--- registration stay the same whatever the module is linked into.
--- @export
--- @raises string when the provider was built without the runtime
function native.aotRuntime(): string
    local cached = aotRuntime
    if cached ~= nil then
        return cached
    end
    native.requireFeature(AOT_RUNTIME_FEATURE, "the AOT runtime")
    ffi.cdef("const void *nuppAotRuntime(void);")
    local address = native.C.nuppAotRuntime()
    if address == nil then
        error("the AOT runtime found no Lua API in this process", 2)
    end
    local cell = ffi.new("const void *[1]", address)
    local bytes = ffi.string(cell, ffi.sizeof("void *"))
    aotRuntime = bytes

    return bytes
end

export = native
