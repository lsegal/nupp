--[[
The code generator: LLVM and lld, reached through LuaJIT's FFI.

What goes in is LLVM IR text and the options, checked here from `key=value`
form; what comes out is an object, the phase timings, and optionally the
assembly and optimized IR. The numeric-contract checks
([](nupp.compiler.aot.llvm.contract)) and the report run here too.

LLVM and lld are linked statically into one of two places, each exporting only
the `nuppcg_*` names `native/codegen/symbols` lists: a Nupp host built with
`native-codegen`, whose own process then has them, or the code generator
library `scripts/toolchain codegen-library` links, which a source checkout
stages beside its native provider. A checkout that has not built LLVM reaches a
prebuilt library instead when one is named (`NUPP_CODEGEN_LIBRARY`, or
`useLibrary`), and otherwise answers `available()` with the reason.

Most of the surface is LLVM's C API. What it lacks is reached by its mangled
C++ name: lld's drivers, run in process through `lld::lldMain`; the
`raw_fd_ostream` their messages are written to; crash recovery around a link;
and `writeArchiveToBuffer`. Import libraries come from lld-link's own `/lib
/def:` mode. Strict floating-point fusion, which the C API cannot set either, is
written into the target machine's options, found from a field beside it that
the C API does set (see `strictFusion`).
]]
module nupp.compiler.aot.llvm.codegen

local native = require("nupp.runtime.native")
local platform = require("nupp.runtime.provider.nativeplatform")

local codegen = {}

--- The code generator's own revision: part of every AOT cache key beside
--- LLVM's version, so artifacts an earlier implementation produced are not
--- taken for this one's.
const CODEGEN_VERSION = 2

const ffi: any = native.ffi

const windows = ffi.os == "Windows"

local declared = false

local function declare(): nil
    if declared then
        return
    end
    declared = true
    ffi.cdef[[
void nuppcg_LLVMGetVersion(unsigned *major, unsigned *minor, unsigned *patch);
void *nuppcg_LLVMContextCreate(void);
void nuppcg_LLVMContextDispose(void *context);
void *nuppcg_LLVMCreateMemoryBufferWithMemoryRangeCopy(const char *data, size_t length, const char *name);
int nuppcg_LLVMCreateMemoryBufferWithContentsOfFile(const char *path, void **buffer, char **message);
void nuppcg_LLVMDisposeMemoryBuffer(void *buffer);
const char *nuppcg_LLVMGetBufferStart(void *buffer);
size_t nuppcg_LLVMGetBufferSize(void *buffer);
int nuppcg_LLVMParseIRInContext2(void *context, void *buffer, void **module, char **message);
int nuppcg_LLVMVerifyModule(void *module, int action, char **message);
void nuppcg_LLVMDisposeModule(void *module);
void *nuppcg_LLVMCloneModule(void *module);
void nuppcg_LLVMSetTarget(void *module, const char *triple);
char *nuppcg_LLVMPrintModuleToString(void *module);
void nuppcg_LLVMDisposeMessage(char *message);
char *nuppcg_LLVMGetErrorMessage(void *error);
void nuppcg_LLVMDisposeErrorMessage(char *message);
int nuppcg_LLVMGetTargetFromTriple(const char *triple, void **target, char **message);
void *nuppcg_LLVMCreateTargetMachineOptions(void);
void nuppcg_LLVMDisposeTargetMachineOptions(void *options);
void nuppcg_LLVMTargetMachineOptionsSetCPU(void *options, const char *cpu);
void nuppcg_LLVMTargetMachineOptionsSetFeatures(void *options, const char *features);
void nuppcg_LLVMTargetMachineOptionsSetCodeGenOptLevel(void *options, int level);
void nuppcg_LLVMTargetMachineOptionsSetRelocMode(void *options, int mode);
void *nuppcg_LLVMCreateTargetMachineWithOptions(void *target, const char *triple, void *options);
void nuppcg_LLVMDisposeTargetMachine(void *machine);
void nuppcg_LLVMSetTargetMachineAsmVerbosity(void *machine, int verbose);
int nuppcg_LLVMTargetMachineEmitToMemoryBuffer(void *machine, void *module, int kind, char **message, void **buffer);
void *nuppcg_LLVMCreateTargetDataLayout(void *machine);
void nuppcg_LLVMSetModuleDataLayout(void *module, void *layout);
void nuppcg_LLVMDisposeTargetData(void *layout);
void *nuppcg_LLVMCreatePassBuilderOptions(void);
void nuppcg_LLVMPassBuilderOptionsSetLoopVectorization(void *options, int enable);
void nuppcg_LLVMPassBuilderOptionsSetSLPVectorization(void *options, int enable);
void nuppcg_LLVMPassBuilderOptionsSetLoopInterleaving(void *options, int enable);
void nuppcg_LLVMPassBuilderOptionsSetLoopUnrolling(void *options, int enable);
void *nuppcg_LLVMRunPasses(void *module, const char *pipeline, void *machine, void *options);
void nuppcg_LLVMDisposePassBuilderOptions(void *options);
void nuppcg_LLVMInitializeAArch64TargetInfo(void);
void nuppcg_LLVMInitializeAArch64Target(void);
void nuppcg_LLVMInitializeAArch64TargetMC(void);
void nuppcg_LLVMInitializeAArch64AsmPrinter(void);
void nuppcg_LLVMInitializeAArch64AsmParser(void);
void nuppcg_LLVMInitializeAArch64Disassembler(void);
void nuppcg_LLVMInitializeX86TargetInfo(void);
void nuppcg_LLVMInitializeX86Target(void);
void nuppcg_LLVMInitializeX86TargetMC(void);
void nuppcg_LLVMInitializeX86AsmPrinter(void);
void nuppcg_LLVMInitializeX86AsmParser(void);
void nuppcg_LLVMInitializeX86Disassembler(void);
void nuppcg_LLVMInitializeWebAssemblyTargetInfo(void);
void nuppcg_LLVMInitializeWebAssemblyTarget(void);
void nuppcg_LLVMInitializeWebAssemblyTargetMC(void);
void nuppcg_LLVMInitializeWebAssemblyAsmPrinter(void);
void nuppcg_LLVMInitializeWebAssemblyAsmParser(void);
void nuppcg_LLVMInitializeWebAssemblyDisassembler(void);

typedef struct { const char *data; size_t length; } nuppcg_StringRef;
typedef struct { const char *const *data; size_t length; } nuppcg_Arguments;
typedef struct { int32_t flavor; void *link; } nuppcg_Driver;
typedef struct { const nuppcg_Driver *data; size_t length; } nuppcg_Drivers;
typedef struct { int32_t status; bool canRunAgain; } nuppcg_LinkResult;
nuppcg_LinkResult nuppcg_lldMain(nuppcg_Arguments arguments, void *out, void *err, nuppcg_Drivers drivers);
bool nuppcg_lldCoffLink(nuppcg_Arguments arguments, void *out, void *err, bool exitEarly, bool disableOutput);
bool nuppcg_lldElfLink(nuppcg_Arguments arguments, void *out, void *err, bool exitEarly, bool disableOutput);
bool nuppcg_lldMinGWLink(nuppcg_Arguments arguments, void *out, void *err, bool exitEarly, bool disableOutput);
bool nuppcg_lldMachOLink(nuppcg_Arguments arguments, void *out, void *err, bool exitEarly, bool disableOutput);
bool nuppcg_lldWasmLink(nuppcg_Arguments arguments, void *out, void *err, bool exitEarly, bool disableOutput);
void nuppcg_crashRecoveryEnable(bool posixUtilitySignals);
void nuppcg_crashRecoveryDisable(void);
void nuppcg_rawFdOstreamOpen(void *self, nuppcg_StringRef path, void *error);
void nuppcg_rawFdOstreamClose(void *self);

typedef struct {
    void *buffer;
    nuppcg_StringRef name;
    int64_t modified;
    uint32_t uid, gid, perms;
} nuppcg_Member;
typedef struct { const nuppcg_Member *data; size_t length; } nuppcg_Members;
typedef struct { void *callback; intptr_t callable; } nuppcg_Warn;
typedef struct { void *value; uint8_t flags; uint8_t unused[23]; } nuppcg_Expected;
nuppcg_Expected nuppcg_writeArchiveToBuffer(
    nuppcg_Members members, int32_t symbolTable, int32_t kind, bool deterministic, bool thin, nuppcg_Warn warn);
]]
end

--- A place the code generator is reached through: a namespace holding the
--- `nuppcg_*` names, and where it came from.
record codegen.Backend
    C: any
    origin: string
    initialized: boolean
end

--- This process, when a host linked the code generator into it.
local linked: codegen.Backend? = nil

local probedProcess = false

--- The prebuilt library `codegen.useLibrary` named.
local fallback: string? = nil

--- Libraries already opened, by path, and why one could not be.
local opened: {[string]: codegen.Backend} = {}

local refused: {[string]: string} = {}

--- The process's own code generator, which a host built with
--- `native-codegen` carries.
local function processBackend(): codegen.Backend?
    if probedProcess then
        return linked
    end
    probedProcess = true
    declare()
    local found = pcall(function(): any
        return ffi.C.nuppcg_LLVMGetVersion
    end)
    if found then
        linked = codegen.Backend(C = ffi.C, origin = "this process", initialized = false)
    end

    return linked
end

--- A code generator library, opened for the life of the process: it is never
--- unloaded while anything it returned may still be read.
local function library(path: string): (codegen.Backend?, string?)
    if opened[path] ~= nil then
        return opened[path], nil
    end
    if refused[path] ~= nil then
        return nil, refused[path]
    end
    declare()
    local ok, answer = pcall(function(): any
        local loaded: any = ffi.load(path)
        -- Resolving one name proves the library is a code generator rather
        -- than some other shared library with the same file name.
        local _ = loaded.nuppcg_LLVMGetVersion

        return loaded
    end)
    if not ok then
        refused[path] = "cannot load the code generator " .. path .. ": " .. tostring(answer)

        return nil, refused[path]
    end
    local backend = codegen.Backend(C = answer, origin = path, initialized = false)
    opened[path] = backend

    return backend, nil
end

--- The code generator library's file name beside a native provider's: a
--- checkout stages `nupp_codegen_dev` beside `nupp_native_dev`, and a prebuilt
--- archive carries `nupp_codegen` beside `nupp_native`.
function codegen.besideProvider(providerPath: string): string?
    local directory, name = providerPath:match("^(.*[/\\])([^/\\]+)$")
    if name == nil then
        directory, name = "", providerPath
    end
    local renamed, count = (name as string):gsub("nupp_native", "nupp_codegen", 1)
    if count == 0 then
        return nil
    end

    return (directory as string) .. renamed
end

local function fileExists(path: string): boolean
    local file = io.open(path, "rb")
    if file == nil then
        return false
    end
    file:close()

    return true
end

--- The library a source checkout staged beside its native provider, when
--- there is one.
local function stagedLibrary(): string?
    local provider = os.getenv("NUPP_NATIVE_LIBRARY")
    if provider == nil or provider == "" then
        return nil
    end
    local path = codegen.besideProvider(provider as string)
    if path ~= nil and fileExists(path as string) then
        return path
    end

    return nil
end

local UNAVAILABLE = "this nupp has no LLVM code generator; run scripts/toolchain llvm and rebuild, or name a prebuilt one with NUPP_CODEGEN_LIBRARY"

--- The code generator to reach, or nil and why there is none: this process's
--- own, else the library staged beside the provider, else
--- `NUPP_CODEGEN_LIBRARY`, else the prebuilt one `codegen.useLibrary` named.
local function selected(): (codegen.Backend?, string?)
    local own = processBackend()
    if own ~= nil then
        return own, nil
    end
    local staged = stagedLibrary()
    if staged ~= nil then
        return library(staged as string)
    end
    local named = os.getenv("NUPP_CODEGEN_LIBRARY")
    if named ~= nil and named ~= "" then
        return library(named as string)
    end
    if fallback ~= nil then
        return library(fallback as string)
    end

    return nil, UNAVAILABLE
end

--- Initializes the three targets a build reaches, once per backend.
local function initialized(backend: codegen.Backend): codegen.Backend
    if not backend.initialized then
        local C: any = backend.C
        for _, target in ipairs({"AArch64", "X86", "WebAssembly"}) do
            for _, part in ipairs({"TargetInfo", "Target", "TargetMC", "AsmPrinter", "AsmParser", "Disassembler"}) do
                C["nuppcg_LLVMInitialize" .. target .. part]()
            end
        end
        backend.initialized = true
    end

    return backend
end

--- The backend, for a call that has already been told it is available.
--- @raises string when there is none
local function reach(): codegen.Backend
    local found, why = selected()
    if found == nil then
        error(why, 0)
    end

    return initialized(found as codegen.Backend)
end

--- Names a prebuilt code generator library to reach when this process has
--- none of its own.
--- @return nil, or why that library cannot serve
function codegen.useLibrary(path: string): string?
    local _, why = library(path)
    if why == nil then
        fallback = path
    end

    return why
end

--- Whether this process has the code generator, and if not, why not.
function codegen.available(): (boolean, string?)
    local found, why = selected()
    if found == nil then
        return false, why
    end

    return true, nil
end

--- `"llvm <version>; codegen <n>"`: part of every artifact's key.
--- @raises string when the code generator is unavailable
function codegen.version(): string
    local backend = reach()
    local parts: any = ffi.new("unsigned[3]")
    backend.C.nuppcg_LLVMGetVersion(parts, parts + 1, parts + 2)

    return (
        "llvm %d.%d.%d; codegen %d"
    ):format(
        tonumber(parts[0]) as integer,
        tonumber(parts[1]) as integer,
        tonumber(parts[2]) as integer,
        CODEGEN_VERSION
    )
end

--- Takes a message LLVM allocated with `malloc`, and frees it.
local function message(C: any, slot: any): string
    local text: any = slot[0]
    slot[0] = nil
    if text == nil then
        return ""
    end
    local copied = ffi.string(text)
    C.nuppcg_LLVMDisposeMessage(text)

    return copied
end

--- Takes an `LLVMErrorRef`'s message, consuming the error.
local function errorText(C: any, err: any): string
    local text: any = C.nuppcg_LLVMGetErrorMessage(err)
    local copied = ffi.string(text)
    C.nuppcg_LLVMDisposeErrorMessage(text)

    return copied
end

--- A memory buffer's bytes, after which the buffer is disposed.
local function drain(C: any, buffer: any): string
    local bytes = ffi.string(C.nuppcg_LLVMGetBufferStart(buffer), C.nuppcg_LLVMGetBufferSize(buffer))
    C.nuppcg_LLVMDisposeMemoryBuffer(buffer)

    return bytes
end

--- `FPOpFusion::Standard` and `FPOpFusion::Strict`.
const FUSION_STANDARD = 1

const FUSION_STRICT = 2

--- How far into a target machine its options are searched for. They are a
--- member of the `TargetMachine` base class, so where they sit does not depend
--- on the target; in LLVM 23 `MCOptions` begins about 1400 bytes in. A layout that
--- moved past the window is refused rather than read further.
const OPTIONS_WINDOW = 2048

local regionDeclared = false

local probeDeclared = false

--- How much of the window from `base` is readable on Linux and macOS. The page
--- holding the machine is; each page after it is offered to `write` on a pipe,
--- which fails with `EFAULT` instead of faulting when a page is unmapped or
--- unreadable. `msync` would only say whether a page is mapped, and a guard
--- page is mapped but faults when read.
local function readableWindow(base: any): integer
    if not probeDeclared then
        probeDeclared = true
        ffi.cdef[[
int nuppcg_getpagesize(void) __asm__("getpagesize");
int nuppcg_pipe(int fds[2]) __asm__("pipe");
intptr_t nuppcg_write(int fd, const void *bytes, size_t count) __asm__("write");
intptr_t nuppcg_read(int fd, void *bytes, size_t count) __asm__("read");
int nuppcg_close(int fd) __asm__("close");
]]
    end
    local C: any = ffi.C
    local fds: any = ffi.new("int[2]")
    if C.nuppcg_pipe(fds) ~= 0 then
        return OPTIONS_WINDOW
    end
    local page = tonumber(C.nuppcg_getpagesize()) as integer
    local byte: any = ffi.new("uint8_t[1]")
    local into = tonumber(ffi.cast("uintptr_t", base) % page) as integer
    local readable: integer = OPTIONS_WINDOW
    for offset = page - into, OPTIONS_WINDOW - 1, page do
        if C.nuppcg_write(fds[1], base + offset, 1) ~= 1 then
            readable = offset
            break
        end
        C.nuppcg_read(fds[0], byte, 1)
    end
    C.nuppcg_close(fds[0])
    C.nuppcg_close(fds[1])

    return readable
end

--- How much of the window from `base` is mapped. A target machine is smaller
--- than the window, and the heap can place one at the very end of a region,
--- where reading the whole window runs into an unmapped page (#219, #228). On
--- Windows `VirtualQuery` says where the region holding the machine ends, and
--- the machine itself always lies inside it.
function codegen.mappedWindow(base: any): integer
    if not windows then
        return readableWindow(ffi.cast("uint8_t *", base))
    end
    if not regionDeclared then
        regionDeclared = true
        ffi.cdef[[
typedef struct {
    void *base;
    void *allocationBase;
    uint32_t allocationProtect;
    uint16_t partition;
    size_t size;
    uint32_t state, protect, type;
} nuppcg_MemoryRegion;
size_t nuppcg_VirtualQuery(const void *address, nuppcg_MemoryRegion *region, size_t length) __asm__("VirtualQuery");
]]
    end
    local region: any = ffi.new("nuppcg_MemoryRegion")
    if ffi.C.nuppcg_VirtualQuery(base, region, ffi.sizeof(region)) == 0 then
        return OPTIONS_WINDOW
    end
    local start: any = ffi.cast("uint8_t *", region.base)
    local left = tonumber(start + region.size - base) as integer

    return math.min(OPTIONS_WINDOW, left)
end

--- Sets a target machine's `Options.AllowFPOpFusion` to `Strict`: no
--- multiply-add is formed except where an instruction's own `contract` flag
--- allows it, which Nupp emits only inside `@relax("fp-contract")` functions.
---
--- The C API has no setter for it, so the field is found. `MCOptions.AsmVerbose`
--- is a field the C API does set, and the only byte of the machine that
--- `LLVMSetTargetMachineAsmVerbosity` changes; it is bit 3 of the second byte of
--- `MCOptions`. In `TargetOptions` the 32-bit enums `FloatABIType`,
--- `AllowFPOpFusion`, `ThreadModel`, `EABIVersion`, `DebuggerTuning`, `VecLib`
--- and `ExceptionModel` run, in that order, up to `MCOptions`, after a
--- `std::string` whose size depends on the C++ standard library but whose end
--- is 8-aligned either way; so the fusion mode sits 24 bytes before
--- `MCOptions` whichever library LLVM was built with. The defaults around it
--- are checked before it is written, so a repinned LLVM whose layout moved is
--- refused rather than written into.
--- @return nil, or why the field could not be found
local function strictFusion(C: any, machine: any): string?
    local base: any = ffi.cast("uint8_t *", machine)
    local window = codegen.mappedWindow(base)
    local before: any = ffi.new("uint8_t[?]", window)
    ffi.copy(before, base, window)
    C.nuppcg_LLVMSetTargetMachineAsmVerbosity(machine, 0)
    local quiet: any = ffi.new("uint8_t[?]", window)
    ffi.copy(quiet, base, window)
    C.nuppcg_LLVMSetTargetMachineAsmVerbosity(machine, 1)
    local changed: integer? = nil
    for offset = 0, window - 1 do
        if base[offset] ~= quiet[offset] then
            local flipped = (tonumber(base[offset]) as integer) ~ (tonumber(quiet[offset]) as integer)
            if changed ~= nil or flipped ~= 8 then
                return "the target machine's assembly-verbosity flag is not where this LLVM keeps it"
            end
            changed = offset
        end
    end
    if changed == nil or (changed as integer) < 32 then
        return "the target machine's assembly-verbosity flag did not move"
    end
    -- The probe leaves the flag as the machine was created with it, so a
    -- listing reads as it always has.
    local verbose = (tonumber(before[changed as integer]) as integer) & 8 ~= 0
    C.nuppcg_LLVMSetTargetMachineAsmVerbosity(machine, verbose and 1 or 0)
    local options: any = ffi.cast("int32_t *", base + (changed as integer) - 1 - 28)
    -- FloatABI::Default, FPOpFusion::Standard, ThreadModel::POSIX, EABI::Default.
    if options[0] ~= 0 or options[1] ~= FUSION_STANDARD or options[2] ~= 0 or options[3] ~= 1 then
        return "the target machine's floating-point options are not where this LLVM keeps them"
    end
    options[1] = FUSION_STRICT

    return nil
end

--- `LLVMCodeGenLevelNone` .. `LLVMCodeGenLevelAggressive`, and `LLVMRelocPIC`.
const RELOC_PIC = 2

--- `LLVMAssemblyFile` and `LLVMObjectFile`.
const ASSEMBLY_FILE = 0

const OBJECT_FILE = 1

--- `LLVMReturnStatusAction`.
const RETURN_STATUS = 2

--- What a compile is for. `triple` is the LLVM code-generation triple (never
--- a public Nupp platform name); `cpu` and `features` are the module's
--- baseline, which per-function `"target-cpu"`/`"target-features"` attributes
--- override for tiered functions.
record codegen.Options
    triple: string
    cpu: string
    features: string

    --- 0-3: `default<O0>` .. `default<O3>`, and the matching code-generation level.
    opt: integer

    --- Also return the assembly listing (a second code generation).
    assembly: boolean

    --- Also return the optimized IR.
    optimizedIr: boolean

    --- Run the numeric-contract checks over the optimized IR, and over the
    --- assembly when it is produced.
    verify: boolean
end

--- What one compile produced: the object, the assembly and optimized IR when
--- they were asked for, and microseconds spent parsing, optimizing and
--- generating code.
local record Output
    object: string
    assembly: string?
    optimizedIr: string?
    timings: {number}
end

--- Microseconds since `started`, a reading of the monotonic clock.
local function since(started: uint64): number
    return (tonumber(platform.monotonic() - started) as number) / 1000
end

--- A target machine for `options`, with strict floating-point fusion.
--- @raises string when the target or its machine cannot be had
local function targetMachine(C: any, options: codegen.Options): any
    local target: any = ffi.new("void *[1]")
    local err: any = ffi.new("char *[1]")
    if C.nuppcg_LLVMGetTargetFromTriple(options.triple, target, err) ~= 0 then
        error("target " .. options.triple .. ": " .. message(C, err), 0)
    end
    local settings: any = C.nuppcg_LLVMCreateTargetMachineOptions()
    C.nuppcg_LLVMTargetMachineOptionsSetCPU(settings, options.cpu)
    C.nuppcg_LLVMTargetMachineOptionsSetFeatures(settings, options.features)
    C.nuppcg_LLVMTargetMachineOptionsSetCodeGenOptLevel(settings, options.opt)
    C.nuppcg_LLVMTargetMachineOptionsSetRelocMode(settings, RELOC_PIC)
    local machine: any = C.nuppcg_LLVMCreateTargetMachineWithOptions(target[0], options.triple, settings)
    C.nuppcg_LLVMDisposeTargetMachineOptions(settings)
    if machine == nil then
        error("cannot create a target machine for " .. options.triple, 0)
    end
    local refusal = strictFusion(C, machine)
    if refusal ~= nil then
        C.nuppcg_LLVMDisposeTargetMachine(machine)
        error("cannot set strict floating-point fusion: " .. refusal, 0)
    end

    return machine
end

--- Emits a module as an object or an assembly listing. Code generation
--- rewrites IR (CodeGenPrepare), so it works on a copy and the module can be
--- emitted again.
--- @raises string when code generation fails
local function emit(C: any, machine: any, module: any, kind: integer): string
    local copy: any = C.nuppcg_LLVMCloneModule(module)
    local err: any = ffi.new("char *[1]")
    local buffer: any = ffi.new("void *[1]")
    local failed = C.nuppcg_LLVMTargetMachineEmitToMemoryBuffer(machine, copy, kind, err, buffer) ~= 0
    C.nuppcg_LLVMDisposeModule(copy)
    if failed then
        error("code generation: " .. message(C, err), 0)
    end

    return drain(C, buffer[0])
end

--- Compiles one module of LLVM IR text: parsed and verified, given the
--- target's triple and data layout (the emitter names neither, so one text
--- serves every target), optimized with `default<O{opt}>`, then emitted.
--- @raises string when any phase fails
local function compileModule(
    backend: codegen.Backend,
    ir: string,
    name: string,
    options: codegen.Options,
    wantAssembly: boolean,
    wantOptimizedIr: boolean
): Output
    local C: any = backend.C
    local machine: any = targetMachine(C, options)
    local context: any = C.nuppcg_LLVMContextCreate()
    local module: any = nil
    local ok, result = pcall(function(): Output
        local started = platform.monotonic()
        local buffer: any = C.nuppcg_LLVMCreateMemoryBufferWithMemoryRangeCopy(ir, #ir, name)
        local parsed: any = ffi.new("void *[1]")
        local err: any = ffi.new("char *[1]")
        -- Borrows the buffer, which is disposed here either way.
        local failed = C.nuppcg_LLVMParseIRInContext2(context, buffer, parsed, err) ~= 0
        C.nuppcg_LLVMDisposeMemoryBuffer(buffer)
        if failed then
            error(name .. ": " .. message(C, err), 0)
        end
        module = parsed[0]
        local invalid = C.nuppcg_LLVMVerifyModule(module, RETURN_STATUS, err) ~= 0
        local why = message(C, err)
        if invalid then
            error(name .. ": invalid IR: " .. why, 0)
        end
        C.nuppcg_LLVMSetTarget(module, options.triple)
        local layout: any = C.nuppcg_LLVMCreateTargetDataLayout(machine)
        C.nuppcg_LLVMSetModuleDataLayout(module, layout)
        C.nuppcg_LLVMDisposeTargetData(layout)
        local parsing = since(started)

        started = platform.monotonic()
        local passes: any = C.nuppcg_LLVMCreatePassBuilderOptions()
        local vectorize = options.opt >= 2 and 1 or 0
        C.nuppcg_LLVMPassBuilderOptionsSetLoopVectorization(passes, vectorize)
        C.nuppcg_LLVMPassBuilderOptionsSetSLPVectorization(passes, vectorize)
        C.nuppcg_LLVMPassBuilderOptionsSetLoopInterleaving(passes, vectorize)
        C.nuppcg_LLVMPassBuilderOptionsSetLoopUnrolling(passes, vectorize)
        local problem: any = C.nuppcg_LLVMRunPasses(module, ("default<O%d>"):format(options.opt), machine, passes)
        C.nuppcg_LLVMDisposePassBuilderOptions(passes)
        if problem ~= nil then
            error("optimization: " .. errorText(C, problem), 0)
        end
        local optimizing = since(started)
        local optimizedIr: string? = nil
        if wantOptimizedIr then
            local printed: any = ffi.new("char *[1]")
            printed[0] = C.nuppcg_LLVMPrintModuleToString(module)
            optimizedIr = message(C, printed)
        end

        started = platform.monotonic()
        local object = emit(C, machine, module, OBJECT_FILE)
        local generating = since(started)
        local assembly: string? = wantAssembly and emit(C, machine, module, ASSEMBLY_FILE) or nil

        return Output(
            object = object,
            assembly = assembly,
            optimizedIr = optimizedIr,
            timings = {parsing, optimizing, generating}
        )
    end)
    if module ~= nil then
        C.nuppcg_LLVMDisposeModule(module)
    end
    C.nuppcg_LLVMContextDispose(context)
    C.nuppcg_LLVMDisposeTargetMachine(machine)
    if not ok then
        error(result, 0)
    end

    return result as Output
end

--- A compiled module.
record codegen.Compiled
    object: string
    report: string
    assembly: string?
    optimizedIr: string?
end

--- Reads `key=value` lines: triple, cpu, features, opt, assembly,
--- optimized-ir, verify. Unknown keys are refused.
--- @return the options, or nil and why they are refused
function codegen.parseOptions(text: string): (codegen.Options?, string?)
    local options = codegen.Options(
        triple = "",
        cpu = "",
        features = "",
        opt = 3,
        assembly = false,
        optimizedIr = false,
        verify = false
    )
    for raw in (text .. "\n"):gmatch("([^\n]*)\n") do
        local line = (raw:match("^%s*(.-)%s*$")) as string
        if line ~= "" then
            local key, value = line:match("^([^=]*)=(.*)$")
            if key == nil then
                return nil, ("codegen option `%s` has no `=`"):format(line)
            end
            local flag = value == "1" or value == "true"
            if key == "triple" then
                options.triple = value as string
            elseif key == "cpu" then
                options.cpu = value as string
            elseif key == "features" then
                options.features = value as string
            elseif key == "opt" then
                local level = (value as string):match("^%d+$") and tonumber(value) or nil
                if level == nil or level > 3 then
                    return nil, ("codegen opt `%s` is not 0-3"):format(value)
                end
                options.opt = level as integer
            elseif key == "assembly" then
                options.assembly = flag
            elseif key == "optimized-ir" then
                options.optimizedIr = flag
            elseif key == "verify" then
                options.verify = flag
            else
                return nil, ("unknown codegen option `%s`"):format(key)
            end
        end
    end
    if options.triple == "" then
        return nil, "codegen options name no triple"
    end

    return options, nil
end

--- A plain-text report of one compile: its phase timings in microseconds,
--- the object's size, then one contract violation per line.
function codegen.report(timings: {number}, objectBytes: integer, violations: {string}): string
    local lines: {
        string
    } = {
        (
            "parse-us=%.0f\noptimize-us=%.0f\ncodegen-us=%.0f\nobject-bytes=%d\n"
        ):format(timings[1] or 0, timings[2] or 0, timings[3] or 0, objectBytes),
    }
    for _, violation in ipairs(violations) do
        lines[#lines + 1] = "violation=" .. violation:gsub("\n", " ") .. "\n"
    end

    return table.concat(lines)
end

--- The contract violations in a compile's optimized IR and assembly.
local function violations(optimizedIr: string, assembly: string?): {string}
    local contract = require("nupp.compiler.aot.llvm.contract")
    local found = contract.ir(optimizedIr)
    if assembly ~= nil then
        for _, violation in ipairs(contract.fusedInstructions(assembly as string, optimizedIr)) do
            found[#found + 1] = violation
        end
    end

    return found
end

--- `key=value` lines from an options table, in a stable order.
local function optionText(options: {[string]: string}): string
    local keys: {string} = {}
    for key in pairs(options) do
        keys[#keys + 1] = key
    end
    table.sort(keys)
    local lines: {string} = {}
    for _, key in ipairs(keys) do
        lines[#lines + 1] = key .. "=" .. (options[key] as string)
    end

    return table.concat(lines, "\n")
end

--- The checked options an options table names.
--- @raises string when the options are refused
local function checkedOptions(options: {[string]: string}): codegen.Options
    local parsed, err = codegen.parseOptions(optionText(options))
    if parsed == nil then
        error(err, 0)
    end

    return parsed as codegen.Options
end

--- Compiles LLVM IR text. Options: `triple` (required), `cpu`, `features`,
--- `opt` (0-3), `assembly`, `optimized-ir`, `verify` ("1" to enable).
--- Verifying needs the optimized IR, and the assembly when it is asked for;
--- outputs nobody keeps are produced only to verify.
--- @return the compiled module, or nil and why not
function codegen.compile(ir: string, name: string, options: {[string]: string}): (codegen.Compiled?, string?)
    local ok, result = pcall(function(): codegen.Compiled
        local checked = checkedOptions(options)
        local backend = reach()
        local output = compileModule(
            backend,
            ir,
            name,
            checked,
            checked.assembly,
            checked.optimizedIr or checked.verify
        )
        local found: {string} = checked.verify and violations(output.optimizedIr or "", output.assembly) or {}

        return codegen.Compiled(
            object = output.object,
            report = codegen.report(output.timings, #output.object, found),
            assembly = output.assembly,
            optimizedIr = checked.optimizedIr and output.optimizedIr or nil
        )
    end)
    if not ok then
        return nil, tostring(result)
    end

    return result as codegen.Compiled, nil
end

--- A module `codegen.compileFiles` compiles.
record codegen.Job
    ir: string
    object: string
    options: {[string]: string}
end

--- A job's outcome: its report, or why it failed.
record codegen.Outcome
    report: string?
    error: string?
end

local function readFile(path: string): string?
    local file = io.open(path, "rb")
    if file == nil then
        return nil
    end
    local text = file:read("*a") as string
    file:close()

    return text
end

local function writeFile(path: string, contents: string): string?
    local file, err = io.open(path, "wb")
    if file == nil then
        return "cannot write " .. path .. ": " .. tostring(err)
    end
    file:write(contents)
    file:close()

    return nil
end

--- Reads and removes a file a compile job wrote beside its object.
local function consume(path: string): string?
    local text = readFile(path)
    if text ~= nil then
        os.remove(path)
    end

    return text
end

--- Compiles one job here: its object, and its optimized IR and assembly beside
--- it as `.ll` and `.s` when it verifies; answers the phase timings.
--- @raises string when the job fails
local function runJob(backend: codegen.Backend, job: codegen.Job, options: codegen.Options): {number}
    local ir = readFile(job.ir)
    if ir == nil then
        error("cannot read " .. job.ir, 0)
    end
    local output = compileModule(
        backend,
        ir as string,
        job.ir,
        options,
        options.assembly and options.verify,
        options.verify
    )
    local err = writeFile(job.object, output.object)
    if err ~= nil then
        error(err, 0)
    end
    for _, pair in ipairs({{output.optimizedIr, ".ll"}, {output.assembly, ".s"}}) do
        if pair[1] ~= nil then
            err = writeFile(job.object .. (pair[2] as string), pair[1] as string)
            if err ~= nil then
                error(err, 0)
            end
        end
    end

    return output.timings
end

local posixDeclared = false

local function declarePosix(): nil
    if posixDeclared then
        return
    end
    posixDeclared = true
    ffi.cdef[[
int nuppcg_fork(void) __asm__("fork");
int nuppcg_waitpid(int pid, int *status, int options) __asm__("waitpid");
void nuppcg_exit(int status) __asm__("_exit");
int nuppcg_dup2(int from, int to) __asm__("dup2");
int nuppcg_creat(const char *path, unsigned int mode) __asm__("creat");
int nuppcg_close(int fd) __asm__("close");
]]
end

--- `waitpid` answers at once for a child that has not exited (the same
--- value on Linux and macOS).
const WNOHANG = 1

--- A job's timings as the text a forked child writes, and back.
local function timingText(timings: {number}): string
    return ("%s %s %s"):format(tostring(timings[1]), tostring(timings[2]), tostring(timings[3]))
end

local function timingsOf(text: string): {number}
    local out: {number} = {}
    for number in text:gmatch("%S+") do
        out[#out + 1] = tonumber(number) or 0
    end

    return out
end

--- An object file's size in bytes, or zero when it cannot be read.
local function fileSize(path: string): integer
    local file = io.open(path, "rb")
    if file == nil then
        return 0
    end
    local size = file:seek("end") as integer
    file:close()

    return size
end

--- Compiles every job in a child process of its own, at most `width` at a
--- time. LLVM ends a process on an internal error (`report_fatal_error`, a
--- failed assertion in legalization), and the process is the user's `nupp`; a
--- child that dies instead is that one module's error, carrying what LLVM
--- printed. Children run side by side, which is also what makes a build's units
--- compile in parallel.
---
--- A child touches nothing but LLVM, the files it writes and the allocator,
--- and nothing else in `nupp` uses LLVM from another thread, so no lock LLVM
--- needs can be held by a thread the fork left behind.
local function forked(
    backend: codegen.Backend,
    jobs: {codegen.Job},
    checked: {codegen.Options},
    width: integer
): {{string}}
    declarePosix()
    local C: any = ffi.C
    local results: {[integer]: {string}} = {}
    local running: {[integer]: integer} = {}
    local runningCount: integer = 0
    local nextJob: integer = 1
    local status: any = ffi.new("int[1]")
    while nextJob <= #jobs or runningCount > 0 do
        while nextJob <= #jobs and runningCount < width do
            local job = jobs[nextJob]
            os.remove(job.object .. ".report")
            local errors = C.nuppcg_creat(job.object .. ".stderr", tonumber("644", 8) as integer)
            local pid = C.nuppcg_fork()
            if pid == 0 then
                -- The child: its diagnostics go to its own file, and it leaves
                -- with `_exit`, running nothing the parent registered.
                if errors >= 0 then
                    C.nuppcg_dup2(errors, 2)
                end
                local ok, answer = pcall(runJob, backend, job, checked[nextJob])
                local text = ok and timingText(answer as {number}) or tostring(answer)
                writeFile(job.object .. ".report", text)
                C.nuppcg_exit(ok and 0 or 1)
            end
            if errors >= 0 then
                C.nuppcg_close(errors)
            end
            if pid < 0 then
                local ok, answer = pcall(runJob, backend, job, checked[nextJob])
                results[nextJob] = ok and {"ok", timingText(answer as {number})} or {"error", tostring(answer)}
                os.remove(job.object .. ".stderr")
            else
                running[pid] = nextJob
                runningCount = runningCount + 1
            end
            nextJob = nextJob + 1
        end
        if runningCount > 0 then
            -- Only these children, each by its pid: nupp has children of its
            -- own (the comptime worker service, processes a program starts),
            -- and reaping one of theirs, as waiting for any child would, leaves
            -- its owner waiting for an exit it will never see.
            local finished: integer? = nil
            local lost = false
            while finished == nil do
                for pid in pairs(running) do
                    local answer = C.nuppcg_waitpid(pid, status, WNOHANG)
                    if answer == pid then
                        finished = pid
                        break
                    end
                    if answer < 0 then
                        -- Not waitable any more; judged by what it wrote below.
                        finished = pid
                        lost = true
                        break
                    end
                end
                if finished == nil then
                    platform.sleep(2)
                end
            end
            local index = running[finished as integer] as integer
            running[finished as integer] = nil
            runningCount = runningCount - 1
            local job = jobs[index]
            local report = consume(job.object .. ".report") or ""
            local printed = consume(job.object .. ".stderr") or ""
            local code = tonumber(status[0]) as integer
            if lost then
                results[index] = report ~= "" and {"ok", report}
                    or {"error", "the process compiling " .. job.ir .. " could not be waited for"}
            elseif code & 0x7f == 0 then
                results[index] = (code >> 8) & 0xff == 0 and {"ok", report} or {"error", report}
            else
                local said = (printed:match("^%s*(.-)%s*$")) as string
                results[
                    index
                ] = {
                    "error",
                    (
                        "LLVM stopped compiling %s (signal %d)%s"
                    ):format(job.ir, code & 0x7f, said == "" and "" or ": " .. said),
                }
            end
        end
    end
    local ordered: {{string}} = {}
    for index = 1, #jobs do
        ordered[index] = results[index] or {"error", "not compiled"}
    end

    return ordered
end

--- Compiles IR files to objects, `width` at a time, each where LLVM's
--- ending the process on an internal error ends only that job: a job that
--- crashes is an outcome with an error, and the build goes on to report it.
--- Without `fork` (Windows) the jobs run here, one after another. A job that
--- verifies has its optimized IR and assembly written beside its object as
--- `.ll` and `.s`, which are checked here and then removed.
--- @return one outcome per job, in order, or nil and why none ran
function codegen.compileFiles(jobs: {codegen.Job}, width: integer): ({codegen.Outcome}?, string?)
    local ok, result = pcall(function(): {codegen.Outcome}
        local checked: {codegen.Options} = {}
        for position, job in ipairs(jobs) do
            checked[position] = checkedOptions(job.options)
        end
        local backend = reach()
        local answers: {{string}} = {}
        if windows then
            for position, job in ipairs(jobs) do
                local done, answer = pcall(runJob, backend, job, checked[position])
                answers[position] = done and {"ok", timingText(answer as {number})} or {"error", tostring(answer)}
            end
        else
            answers = forked(backend, jobs, checked, math.max(width, 1))
        end
        local outcomes: {codegen.Outcome} = {}
        for position, job in ipairs(jobs) do
            local optimizedIr = consume(job.object .. ".ll")
            local listing = consume(job.object .. ".s")
            local answer = answers[position]
            if answer[1] == "ok" then
                local options = checked[position]
                local found = options.verify and violations(optimizedIr or "", listing) or {}
                local report = codegen.report(timingsOf(answer[2] as string), fileSize(job.object), found)
                outcomes[position] = codegen.Outcome(report = report, error = nil)
            else
                outcomes[position] = codegen.Outcome(report = nil, error = answer[2])
            end
        end

        return outcomes
    end)
    if not ok then
        return nil, tostring(result)
    end

    return result as {codegen.Outcome}, nil
end

--- Whether this process has run a lld whose state it cannot shed on the way
--- out. On a Windows host an ELF, Mach-O or Wasm link leaves the process unable
--- to exit through its static destructors (#71); `lld-link` with one thread
--- does not.
local unexitable = false

local windowsDeclared = false

--- Ends this process with `code` when a link left it unable to exit through
--- its static destructors, which on a Windows host an ELF, Mach-O or Wasm link
--- does; returns otherwise. The process's own buffered output is flushed
--- first, since nothing after this runs.
function codegen.endIfUnexitable(code: integer): nil
    if not unexitable then
        return
    end
    io.stdout:flush()
    io.stderr:flush()
    if not windowsDeclared then
        windowsDeclared = true
        ffi.cdef[[
void *nuppcg_GetCurrentProcess(void) __asm__("GetCurrentProcess");
int nuppcg_TerminateProcess(void *process, unsigned int code) __asm__("TerminateProcess");
]]
    end
    local C: any = ffi.C
    C.nuppcg_TerminateProcess(C.nuppcg_GetCurrentProcess(), code)
end

--- lld's `Flavor` enumerators, in lld/Common/Driver.h's order.
const FLAVOR_GNU = 1

const FLAVOR_MINGW = 2

const FLAVOR_WINLINK = 3

const FLAVOR_DARWIN = 4

const FLAVOR_WASM = 5

--- Room for an `llvm::raw_fd_ostream`, far more than any standard library
--- lays one out in.
const STREAM_BYTES = 1024

--- Runs lld in process with `argv`, returning its status and everything it
--- printed. lld ends a fatal error through `Process::Exit`, which returns to
--- lldMain's recovery context only while crash recovery is enabled; otherwise
--- it ends nupp, silently. It is enabled for the link alone, so the handlers it
--- installs are the process's own again afterwards.
--- @raises string when lld's message stream cannot be opened
local function runLld(backend: codegen.Backend, argv: {string}): (integer, string)
    local C: any = backend.C
    local path = require("nupp.compiler.process").tmpname()
    local stream: any = ffi.new("uint64_t[?]", STREAM_BYTES // 8)
    local status: any = ffi.new("uint64_t[4]")
    C.nuppcg_rawFdOstreamOpen(stream, ffi.new("nuppcg_StringRef", path, #path), status)
    local opened: any = ffi.cast("int32_t *", status)
    if opened[0] ~= 0 then
        C.nuppcg_rawFdOstreamClose(stream)
        os.remove(path)
        error("cannot open " .. path .. " for lld's messages", 0)
    end
    local arguments: any = ffi.new("const char *[?]", #argv)
    for position, argument in ipairs(argv) do
        arguments[position - 1] = argument
    end
    local drivers: any = ffi.new("nuppcg_Driver[5]", {
        {FLAVOR_WINLINK, ffi.cast("void *", C.nuppcg_lldCoffLink)},
        {FLAVOR_GNU, ffi.cast("void *", C.nuppcg_lldElfLink)},
        {FLAVOR_MINGW, ffi.cast("void *", C.nuppcg_lldMinGWLink)},
        {FLAVOR_DARWIN, ffi.cast("void *", C.nuppcg_lldMachOLink)},
        {FLAVOR_WASM, ffi.cast("void *", C.nuppcg_lldWasmLink)},
    })
    C.nuppcg_crashRecoveryEnable(false)
    local result: any = C.nuppcg_lldMain(
        ffi.new("nuppcg_Arguments", arguments, #argv),
        stream,
        stream,
        ffi.new("nuppcg_Drivers", drivers, 5)
    )
    C.nuppcg_crashRecoveryDisable()
    -- Closing flushes the stream into the file.
    C.nuppcg_rawFdOstreamClose(stream)
    local text = readFile(path) or ""
    os.remove(path)
    local code = tonumber(result.status) as integer
    if code ~= 0 and text == "" then
        text = ("lld stopped with status %d and no message"):format(code)
    end

    return code, text
end

--- Runs lld in process. `argv[1]` picks the flavor: `ld64.lld`, `ld.lld`,
--- `lld-link`, `wasm-ld`.
---
--- On a Windows host lld links with one thread. Its parallel executor is a
--- static that only `llvm_shutdown` stops, which a lld of its own calls on the
--- way out and nupp never does; left running, its destructor joins threads the
--- process exit has already ended, and nupp never exits.
--- @return lld's messages on success, or nil and the failure
function codegen.link(argv: {string}): (string?, string?)
    local ok, result = pcall(function(): string
        local backend = reach()
        local arguments: {string} = {}
        for position, argument in ipairs(argv) do
            arguments[position] = argument
        end
        if windows then
            arguments[#arguments + 1] = argv[1] == "lld-link" and "/threads:1" or "--threads=1"
            if argv[1] ~= "lld-link" then
                unexitable = true
            end
        end
        local code, text = runLld(backend, arguments)
        if code ~= 0 then
            error(("lld exited %d: %s"):format(code, (text:match("^%s*(.-)%s*$")) as string), 0)
        end

        return text
    end)
    if not ok then
        return nil, tostring(result)
    end

    return result as string, nil
end

--- Writes a MinGW import library naming `dll` as the provider of `names`;
--- an entry `{name, export}` imports `name` under `export`. lld-link's
--- librarian mode writes it from a module-definition file.
--- @return nil, or why it could not be written
function codegen.importLibrary(dll: string, path: string, names: {{string}}): string?
    local ok, err = pcall(function(): nil
        local backend = reach()
        local lines = {"LIBRARY " .. dll, "EXPORTS"}
        for _, entry in ipairs(names) do
            lines[#lines + 1] = entry[2] ~= nil and "    " .. entry[1] .. "=" .. entry[2] or "    " .. entry[1]
        end
        local definitions = path .. ".def"
        local wrote = writeFile(definitions, table.concat(lines, "\n") .. "\n")
        if wrote ~= nil then
            error(wrote, 0)
        end
        local code, text = runLld(backend, {
            "lld-link",
            "/lib",
            "/machine:x64",
            "/def:" .. definitions,
            "/out:" .. path
        })
        os.remove(definitions)
        if code ~= 0 then
            error(("import library %s: %s"):format(path, (text:match("^%s*(.-)%s*$")) as string), 0)
        end
    end)
    if not ok then
        return tostring(err)
    end

    return nil
end

--- The archive formats `codegen.archive` writes, as `object::Archive::Kind`.
const ARCHIVE: {[string]: integer} = {gnu = 0, bsd = 2, darwin = 3, coff = 5}

--- `SymtabWritingMode::NormalSymtab`.
const NORMAL_SYMBOL_TABLE = 1

--- Writes the indexed static archive `path` of `members` in `format`:
--- `gnu`, `bsd`, `darwin` or `coff`. Deterministic: no times, owners or modes,
--- so equal members give equal bytes.
--- @return nil, or why it could not be written
function codegen.archive(path: string, members: {string}, format: string): string?
    local ok, err = pcall(function(): nil
        local backend = reach()
        local C: any = backend.C
        local entries: any = ffi.new("nuppcg_Member[?]", #members)
        local names: {string} = {}
        local loaded = 0
        local problem: string? = nil
        for position, member in ipairs(members) do
            local buffer: any = ffi.new("void *[1]")
            local why: any = ffi.new("char *[1]")
            if C.nuppcg_LLVMCreateMemoryBufferWithContentsOfFile(member, buffer, why) ~= 0 then
                problem = member .. ": " .. message(C, why)
                break
            end
            local name = (member:match("([^/\\]+)$") or member) as string
            names[position] = name
            local entry: any = entries[position - 1]
            entry.buffer = buffer[0]
            entry.name.data = name
            entry.name.length = #name
            entry.modified = 0
            entry.uid = 0
            entry.gid = 0
            entry.perms = tonumber("644", 8)
            loaded = position
        end
        local bytes: string? = nil
        if problem == nil then
            local warnings: {string} = {}
            -- A warning arrives as an `Error` passed by reference; taking its
            -- payload leaves the caller's copy nothing to destroy.
            local warn: any = ffi.cast("void (*)(intptr_t, void *)", function(_: any, raised: any): nil
                local slot: any = ffi.cast("void **", raised)
                local payload: any = slot[0]
                slot[0] = nil
                if payload ~= nil then
                    warnings[#warnings + 1] = errorText(C, payload)
                end
            end)
            local result: any = C.nuppcg_writeArchiveToBuffer(
                ffi.new("nuppcg_Members", entries, #members),
                NORMAL_SYMBOL_TABLE,
                ARCHIVE[format] or 0,
                true,
                false,
                ffi.new("nuppcg_Warn", ffi.cast("void *", warn), 0)
            )
            warn:free()
            if result.flags & 1 ~= 0 then
                problem = errorText(C, result.value)
            elseif #warnings > 0 then
                C.nuppcg_LLVMDisposeMemoryBuffer(result.value)
                problem = table.concat(warnings, "; ")
            else
                bytes = drain(C, result.value)
            end
        end
        for position = 1, loaded do
            C.nuppcg_LLVMDisposeMemoryBuffer(entries[position - 1].buffer)
        end
        if problem ~= nil then
            error("archive " .. path .. ": " .. (problem as string), 0)
        end
        local wrote = writeFile(path, bytes as string)
        if wrote ~= nil then
            error(wrote, 0)
        end
    end)
    if not ok then
        return tostring(err)
    end

    return nil
end

export = codegen
