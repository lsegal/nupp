--[[
The code generator linked into the host: LLVM and lld, reached through the
versioned native provider.

The calls into the provider are thin. What goes in is LLVM IR text and the
options, checked here from `key=value` form, and what comes out is an object,
the phase timings, and optionally the assembly and optimized IR; the crate
behind it knows nothing about Nupp. The numeric-contract checks
([](nupp.compiler.aot.llvm.contract)) and the report run here. A host built without
the pinned LLVM reaches a prebuilt provider instead when one is named
(`NUPP_CODEGEN_LIBRARY`, or `useLibrary`), and otherwise answers `available()`
with the reason.
]]
module nupp.compiler.aot.llvm.codegen

local native = require("nupp.runtime.native")

local codegen = {}

--- The provider's feature bit for the code generator.
const CODEGEN_FEATURE = 2048

local declared = false

local function declare(): nil
    if declared then
        return
    end
    declared = true
    local ffi: any = native.ffi
    ffi.cdef[[
uint32_t nuppCodegenAvailable(void);
int32_t nuppCodegenVersion(uint64_t *result);
int32_t nuppCodegenCompile(
    const char *ir, size_t irLength,
    const char *name, size_t nameLength,
    const char *options, size_t optionsLength,
    uint64_t *object, uint64_t *timings, uint64_t *assembly, uint64_t *optimizedIr);
int32_t nuppCodegenLink(const char *argv, size_t length, uint64_t *messages);
int32_t nuppCodegenUnexitable(void);
void nuppCodegenEndProcess(int32_t code);
int32_t nuppCodegenImportLibrary(
    const char *dll, size_t dllLength,
    const char *path, size_t pathLength,
    const char *names, size_t namesLength);
int32_t nuppCodegenCompileFiles(const char *jobs, size_t length, uint32_t width, uint64_t *results);
int32_t nuppCodegenArchive(
    const char *path, size_t pathLength,
    const char *members, size_t membersLength,
    int32_t kind);
int32_t nuppCodegenKitFetch(
    const char *url, size_t urlLength,
    const char *path, size_t pathLength,
    uint64_t size);
]]
end

--- A provider the code generator is reached through: its namespace, and the
--- status and byte-handle readers that go with that namespace.
record codegen.Provider
    C: any
    succeeded: function(integer, integer): nil
    bytes: function(any): string
end

--- The prebuilt code generator named by `codegen.useLibrary`, when this
--- process's own provider was built without one.
local fallback: string? = nil

--- Prebuilt providers already opened, by path, and why one could not be.
local opened: {[string]: codegen.Provider} = {}

local refused: {[string]: string} = {}

--- This process's provider, when it carries the code generator.
local function own(): (codegen.Provider?, string?)
    local ok, answer = pcall(function(): boolean
        declare()
        local C: any = native.C
        if (C.nuppNativeFeatures() as integer) % (CODEGEN_FEATURE * 2) < CODEGEN_FEATURE then
            return false
        end

        return C.nuppCodegenAvailable() ~= 0
    end)
    if not ok then
        return nil, "the native provider could not be loaded: " .. tostring(answer)
    end
    if answer ~= true then
        return nil, "this nupp was built without the LLVM code generator; run scripts/toolchain llvm and rebuild"
    end

    return codegen.Provider(C = native.C, succeeded = native.succeeded, bytes = native.bytes), nil
end

--- A prebuilt provider library, opened beside this process's own for its
--- code generator alone: a checkout that has not built LLVM links native
--- programs with the one `scripts/toolchain prebuilt-codegen` fetched. Its
--- byte handles and errors are its own, so they are read through it too.
local function prebuilt(path: string): (codegen.Provider?, string?)
    if opened[path] ~= nil then
        return opened[path], nil
    end
    if refused[path] ~= nil then
        return nil, refused[path]
    end
    local ok, answer = pcall(function(): any
        declare()
        local ffi: any = native.ffi
        -- Kept in `opened` for the life of the process, so it is never
        -- unloaded while a handle it returned is still being read.
        local library: any = ffi.load(path)
        if (library.nuppNativeFeatures() as integer) % (CODEGEN_FEATURE * 2) < CODEGEN_FEATURE
            or library.nuppCodegenAvailable() == 0
        then
            return nil
        end

        return library
    end)
    if not ok or answer == nil then
        refused[path] = not ok and "cannot load the prebuilt code generator " .. path .. ": " .. tostring(answer)
            or "the prebuilt provider " .. path .. " was built without the LLVM code generator"

        return nil, refused[path]
    end
    local ffi: any = native.ffi
    local library: any = answer

    local function succeeded(status: integer, level: integer): nil
        if status ~= 0 then
            error("nupp: " .. ffi.string(library.nuppNativeLastError()), level)
        end
    end

    local function bytes(handle: any): string
        local length = ffi.new("size_t[1]")
        local status = library.nuppNativeBytesCopy(handle, nil, 0, length)
        local count = (tonumber(length[0]) or 0) as integer
        if count == 0 then
            local released = library.nuppNativeBytesRelease(handle)
            succeeded(status, 3)
            succeeded(released, 3)

            return ""
        end
        -- Capacity is the expected result of probing a nonempty value.
        if status ~= 2 then
            local released = library.nuppNativeBytesRelease(handle)
            succeeded(status, 3)
            succeeded(released, 3)
        end
        local buffer = ffi.new("uint8_t[?]", count)
        status = library.nuppNativeBytesCopy(handle, buffer, count, length)
        local released = library.nuppNativeBytesRelease(handle)
        succeeded(status, 3)
        succeeded(released, 3)

        return ffi.string(buffer, count)
    end

    local provider = codegen.Provider(C = library, succeeded = succeeded, bytes = bytes)
    opened[path] = provider

    return provider, nil
end

--- The provider to reach the code generator through, or nil and why there is
--- none: this process's own, else `NUPP_CODEGEN_LIBRARY`, else the prebuilt
--- one `codegen.useLibrary` named.
local function selected(): (codegen.Provider?, string?)
    local found, why = own()
    if found ~= nil then
        return found, nil
    end
    local named = os.getenv("NUPP_CODEGEN_LIBRARY")
    if named ~= nil and named ~= "" then
        return prebuilt(named as string)
    end
    if fallback ~= nil then
        return prebuilt(fallback as string)
    end

    return nil, why
end

--- The provider, for a call that has already been told it is available.
--- @raises string when there is none
local function reach(): codegen.Provider
    local found, why = selected()
    if found == nil then
        error(why, 0)
    end

    return found as codegen.Provider
end

--- Names a prebuilt provider library to reach the code generator through
--- when this process's own was built without it.
--- @return nil, or why that library cannot serve
function codegen.useLibrary(path: string): string?
    local _, why = prebuilt(path)
    if why == nil then
        fallback = path
    end

    return why
end

--- Whether this process has the code generator, and if not, why not.
function codegen.available(): (boolean, string?)
    local found, why = selected()
    if found == nil then
        return false, why
    end

    return true, nil
end

--- `"llvm <version>; codegen <n>"`: part of every artifact's key.
--- @raises string when the code generator is unavailable
function codegen.version(): string
    declare()
    local ffi: any = native.ffi
    local provider = reach()
    local handle = ffi.new("uint64_t[1]")
    provider.succeeded(provider.C.nuppCodegenVersion(handle), 2)

    return provider.bytes(handle[0])
end

--- The contents of a byte handle, or nil for the zero handle.
local function take(provider: codegen.Provider, handle: any): string?
    local ffi: any = native.ffi
    if ffi.cast("uint64_t", handle) == 0 then
        return nil
    end

    return provider.bytes(handle)
end

--- A compiled module.
record codegen.Compiled
    object: string
    report: string
    assembly: string?
    optimizedIr: string?
end

--- What a compile is for. `triple` is the LLVM code-generation triple (never
--- a public Nupp platform name); `cpu` and `features` are the module's
--- baseline, which per-function `"target-cpu"`/`"target-features"` attributes
--- override for tiered functions.
record codegen.Options
    triple: string
    cpu: string
    features: string

    --- 0-3: `default<O0>` .. `default<O3>`, and the matching code-generation level.
    opt: integer

    --- Also return the assembly listing (a second code generation).
    assembly: boolean

    --- Also return the optimized IR.
    optimizedIr: boolean

    --- Run the numeric-contract checks over the optimized IR, and over the
    --- assembly when it is produced.
    verify: boolean
end

--- Reads `key=value` lines: triple, cpu, features, opt, assembly,
--- optimized-ir, verify. Unknown keys are refused.
--- @return the options, or nil and why they are refused
function codegen.parseOptions(text: string): (codegen.Options?, string?)
    local options = codegen.Options(
        triple = "",
        cpu = "",
        features = "",
        opt = 3,
        assembly = false,
        optimizedIr = false,
        verify = false
    )
    for raw in (text .. "\n"):gmatch("([^\n]*)\n") do
        local line = (raw:match("^%s*(.-)%s*$")) as string
        if line ~= "" then
            local key, value = line:match("^([^=]*)=(.*)$")
            if key == nil then
                return nil, ("codegen option `%s` has no `=`"):format(line)
            end
            local flag = value == "1" or value == "true"
            if key == "triple" then
                options.triple = value as string
            elseif key == "cpu" then
                options.cpu = value as string
            elseif key == "features" then
                options.features = value as string
            elseif key == "opt" then
                local level = (value as string):match("^%d+$") and tonumber(value) or nil
                if level == nil or level > 3 then
                    return nil, ("codegen opt `%s` is not 0-3"):format(value)
                end
                options.opt = level as integer
            elseif key == "assembly" then
                options.assembly = flag
            elseif key == "optimized-ir" then
                options.optimizedIr = flag
            elseif key == "verify" then
                options.verify = flag
            else
                return nil, ("unknown codegen option `%s`"):format(key)
            end
        end
    end
    if options.triple == "" then
        return nil, "codegen options name no triple"
    end

    return options, nil
end

--- A plain-text report of one compile: its phase timings in microseconds,
--- the object's size, then one contract violation per line.
function codegen.report(timings: {number}, objectBytes: integer, violations: {string}): string
    local lines: {
        string
    } = {
        (
            "parse-us=%.0f\noptimize-us=%.0f\ncodegen-us=%.0f\nobject-bytes=%d\n"
        ):format(timings[1] or 0, timings[2] or 0, timings[3] or 0, objectBytes),
    }
    for _, violation in ipairs(violations) do
        lines[#lines + 1] = "violation=" .. violation:gsub("\n", " ") .. "\n"
    end

    return table.concat(lines)
end

--- The contract violations in a compile's optimized IR and assembly.
local function violations(optimizedIr: string, assembly: string?): {string}
    local contract = require("nupp.compiler.aot.llvm.contract")
    local found = contract.ir(optimizedIr)
    if assembly ~= nil then
        for _, violation in ipairs(contract.fusedInstructions(assembly as string, optimizedIr)) do
            found[#found + 1] = violation
        end
    end

    return found
end

--- `key=value` lines from an options table, in a stable order.
local function optionText(options: {[string]: string}): string
    local keys: {string} = {}
    for key in pairs(options) do
        keys[#keys + 1] = key
    end
    table.sort(keys)
    local lines: {string} = {}
    for _, key in ipairs(keys) do
        lines[#lines + 1] = key .. "=" .. (options[key] as string)
    end

    return table.concat(lines, "\n")
end

--- The checked options an options table names, in the provider's positional
--- form: triple, cpu, features, opt, then whether to return the assembly and
--- the optimized IR. Verifying needs the optimized IR, and the assembly when it
--- is asked for; outputs nobody keeps are produced only to verify.
--- @raises string when the options are refused
local function nativeOptions(options: {[string]: string}, kept: boolean): (codegen.Options, string)
    local parsed, err = codegen.parseOptions(optionText(options))
    if parsed == nil then
        error(err, 0)
    end
    local checked = parsed as codegen.Options
    local fields = {
        checked.triple,
        checked.cpu,
        checked.features,
        tostring(checked.opt),
        checked.assembly and (kept or checked.verify) and "1" or "0",
        ((kept and checked.optimizedIr) or checked.verify) and "1" or "0",
    }

    return checked, table.concat(fields, "\31")
end

--- The phase timings a provider answers: microseconds, space-separated.
local function timings(text: string): {number}
    local out: {number} = {}
    for number in text:gmatch("%S+") do
        out[#out + 1] = tonumber(number) or 0
    end

    return out
end

--- Compiles LLVM IR text. Options: `triple` (required), `cpu`, `features`,
--- `opt` (0-3), `assembly`, `optimized-ir`, `verify` ("1" to enable).
--- @return the compiled module, or nil and why not
function codegen.compile(ir: string, name: string, options: {[string]: string}): (codegen.Compiled?, string?)
    local ok, result = pcall(function(): codegen.Compiled
        declare()
        local ffi: any = native.ffi
        local checked, text = nativeOptions(options, true)
        local provider = reach()
        local C: any = provider.C
        local object = ffi.new("uint64_t[1]")
        local spent = ffi.new("uint64_t[1]")
        local assembly = ffi.new("uint64_t[1]")
        local optimized = ffi.new("uint64_t[1]")
        provider.succeeded(
            C.nuppCodegenCompile(ir, #ir, name, #name, text, #text, object, spent, assembly, optimized),
            2
        )
        local objectBytes = take(provider, object[0]) or ""
        local listing = take(provider, assembly[0])
        local optimizedIr = take(provider, optimized[0])
        local found: {string} = checked.verify and violations(optimizedIr or "", listing) or {}

        return codegen.Compiled(
            object = objectBytes,
            report = codegen.report(timings(take(provider, spent[0]) or ""), #objectBytes, found),
            assembly = listing,
            optimizedIr = checked.optimizedIr and optimizedIr or nil
        )
    end)
    if not ok then
        return nil, tostring(result)
    end

    return result as codegen.Compiled, nil
end

--- A module `codegen.compileFiles` compiles.
record codegen.Job
    ir: string
    object: string
    options: {[string]: string}
end

--- A job's outcome: its report, or why it failed.
record codegen.Outcome
    report: string?
    error: string?
end

--- Reads and removes a file a compile job wrote beside its object.
local function consume(path: string): string?
    local file = io.open(path, "rb")
    if file == nil then
        return nil
    end
    local text = file:read("*a") as string
    file:close()
    os.remove(path)

    return text
end

--- An object file's size in bytes, or zero when it cannot be read.
local function fileSize(path: string): integer
    local file = io.open(path, "rb")
    if file == nil then
        return 0
    end
    local size = file:seek("end") as integer
    file:close()

    return size
end

--- Compiles IR files to objects, `width` at a time, each where LLVM's
--- ending the process on an internal error ends only that job: a job that
--- crashes is an outcome with an error, and the build goes on to report it.
--- A job that verifies has its optimized IR and assembly written beside its
--- object as `.ll` and `.s`, which are checked here and then removed.
--- @return one outcome per job, in order, or nil and why none ran
function codegen.compileFiles(jobs: {codegen.Job}, width: integer): ({codegen.Outcome}?, string?)
    local ok, result = pcall(function(): {codegen.Outcome}
        declare()
        local ffi: any = native.ffi
        local records: {string} = {}
        local checked: {codegen.Options} = {}
        for position, job in ipairs(jobs) do
            local options, text = nativeOptions(job.options, false)
            checked[position] = options
            records[position] = job.ir .. "\31" .. job.object .. "\31" .. text
        end
        local provider = reach()
        local C: any = provider.C
        local joined = table.concat(records, "\0") .. "\0"
        local handle = ffi.new("uint64_t[1]")
        provider.succeeded(C.nuppCodegenCompileFiles(joined, #joined, width, handle), 2)
        local text = take(provider, handle[0]) or ""
        local outcomes: {codegen.Outcome} = {}
        for record in text:gmatch("([^%z]*)%z") do
            local position = #outcomes + 1
            local job = jobs[position]
            local optimizedIr = job ~= nil and consume(job.object .. ".ll") or nil
            local listing = job ~= nil and consume(job.object .. ".s") or nil
            local kind, body = record:match("^(%a+)\31(.*)$")
            if kind == "ok" and job ~= nil then
                local found = checked[position].verify and violations(optimizedIr or "", listing) or {}
                local report = codegen.report(timings(body as string), fileSize(job.object), found)
                outcomes[position] = codegen.Outcome(report = report, error = nil)
            else
                outcomes[position] = codegen.Outcome(report = nil, error = body or record)
            end
        end

        return outcomes
    end)
    if not ok then
        return nil, tostring(result)
    end

    return result as {codegen.Outcome}, nil
end

--- Ends this process with `code` when a link left it unable to exit through
--- its static destructors, which on a Windows host an ELF, Mach-O or Wasm link
--- does; returns otherwise. The process's own buffered output is flushed
--- first, since nothing after this runs.
function codegen.endIfUnexitable(code: integer): nil
    if not declared then
        return
    end
    local provider = selected()
    if provider == nil then
        return
    end
    local C: any = provider.C
    local ok, unexitable = pcall(function(): boolean
        return C.nuppCodegenUnexitable() ~= 0
    end)
    if ok and unexitable then
        io.stdout:flush()
        io.stderr:flush()
        C.nuppCodegenEndProcess(code)
    end
end

--- Runs lld in process. `argv[1]` picks the flavor: `ld64.lld`, `ld.lld`,
--- `lld-link`, `wasm-ld`.
--- @return lld's messages on success, or nil and the failure
function codegen.link(argv: {string}): (string?, string?)
    local ok, result = pcall(function(): string
        declare()
        local ffi: any = native.ffi
        local provider = reach()
        local C: any = provider.C
        local joined = table.concat(argv, "\0") .. "\0"
        local messages = ffi.new("uint64_t[1]")
        provider.succeeded(C.nuppCodegenLink(joined, #joined, messages), 2)

        return take(provider, messages[0]) or ""
    end)
    if not ok then
        return nil, tostring(result)
    end

    return result as string, nil
end

--- Writes a MinGW import library naming `dll` as the provider of `names`;
--- an entry `{name, export}` imports `name` under `export`.
--- @return nil, or why it could not be written
function codegen.importLibrary(dll: string, path: string, names: {{string}}): string?
    local ok, err = pcall(function(): nil
        declare()
        local provider = reach()
        local C: any = provider.C
        local entries: {string} = {}
        for position, entry in ipairs(names) do
            entries[position] = entry[2] ~= nil and entry[1] .. "\t" .. entry[2] or entry[1]
        end
        local joined = table.concat(entries, "\0") .. "\0"
        provider.succeeded(C.nuppCodegenImportLibrary(dll, #dll, path, #path, joined, #joined), 2)
    end)
    if not ok then
        return tostring(err)
    end

    return nil
end

--- The archive formats `codegen.archive` writes.
const ARCHIVE: {[string]: integer} = {gnu = 0, bsd = 1, darwin = 2, coff = 3}

--- Writes the indexed static archive `path` of `members` in `format`:
--- `gnu`, `bsd`, `darwin` or `coff`.
--- @return nil, or why it could not be written
function codegen.archive(path: string, members: {string}, format: string): string?
    local ok, err = pcall(function(): nil
        declare()
        local provider = reach()
        local C: any = provider.C
        local joined = table.concat(members, "\0") .. "\0"
        provider.succeeded(C.nuppCodegenArchive(path, #path, joined, #joined, ARCHIVE[format] or 0), 2)
    end)
    if not ok then
        return tostring(err)
    end

    return nil
end

--- Fetches the link kit archive at the HTTPS `url` into `path`, which is
--- written only once the whole body of `size` bytes has arrived. Its digest is
--- the caller's to check ([](nupp.tools.build.kitarchive)).
--- @return nil, or why it could not be fetched
function codegen.fetchKit(url: string, path: string, size: integer): string?
    local ok, err = pcall(function(): nil
        declare()
        local provider = reach()
        local C: any = provider.C
        provider.succeeded(C.nuppCodegenKitFetch(url, #url, path, #path, size), 2)
    end)
    if not ok then
        return tostring(err)
    end

    return nil
end

export = codegen
