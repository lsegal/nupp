--[[
What a Windows DLL of AOT code needs beyond its units.

Windows binds every import at link time to a named module. The Lua C API lives
in whichever module carries the VM -- the program itself when LuaJIT is linked
into it, `lua51.dll` beside the interpreter otherwise -- and a library built
once is loaded by both. So a DLL carries a jump for each API function through a
slot of its own, and its entry point fills the slots from whichever loaded
module exports the API, refusing to load when that module lacks part of it. A
process with no VM at all is a C program calling the library's `@aot(export)`
functions, which never reach the API, so the DLL loads there with the slots
empty.

The rest are the system's: the C runtime's math and memory functions, imported
from `msvcrt.dll` (the C runtime the Rust `windows-gnu` host itself uses) and,
for the C99 math it lacks, from the Universal C Runtime's math API set; the
two `kernel32.dll` functions the entry point calls, and `___chkstk_ms`, the
stack probe a large frame calls, which MinGW's libgcc would otherwise supply.

`pow` is the exception: the binding defines it, as whichever `pow` the VM's
own `^` calls. The C runtimes disagree in the last bit for exponents as plain
as `0.3 ^ 3`: the Universal C Runtime's and `msvcrt.dll`'s round correctly,
while MinGW-w64's, which a LuaJIT built against `msvcrt.dll` links in
statically, squares repeatedly for an integer exponent. So the entry point
looks `pow` up in the VM module's imports and binds to that; a VM that
imports none carries MinGW's, and gets the transcription of it here.
]]
module nupp.compiler.aot.llvm.coff

local coff = {}

--- The entry point the binding defines.
const coff.ENTRY = "ks_dll_main"

--- The C runtime functions a unit may call, imported from `msvcrt.dll`. A
--- name nothing calls costs nothing: an import library member is linked only
--- when referenced.
const CRT: {
    string
} = {
    "acos",
    "asin",
    "atan",
    "atan2",
    "ceil",
    "cos",
    "cosh",
    "exp",
    "floor",
    "fmod",
    "frexp",
    "ldexp",
    "log",
    "log10",
    "memchr",
    "memcmp",
    "memcpy",
    "memmove",
    "memset",
    "modf",
    "sin",
    "sinh",
    "sqrt",
    "strlen",
    "tan",
    "tanh",
}

--- The C99 math `msvcrt.dll` predates, imported from the Universal C Runtime's
--- math API set, which every supported Windows resolves to `ucrtbase.dll`.
--- LLVM calls these where a tier has no instruction for them: SSE2 has no
--- fused multiply-add and no rounding instruction, so `llvm.fma` becomes
--- `fma`/`fmaf` and `llvm.trunc` becomes `trunc`/`truncf` there. Disjoint from
--- `CRT`, so which module provides a name is never a question of order.
const UCRT: {
    string
} = {
    "ceilf",
    "cbrt",
    "cbrtf",
    "exp2",
    "exp2f",
    "expf",
    "floorf",
    "fma",
    "fmaf",
    "fmax",
    "fmaxf",
    "fmin",
    "fminf",
    "fmodf",
    "log2",
    "log2f",
    "logf",
    "nearbyint",
    "nearbyintf",
    "powf",
    "rint",
    "rintf",
    "round",
    "roundf",
    "sinf",
    "cosf",
    "sqrtf",
    "tanf",
    "trunc",
    "truncf",
}

--- The API set `UCRT` is imported from.
const coff.UCRT_MODULE = "api-ms-win-crt-math-l1-1-0.dll"

--- What the binding's entry point imports from `kernel32.dll`.
const KERNEL32: {string} = {"GetModuleHandleA", "GetProcAddress"}

coff.CRT = CRT
coff.UCRT = UCRT
coff.KERNEL32 = KERNEL32

--- The x87 halves of MinGW-w64's `pow` (`math/x86/pow.def.h`): `fsqrt` for an
--- exponent of one half, and `exp2l(y * log2l(|x|))`, rounded to a double,
--- for the rest. Run in this process's own x87 control word, as MinGW's are.
--- Leaf functions that keep their scratch in the caller's home area.
const X87: {string} = {
    ".globl nupp_mingw_sqrt",
    "nupp_mingw_sqrt:",
    "    movsd %xmm0, 8(%rsp)",
    "    fldl 8(%rsp)",
    "    fsqrt",
    "    fstpl 8(%rsp)",
    "    movsd 8(%rsp), %xmm0",
    "    retq",
    ".globl nupp_mingw_exp2log2",
    "nupp_mingw_exp2log2:",
    "    movsd %xmm0, 8(%rsp)",
    "    movsd %xmm1, 16(%rsp)",
    -- log2l: fyl2xp1 on x - 1 near one, fyl2x elsewhere.
    "    fld1",
    "    fldl 16(%rsp)",
    "    fld %st(0)",
    "    fsub %st(2), %st",
    "    fld %st(0)",
    "    fabs",
    "    fcompl nupp_mingw_log2_limit(%rip)",
    "    fnstsw %ax",
    "    andb $0x45, %ah",
    "    jz .Lnupp_log2_far",
    "    fstp %st(1)",
    "    fyl2xp1",
    "    jmp .Lnupp_log2_done",
    ".Lnupp_log2_far:",
    "    fstp %st(0)",
    "    fyl2x",
    ".Lnupp_log2_done:",
    "    fmull 8(%rsp)",
    -- exp2l: 2^fraction by f2xm1, scaled by the truncated integer part.
    "    fld %st(0)",
    "    fnstcw 28(%rsp)",
    "    movzwl 28(%rsp), %eax",
    "    orb $12, %ah",
    "    movw %ax, 24(%rsp)",
    "    fldcw 24(%rsp)",
    "    frndint",
    "    fldcw 28(%rsp)",
    -- st(1) = st(1) - st(0), the fraction; spelled as bytes because the
    -- AT&T mnemonic for it is the one assemblers disagree over.
    "    .byte 0xdc, 0xe9",
    "    fxch %st(1)",
    "    f2xm1",
    "    fld1",
    "    faddp %st, %st(1)",
    "    fscale",
    "    fstp %st(1)",
    "    fstpl 8(%rsp)",
    "    movsd 8(%rsp), %xmm0",
    "    retq",
    ".section .rdata,\\22dr\\22",
    ".p2align 3",
    "nupp_mingw_log2_limit:",
    "    .double 0.29",
    ".text",
}

--- `pow`: the one the VM imports, which `ks_imported` finds when the library
--- loads, else MinGW-w64's `pow` and its `__powi` (`math/powi.def.h`), case
--- for case: `edges` is a zero or infinite `x`, `powi` an exponent that fits
--- an `int`.
const POW = [[
declare double @nupp_mingw_sqrt(double)
declare double @nupp_mingw_exp2log2(double, double)
declare double @llvm.fabs.f64(double)
declare double @llvm.trunc.f64(double)

@ks_pow_name = private unnamed_addr constant [4 x i8] c"pow\00"
@ks_pow_slot = internal global ptr null

define dso_local double @pow(double %x, double %y) {
entry:
  %bound = load ptr, ptr @ks_pow_slot
  %imported = icmp ne ptr %bound, null
  br i1 %imported, label %vm, label %own
vm:
  %theirs = tail call double %bound(double %x, double %y)
  ret double %theirs
own:
  %ours = tail call double @nupp_mingw_pow(double %x, double %y)
  ret double %ours
}

; The address a module's import table binds `wanted` to, or null when the
; module imports no function of that name.
define internal ptr @ks_imported(ptr %base, ptr %wanted) {
entry:
  %lfanew.at = getelementptr i8, ptr %base, i64 60
  %lfanew = load i32, ptr %lfanew.at, align 1
  %lfanew64 = sext i32 %lfanew to i64
  %nt = getelementptr i8, ptr %base, i64 %lfanew64
  %directory.at = getelementptr i8, ptr %nt, i64 144
  %directory = load i32, ptr %directory.at, align 1
  %empty = icmp eq i32 %directory, 0
  br i1 %empty, label %missing, label %descriptors
descriptors:
  %directory64 = zext i32 %directory to i64
  %first = getelementptr i8, ptr %base, i64 %directory64
  br label %descriptor
descriptor:
  %d = phi ptr [ %first, %descriptors ], [ %following, %nextdescriptor ]
  %library.at = getelementptr i8, ptr %d, i64 12
  %library = load i32, ptr %library.at, align 1
  %last = icmp eq i32 %library, 0
  br i1 %last, label %missing, label %thunks
thunks:
  %original = load i32, ptr %d, align 1
  %bound.at = getelementptr i8, ptr %d, i64 16
  %boundrva = load i32, ptr %bound.at, align 1
  %hasoriginal = icmp ne i32 %original, 0
  %lookup = select i1 %hasoriginal, i32 %original, i32 %boundrva
  %lookup64 = zext i32 %lookup to i64
  %bound64 = zext i32 %boundrva to i64
  %names = getelementptr i8, ptr %base, i64 %lookup64
  %addresses = getelementptr i8, ptr %base, i64 %bound64
  br label %thunk
thunk:
  %i = phi i64 [ 0, %thunks ], [ %inext, %nextthunk ]
  %named.at = getelementptr i64, ptr %names, i64 %i
  %named = load i64, ptr %named.at, align 8
  %done = icmp eq i64 %named, 0
  br i1 %done, label %nextdescriptor, label %byname
byname:
  %ordinal = icmp slt i64 %named, 0
  br i1 %ordinal, label %nextthunk, label %compare
compare:
  %hintrva = and i64 %named, 2147483647
  %hint = getelementptr i8, ptr %base, i64 %hintrva
  %name = getelementptr i8, ptr %hint, i64 2
  %same = call i1 @ks_same(ptr %name, ptr %wanted)
  br i1 %same, label %found, label %nextthunk
found:
  %address.at = getelementptr ptr, ptr %addresses, i64 %i
  %address = load ptr, ptr %address.at, align 8
  ret ptr %address
nextthunk:
  %inext = add i64 %i, 1
  br label %thunk
nextdescriptor:
  %following = getelementptr i8, ptr %d, i64 20
  br label %descriptor
missing:
  ret ptr null
}

define internal i1 @ks_same(ptr %a, ptr %b) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %inext, %next ]
  %at.a = getelementptr i8, ptr %a, i64 %i
  %at.b = getelementptr i8, ptr %b, i64 %i
  %ca = load i8, ptr %at.a, align 1
  %cb = load i8, ptr %at.b, align 1
  %equal = icmp eq i8 %ca, %cb
  br i1 %equal, label %check, label %differ
check:
  %end = icmp eq i8 %ca, 0
  br i1 %end, label %same, label %next
next:
  %inext = add i64 %i, 1
  br label %loop
same:
  ret i1 true
differ:
  ret i1 false
}

define internal double @nupp_mingw_pow(double %x, double %y) {
entry:
  %xbits = bitcast double %x to i64
  %xneg = icmp slt i64 %xbits, 0
  %ybits = bitcast double %y to i64
  %yneg = icmp slt i64 %ybits, 0
  %ax = call double @llvm.fabs.f64(double %x)
  %ay = call double @llvm.fabs.f64(double %y)
  %yzero = fcmp oeq double %y, 0.0
  %xone = fcmp oeq double %x, 1.0
  %unit = or i1 %yzero, %xone
  br i1 %unit, label %one, label %xnans
one:
  ret double 1.0
xnans:
  %xnan = fcmp uno double %x, 0.0
  br i1 %xnan, label %retx, label %ynans
retx:
  ret double %x
ynans:
  %ynan = fcmp uno double %y, 0.0
  br i1 %ynan, label %rety, label %classify
rety:
  ret double %y
classify:
  %ytrunc = call double @llvm.trunc.f64(double %y)
  %yfrac = fcmp one double %ytrunc, %y
  %yhalf = fmul double %y, 0.5
  %htrunc = call double @llvm.trunc.f64(double %yhalf)
  %yodd = fcmp one double %htrunc, %yhalf
  %xzero = fcmp oeq double %x, 0.0
  %xinf = fcmp oeq double %ax, 0x7FF0000000000000
  %edge = or i1 %xzero, %xinf
  br i1 %edge, label %edges, label %yinfs
edges:
  %yint = xor i1 %yfrac, true
  %oddint = and i1 %yint, %yodd
  %negative = and i1 %xneg, %oddint
  %differ = xor i1 %xzero, %yneg
  %large = xor i1 %differ, true
  %magnitude = select i1 %large, double 0x7FF0000000000000, double 0.0
  %negated = fneg double %magnitude
  %edged = select i1 %negative, double %negated, double %magnitude
  ret double %edged
yinfs:
  %yinf = fcmp oeq double %ay, 0x7FF0000000000000
  br i1 %yinf, label %yinfinite, label %finite
yinfinite:
  %axone = fcmp oeq double %ax, 1.0
  %axbig = fcmp ogt double %ax, 1.0
  %grows = xor i1 %axbig, %yneg
  %limit = select i1 %grows, double 0x7FF0000000000000, double 0.0
  %limited = select i1 %axone, double 1.0, double %limit
  ret double %limited
finite:
  br i1 %yfrac, label %fraction, label %integer
fraction:
  br i1 %xneg, label %invalid, label %half
invalid:
  ret double 0xFFF8000000000000
half:
  %ishalf = fcmp oeq double %y, 0.5
  br i1 %ishalf, label %root, label %general
root:
  %rooted = call double @nupp_mingw_sqrt(double %x)
  ret double %rooted
integer:
  %below = fcmp ole double %y, 2147483647.0
  %above = fcmp oge double %y, -2147483648.0
  %fits = and i1 %below, %above
  br i1 %fits, label %powi, label %general
powi:
  %n = fptosi double %y to i32
  %squared = call double @nupp_mingw_powi(double %x, i32 %n)
  ret double %squared
general:
  %raised = call double @nupp_mingw_exp2log2(double %y, double %ax)
  %flip = and i1 %xneg, %yodd
  %flipped = fneg double %raised
  %signed = select i1 %flip, double %flipped, double %raised
  ret double %signed
}

define internal double @nupp_mingw_powi(double %x, i32 %n) {
entry:
  %d = call double @llvm.fabs.f64(double %x)
  %reciprocal = icmp slt i32 %n, 0
  %negn = sub i32 0, %n
  %m = select i1 %reciprocal, i32 %negn, i32 %n
  %single = icmp eq i32 %m, 1
  br i1 %single, label %finish, label %iterate
iterate:
  %r = call double @nupp_mingw_powi_iter(double %d, i32 %m)
  %rinf = fcmp oeq double %r, 0x7FF0000000000000
  %dbig = fcmp ogt double %d, 1.0
  %overflow = and i1 %rinf, %dbig
  %redo = and i1 %overflow, %reciprocal
  br i1 %redo, label %upfront, label %finish
upfront:
  %inverse = fdiv double 1.0, %d
  %again = call double @nupp_mingw_powi_iter(double %inverse, i32 %m)
  br label %signed
finish:
  %rr = phi double [ %d, %entry ], [ %r, %iterate ]
  %inverted = fdiv double 1.0, %rr
  %rf = select i1 %reciprocal, double %inverted, double %rr
  br label %signed
signed:
  %result = phi double [ %again, %upfront ], [ %rf, %finish ]
  %odd = trunc i32 %n to i1
  %xbits = bitcast double %x to i64
  %xneg = icmp slt i64 %xbits, 0
  %flip = and i1 %xneg, %odd
  %negated = fneg double %result
  %final = select i1 %flip, double %negated, double %result
  ret double %final
}

define internal double @nupp_mingw_powi_iter(double %base, i32 %m) {
entry:
  %low = and i32 %m, 1
  %isodd = icmp ne i32 %low, 0
  %start = select i1 %isodd, double %base, double 1.0
  %u0 = lshr i32 %m, 1
  br label %loop
loop:
  %d = phi double [ %base, %entry ], [ %d2, %loop ]
  %r = phi double [ %start, %entry ], [ %r2, %loop ]
  %u = phi i32 [ %u0, %entry ], [ %u2, %loop ]
  %d2 = fmul double %d, %d
  %bit = and i32 %u, 1
  %take = icmp ne i32 %bit, 0
  %product = fmul double %r, %d2
  %r2 = select i1 %take, double %product, double %r
  %u2 = lshr i32 %u, 1
  %more = icmp ne i32 %u2, 0
  br i1 %more, label %loop, label %done
done:
  ret double %r2
}
]]

local function cString(name: string): string
    return ("private unnamed_addr constant [%d x i8] c\"%s\\00\""):format(#name + 1, name)
end

--- The binding module's IR for `triple`: a jump through a slot for each of
--- `names`, and the entry point that fills the slots.
function coff.binding(triple: string, names: {string}): string
    local lines: {string} = {
        "; The Lua C API for a Windows DLL of AOT code, bound when it loads.",
        "target triple = \"" .. triple .. "\"",
        "",
        "module asm \".text\"",
        -- libgcc's stack probe: touch each page between the stack pointer and
        -- the frame about to be allocated, whose size is in %rax.
        "module asm \".globl ___chkstk_ms\"",
        "module asm \"___chkstk_ms:\"",
        "module asm \"    pushq %rcx\"",
        "module asm \"    pushq %rax\"",
        "module asm \"    cmpq $0x1000, %rax\"",
        "module asm \"    leaq 24(%rsp), %rcx\"",
        "module asm \"    jb 1f\"",
        "module asm \"2:  subq $0x1000, %rcx\"",
        "module asm \"    testq %rcx, (%rcx)\"",
        "module asm \"    subq $0x1000, %rax\"",
        "module asm \"    cmpq $0x1000, %rax\"",
        "module asm \"    ja 2b\"",
        "module asm \"1:  subq %rax, %rcx\"",
        "module asm \"    testq %rcx, (%rcx)\"",
        "module asm \"    popq %rax\"",
        "module asm \"    popq %rcx\"",
        "module asm \"    retq\"",
    }
    for _, line in ipairs(X87) do
        lines[#lines + 1] = "module asm \"" .. line .. "\""
    end
    for _, name in ipairs(names) do
        lines[#lines + 1] = "module asm \".globl " .. name .. "\""
        lines[#lines + 1] = "module asm \"" .. name .. ":\""
        lines[#lines + 1] = "module asm \"    jmpq *ks_lua_slot_" .. name .. "(%rip)\""
    end
    lines[#lines + 1] = ""
    for _, name in ipairs(names) do
        lines[#lines + 1] = "@ks_lua_slot_" .. name .. " = hidden global ptr null"
        lines[#lines + 1] = "@ks_lua_name_" .. name .. " = " .. cString(name)
    end
    lines[#lines + 1] = "@ks_lua_module = " .. cString("lua51.dll")
    lines[#lines + 1] = "@ks_lua_probe = " .. cString("lua_gettop")
    lines[#lines + 1] = ""
    lines[#lines + 1] = "declare dllimport ptr @GetModuleHandleA(ptr)"
    lines[#lines + 1] = "declare dllimport ptr @GetProcAddress(ptr, ptr)"
    lines[#lines + 1] = ""
    -- The program's own exports come first: a program that links LuaJIT in
    -- exports its API, and may have loaded some lua51.dll besides.
    lines[#lines + 1] = "define dso_local i32 @" .. coff.ENTRY .. "(ptr %instance, i32 %reason, ptr %reserved) {"
    lines[#lines + 1] = "entry:"
    lines[#lines + 1] = "  %attach = icmp eq i32 %reason, 1"
    lines[#lines + 1] = "  br i1 %attach, label %bind, label %done"
    lines[#lines + 1] = "bind:"
    lines[#lines + 1] = "  %self = call ptr @GetModuleHandleA(ptr null)"
    lines[#lines + 1] = "  %probe = call ptr @GetProcAddress(ptr %self, ptr @ks_lua_probe)"
    lines[#lines + 1] = "  %exports = icmp ne ptr %probe, null"
    lines[#lines + 1] = "  br i1 %exports, label %found, label %library"
    lines[#lines + 1] = "library:"
    lines[#lines + 1] = "  %lua = call ptr @GetModuleHandleA(ptr @ks_lua_module)"
    lines[#lines + 1] = "  br label %found"
    lines[#lines + 1] = "found:"
    lines[#lines + 1] = "  %module = phi ptr [ %self, %bind ], [ %lua, %library ]"
    lines[#lines + 1] = "  %none = icmp eq ptr %module, null"
    lines[#lines + 1] = "  br i1 %none, label %done, label %fill"
    lines[#lines + 1] = "fill:"
    lines[#lines + 1] = "  %pow = call ptr @ks_imported(ptr %module, ptr @ks_pow_name)"
    lines[#lines + 1] = "  store ptr %pow, ptr @ks_pow_slot"
    local ok = "true"
    for position, name in ipairs(names) do
        lines[
            #lines + 1
        ] = ("  %%f%d = call ptr @GetProcAddress(ptr %%module, ptr @ks_lua_name_%s)"):format(position, name)
        lines[#lines + 1] = ("  store ptr %%f%d, ptr @ks_lua_slot_%s"):format(position, name)
        lines[#lines + 1] = ("  %%has%d = icmp ne ptr %%f%d, null"):format(position, position)
        lines[#lines + 1] = ("  %%ok%d = and i1 %s, %%has%d"):format(position, ok, position)
        ok = "%ok" .. tostring(position)
    end
    lines[#lines + 1] = "  br i1 " .. ok .. ", label %done, label %fail"
    lines[#lines + 1] = "fail:"
    lines[#lines + 1] = "  ret i32 0"
    lines[#lines + 1] = "done:"
    lines[#lines + 1] = "  ret i32 1"
    lines[#lines + 1] = "}"
    lines[#lines + 1] = ""
    lines[#lines + 1] = POW

    return table.concat(lines, "\n") .. "\n"
end

export = coff
