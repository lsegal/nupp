--[[
A native program: a checked Nupp file whose `main` is the executable's own.

An `@aot` function is a body an already-running LuaJIT host calls into. A native
program is the other way round: its `main` is what the C runtime calls, and it
reaches LuaJIT, or any other C library, through the `cdef function`
declarations beside it. So the vocabulary is C's rather than the kernel IR's:
calls to declared C functions, opaque pointers, C strings, pointer reads and
writes, `cdef struct` fields reached through a pointer, and Nupp functions
handed to C as function pointers, such as a `lua_CFunction` registered with
`lua_pushcclosure`. A struct's fields are laid out by `nupp.compiler.targetlayout`
for the triple being compiled, the model the generated C headers share, and a
struct that model does not place as C does, a union or one with a bitfield, is
refused where its fields are read.

The same function pointers start OS threads: a program declares its platform's
thread, mutex and condition variable functions (`pthread_create`, or Windows'
`CreateThread`) and passes a Nupp function as the entry. Atomics are the one
part C reaches through its compiler rather than a library, so the libatomic
functions a program declares are lowered in place; see "Atomics" below.

The file's top level holds only `cdef function` declarations and functions, and
every function is lowered as a C function. A function's parameters and result
must have C types, written out. `main` takes nothing or `(argc, argv)` and
returns its exit status. Everything outside that subset is refused where it was
written rather than approximated, because there is no Lua state to fall back to.

Arithmetic keeps the language's meaning rather than C's. `number` and `integer`
are binary64, and so is arithmetic over `int32`, `uint32` and `float`: those are
refinements a value enters through an establishing conversion such as
`math.i32.wrap`, not types whose operators wrap. `//` and `%` floor. Only `int64`
and `uint64` arithmetic is fixed-width, as LuaJIT's is: it wraps, `/` and `%`
truncate, and `//` floors as the Lua backend's helper does. Bit operators are
the patched LuaJIT's: numbers meet as 32-bit words and give the signed word
back, and an `int64` or `uint64` operand makes them 64-bit.
]]
module nupp.compiler.aot.llvm.native

local T = require("nupp.compiler.types")
local apiidentity = require("nupp.compiler.apiidentity")
local builder = require("nupp.compiler.aot.llvm.builder")
local cst = require("nupp.compiler.syntax.cst")
local lexer = require("nupp.compiler.syntax.lexer")
local llvmText = require("nupp.compiler.aot.llvm.text")
local lower = require("nupp.compiler.aot.lower")
local targetLayout = require("nupp.compiler.targetlayout")

local native = {}

--- Something the program does that a native program cannot.
record native.Problem
    line: integer
    column: integer
    message: string

    --- The file of the module the problem is in, when the caller named one.
    path: string?
end

--- One module of a native program: its checked tree, the name other modules
--- `require` it by, and the file it came from, which a problem names.
record native.Unit
    name: string
    tree: cst.Chunk
    path: string?
end

--- A C value as LLVM holds it: its type, whether integer conversions extend it
--- as signed, and, for a pointer that can be indexed, what it points at. A
--- `cdef struct` a pointer points at is a kind too, with `aggregate` its checked
--- type, but only as a place whose fields are read: it is never a value.
local record Kind
    llvm: string
    signed: boolean
    elem: Kind?
    aggregate: any?

    --- For a function pointer, the checked function type it is called through.
    signature: any?
end

local VOID = Kind(llvm = "void", signed = false)
local BOOL = Kind(llvm = "i1", signed = false)
local F64 = Kind(llvm = "double", signed = true)
local F32 = Kind(llvm = "float", signed = true)
local I32 = Kind(llvm = "i32", signed = true)
local U32 = Kind(llvm = "i32", signed = false)
local I64 = Kind(llvm = "i64", signed = true)
local U64 = Kind(llvm = "i64", signed = false)
local PTR = Kind(llvm = "ptr", signed = false)

local INTEGERS: {
    [string]: Kind
} = {
    int8 = Kind(llvm = "i8", signed = true),
    uint8 = Kind(llvm = "i8", signed = false),
    int16 = Kind(llvm = "i16", signed = true),
    uint16 = Kind(llvm = "i16", signed = false),
    int32 = I32,
    uint32 = U32,
    int64 = I64,
    uint64 = U64,
}

const WIDTHS: {[string]: integer} = {i1 = 1, i8 = 8, i16 = 16, i32 = 32, i64 = 64}

local function isInteger(kind: Kind): boolean
    return kind.llvm ~= "i1" and WIDTHS[kind.llvm] ~= nil
end

local function isFloat(kind: Kind): boolean
    return kind.llvm == "double" or kind.llvm == "float"
end

--- Raised to stop lowering at the first refusal; caught by `module`.
local record Refusal
    problem: native.Problem
end

local function site(node: any): (integer, integer)
    local token = node ~= nil and cst.firstToken(node as cst.Child) or nil
    if token == nil then
        return 1, 1
    end

    return (token as lexer.Token).line, (token as lexer.Token).col
end

local function refuse(node: any, message: string): never
    local line, column = site(node)
    error(Refusal(problem = native.Problem(line = line, column = column, message = message)), 0)
end

--- `t` with ownership, closed aliases and `const` taken off.
local function bare(t: any): any
    local raw = T.unwrapOwnership(t)
    while raw.tag == "genericAlias" and #(raw.paramKinds or {}) == 0 or raw.tag == "const" do
        raw = T.unwrapOwnership(raw.tag == "const" and raw.inner or raw.body)
    end

    return raw
end

--- Whether `t` is a type a `cdef struct` (or `cdef union`) declared.
local function isAggregate(t: any): boolean
    return t ~= nil and t.tag == "nominal" and t.declKind == "struct" and t.cdefName ~= nil
end

--- The C kind of a checked type, or nil when it has none.
local function kindOf(t: any): Kind?
    if t == nil then
        return nil
    end
    local raw = T.unwrapOwnership(t)
    while raw.tag == "genericAlias" and #(raw.paramKinds or {}) == 0 do
        raw = T.unwrapOwnership(raw.body)
    end
    local tag = raw.tag
    if tag == "literal" then
        return kindOf(raw.base)
    elseif tag == "const" then
        return kindOf(raw.inner)
    elseif tag == "boolean" then
        return BOOL
    elseif tag == "number" or tag == "integer" then
        return F64
    elseif tag == "float" then
        return F32
    elseif INTEGERS[tag] ~= nil then
        return INTEGERS[tag]
    elseif tag == "nil" then
        return VOID
    elseif tag == "voidptr" then
        return PTR
    elseif tag == "func" then
        return Kind(llvm = "ptr", signed = false, signature = raw)
    elseif tag == "cstring" then
        return Kind(llvm = "ptr", signed = false, elem = INTEGERS.uint8)
    elseif tag == "ptr" then
        local pointee = raw.elem ~= nil and bare(raw.elem) or nil
        if isAggregate(pointee) then
            return Kind(llvm = "ptr", signed = false, elem = Kind(llvm = "struct", signed = false, aggregate = pointee))
        end
        local elem = kindOf(raw.elem)
        if elem == nil or (elem as Kind).llvm == "void" then
            return PTR
        end
        return Kind(llvm = "ptr", signed = false, elem = elem)
    elseif tag == "union" and raw.hasNil and #(raw.members or {}) == 2 then
        local other = raw.members[1].tag == "nil" and raw.members[2] or raw.members[1]
        local kind = kindOf(other)
        if kind ~= nil and (kind as Kind).llvm == "ptr" then
            return kind
        end
    end

    return nil
end

--- The C kind a written type annotation names. `checked` is the type the
--- checker gave what it annotates, for an annotation it does not publish a
--- type on itself, as on a cast.
local function annotated(node: any, what: string, checked: any?): Kind
    if node == nil then
        refuse(node, what .. " needs a written C type in a native program")
    end
    local kind = kindOf((node as any).resolvedType or checked)
    if kind == nil then
        refuse(node, what .. " has type " .. cst.textOf(node as cst.Child) .. ", which has no C representation")
    end

    return kind as Kind
end

--- The attribute an argument or result of a C call carries for its width.
local function extension(kind: Kind): string
    if kind.llvm == "i1" or (kind.llvm == "i8" or kind.llvm == "i16") and not kind.signed then
        return " zeroext"
    elseif kind.llvm == "i8" or kind.llvm == "i16" then
        return " signext"
    end

    return ""
end

--- A function the program can call: one it defines, or a C one it declares.
--- A declared libatomic function names the operation it is lowered to in
--- place, and the width of the integer it acts on.
local record Callee
    symbol: string
    params: {Kind}
    result: Kind
    varargs: boolean
    foreign: boolean
    atomic: string?
    width: integer?

    --- Defined with external linkage under its own name: an `export function`,
    --- which other modules call and C finds by name.
    public: boolean?

    --- Its checked function type, which its address carries as a function
    --- pointer's signature.
    signature: any?
end

--- A name a body can read: a local's stack slot, or a module's global. A
--- global `cdef struct` is `aggregate`: its slot is the struct's storage,
--- which the name evaluates to the address of.
local record Local
    slot: string
    kind: Kind
    aggregate: Kind?
end

--- The lexical scopes of one body, innermost last.
local record Scope
    names: {[string]: Local}
    parent: Scope?
end

--- A lowered value.
local record Value
    text: string
    kind: Kind
end

--- A name a binding pattern selected from a required module.
local record Alias
    unit: Program
    member: string
end

--- One module's lowering. The modules of a program share the LLVM module,
--- the struct declarations and their layouts; names are each module's own.
local record Program
    module: builder.Module
    callees: {[string]: Callee}

    --- Top-level state, by name: a global every function of the module reads
    --- and writes. A `cdef struct` held in place is a pointer to its storage.
    globals: {[string]: Local}

    --- The modules this one requires, by the name each is bound to.
    imports: {[string]: Program}

    --- The names a binding pattern selected from the modules this one
    --- requires, each resolved where it is read.
    aliases: {[string]: Alias}

    --- What `export` makes visible to the modules requiring this one.
    exportedCallees: {[string]: Callee}

    --- The `export const`s, by name, as the literals they bind.
    exportedConstants: {[string]: any}

    --- The name other modules require this one by.
    name: string

    --- What symbols of the module's own are prefixed with: empty for the
    --- entry module, so a one-file program's IR is unchanged.
    prefix: string

    --- Top-level `const` literals, by name, lowered where they are read.
    constants: {[string]: any}

    --- The target triple, which `cdef struct` fields are laid out for.
    triple: string

    --- Every symbol a module of the program defines, shared by them all, so
    --- two `export`s of one name are refused rather than merged.
    symbols: {[string]: boolean}

    --- The program's `cdef struct` declarations, by their checked identity.
    aggregates: {[string]: cst.CdefStruct}

    --- Each laid-out struct's size and field offsets, by its checked type.
    layouts: {[any]: any}
end

--- The function being filled.
local record Body
    f: builder.Function
    scope: Scope
    result: Kind

    --- The labels a `break` leaves through, innermost last.
    exits: {string}

    --- The program the function belongs to.
    program: Program
end

local function lookup(scope: Scope?, name: string): Local?
    local current = scope
    while current ~= nil do
        local found = (current as Scope).names[name]
        if found ~= nil then
            return found
        end
        current = (current as Scope).parent
    end

    return nil
end

local function declareLocal(body: Body, name: string, kind: Kind): Local
    local slot = builder.alloca(body.f, kind.llvm)
    local entry = Local(slot = slot, kind = kind)
    body.scope.names[name] = entry

    return entry
end

local function enter(body: Body): nil
    body.scope = Scope(names = {}, parent = body.scope)
end

local function leave(body: Body): nil
    body.scope = body.scope.parent as Scope
end

local function value(body: Body, instruction: string): string
    return builder.value(body.f, instruction)
end

--- A saturating conversion of the binary64 `wide`, which LLVM defines for every
--- input: out of range it clamps, and NaN gives 0.
local function saturate(body: Body, wide: string, signed: boolean): string
    local intrinsic = signed and "llvm.fptosi.sat.i64.f64" or "llvm.fptoui.sat.i64.f64"
    builder.declare(body.program.module, "@" .. intrinsic, ("declare i64 @%s(double)"):format(intrinsic))

    return value(body, ("call i64 @%s(double %s)"):format(intrinsic, wide))
end

--- `wide` truncated toward zero as x86's `cvttsd2si` does it: out of range, and
--- for NaN, it gives the "integer indefinite" value, -2^63.
local function indefinite(body: Body, wide: string): string
    local clamped = saturate(body, wide, true)
    local fits = value(body, ("fcmp olt double %s, %s"):format(wide, llvmText.double(2 ^ 63)))

    return value(body, ("select i1 %s, i64 %s, i64 -9223372036854775808"):format(fits, clamped))
end

--- The binary64 `wide` truncated toward zero to 64 bits, as `lj_num2i64` does,
--- or, when `unsigned`, as `lj_num2u64` does. Their result out of range, and
--- for NaN or an infinity, is what the target's instructions give, so it is
--- reproduced per target: arm64's `fcvtzs` and `fcvtzu` saturate, and x86's
--- `cvttsd2si` gives -2^63, which `lj_num2u64` retries 2^64 lower. LLVM's own
--- `fptosi` and `fptoui` would give poison there instead.
local function integer64(body: Body, wide: string, unsigned: boolean): string
    local triple = body.program.triple
    if triple:match("^aarch64") ~= nil or triple:match("^arm64") ~= nil then
        local signed = saturate(body, wide, true)
        if not unsigned then
            return signed
        end
        local saturated = saturate(body, wide, false)
        local overflowed = value(body, "icmp eq i64 " .. signed .. ", 9223372036854775807")

        return value(body, ("select i1 %s, i64 %s, i64 %s"):format(overflowed, saturated, signed))
    end
    local first = indefinite(body, wide)
    if not unsigned then
        return first
    end
    local lowered = value(body, ("fsub double %s, %s"):format(wide, llvmText.double(2 ^ 64)))
    local retried = indefinite(body, lowered)
    local overflowed = value(body, "icmp eq i64 " .. first .. ", -9223372036854775808")

    return value(body, ("select i1 %s, i64 %s, i64 %s"):format(overflowed, retried, first))
end

--- `v` as `to`. `explicit` admits what only an `as` cast may do: pointers to
--- and from integers.
local function convert(body: Body, v: Value, to: Kind, node: any, explicit: boolean?): Value
    local from = v.kind
    if from.llvm == to.llvm then
        return Value(text = v.text, kind = to)
    end
    if to.llvm == "i1" then
        -- A pointer tests against NULL, the nil of `T*?`. A number is always
        -- true in the language, so testing one is written as a comparison.
        if from.llvm == "ptr" then
            return Value(text = value(body, "icmp ne ptr " .. v.text .. ", null"), kind = BOOL)
        end
        refuse(node, "a native condition is a boolean or a pointer; compare a number explicitly")
    elseif isInteger(to) and (isInteger(from) or from.llvm == "i1") then
        local wide, narrow = WIDTHS[to.llvm] as integer, WIDTHS[from.llvm] as integer
        local op = wide < narrow and "trunc" or (from.signed and from.llvm ~= "i1") and "sext" or "zext"
        return Value(text = value(body, ("%s %s %s to %s"):format(op, from.llvm, v.text, to.llvm)), kind = to)
    elseif isFloat(to) and isInteger(from) then
        local op = from.signed and "sitofp" or "uitofp"
        return Value(text = value(body, ("%s %s %s to %s"):format(op, from.llvm, v.text, to.llvm)), kind = to)
    elseif isInteger(to) and isFloat(from) then
        -- As LuaJIT's `lj_cconv_ct_ct` converts a number to a C integer:
        -- through binary64, then `lj_num2u64` for a `uint64_t` and `lj_num2i64`
        -- for every other, truncated, so a narrow field stored past its range
        -- wraps.
        local wide = from.llvm == "double" and v.text or value(body, "fpext float " .. v.text .. " to double")
        local whole = integer64(body, wide, to.llvm == "i64" and not to.signed)
        if to.llvm == "i64" then
            return Value(text = whole, kind = to)
        end
        return Value(text = value(body, ("trunc i64 %s to %s"):format(whole, to.llvm)), kind = to)
    elseif isFloat(to) and isFloat(from) then
        local op = to.llvm == "double" and "fpext" or "fptrunc"
        return Value(text = value(body, ("%s %s %s to %s"):format(op, from.llvm, v.text, to.llvm)), kind = to)
    elseif explicit and to.llvm == "ptr" and isInteger(from) then
        return Value(text = value(body, ("inttoptr %s %s to ptr"):format(from.llvm, v.text)), kind = to)
    elseif explicit and isInteger(to) and from.llvm == "ptr" then
        return Value(text = value(body, ("ptrtoint ptr %s to %s"):format(v.text, to.llvm)), kind = to)
    end
    refuse(node, ("a native program cannot convert %s to %s here"):format(from.llvm, to.llvm))
end

local expression: function(Program, Body, any, Kind?): Value

--- A numeric literal, in the kind it is wanted in when there is one, negated
--- when it is the operand of a unary minus. An `LL` or `ULL` literal is an
--- `int64` or `uint64` whatever it is wanted as, its value exact and wrapped to
--- 64 bits as LuaJIT reads it; any other is binary64 unless a C integer is
--- wanted, where the checker has already said it is exact.
local function number(node: cst.NumberLit, want: Kind?, negated: boolean?): Value
    local spelling = (node.token as lexer.Token).text
    local digits, suffix = spelling:match("^(.-)([uU]?[lL][lL])$")
    if digits ~= nil then
        local wide = (suffix as string):sub(1, 1):lower() == "u" and U64 or I64
        local text = llvmText.wideInteger(digits as string, wide == U64, negated)
        if text == nil then
            refuse(node, "a native program cannot represent the number " .. spelling)
        end
        return Value(text = text as string, kind = wide)
    end
    local parsed = tonumber(spelling)
    if parsed == nil then
        refuse(node, "a native program cannot represent the number " .. spelling)
    end
    local amount = negated and -(parsed as number) or parsed as number
    local selected = F64
    if want ~= nil and (isInteger(want as Kind) or isFloat(want as Kind)) then
        selected = want as Kind
    end
    if isInteger(selected) then
        if amount ~= math.floor(amount) or math.abs(amount) >= 2 ^ 63 then
            refuse(node, spelling .. " is not an integer")
        end
        return Value(text = llvmText.integer(amount), kind = selected)
    end
    if selected.llvm == "float" then
        return Value(text = llvmText.float(llvmText.roundToFloat(amount)), kind = selected)
    end

    return Value(text = llvmText.double(amount), kind = selected)
end

--- A string literal as a pointer to its NUL-terminated bytes.
local function stringConstant(program: Program, node: any): Value
    local token = (node as any).token as lexer.Token
    local bytes = lexer.stringValue(token.text)
    if bytes == nil then
        refuse(node, "a native program cannot read this string literal")
    end
    local name = builder.bytes(program.module, (bytes as string) .. "\0")

    return Value(text = name, kind = Kind(llvm = "ptr", signed = false, elem = INTEGERS.uint8))
end

--- The local, parameter or module global the name `name` reads, innermost first.
local function variable(program: Program, body: Body, name: string): Local?
    return lookup(body.scope, name) or program.globals[name]
end

--- The required module and member `node` names, when it is `m.name` with `m`
--- bound to a module this one requires.
local function memberOf(program: Program, body: Body, node: any): (Program?, string?)
    if node == nil or node.kind ~= "dotIndex" then
        return nil, nil
    end
    local index = node as cst.DotIndex
    local obj = index.obj as any
    if obj == nil or obj.kind ~= "name" or index.name == nil then
        return nil, nil
    end
    local name = ((obj as cst.NameExpr).token as lexer.Token).text
    if variable(program, body, name) ~= nil then
        return nil, nil
    end
    local required = program.imports[name]
    if required == nil then
        return nil, nil
    end

    return required, (index.name as lexer.Token).text
end

--- The literal the `export const` `m.name` binds in a module this one
--- requires, or a refusal at `node` when that module exports no such constant
--- or function.
local function importedConstant(required: Program, member: string, node: any): any
    local found = required.exportedConstants[member]
    if found == nil and required.exportedCallees[member] == nil then
        refuse(node, ("module %s exports no function or constant %s"):format(required.name, member))
    elseif found == nil then
        refuse(node, ("%s.%s is a function, which is not assigned"):format(required.name, member))
    end

    return found
end

--- The value of the local or global `entry`. A global `cdef struct` is the
--- address of its storage, which `.` reaches through and C takes as a pointer.
local function readVariable(body: Body, entry: Local): Value
    if entry.aggregate ~= nil then
        return Value(text = entry.slot, kind = entry.kind)
    end

    return Value(text = value(body, ("load %s, ptr %s"):format(entry.kind.llvm, entry.slot)), kind = entry.kind)
end

--- The function `callee` as a value: its address, which C takes as a callback
--- and a function pointer of its type calls back.
local function address(callee: Callee): Value
    return Value(text = "@" .. callee.symbol, kind = Kind(llvm = "ptr", signed = false, signature = callee.signature))
end

--- The callee a call or a function value names, if it names one.
local function calleeOf(program: Program, body: Body, node: any): Callee?
    local required, member = memberOf(program, body, node)
    if required ~= nil then
        return (required as Program).exportedCallees[member as string]
    end
    if node == nil or node.kind ~= "name" then
        return nil
    end
    local name = ((node as cst.NameExpr).token as lexer.Token).text
    if variable(program, body, name) ~= nil then
        return nil
    end
    local alias = program.aliases[name]
    if alias ~= nil then
        return (alias as Alias).unit.exportedCallees[(alias as Alias).member]
    end

    return program.callees[name]
end

--[[
Atomics. A native program declares libatomic's sized functions, such as
`__atomic_fetch_add_8`, and each call is lowered in place to the LLVM atomic
instruction it stands for, as a C compiler lowers its `__atomic` builtins; no
libatomic is linked. The memory orders are GCC's: 0 relaxed, 1 consume, 2
acquire, 3 release, 4 acq_rel, 5 seq_cst. An order that is not a literal is
seq_cst, as it is in C.
]]

--- The libatomic operations, by the name between `__atomic_` and the size, as
--- the LLVM operation each is lowered to.
const ATOMIC_OPERATIONS: {
    [string]: string
} = {
    load = "load",
    store = "store",
    exchange = "xchg",
    compare_exchange = "cmpxchg",
    fetch_add = "add",
    fetch_sub = "sub",
    fetch_and = "and",
    fetch_or = "or",
    fetch_xor = "xor",
    fetch_nand = "nand",
}

--- GCC's memory orders, indexed from 1, as LLVM's orderings.
const ATOMIC_ORDERS: {string} = {"monotonic", "acquire", "acquire", "release", "acq_rel", "seq_cst"}

--- The orders each kind of access admits; anything else is refused.
const LOAD_ORDERS: {[integer]: boolean} = {[0] = true, [1] = true, [2] = true, [5] = true}

const STORE_ORDERS: {[integer]: boolean} = {[0] = true, [3] = true, [5] = true}
const ANY_ORDER: {[integer]: boolean} = {[0] = true, [1] = true, [2] = true, [3] = true, [4] = true, [5] = true}

--- The LLVM types of an atomic operation's parameters and result at `width`.
local function atomicShape(operation: string, width: integer): ({string}, string)
    local w = "i" .. tostring(width)
    if operation == "load" then
        return {"ptr", "i32"}, w
    elseif operation == "store" then
        return {"ptr", w, "i32"}, "void"
    elseif operation == "cmpxchg" then
        return {"ptr", "ptr", w, "i32", "i32"}, "i1"
    end

    return {"ptr", w, "i32"}, w
end

--- `callee` as the atomic operation its declared name `name` stands for, or
--- unchanged when it names none.
local function atomicCallee(stat: any, name: string, callee: Callee): Callee
    local spelled, bytes = name:match("^__atomic_([%a_]+)_(%d+)$")
    if spelled == nil then
        return callee
    end
    local operation = ATOMIC_OPERATIONS[spelled as string]
    local width = (tonumber(bytes as string) as integer) * 8
    if operation == nil or WIDTHS["i" .. tostring(width)] == nil then
        refuse(stat, name .. " is not a libatomic operation a native program can lower")
    end
    local params, result = atomicShape(operation as string, width)
    local matches = #callee.params == #params and callee.result.llvm == result and not callee.varargs
    for index, kind in ipairs(callee.params) do
        matches = matches and kind.llvm == params[index]
    end
    if not matches then
        refuse(
            stat,
            ("%s takes (%s) and returns %s, as libatomic declares it"):format(name, table.concat(params, ", "), result)
        )
    end
    callee.atomic = operation
    callee.width = width

    return callee
end

--- The LLVM ordering of the memory order `node`, which `allowed` admits.
local function memoryOrder(program: Program, body: Body, node: any, allowed: {[integer]: boolean}): string
    local inner = node
    while inner ~= nil and inner.kind == "paren" do
        inner = (inner as cst.Paren).expr
    end
    if inner == nil or inner.kind ~= "number" then
        local _ = expression(program, body, node, I32)
        return "seq_cst"
    end
    local order = tonumber(((inner as cst.NumberLit).token as lexer.Token).text)
    if order == nil or not allowed[order as integer] then
        refuse(node, "memory order " .. tostring(order) .. " is not valid for this atomic operation")
    end

    return ATOMIC_ORDERS[(order as integer) + 1]
end

local function atomicCall(program: Program, body: Body, target: Callee, written: {any}): Value
    local operation = target.atomic as string
    local width = target.width as integer
    local w = "i" .. tostring(width)
    local align = tostring(width // 8)
    local argument = function(index: integer): string
        return convert(
            body,
            expression(program, body, written[index], target.params[index]),
            target.params[index],
            written[index]
        ).text
    end
    local address = argument(1)
    if operation == "load" then
        local ordering = memoryOrder(program, body, written[2], LOAD_ORDERS)
        local loaded = value(body, ("load atomic %s, ptr %s %s, align %s"):format(w, address, ordering, align))
        return Value(text = loaded, kind = target.result)
    elseif operation == "store" then
        local stored = argument(2)
        local ordering = memoryOrder(program, body, written[3], STORE_ORDERS)
        builder.emit(body.f, ("store atomic %s %s, ptr %s %s, align %s"):format(w, stored, address, ordering, align))
        return Value(text = "", kind = VOID)
    elseif operation == "cmpxchg" then
        -- `expected` receives what was there, which is what it held already
        -- when the exchange succeeded.
        local expected = argument(2)
        local desired = argument(3)
        local success = memoryOrder(program, body, written[4], ANY_ORDER)
        local failure = memoryOrder(program, body, written[5], LOAD_ORDERS)
        local old = value(body, ("load %s, ptr %s"):format(w, expected))
        local pair = value(
            body,
            (
                "cmpxchg ptr %s, %s %s, %s %s %s %s, align %s"
            ):format(address, w, old, w, desired, success, failure, align)
        )
        builder.emit(
            body.f,
            ("store %s %s, ptr %s"):format(w, value(body, ("extractvalue { %s, i1 } %s, 0"):format(w, pair)), expected)
        )
        return Value(text = value(body, ("extractvalue { %s, i1 } %s, 1"):format(w, pair)), kind = BOOL)
    end
    local operand = argument(2)
    local ordering = memoryOrder(program, body, written[3], ANY_ORDER)
    local old = value(
        body,
        ("atomicrmw %s ptr %s, %s %s %s, align %s"):format(operation, address, w, operand, ordering, align)
    )

    return Value(text = old, kind = target.result)
end

--- A standard-library call lowered in place, by its resolved identity, or nil.
local intrinsic: function(Program, Body, cst.Call): Value?

--- The source `node` was written as, without the whitespace around it.
local function spelled(node: any): string
    return (cst.textOf(node as cst.Child):match("^%s*(.-)%s*$")) as string
end

--- Whether `node` reads a value of the program's own: a local, a parameter or
--- module state, or a field or element reached from one, rather than a name
--- the program does not define.
local function own(program: Program, body: Body, node: any): boolean
    local root = node
    while root ~= nil and (root.kind == "paren" or root.kind == "dotIndex" or root.kind == "bracketIndex") do
        root = root.kind == "paren" and (root as cst.Paren).expr or root.obj
    end
    if root == nil or root.kind ~= "name" then
        return root ~= nil
    end
    local name = ((root as cst.NameExpr).token as lexer.Token).text

    return variable(program, body, name) ~= nil or program.imports[name] ~= nil
end

--- What a call through a pointer of the checked function type `t` passes and
--- returns, as a callee whose `symbol` names it in a refusal.
local function pointerCallee(t: any, node: any): Callee
    local name = spelled(node)
    local params: {Kind} = {}
    for index, param in ipairs(t.params) do
        local kind = kindOf(param)
        if kind == nil or (kind as Kind).llvm == "void" then
            refuse(
                node,
                ("parameter %d of %s has type %s, which has no C representation"):format(index, name, T.tostring(param))
            )
        end
        params[index] = kind as Kind
    end
    local result = VOID
    if #t.rets > 1 then
        refuse(node, name .. " returns more than one value")
    elseif #t.rets == 1 then
        local kind = kindOf(t.rets[1])
        if kind == nil then
            refuse(
                node,
                ("the result of %s has type %s, which has no C representation"):format(name, T.tostring(t.rets[1]))
            )
        end
        result = kind as Kind
    end

    return Callee(symbol = name, params = params, result = result, varargs = t.vararg == true, foreign = true)
end

local function call(program: Program, body: Body, node: cst.Call): Value
    local callee = calleeOf(program, body, node.obj)
    -- What is called: a function by its symbol, or a function pointer's value.
    local called: string
    if callee ~= nil then
        called = "@" .. (callee as Callee).symbol
    else
        local inlined = intrinsic(program, body, node)
        if inlined ~= nil then
            return inlined as Value
        end
        if not own(program, body, node.obj) then
            refuse(node, "a native program calls only the functions it defines and the C functions it declares")
        end
        local pointer = expression(program, body, node.obj, nil)
        if pointer.kind.signature == nil then
            refuse(node, spelled(node.obj) .. " is not a function pointer")
        end
        callee = pointerCallee(pointer.kind.signature, node.obj)
        called = pointer.text
    end
    local target = callee as Callee
    local written = node.args ~= nil and ((node.args as cst.Args).exprs or {}) or {}
    if node.args ~= nil and ((node.args as cst.Args).str ~= nil or (node.args as cst.Args).table ~= nil) then
        refuse(node, "a native call takes parenthesized arguments")
    end
    if #written < #target.params or #written > #target.params and not target.varargs then
        refuse(node, ("%s takes %d arguments, not %d"):format(target.symbol, #target.params, #written))
    end
    if target.atomic ~= nil then
        return atomicCall(program, body, target, written)
    end
    local arguments: {string} = {}
    for index, argument in ipairs(written) do
        local wanted = target.params[index]
        local lowered = expression(program, body, argument, wanted)
        if wanted == nil then
            -- What LuaJIT passes a variadic parameter: a number, refinements
            -- included, as a double, a boolean as an int, an `int64` as itself.
            if lowered.kind.llvm == "i1" then
                lowered = Value(text = value(body, "zext i1 " .. lowered.text .. " to i32"), kind = I32)
            elseif isFloat(lowered.kind) or isInteger(lowered.kind) and lowered.kind.llvm ~= "i64" then
                lowered = convert(body, lowered, F64, argument)
            end
        else
            lowered = convert(body, lowered, wanted as Kind, argument)
        end
        arguments[index] = lowered.kind.llvm .. extension(lowered.kind) .. " " .. lowered.text
    end
    local signature = target.result.llvm
    if target.varargs then
        local fixed: {string} = {}
        for index, kind in ipairs(target.params) do
            fixed[index] = kind.llvm
        end
        fixed[#fixed + 1] = "..."
        signature = signature .. " (" .. table.concat(fixed, ", ") .. ")"
    end
    local text = ("call %s %s(%s)"):format(signature, called, table.concat(arguments, ", "))
    if target.result.llvm == "void" then
        builder.emit(body.f, text)
        return Value(text = "", kind = VOID)
    end

    return Value(text = value(body, text), kind = target.result)
end

--- The kind two operands of an arithmetic operator meet in: a 64-bit integer
--- when either is one, as a LuaJIT `int64` absorbs a number, and binary64
--- otherwise. A `uint64` on either side makes the result unsigned.
local function common(left: Kind, right: Kind): Kind
    if left.llvm == "i64" or right.llvm == "i64" then
        local unsigned = left.llvm == "i64" and not left.signed or right.llvm == "i64" and not right.signed

        return unsigned and U64 or I64
    end

    return F64
end

local function libm(program: Program, name: string, kind: Kind): string
    local intrinsic = ("llvm.%s.%s"):format(name, kind.llvm == "float" and "f32" or "f64")
    local params = name == "pow" and kind.llvm .. ", " .. kind.llvm or kind.llvm
    builder.declare(program.module, "@" .. intrinsic, ("declare %s @%s(%s)"):format(kind.llvm, intrinsic, params))

    return "@" .. intrinsic
end

--- The standard functions a native program calls, by canonical identity: the
--- LLVM intrinsic each is, or for the establishing conversions, the kind it
--- establishes.
const INTRINSICS: {
    [string]: string
} = {
    ["math.floor"] = "floor",
    ["math.ceil"] = "ceil",
    ["math.abs"] = "fabs",
    ["math.sqrt"] = "sqrt",
    ["math.i32.wrap"] = "i32",
    ["math.u32.wrap"] = "u32",
    ["math.f32.narrow"] = "f32",
}

intrinsic = function(program: Program, body: Body, node: cst.Call): Value?
    local identity = lower.callIdentity(node.obj)
    local operation: string? = nil
    for name, selected in pairs(INTRINSICS) do
        if identity ~= nil and identity == apiidentity.canonical(name) then
            operation = selected
        end
    end
    if operation == nil then
        return nil
    end
    local written = node.args ~= nil and ((node.args as cst.Args).exprs or {}) or {}
    if #written ~= 1 then
        refuse(node, tostring(identity) .. " takes one argument")
    end
    local argument = convert(body, expression(program, body, written[1], F64), F64, written[1])
    if operation == "i32" or operation == "u32" then
        -- Modulo 2^32, as the checker's integer argument is whole.
        local whole = value(body, "fptosi double " .. argument.text .. " to i64")
        local kind = operation == "i32" and I32 or U32
        return Value(text = value(body, "trunc i64 " .. whole .. " to i32"), kind = kind)
    elseif operation == "f32" then
        return Value(text = value(body, "fptrunc double " .. argument.text .. " to float"), kind = F32)
    end
    local name = libm(program, operation as string, F64)

    return Value(text = value(body, ("call double %s(double %s)"):format(name, argument.text)), kind = F64)
end

const INT64_MIN = "-9223372036854775808"

--- `a / b` or `a % b` over 64-bit integers, as LuaJIT's `lj_carith_divi64` and
--- its kin compute them: C's truncating division, except that dividing by zero
--- gives INT64_MIN, and so does INT64_MIN / -1, whose remainder is 0. Those
--- cases divide by 1 instead, so the instruction itself is always defined.
local function integerDivision(body: Body, op: string, a: string, b: string, kind: Kind): string
    local zero = value(body, ("icmp eq i64 %s, 0"):format(b))
    local special = zero
    if kind.signed then
        local minusOne = value(body, ("icmp eq i64 %s, -1"):format(b))
        local least = value(body, ("icmp eq i64 %s, %s"):format(a, INT64_MIN))
        local overflow = value(body, ("and i1 %s, %s"):format(minusOne, least))
        special = value(body, ("or i1 %s, %s"):format(zero, overflow))
    end
    local divisor = value(body, ("select i1 %s, i64 1, i64 %s"):format(special, b))
    local instruction = (kind.signed and "s" or "u") .. (op == "%" and "rem" or "div")
    local result = value(body, ("%s i64 %s, %s"):format(instruction, a, divisor))

    -- INT64_MIN % 1 is already the 0 that INT64_MIN % -1 gives.
    local replaced = special
    if op == "%" then
        replaced = zero
    end

    return value(body, ("select i1 %s, i64 %s, i64 %s"):format(replaced, INT64_MIN, result))
end

--- Whether an operand is below zero as it was written, before it met the other
--- side's kind: a `uint64` never is, and a number by its own sign.
local function negative(body: Body, v: Value): string
    if isFloat(v.kind) then
        return value(body, ("fcmp olt %s %s, 0.0"):format(v.kind.llvm, v.text))
    elseif v.kind.signed then
        return value(body, ("icmp slt %s %s, 0"):format(v.kind.llvm, v.text))
    end

    return "false"
end

--- `left // right` over 64-bit integers, as the Lua backend's `__nuppFloorDiv`
--- computes it from LuaJIT's `/`: the truncated quotient, one lower when it was
--- inexact and the written operands differ in sign.
local function floorDivision(body: Body, left: Value, right: Value, a: string, b: string, kind: Kind): string
    local quotient = integerDivision(body, "/", a, b, kind)
    local product = value(body, ("mul i64 %s, %s"):format(quotient, b))
    local inexact = value(body, ("icmp ne i64 %s, %s"):format(product, a))
    local signs = value(body, ("xor i1 %s, %s"):format(negative(body, left), negative(body, right)))
    local adjust = value(body, ("and i1 %s, %s"):format(inexact, signs))
    local step = value(body, ("zext i1 %s to i64"):format(adjust))

    return value(body, ("sub i64 %s, %s"):format(quotient, step))
end

--- `left op right` over 64-bit integers, which wrap as LuaJIT's do.
local function integerArithmetic(
    body: Body,
    op: string,
    left: Value,
    right: Value,
    a: string,
    b: string,
    kind: Kind
): string
    if op == "/" or op == "%" then
        return integerDivision(body, op, a, b, kind)
    elseif op == "//" then
        return floorDivision(body, left, right, a, b, kind)
    end
    local instruction = op == "+" and "add" or op == "-" and "sub" or "mul"

    return value(body, ("%s %s %s, %s"):format(instruction, kind.llvm, a, b))
end

local function floatArithmetic(program: Program, body: Body, op: string, a: string, b: string, kind: Kind): string
    local t = kind.llvm
    if op == "+" then
        return value(body, ("fadd %s %s, %s"):format(t, a, b))
    elseif op == "-" then
        return value(body, ("fsub %s %s, %s"):format(t, a, b))
    elseif op == "*" then
        return value(body, ("fmul %s %s, %s"):format(t, a, b))
    elseif op == "/" then
        return value(body, ("fdiv %s %s, %s"):format(t, a, b))
    elseif op == "^" then
        return value(body, ("call %s %s(%s %s, %s %s)"):format(t, libm(program, "pow", kind), t, a, t, b))
    end
    local quotient = value(body, ("fdiv %s %s, %s"):format(t, a, b))
    local floored = value(body, ("call %s %s(%s %s)"):format(t, libm(program, "floor", kind), t, quotient))
    if op == "//" then
        return floored
    end
    local product = value(body, ("fmul %s %s, %s"):format(t, floored, b))

    return value(body, ("fsub %s %s, %s"):format(t, a, product))
end

const ORDERS: {
    [string]: {string}
} = {
    ["=="] = {"eq", "eq", "oeq"},
    ["~="] = {"ne", "ne", "une"},
    ["<"] = {"slt", "ult", "olt"},
    ["<="] = {"sle", "ule", "ole"},
    [">"] = {"sgt", "ugt", "ogt"},
    [">="] = {"sge", "uge", "oge"},
}

--- `and` or `or` over booleans, evaluating the right side only when needed.
local function logical(program: Program, body: Body, node: cst.Binop, op: string): Value
    local slot = builder.alloca(body.f, "i1", 1)
    local left = convert(body, expression(program, body, node.lhs, BOOL), BOOL, node.lhs)
    builder.emit(body.f, "store i1 " .. left.text .. ", ptr " .. slot)
    local right = builder.label(body.f, op)
    local done = builder.label(body.f, op .. ".done")
    if op == "and" then
        builder.terminate(body.f, ("br i1 %s, label %%%s, label %%%s"):format(left.text, right, done))
    else
        builder.terminate(body.f, ("br i1 %s, label %%%s, label %%%s"):format(left.text, done, right))
    end
    builder.start(body.f, right)
    local second = convert(body, expression(program, body, node.rhs, BOOL), BOOL, node.rhs)
    builder.emit(body.f, "store i1 " .. second.text .. ", ptr " .. slot)
    builder.start(body.f, done)

    return Value(text = value(body, "load i1, ptr " .. slot), kind = BOOL)
end

const BITWISE: {
    [string]: string
} = {["&"] = "and", ["|"] = "or", ["~"] = "xor", ["<<"] = "shl", [">>"] = "lshr", ["~>>"] = "ashr",}

--- A number as LuaJIT's bit operators read it: modulo 2^32, by adding
--- 2^52 + 2^51 and keeping the low word, which rounds a fraction to nearest.
--- A C integer narrower than 64 bits is already whole, so it only extends.
local function word(body: Body, v: Value, node: any): string
    if isInteger(v.kind) then
        return convert(body, v, v.kind.signed and I32 or U32, node).text
    end
    local wide = convert(body, v, F64, node).text
    local biased = value(body, ("fadd double %s, %s"):format(wide, llvmText.double(6755399441055744)))
    local bits = value(body, "bitcast double " .. biased .. " to i64")

    return value(body, "trunc i64 " .. bits .. " to i32")
end

--- An operand of a bit operator over 64-bit integers. A number truncates
--- toward zero, as `lj_num2i64` does, or, beside a `uint64`, as `lj_num2u64`
--- does; see `integer64`.
local function word64(body: Body, v: Value, kind: Kind, node: any): string
    if v.kind.llvm == "i64" then
        return v.text
    elseif isInteger(v.kind) then
        return convert(body, v, I64, node).text
    end

    return convert(body, v, kind, node).text
end

--- What a 32-bit bit operation gives: the signed word LuaJIT returns, as a
--- number, unless the checker established the result as `int32` or `uint32`.
local function bitResult(body: Body, node: any, result: string): Value
    local established = (node as any).fixedWidthEstablished
    if established ~= nil and established.uint32 then
        return Value(text = result, kind = U32)
    elseif established ~= nil and established.int32 then
        return Value(text = result, kind = I32)
    end

    return Value(text = value(body, "sitofp i32 " .. result .. " to double"), kind = F64)
end

--- `left op right` for a bit operator, as the patched LuaJIT's `lj_meta_bitop`
--- computes it. Numbers meet as 32-bit words, and a shift reads its count's
--- low five bits. An `int64` or `uint64` operand makes the operation 64-bit,
--- with a `uint64` making it unsigned, and a shift reads six bits; a shift
--- takes its width from its left operand alone.
local function bitwise(
    program: Program,
    body: Body,
    node: any,
    op: string,
    left: Value,
    right: Value,
    lhs: any,
    rhs: any
): Value
    local instruction = BITWISE[op] as string
    local shift = op == "<<" or op == ">>" or op == "~>>"
    local wide = left.kind.llvm == "i64" or not shift and right.kind.llvm == "i64"
    if not wide then
        -- A number shifted by a 64-bit count reads the count's low word, as
        -- `lj_carith_check64`'s result truncated to 32 bits.
        local a = word(body, left, lhs)
        local b = word(body, right, rhs)
        if shift then
            b = value(body, "and i32 " .. b .. ", 31")
        end

        return bitResult(body, node, value(body, ("%s i32 %s, %s"):format(instruction, a, b)))
    end
    local kind = shift and left.kind or common(left.kind, right.kind)
    local a = word64(body, left, kind, lhs)
    local b = word64(body, right, kind, rhs)
    if shift then
        b = value(body, "and i64 " .. b .. ", 63")
    end

    return Value(text = value(body, ("%s i64 %s, %s"):format(instruction, a, b)), kind = kind)
end

--- `left op right` once both sides are lowered. `node` is what a refusal names;
--- `lhs` and `rhs`, the operands' own nodes.
local function binaryValues(
    program: Program,
    body: Body,
    node: any,
    op: string,
    left: Value,
    right: Value,
    lhs: any,
    rhs: any
): Value
    local order = ORDERS[op]
    if order ~= nil then
        if left.kind.llvm == "ptr" or right.kind.llvm == "ptr" then
            if op ~= "==" and op ~= "~=" then
                refuse(node, "pointers compare only for equality")
            end
            local a = left.kind.llvm == "ptr" and left.text or "null"
            local b = right.kind.llvm == "ptr" and right.text or "null"
            return Value(text = value(body, ("icmp %s ptr %s, %s"):format(order[1], a, b)), kind = BOOL)
        end
        if left.kind.llvm == "i1" and right.kind.llvm == "i1" then
            if op ~= "==" and op ~= "~=" then
                refuse(node, "booleans compare only for equality")
            end
            return Value(text = value(body, ("icmp %s i1 %s, %s"):format(order[1], left.text, right.text)), kind = BOOL)
        end
    end
    local arithmetic = left.kind.llvm ~= "ptr"
        and left.kind.llvm ~= "i1"
        and left.kind.llvm ~= "void"
        and right.kind.llvm ~= "ptr"
        and right.kind.llvm ~= "i1"
        and right.kind.llvm ~= "void"
    if not arithmetic then
        refuse(node, "the operands of " .. op .. " must be numbers in a native program")
    end
    if BITWISE[op] ~= nil then
        return bitwise(program, body, node, op, left, right, lhs, rhs)
    end
    local meet = common(left.kind, right.kind)
    if order == nil and meet.llvm == "i64" and op == "^" then
        refuse(node, "a native program does not lower " .. op .. " over 64-bit integers")
    end
    local a = convert(body, left, meet, lhs).text
    local b = convert(body, right, meet, rhs).text
    if order ~= nil then
        if isFloat(meet) then
            return Value(text = value(body, ("fcmp %s %s %s, %s"):format(order[3], meet.llvm, a, b)), kind = BOOL)
        end
        local predicate = meet.signed and order[1] or order[2]
        return Value(text = value(body, ("icmp %s %s %s, %s"):format(predicate, meet.llvm, a, b)), kind = BOOL)
    end
    if isFloat(meet) then
        return Value(text = floatArithmetic(program, body, op, a, b, meet), kind = meet)
    end

    return Value(text = integerArithmetic(body, op, left, right, a, b, meet), kind = meet)
end

local function binary(program: Program, body: Body, node: cst.Binop, want: Kind?): Value
    local op = (node.op as lexer.Token).text
    if op == "and" or op == "or" then
        return logical(program, body, node, op)
    end
    if op == ".." then
        refuse(node, "a native program cannot concatenate strings")
    end

    -- A literal operand takes the other side's kind, so `n < 10` compares in
    -- `n`'s width rather than widening it. A literal has no effects, so reading
    -- the other side first changes nothing. A bit operator's literal stays a
    -- number, as it is under LuaJIT, and is converted as LuaJIT converts one:
    -- modulo 2^32, or beside a 64-bit integer, truncated.
    local function operand(v: Value): Kind?
        if BITWISE[op] ~= nil then
            return nil
        end
        return (v.kind.llvm ~= "ptr" and v.kind.llvm ~= "void") and v.kind or nil
    end

    if (node.lhs as any).kind == "number" and (node.rhs as any).kind ~= "number" then
        local right = expression(program, body, node.rhs, nil)
        local left = expression(program, body, node.lhs, operand(right))
        return binaryValues(program, body, node, op, left, right, node.lhs, node.rhs)
    end
    local left = expression(program, body, node.lhs, ORDERS[op] == nil and BITWISE[op] == nil and want or nil)
    local right = expression(program, body, node.rhs, operand(left))

    return binaryValues(program, body, node, op, left, right, node.lhs, node.rhs)
end

local function unary(program: Program, body: Body, node: cst.Unop, want: Kind?): Value
    local op = (node.op as lexer.Token).text
    if op == "not" then
        local operand = convert(body, expression(program, body, node.operand, BOOL), BOOL, node.operand)
        return Value(text = value(body, "xor i1 " .. operand.text .. ", true"), kind = BOOL)
    elseif op == "-" then
        if (node.operand as any).kind == "number" then
            return number(node.operand as cst.NumberLit, want, true)
        end
        local operand = expression(program, body, node.operand, nil)
        if operand.kind.llvm == "i64" then
            return Value(text = value(body, "sub i64 0, " .. operand.text), kind = operand.kind)
        elseif isInteger(operand.kind) or isFloat(operand.kind) then
            local wide = convert(body, operand, F64, node.operand)
            return Value(text = value(body, "fneg double " .. wide.text), kind = F64)
        end
    elseif op == "~" then
        local operand = expression(program, body, node.operand, nil)
        if operand.kind.llvm == "i64" then
            return Value(text = value(body, "xor i64 " .. operand.text .. ", -1"), kind = operand.kind)
        elseif isInteger(operand.kind) or isFloat(operand.kind) then
            return bitResult(body, node, value(body, "xor i32 " .. word(body, operand, node.operand) .. ", -1"))
        end
    end
    refuse(node, "a native program cannot apply " .. op .. " here")
end

--- The layout of the `cdef struct` `t` on the program's target: its size and
--- each field's offset. What the target layout model would not place as C
--- does is refused at `node`, the access that needed the layout, so a struct
--- only ever passed by pointer needs none.
local function layoutOf(program: Program, t: any, node: any): any
    local cached = program.layouts[t]
    if cached ~= nil then
        return cached
    end
    -- Every struct a by-value field nests is placed by the same model, so each
    -- is checked for what the model does not represent.
    local pending: {any} = {t}
    local seen: {[any]: boolean} = {}
    while #pending > 0 do
        local current = table.remove(pending)
        if not seen[current] then
            seen[current] = true
            local name = tostring(current.cdefName)
            local declared = program.aggregates[tostring(current.cdefIdentity)]
            if declared == nil then
                refuse(node, "cdef struct " .. name .. " is not declared by this native program")
            end
            if current.cdefKind == "union" then
                refuse(node, name .. " is a cdef union, which a native program does not lay out")
            end
            for _, entry in ipairs((declared as cst.CdefStruct).entries) do
                local field = entry as cst.FieldDecl
                if entry.kind == "fieldDecl" and field.bitWidth ~= nil and field.name ~= nil then
                    refuse(
                        node,
                        (
                            "field %s of cdef struct %s is a bitfield, which a native program does not lay out"
                        ):format((field.name as lexer.Token).text, name)
                    )
                end
            end
            for _, fieldName in ipairs(current.fieldOrder or {}) do
                local fieldType = bare(current.byname[fieldName])
                while fieldType.tag == "carray" do
                    fieldType = bare(fieldType.elem)
                end
                if isAggregate(fieldType) then
                    pending[#pending + 1] = fieldType
                end
            end
        end
    end
    local layout, why = targetLayout.of(t, program.triple)
    if layout == nil then
        refuse(
            node,
            ("cdef struct %s has no layout on %s: %s"):format(tostring(t.cdefName), program.triple, tostring(why))
        )
    end
    program.layouts[t] = layout

    return layout
end

--- The address of `p[i]`, and what is stored there.
local function element(program: Program, body: Body, node: cst.BracketIndex): (string, Kind)
    local base = expression(program, body, node.obj, nil)
    if base.kind.llvm ~= "ptr" or base.kind.elem == nil then
        refuse(node, "a native program indexes only pointers to C scalars, pointers and cdef structs")
    end
    local elem = base.kind.elem as Kind
    -- A struct strides by its size on the target, padding included.
    local stride = elem.aggregate ~= nil and ("[%d x i8]"):format(layoutOf(program, elem.aggregate, node).size)
        or elem.llvm
    local index = expression(program, body, node.expr, I64)
    if not isInteger(index.kind) and not isFloat(index.kind) then
        refuse(node.expr, "a pointer index must be a number")
    end
    local wide = convert(body, index, I64, node.expr)
    local address = value(body, ("getelementptr %s, ptr %s, i64 %s"):format(stride, base.text, wide.text))

    return address, elem
end

--- How a field of type `t` is held: as it is stored, and as the program reads
--- it. They differ where C's storage is not the value's kind: a `boolean` is a
--- byte, and an `integer`, binary64 when read, is an `int32_t`.
local function fieldKinds(t: any, field: string, owner: string, node: any): (Kind, Kind)
    local raw = bare(t)
    if isAggregate(raw) then
        local nested = Kind(llvm = "struct", signed = false, aggregate = raw)
        return nested, nested
    elseif raw.tag == "carray" then
        refuse(
            node,
            ("field %s of cdef struct %s is a C array, which a native program does not index"):format(field, owner)
        )
    elseif raw.tag == "boolean" then
        return INTEGERS.uint8 as Kind, BOOL
    elseif raw.tag == "integer" then
        return I32, F64
    end
    local kind = kindOf(t)
    if kind == nil or (kind as Kind).llvm == "void" then
        refuse(
            node,
            (
                "field %s of cdef struct %s has type %s, which a native program cannot read"
            ):format(field, owner, T.tostring(t))
        )
    end

    return kind as Kind, kind as Kind
end

--- Where the field or element `node` names lives: its address, the kind
--- stored there, and the kind the program reads it as.
local place: function(Program, Body, any): (string, Kind, Kind)

--- The address of the struct `node` names, and its kind: a field or element
--- holding one in place, or a pointer to one, which `.` reaches through as
--- LuaJIT's does.
local function aggregatePlace(program: Program, body: Body, node: any): (string, Kind)
    local kind = node ~= nil and node.kind or nil
    if kind == "paren" then
        return aggregatePlace(program, body, (node as cst.Paren).expr)
    elseif (kind == "dotIndex" or kind == "bracketIndex") and memberOf(program, body, node) == nil then
        local address, stored = place(program, body, node)
        if stored.aggregate ~= nil then
            return address, stored
        elseif stored.llvm == "ptr" and stored.elem ~= nil and (stored.elem as Kind).aggregate ~= nil then
            return value(body, "load ptr, ptr " .. address), stored.elem as Kind
        end
    else
        local base = expression(program, body, node, nil)
        if base.kind.llvm == "ptr" and base.kind.elem ~= nil and (base.kind.elem as Kind).aggregate ~= nil then
            return base.text, base.kind.elem as Kind
        end
    end
    refuse(node, "a native program reads fields only of cdef structs, in place or through a pointer")
end

place = function(program: Program, body: Body, node: any): (string, Kind, Kind)
    if node.kind == "bracketIndex" then
        local address, elem = element(program, body, node as cst.BracketIndex)
        return address, elem, elem
    end
    local index = node as cst.DotIndex
    local base, owner = aggregatePlace(program, body, index.obj)
    local t = owner.aggregate
    local name = tostring(t.cdefName)
    local field = (index.name as lexer.Token).text
    local fieldType = t.byname ~= nil and t.byname[field] or nil
    if fieldType == nil then
        refuse(node, "cdef struct " .. name .. " has no field " .. field)
    end
    local stored, read = fieldKinds(fieldType, field, name, node)
    local offset = layoutOf(program, t, node).offsets[field] as integer
    local address = offset == 0 and base or value(body, ("getelementptr i8, ptr %s, i64 %d"):format(base, offset))

    return address, stored, read
end

--- What is stored at `address`, read as `read`.
local function readPlace(body: Body, address: string, stored: Kind, read: Kind, node: any): Value
    if read.aggregate ~= nil then
        refuse(node, "a native program reads a cdef struct's fields, not the whole struct")
    end
    local loaded = Value(text = value(body, ("load %s, ptr %s"):format(stored.llvm, address)), kind = stored)
    if read.llvm == "i1" and stored.llvm ~= "i1" then
        return Value(text = value(body, ("icmp ne %s %s, 0"):format(stored.llvm, loaded.text)), kind = BOOL)
    end

    return convert(body, loaded, read, node)
end

--- Stores `v` at `address` as the program writes `read` and C holds `stored`.
local function writePlace(body: Body, address: string, stored: Kind, read: Kind, v: Value, node: any): nil
    if read.aggregate ~= nil then
        refuse(node, "a native program assigns a cdef struct's fields, not the whole struct")
    end
    local converted = convert(body, convert(body, v, read, node), stored, node)
    builder.emit(body.f, ("store %s %s, ptr %s"):format(stored.llvm, converted.text, address))
end

--- `node` as a value. `want` is the kind its context takes, which a literal
--- is spelled in directly; the caller still converts whatever comes back.
expression = function(program: Program, body: Body, node: any, want: Kind?): Value
    local kind = node ~= nil and node.kind or nil
    if kind == "paren" then
        return expression(program, body, (node as cst.Paren).expr, want)
    elseif kind == "number" then
        return number(node as cst.NumberLit, want)
    elseif kind == "string" then
        return stringConstant(program, node)
    elseif kind == "nilExpr" then
        return Value(text = "null", kind = PTR)
    elseif kind == "trueExpr" then
        return Value(text = "true", kind = BOOL)
    elseif kind == "falseExpr" then
        return Value(text = "false", kind = BOOL)
    elseif kind == "name" then
        local name = ((node as cst.NameExpr).token as lexer.Token).text
        local found = variable(program, body, name)
        if found ~= nil then
            return readVariable(body, found as Local)
        end
        local constant = program.constants[name]
        if constant ~= nil then
            return expression(program, body, constant, want)
        end
        local callee = program.callees[name]
        if callee ~= nil then
            if (callee as Callee).atomic ~= nil then
                refuse(node, name .. " is lowered in place, so it has no address")
            end
            -- A function as a value is its address: what C takes as a callback.
            return address(callee as Callee)
        end
        local alias = program.aliases[name]
        if alias ~= nil then
            local selected = alias as Alias
            local exported = selected.unit.exportedCallees[selected.member]
            if exported ~= nil then
                return address(exported as Callee)
            end
            return expression(program, body, importedConstant(selected.unit, selected.member, node), want)
        end
        refuse(node, name .. " is not a local, a parameter or a function of this native program")
    elseif kind == "call" then
        return call(program, body, node as cst.Call)
    elseif kind == "binop" then
        return binary(program, body, node as cst.Binop, want)
    elseif kind == "unop" then
        return unary(program, body, node as cst.Unop, want)
    elseif kind == "castExpr" then
        local cast = node as cst.CastExpr
        local to = annotated(cast.type, "a cast", (node as any).inferredType)
        local inner = expression(program, body, cast.expr, nil)
        if to.llvm == "ptr" and inner.kind.llvm == "ptr" then
            return Value(text = inner.text, kind = to)
        end
        return convert(body, inner, to, node, true)
    elseif kind == "bracketIndex" or kind == "dotIndex" then
        local required, member = memberOf(program, body, node)
        if required ~= nil then
            local callee = (required as Program).exportedCallees[member as string]
            if callee ~= nil then
                return address(callee as Callee)
            end
            return expression(program, body, importedConstant(required as Program, member as string, node), want)
        end
        local address, stored, read = place(program, body, node)
        return readPlace(body, address, stored, read, node)
    end
    refuse(node, "a native program cannot evaluate " .. tostring(kind) .. " expressions")
end

local block: function(Program, Body, any): nil

local function condition(program: Program, body: Body, node: any): string
    return convert(body, expression(program, body, node, BOOL), BOOL, node).text
end

local function store(body: Body, entry: Local, v: Value, node: any): nil
    if entry.aggregate ~= nil then
        refuse(node, "a native program assigns a cdef struct's fields, not the whole struct")
    end
    local converted = convert(body, v, entry.kind, node)
    builder.emit(body.f, ("store %s %s, ptr %s"):format(entry.kind.llvm, converted.text, entry.slot))
end

local function localStmt(program: Program, body: Body, stat: cst.LocalStmt): nil
    if stat.pattern ~= nil then
        refuse(stat, "a native program cannot destructure")
    end
    local exprs = stat.exprs or {}
    if #exprs > #stat.names then
        refuse(stat, "a native local binds one value per name")
    end
    local values: {Value} = {}
    local kinds: {Kind} = {}
    for index, name in ipairs(stat.names) do
        local written = stat.types[index]
        local kind: Kind? = written ~= nil and annotated(written, "local " .. name.text) or nil
        local initial = exprs[index]
        if initial ~= nil then
            values[index] = expression(program, body, initial, kind)
            if kind == nil then
                kind = values[index].kind
                if kind.llvm == "void" then
                    refuse(initial, "local " .. name.text .. " is bound to a call with no result")
                end
                if kind.llvm == "ptr" and (initial as any).kind == "nilExpr" then
                    refuse(stat, "local " .. name.text .. " needs a written pointer type")
                end
            end
        elseif kind == nil then
            refuse(stat, "local " .. name.text .. " needs a written C type or a value")
        end
        kinds[index] = kind as Kind
    end
    -- Bound after every value is read, as `local a, b = b, a` reads the outer names.
    for index, name in ipairs(stat.names) do
        local entry = declareLocal(body, name.text, kinds[index])
        if values[index] ~= nil then
            store(body, entry, values[index], exprs[index])
        elseif kinds[index].llvm == "ptr" then
            builder.emit(body.f, "store ptr null, ptr " .. entry.slot)
        elseif isFloat(kinds[index]) then
            builder.emit(body.f, ("store %s 0.0, ptr %s"):format(kinds[index].llvm, entry.slot))
        else
            builder.emit(body.f, ("store %s 0, ptr %s"):format(kinds[index].llvm, entry.slot))
        end
    end
end

local function assign(program: Program, body: Body, target: any, v: any): nil
    if target.kind == "name" then
        local name = ((target as cst.NameExpr).token as lexer.Token).text
        local found = variable(program, body, name)
        if found == nil then
            refuse(target, "a native program assigns only its own locals and module state")
        end
        local entry = found as Local
        store(body, entry, expression(program, body, v, entry.kind), v)
        return
    elseif target.kind == "bracketIndex" or target.kind == "dotIndex" then
        local required, member = memberOf(program, body, target)
        if required ~= nil then
            importedConstant(required as Program, member as string, target)
            refuse(target, "a module's exports are constant; its own functions assign its state")
        end
        local address, stored, read = place(program, body, target)
        writePlace(body, address, stored, read, expression(program, body, v, read), v)
        return
    end
    refuse(target, "a native program cannot assign to this")
end

local function returnStmt(program: Program, body: Body, stat: cst.ReturnStmt): nil
    if #stat.exprs > 1 then
        refuse(stat, "a native function returns at most one value")
    end
    if body.result.llvm == "void" then
        if #stat.exprs == 1 then
            refuse(stat, "this native function returns nothing")
        end
        builder.terminate(body.f, "ret void")
        return
    end
    if #stat.exprs == 0 then
        refuse(stat, "this native function must return a value")
    end
    local returned = convert(body, expression(program, body, stat.exprs[1], body.result), body.result, stat.exprs[1])
    builder.terminate(body.f, ("ret %s %s"):format(body.result.llvm, returned.text))
end

local function ifStmt(program: Program, body: Body, stat: cst.IfStmt): nil
    local done = builder.label(body.f, "if.done")
    for _, clause in ipairs(stat.clauses) do
        if (clause as any).binding ~= nil then
            refuse(clause, "a native condition cannot bind a name")
        end
        local test = condition(program, body, (clause as any).cond)
        local taken = builder.label(body.f, "if.then")
        local otherwise = builder.label(body.f, "if.else")
        builder.terminate(body.f, ("br i1 %s, label %%%s, label %%%s"):format(test, taken, otherwise))
        builder.start(body.f, taken)
        block(program, body, (clause as any).body)
        builder.jump(body.f, done)
        builder.start(body.f, otherwise)
    end
    if stat.elseClause ~= nil then
        block(program, body, (stat.elseClause as cst.ElseClause).body)
    end
    builder.start(body.f, done)
end

local function whileStmt(program: Program, body: Body, stat: cst.WhileStmt): nil
    local head = builder.label(body.f, "while.head")
    local loop = builder.label(body.f, "while.body")
    local done = builder.label(body.f, "while.done")
    builder.start(body.f, head)
    local test = condition(program, body, stat.cond)
    builder.terminate(body.f, ("br i1 %s, label %%%s, label %%%s"):format(test, loop, done))
    builder.start(body.f, loop)
    body.exits[#body.exits + 1] = done
    block(program, body, stat.body)
    body.exits[#body.exits] = nil
    builder.jump(body.f, head)
    builder.start(body.f, done)
end

local function repeatStmt(program: Program, body: Body, stat: cst.RepeatStmt): nil
    local loop = builder.label(body.f, "repeat.body")
    local done = builder.label(body.f, "repeat.done")
    builder.start(body.f, loop)
    body.exits[#body.exits + 1] = done
    -- The condition sees the body's locals.
    enter(body)
    local statements = stat.body ~= nil and ((stat.body as cst.Block).stats or {}) or {}
    for _, inner in ipairs(statements) do
        block(program, body, inner)
    end
    local test = condition(program, body, stat.cond)
    leave(body)
    body.exits[#body.exits] = nil
    builder.terminate(body.f, ("br i1 %s, label %%%s, label %%%s"):format(test, done, loop))
    builder.start(body.f, done)
end

local function fornumStmt(program: Program, body: Body, stat: cst.FornumStmt): nil
    local first = expression(program, body, stat.start, nil)
    local last = expression(program, body, stat.stop, first.kind)
    local step = stat.step ~= nil and expression(program, body, stat.step, first.kind) or nil
    local kind = common(first.kind, last.kind)
    if step ~= nil then
        kind = common(kind, (step as Value).kind)
    end
    if not isInteger(kind) and not isFloat(kind) then
        refuse(stat, "a numeric for counts with numbers")
    end
    local stepValue = step ~= nil and convert(body, step as Value, kind, stat.step)
        or Value(text = isFloat(kind) and llvmText.double(1) or "1", kind = kind)
    local stopValue = convert(body, last, kind, stat.stop)
    enter(body)
    local counter = declareLocal(body, "\0counter", kind)
    store(body, counter, first, stat.start)
    local head = builder.label(body.f, "for.head")
    local loop = builder.label(body.f, "for.body")
    local continue = builder.label(body.f, "for.next")
    local done = builder.label(body.f, "for.done")
    builder.start(body.f, head)
    local current = value(body, ("load %s, ptr %s"):format(kind.llvm, counter.slot))
    -- The direction is the step's sign, decided when the loop runs.
    local float = isFloat(kind)
    local compare = float and "fcmp" or "icmp"
    local s = kind.signed and "s" or "u"
    local up = float and value(body, ("fcmp oge %s %s, 0.0"):format(kind.llvm, stepValue.text))
        or kind.signed and value(body, ("icmp sge %s %s, 0"):format(kind.llvm, stepValue.text))
        or "true"
    local within = value(
        body,
        ("%s %s %s %s, %s"):format(compare, float and "ole" or s .. "le", kind.llvm, current, stopValue.text)
    )
    local down = value(
        body,
        ("%s %s %s %s, %s"):format(compare, float and "oge" or s .. "ge", kind.llvm, current, stopValue.text)
    )
    local test = value(body, ("select i1 %s, i1 %s, i1 %s"):format(up, within, down))
    builder.terminate(body.f, ("br i1 %s, label %%%s, label %%%s"):format(test, loop, done))
    builder.start(body.f, loop)
    enter(body)
    local variable = declareLocal(body, (stat.var as lexer.Token).text, kind)
    builder.emit(body.f, ("store %s %s, ptr %s"):format(kind.llvm, current, variable.slot))
    body.exits[#body.exits + 1] = done
    block(program, body, stat.body)
    body.exits[#body.exits] = nil
    leave(body)
    builder.start(body.f, continue)
    local now = value(body, ("load %s, ptr %s"):format(kind.llvm, counter.slot))
    local nextValue = isFloat(kind) and value(body, ("fadd %s %s, %s"):format(kind.llvm, now, stepValue.text))
        or value(body, ("add %s %s, %s"):format(kind.llvm, now, stepValue.text))
    builder.emit(body.f, ("store %s %s, ptr %s"):format(kind.llvm, nextValue, counter.slot))
    builder.jump(body.f, head)
    builder.start(body.f, done)
    leave(body)
end

local function statement(program: Program, body: Body, stat: any): nil
    local kind = stat.kind
    if kind == "block" then
        enter(body)
        for _, inner in ipairs((stat as cst.Block).stats or {}) do
            statement(program, body, inner)
        end
        leave(body)
    elseif kind == "emptyStmt" then
        return
    elseif kind == "localStmt" then
        localStmt(program, body, stat as cst.LocalStmt)
    elseif kind == "assignStmt" then
        local assignment = stat as cst.AssignStmt
        if #assignment.targets ~= 1 or #assignment.exprs ~= 1 then
            refuse(stat, "a native assignment sets one target")
        end
        assign(program, body, assignment.targets[1], assignment.exprs[1])
    elseif kind == "compoundAssign" then
        local compound = stat as cst.CompoundAssign
        local op = ((compound.op as lexer.Token).text):sub(1, -2)
        local target = compound.target
        local targetKind = target ~= nil and (target as any).kind or nil
        local required, member = memberOf(program, body, target)
        if required ~= nil then
            importedConstant(required as Program, member as string, target)
            refuse(target, "a module's exports are constant; its own functions assign its state")
        end
        if targetKind == "dotIndex" or targetKind == "bracketIndex" then
            local address, stored, read = place(program, body, target)
            local current = readPlace(body, address, stored, read, target)
            local operand = expression(program, body, compound.value, current.kind)
            local updated = binaryValues(program, body, stat, op, current, operand, target, compound.value)
            writePlace(body, address, stored, read, updated, stat)
            return
        end
        local found = target ~= nil
            and (target as any).kind == "name"
            and variable(program, body, ((target as cst.NameExpr).token as lexer.Token).text)
            or nil
        if found == nil then
            refuse(stat, "a native compound assignment updates a local, module state, a field or an element")
        end
        local current = expression(program, body, target, nil)
        local wanted = BITWISE[op] == nil and current.kind or nil
        local operand = expression(program, body, compound.value, wanted)
        store(
            body,
            found as Local,
            binaryValues(program, body, stat, op, current, operand, target, compound.value),
            stat
        )
    elseif kind == "callStmt" then
        local expr = (stat as cst.CallStmt).expr
        if expr == nil or (expr as any).kind ~= "call" then
            refuse(stat, "a native program cannot call this")
        end
        call(program, body, expr as cst.Call)
    elseif kind == "returnStmt" then
        returnStmt(program, body, stat as cst.ReturnStmt)
    elseif kind == "ifStmt" then
        ifStmt(program, body, stat as cst.IfStmt)
    elseif kind == "whileStmt" then
        whileStmt(program, body, stat as cst.WhileStmt)
    elseif kind == "repeatStmt" then
        repeatStmt(program, body, stat as cst.RepeatStmt)
    elseif kind == "fornumStmt" then
        fornumStmt(program, body, stat as cst.FornumStmt)
    elseif kind == "doStmt" then
        block(program, body, (stat as cst.DoStmt).body)
    elseif kind == "pragmaStmt" then
        -- `@unsafe` is a promise to the checker, and changes nothing that runs.
        local pragma = stat as cst.PragmaStmt
        if pragma.name == nil or (pragma.name as lexer.Token).text ~= "unsafe" then
            refuse(stat, "a native program cannot apply this annotation")
        end
        block(program, body, pragma.stat)
    elseif kind == "breakStmt" then
        local exit = body.exits[#body.exits]
        if exit == nil then
            refuse(stat, "break outside a loop")
        end
        builder.terminate(body.f, "br label %" .. exit)
    else
        refuse(stat, "a native program cannot run a " .. tostring(kind))
    end
end

block = function(program: Program, body: Body, node: any): nil
    if node ~= nil then
        statement(program, body, node)
    end
end

--- A function the program defines: its name, body, and C signature.
local record Definition
    name: string
    node: any
    funcbody: cst.Funcbody
    callee: Callee
    paramNames: {string}
end

local function definition(stat: any): (string?, cst.Funcbody?)
    if stat.kind == "localFuncStmt" then
        local named = stat as cst.LocalFuncStmt
        return named.name ~= nil and (named.name as lexer.Token).text or nil, named.body as cst.Funcbody?
    elseif stat.kind == "funcStmt" then
        local named = stat as cst.FuncStmt
        local funcname = named.name
        if funcname == nil or (funcname as any).kind ~= "funcname" then
            return nil, nil
        end
        local parts = funcname as cst.Funcname
        if parts.method ~= nil or cst.textOf(parts):find("[.:]") ~= nil then
            refuse(stat, "a native program defines plain functions, not methods or fields")
        end
        return parts.base ~= nil and (parts.base as lexer.Token).text or nil, named.body as cst.Funcbody?
    end

    return nil, nil
end

--- The C signature of the function `name` that `stat` defines in `program`.
--- `public` is an `export function`, defined under its own name; `main` is the
--- entry module's.
local function signature(
    program: Program,
    name: string,
    stat: any,
    funcbody: cst.Funcbody,
    public: boolean,
    entry: boolean
): Definition
    local params: {Kind} = {}
    local names: {string} = {}
    for index, param in ipairs(funcbody.params) do
        local p = param as cst.Param
        if p.vararg or p.name == nil then
            refuse(param, "a native function takes named parameters")
        end
        names[index] = (p.name as lexer.Token).text
        params[index] = annotated(p.type, "parameter " .. names[index])
        if params[index].llvm == "void" then
            refuse(param, "parameter " .. names[index] .. " cannot be nil")
        end
    end
    local rets = funcbody.rets or {}
    local pack = funcbody.returnPack as any
    if #rets > 1 or pack ~= nil and (pack.kind ~= "tpack" or pack.tail ~= nil) then
        refuse(stat, "a native function returns at most one value")
    end
    local checked = (funcbody as any).signatureType
    if checked == nil or checked.tag ~= "func" then
        refuse(stat, "the checker did not resolve the signature of " .. name)
    end
    local result = VOID
    if #rets == 1 then
        local kind = kindOf(checked.rets[1])
        if kind == nil then
            refuse(
                rets[1],
                "the result of " .. name .. " has type " .. cst.textOf(rets[1]) .. ", which has no C representation"
            )
        end
        result = kind as Kind
    end
    local symbol = public and name or "nupp." .. program.prefix .. name
    if name == "main" and entry then
        symbol = "main"
        local integral = result.llvm == "void" or result.llvm == "i32"
        if not integral then
            refuse(stat, "main returns its exit status as an int32")
        end
        if #params ~= 0 and (#params ~= 2 or params[1].llvm ~= "i32" or params[2].llvm ~= "ptr") then
            refuse(stat, "main takes nothing, or (argc: int32, argv: cstring*)")
        end
    end

    return Definition(
        name = name,
        node = stat,
        funcbody = funcbody,
        callee = Callee(
            symbol = symbol,
            params = params,
            result = result,
            varargs = false,
            foreign = false,
            public = public or symbol == "main",
            signature = checked
        ),
        paramNames = names
    )
end

local function foreign(stat: cst.CdefFunc): Callee
    local name = (stat.name as lexer.Token).text
    local physical = stat.physicalSignatureType
    if physical == nil or physical.tag ~= "func" then
        refuse(stat, "the checker did not resolve the C signature of " .. name)
    end
    local params: {Kind} = {}
    for index, t in ipairs(physical.params) do
        local kind = kindOf(t)
        if kind == nil or (kind as Kind).llvm == "void" then
            refuse(
                stat.params[index] or stat,
                "parameter " .. tostring(index) .. " of " .. name .. " has no C representation"
            )
        end
        params[index] = kind as Kind
    end
    local result = VOID
    if #physical.rets > 1 then
        refuse(stat, name .. " returns more than one value")
    elseif #physical.rets == 1 then
        local kind = kindOf(physical.rets[1])
        if kind == nil then
            refuse(stat.ret or stat, "the result of " .. name .. " has no C representation")
        end
        result = kind as Kind
    end

    return atomicCallee(
        stat,
        name,
        Callee(
            symbol = name,
            params = params,
            result = result,
            varargs = stat.varargs or false,
            foreign = true,
            signature = physical
        )
    )
end

--- Whether `node` is a literal, or a negated number, which a `const` may name.
local function literal(node: any): boolean
    local kind = node ~= nil and node.kind or nil
    if kind == "paren" then
        return literal((node as cst.Paren).expr)
    elseif kind == "unop" then
        return ((node as cst.Unop).op as lexer.Token).text == "-"
            and ((node as cst.Unop).operand as any).kind == "number"
    end

    return kind == "number" or kind == "string" or kind == "trueExpr" or kind == "falseExpr"
end

--- Records a top-level `const` of literals, read wherever its name is.
local function constant(program: Program, stat: cst.LocalStmt): nil
    local exprs = stat.exprs or {}
    for index, name in ipairs(stat.names) do
        if not literal(exprs[index]) then
            refuse(exprs[index] or stat, "a native program's top-level const binds a literal")
        end
        program.constants[name.text] = exprs[index]
    end
end

--- The values a top-level `local` or `const` binds: its initializers, or the
--- one a binding pattern selects from.
local function valuesOf(stat: cst.LocalStmt): {any}
    if stat.patternSource ~= nil then
        return {stat.patternSource}
    end

    return stat.exprs or {}
end

--- The module `node` requires, when it is `require("name")` with a literal name.
local function required(node: any): string?
    if node == nil or node.kind ~= "call" then
        return nil
    end
    local called = node as cst.Call
    local callee = called.obj as any
    if callee == nil or callee.kind ~= "name" or ((callee as cst.NameExpr).token as lexer.Token).text ~= "require" then
        return nil
    end
    local args = called.args as cst.Args?
    local written = args ~= nil and (args as cst.Args).exprs or nil
    if written == nil or #(written as {cst.Node}) ~= 1 or (written as {any})[1].kind ~= "string" then
        refuse(node, "a native program requires a module by its literal name")
    end
    local token = ((written as {any})[1] as any).token as lexer.Token

    return lexer.stringValue(token.text)
end

--- The constant text of the initial value `node` gives a global of `kind`.
local function initial(program: Program, node: any, kind: Kind, name: string): string
    local current = node
    while current.kind == "paren" do
        current = (current as cst.Paren).expr
    end
    if current.kind == "name" then
        local named = program.constants[((current as cst.NameExpr).token as lexer.Token).text]
        if named ~= nil then
            return initial(program, named, kind, name)
        end
    end
    local v: Value? = nil
    if current.kind == "number" then
        v = number(current as cst.NumberLit, kind)
    elseif current.kind == "unop"
        and ((current as cst.Unop).op as lexer.Token).text == "-"
        and ((current as cst.Unop).operand as any).kind == "number"
    then
        v = number((current as cst.Unop).operand as cst.NumberLit, kind, true)
    elseif current.kind == "trueExpr" or current.kind == "falseExpr" then
        v = Value(text = current.kind == "trueExpr" and "true" or "false", kind = BOOL)
    elseif current.kind == "string" then
        v = stringConstant(program, current)
    elseif current.kind == "nilExpr" then
        v = Value(text = "null", kind = PTR)
    end
    if v == nil then
        refuse(node, "module state " .. name .. " starts as a literal, nil or a const")
    end
    local got = v as Value
    if got.kind.llvm ~= kind.llvm or isInteger(kind) and got.kind.llvm == "i64" and got.kind.signed ~= kind.signed then
        refuse(node, "the initial value of module state " .. name .. " is not of its type")
    end

    return got.text
end

--- Declares a top-level `local` as module state: a global with a constant
--- initial value, or zero, private to the module. A `cdef struct` is held in
--- place, zeroed.
local function state(program: Program, stat: cst.LocalStmt): nil
    if stat.pattern ~= nil then
        refuse(stat, "a native program cannot destructure")
    end
    local exprs = stat.exprs or {}
    if #exprs > #stat.names then
        refuse(stat, "module state binds one value per name")
    end
    for index, token in ipairs(stat.names) do
        local name = token.text
        if program.globals[name] ~= nil or program.callees[name] ~= nil or program.imports[name] ~= nil then
            refuse(stat, name .. " is defined twice")
        end
        local symbol = "nupp." .. program.prefix .. name
        if program.symbols[symbol] then
            refuse(stat, symbol .. " is defined by more than one module of this program")
        end
        program.symbols[symbol] = true
        local slot = llvmText.name("@", symbol)
        local written = stat.types[index]
        local resolved = written ~= nil and bare((written as any).resolvedType) or nil
        local entry: Local
        if isAggregate(resolved) then
            if exprs[index] ~= nil then
                refuse(exprs[index], "module state " .. name .. " holds a cdef struct, which starts zeroed")
            end
            local layout = layoutOf(program, resolved, written)
            builder.once(
                program.module,
                "global " .. slot,
                ("%s = internal global [%d x i8] zeroinitializer, align %d"):format(slot, layout.size, layout.alignment)
            )
            local storage = Kind(llvm = "struct", signed = false, aggregate = resolved)
            entry = Local(slot = slot, kind = Kind(llvm = "ptr", signed = false, elem = storage), aggregate = storage)
        else
            local kind: Kind? = written ~= nil and annotated(written, "module state " .. name) or nil
            local start = exprs[index]
            if kind == nil then
                if start == nil or (start as any).kind == "nilExpr" then
                    refuse(stat, "module state " .. name .. " needs a written C type")
                end
                kind = kindOf((start as any).inferredType)
                if kind == nil then
                    refuse(stat, "module state " .. name .. " needs a written C type")
                end
            end
            local held = kind as Kind
            if held.llvm == "void" then
                refuse(stat, "module state " .. name .. " cannot be nil")
            end
            local text: string
            if start ~= nil then
                text = initial(program, start, held, name)
            elseif held.llvm == "ptr" then
                text = "null"
            elseif isFloat(held) then
                text = "0.0"
            elseif held.llvm == "i1" then
                text = "false"
            else
                text = "0"
            end
            builder.once(
                program.module,
                "global " .. slot,
                ("%s = internal global %s %s"):format(slot, held.llvm, text)
            )
            entry = Local(slot = slot, kind = held)
        end
        program.globals[name] = entry
    end
end

local function lowerDefinition(program: Program, attributes: string, item: Definition): nil
    local callee = item.callee
    local params: {string} = {}
    for index, kind in ipairs(callee.params) do
        params[index] = kind.llvm .. " %arg" .. tostring(index)
    end
    if callee.symbol == "main" and #params == 0 then
        params = {"i32 %arg1", "ptr %arg2"}
    end
    local linkage = callee.public and "" or "internal "
    local header = (
        "define %s%s @%s(%s) %s {"
    ):format(
        linkage,
        callee.symbol == "main" and "i32" or callee.result.llvm,
        llvmText.name("", callee.symbol),
        table.concat(params, ", "),
        attributes
    )
    local body = Body(
        f = builder.func(program.module, header),
        scope = Scope(names = {}),
        result = callee.symbol == "main" and I32 or callee.result,
        exits = {},
        program = program
    )
    for index, kind in ipairs(callee.params) do
        local entry = declareLocal(body, item.paramNames[index], kind)
        builder.emit(body.f, ("store %s %%arg%d, ptr %s"):format(kind.llvm, index, entry.slot))
    end
    block(program, body, item.funcbody.body)
    if callee.result.llvm == "void" then
        builder.finish(body.f, callee.symbol == "main" and "ret i32 0" or "ret void")
    else
        -- Falling off the end of a function with a result is a path the
        -- checker already refuses; LLVM still needs the block closed.
        builder.finish(body.f, "unreachable")
    end
end

--- How a program is built: as an executable, whose entry module defines
--- `main`, or as a library, which needs none.
record native.Options
    library: boolean?
end

--- The top-level statement `stat` with any `export` taken off, and whether it
--- had one.
local function unexported(stat: any): (any, boolean)
    if stat.kind ~= "exportStmt" then
        return stat, false
    end
    local exported = stat as cst.ExportStmt
    if exported.stat == nil then
        refuse(stat, "a native program exports declarations, not a module value")
    end

    return exported.stat, true
end

--- The modules the top level of `tree` requires, in order, as the names a
--- caller resolves to the units it passes `native.program`.
--- @return the names, or nil and the problem with the first one
--- @raises string on a defect here rather than in the program
function native.requires(tree: cst.Chunk): ({string}?, native.Problem?)
    local names: {string} = {}
    local ok, err = pcall(function(): nil
        for _, top in ipairs(tree.blocks) do
            for _, written in ipairs(top.stats or {}) do
                local stat = unexported(written)
                if (stat as any).kind == "localStmt" then
                    for _, expr in ipairs(valuesOf(stat as cst.LocalStmt)) do
                        local name = required(expr)
                        if name ~= nil then
                            names[#names + 1] = name as string
                        end
                    end
                end
            end
        end
    end)
    if not ok then
        if type(err) == "table" and (err as any).problem ~= nil then
            return nil, (err as Refusal).problem
        end
        error(err, 0)
    end

    return names, nil
end

--- Binds a top-level `local m = require("name")` to the unit named `name`, or
--- each name `const {f, X as Y} = require("name")` selects to what it names
--- there; false when `stat` requires nothing.
local function import(program: Program, stat: cst.LocalStmt, units: {[string]: Program}): boolean
    local sources = valuesOf(stat)
    local requires = false
    for _, expr in ipairs(sources) do
        requires = requires or required(expr) ~= nil
    end
    if not requires then
        return false
    end
    if #sources ~= 1 or stat.pattern == nil and #stat.names ~= 1 then
        refuse(stat, "a native program binds each module it requires to one name")
    end
    local name = required(sources[1]) as string
    local unit = units[name]
    if unit == nil then
        refuse(sources[1], "module " .. name .. " is not a module of this native program")
    end

    local function bind(bound: string): nil
        if program.imports[bound] ~= nil
            or program.aliases[bound] ~= nil
            or program.callees[bound] ~= nil
            or program.globals[bound] ~= nil
        then
            refuse(stat, bound .. " is defined twice")
        end
    end

    if stat.pattern == nil then
        local bound = stat.names[1].text
        bind(bound)
        program.imports[bound] = unit as Program
        return true
    end
    for _, entry in ipairs(stat.pattern as {cst.BindingEntry}) do
        if entry.typeOnly == nil and entry.sourceName ~= nil then
            local member = (entry.sourceName as lexer.Token).text
            local bound = entry.alias ~= nil and (entry.alias as lexer.Token).text or member
            bind(bound)
            program.aliases[bound] = Alias(unit = unit as Program, member = member)
        end
    end

    return true
end

--- A function a module defines, waiting for its body to be lowered.
local record Pending
    program: Program
    unit: native.Unit
    item: Definition
end

--- Records the top-level declarations of one module: its C declarations,
--- structs, constants, state, required modules and function signatures.
--- @return whether it is the entry module and defines `main`
local function declarations(
    program: Program,
    unit: native.Unit,
    entry: boolean,
    units: {[string]: Program},
    pending: {Pending}
): boolean
    local hasMain = false
    for _, top in ipairs(unit.tree.blocks) do
        for _, written in ipairs(top.stats or {}) do
            local stat, public = unexported(written)
            local kind = (stat as any).kind
            if kind == "cdefFunc" then
                local declared = foreign(stat as cst.CdefFunc)
                if program.callees[declared.symbol] ~= nil then
                    refuse(stat, declared.symbol .. " is declared twice")
                end
                program.callees[declared.symbol] = declared
            elseif kind == "localFuncStmt" or kind == "funcStmt" then
                local name, funcbody = definition(stat)
                if name == nil or funcbody == nil then
                    refuse(stat, "a native program defines plain named functions")
                end
                if program.callees[name as string] ~= nil
                    or program.globals[name as string] ~= nil
                    or program.imports[name as string] ~= nil
                then
                    refuse(stat, (name as string) .. " is defined twice")
                end
                local item = signature(program, name as string, stat, funcbody as cst.Funcbody, public, entry)
                if program.symbols[item.callee.symbol] then
                    refuse(stat, item.callee.symbol .. " is defined by more than one module of this program")
                end
                program.symbols[item.callee.symbol] = true
                pending[#pending + 1] = Pending(program = program, unit = unit, item = item)
                program.callees[name as string] = item.callee
                if public then
                    program.exportedCallees[name as string] = item.callee
                end
                hasMain = hasMain or entry and name == "main"
            elseif kind == "localStmt" then
                local declared = stat as cst.LocalStmt
                if not import(program, declared, units) then
                    if declared.isConst then
                        constant(program, declared)
                        if public then
                            for _, name in ipairs(declared.names) do
                                program.exportedConstants[name.text] = program.constants[name.text]
                            end
                        end
                    else
                        state(program, declared)
                    end
                end
            elseif kind == "cdefStruct" then
                local identity = (stat as cst.CdefStruct).cdefIdentity
                if identity ~= nil then
                    program.aggregates[identity as string] = stat as cst.CdefStruct
                end
            elseif kind ~= "emptyStmt" and kind ~= "moduleStmt" then
                refuse(
                    stat,
                    "a native program's top level holds only cdef declarations, functions, constants, "
                    .. "module state and the modules it requires"
                )
            end
        end
    end

    return hasMain
end

--- Declares every C function the modules of a program call.
local function declareForeign(module: builder.Module, programs: {Program}): nil
    for _, program in ipairs(programs) do
        for _, callee in pairs(program.callees) do
            if callee.foreign and callee.atomic == nil then
                local params: {string} = {}
                for index, kind in ipairs(callee.params) do
                    params[index] = kind.llvm .. extension(kind)
                end
                if callee.varargs then
                    params[#params + 1] = "..."
                end
                builder.declare(
                    module,
                    "@" .. callee.symbol,
                    (
                        "declare %s%s @%s(%s)"
                    ):format(callee.result.llvm, extension(callee.result), callee.symbol, table.concat(params, ", "))
                )
            end
        end
    end
end

--- The program made of `units` as one LLVM IR module for `triple`, or nil and
--- what it does that a native program cannot. The first unit is the entry
--- module; the others are the modules it requires, directly or not, each named
--- as `require` names it. `functionAttributes` are the target profile's.
--- @raises string when lowering fails for a reason other than the program: a
---   defect here, which must not be reported as something the program did
function native.program(
    units: {native.Unit},
    triple: string,
    functionAttributes: string,
    options: native.Options?
): (string?, native.Problem?)
    local library = options ~= nil and (options as native.Options).library == true
    local module = builder.module()
    local aggregates: {[string]: cst.CdefStruct} = {}
    local layouts: {[any]: any} = {}
    local symbols: {[string]: boolean} = {}
    local programs: {Program} = {}
    local byName: {[string]: Program} = {}
    for index, unit in ipairs(units) do
        local program = Program(
            module = module,
            callees = {},
            globals = {},
            imports = {},
            aliases = {},
            exportedCallees = {},
            exportedConstants = {},
            name = unit.name,
            prefix = index == 1 and "" or unit.name .. ".",
            constants = {},
            triple = triple,
            symbols = symbols,
            aggregates = aggregates,
            layouts = layouts
        )
        programs[index] = program
        byName[unit.name] = program
    end
    -- The unit being lowered, which names the file a refusal is reported in.
    local current: native.Unit = units[1]
    local pending: {Pending} = {}
    local ok, err = pcall(function(): nil
        local hasMain = false
        -- Every module's declarations before any body, so a function may call
        -- one, or read state, of a module declared after its own.
        for index, unit in ipairs(units) do
            current = unit
            hasMain = declarations(programs[index], unit, index == 1, byName, pending) or hasMain
        end
        current = units[1]
        if not hasMain and not library then
            refuse(units[1].tree, "a native program defines main")
        end
        declareForeign(module, programs)
        -- Unwind tables, because a C function a Nupp callback calls may raise a
        -- Lua error that unwinds through it to the VM's protected call.
        local attributes = builder.attributes(module, (("uwtable " .. functionAttributes):gsub("%s+$", "")))
        for _, one in ipairs(pending) do
            current = one.unit
            lowerDefinition(one.program, attributes, one.item)
        end
    end)
    if not ok then
        if type(err) == "table" and (err as any).problem ~= nil then
            local problem = (err as Refusal).problem
            problem.path = current.path

            return nil, problem
        end
        error(err, 0)
    end

    return builder.render(module), nil
end

--- The one-module program in `tree` as one LLVM IR module for `triple`, or nil
--- and what it does that a native program cannot. `functionAttributes` are the
--- target profile's.
--- @raises string when lowering fails for a reason other than the program: a
---   defect here, which must not be reported as something the program did
function native.module(tree: cst.Chunk, triple: string, functionAttributes: string): (string?, native.Problem?)
    return native.program({native.Unit(name = "", tree = tree)}, triple, functionAttributes)
end

export = native
