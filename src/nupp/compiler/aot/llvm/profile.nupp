--[[
What each target is to LLVM and lld.

A Nupp target triple is a public name, and it is not always the triple LLVM or
Rust needs: `x86_64-pc-windows-msvc` is built and linked as MinGW. One record per
public target owns that translation, so code generation, cache keys and linking
all read the same answer and nothing rewrites a triple string on its own.
]]
module nupp.compiler.aot.llvm.profile

export record Profile
    --- The public Nupp target.
    public: string

    --- The triple LLVM generates code for.
    llvmTriple: string

    --- The baseline CPU; tiers add features on top.
    cpu: string

    --- Features every function on this target has.
    baseFeatures: string

    --- `macho`, `elf`, `coff` or `wasm`.
    format: string

    --- The minimum OS version a Mach-O image states.
    minimum: string?

    --- Extra function attributes clang would give this target.
    functionAttributes: string

    --- lld's `-arch`/`-m` spelling.
    machine: string

    --- The LLVM type of `size_t`.
    sizeType: string

    --- The carried IR of an AOT runtime a module links in, where the process
    --- loading it has no provider to hand it one (the browser guest).
    linkedRuntime: string?
end

local PROFILES: {[string]: Profile} = {
    [
        "aarch64-apple-darwin"
    ] = Profile(
        public = "aarch64-apple-darwin",
        llvmTriple = "arm64-apple-macosx11.0.0",
        cpu = "apple-m1",
        baseFeatures = "+neon",
        format = "macho",
        minimum = "11.0.0",
        functionAttributes = "\"frame-pointer\"=\"non-leaf\"",
        machine = "arm64",
        sizeType = "i64"
    ),
    [
        "x86_64-apple-darwin"
    ] = Profile(
        public = "x86_64-apple-darwin",
        llvmTriple = "x86_64-apple-macosx10.14.0",
        cpu = "x86-64",
        baseFeatures = "",
        format = "macho",
        minimum = "10.14.0",
        functionAttributes = "\"frame-pointer\"=\"all\"",
        machine = "x86_64",
        sizeType = "i64"
    ),
    [
        "x86_64-unknown-linux-gnu"
    ] = Profile(
        public = "x86_64-unknown-linux-gnu",
        llvmTriple = "x86_64-unknown-linux-gnu",
        cpu = "x86-64",
        baseFeatures = "",
        format = "elf",
        functionAttributes = "",
        machine = "elf_x86_64",
        sizeType = "i64"
    ),
    [
        "aarch64-unknown-linux-gnu"
    ] = Profile(
        public = "aarch64-unknown-linux-gnu",
        llvmTriple = "aarch64-unknown-linux-gnu",
        cpu = "generic",
        baseFeatures = "+neon",
        format = "elf",
        functionAttributes = "\"frame-pointer\"=\"non-leaf\"",
        machine = "aarch64linux",
        sizeType = "i64"
    ),
    ["i686-unknown-linux-gnu"] = Profile(
        public = "i686-unknown-linux-gnu",
        llvmTriple = "i686-unknown-linux-gnu",
        cpu = "pentium4",
        baseFeatures = "",
        format = "elf",
        -- This target is the browser guest's: its LuaJIT walks frames for
        -- callback exceptions, and it has no provider, so the runtime (built
        -- against musl, as that LuaJIT is) goes into each library.
        functionAttributes = "\"frame-pointer\"=\"all\"",
        machine = "elf_i386",
        sizeType = "i32",
        linkedRuntime = "/aot/llvm/lua/runtime-i686.ll"
    ),
    ["wasm32-unknown-emscripten"] = Profile(
        public = "wasm32-unknown-emscripten",
        -- An independent module: nothing Emscripten's name promised is used,
        -- and the module imports nothing.
        llvmTriple = "wasm32-unknown-unknown",
        cpu = "generic",
        baseFeatures = "+bulk-memory,+nontrapping-fptoint,+sign-ext,+mutable-globals",
        format = "wasm",
        functionAttributes = "",
        machine = "wasm32",
        sizeType = "i32"
    ),
    ["x86_64-pc-windows-msvc"] = Profile(
        public = "x86_64-pc-windows-msvc",
        llvmTriple = "x86_64-w64-windows-gnu",
        cpu = "x86-64",
        baseFeatures = "",
        format = "coff",
        -- 128-bit vectors, the width Win64 AOT code has always preferred:
        -- GCC, which once compiled it, misaligned wider spills there.
        functionAttributes = "\"prefer-vector-width\"=\"128\"",
        machine = "x64",
        sizeType = "i64"
    ),
}

--- The feature string each tier adds.
---
--- AVX2 carries FMA because LLVM does not imply one from the other and every
--- processor with AVX2 has both. Without it `llvm.fma` on an eight-lane float
--- became eight calls to `fmaf` with the vector spilled around each one, in the
--- tier whose point is doing that in one instruction. AVX-512F implies FMA in
--- LLVM already. The detector asks for FMA before it returns either tier.
const TIER_FEATURES: {
    [string]: string
} = {
    ["baseline"] = "",
    ["avx2"] = "+avx2,+fma",
    ["avx512f"] = "+avx512f",
    ["neon"] = "+neon",
    ["simd128"] = "+simd128",
    ["scalar"] = "",
}

--- The profile of a public target, or nil and why there is none.
export function of(public: string): (Profile?, string?)
    local found = PROFILES[public]
    if found == nil then
        return nil, "the LLVM backend has no profile for " .. public
    end

    return found, nil
end

--- The features a function of `tier` is compiled with.
export function features(selected: Profile, tier: string): string
    local parts: {string} = {}
    if selected.baseFeatures ~= "" then
        parts[#parts + 1] = selected.baseFeatures
    end
    local extra = TIER_FEATURES[tier]
    if extra ~= nil and extra ~= "" and extra ~= selected.baseFeatures then
        parts[#parts + 1] = extra as string
    end

    return table.concat(parts, ",")
end

--- The codegen options for a tier's module.
export function options(selected: Profile, tier: string): {[string]: string}
    return {triple = selected.llvmTriple, cpu = selected.cpu, features = features(selected, tier), opt = "3"}
end

--- lld's arguments linking `objects` into the shared library `output`.
---
--- Undefined symbols -- the Lua C API, the runtime, libm -- bind when the
--- library is loaded, against what the process already has.
---
--- `strip` is a directory prefix, with its trailing slash, that the debug map
--- of a Mach-O library writes object paths without. ld64 records each object's
--- absolute path there, which made two checkouts of one project build two
--- different libraries.
---
--- `exports` is the file `exportList` wrote for the library: what it
--- publishes, and all it publishes. Without one ld.lld and ld64.lld would
--- publish every definition the objects did not mark local, and lld-link
--- every symbol of every object, the Lua API binding's included.
export function sharedLink(
    selected: Profile,
    output: string,
    objects: {string},
    soname: string,
    strip: string?,
    exports: string?
): {string}
    local argv: {string}
    if selected.format == "macho" then
        argv = {
            "ld64.lld",
            "-arch",
            selected.machine,
            "-platform_version",
            "macos",
            tostring(selected.minimum),
            tostring(selected.minimum),
            "-dylib",
            "-install_name",
            "@rpath/" .. soname,
            "-undefined",
            "dynamic_lookup",
            "-o",
            output,
        }
        if strip ~= nil then
            argv[#argv + 1] = "-oso_prefix"
            argv[#argv + 1] = strip as string
        end
        if exports ~= nil then
            argv[#argv + 1] = "-exported_symbols_list"
            argv[#argv + 1] = exports as string
        end
    elseif selected.format == "elf" then
        argv = {
            "ld.lld",
            "-m",
            selected.machine,
            "-shared",
            "--eh-frame-hdr",
            "-z",
            "noexecstack",
            "-z",
            "now",
            "--hash-style=gnu",
            "--gc-sections",
            "-soname",
            soname,
            "-o",
            output,
        }
        if exports ~= nil then
            argv[#argv + 1] = "--version-script=" .. (exports as string)
        end
    else
        argv = {
            "lld-link",
            "-lldmingw",
            "/dll",
            "/noentry",
            "/machine:" .. selected.machine,
            "/nodefaultlib",
            "/out:" .. output
        }
        if exports ~= nil then
            argv[#argv + 1] = "/def:" .. (exports as string)
        end
    end
    for _, object in ipairs(objects) do
        argv[#argv + 1] = object
    end

    return argv
end

--- The linkages and visibilities that keep a definition out of the library's
--- export table whatever list the linker is given.
const UNPUBLISHED: {[string]: boolean} = {["private"] = true, ["internal"] = true, ["hidden"] = true}

--- The names a unit's IR defines for other images to resolve: every function
--- and alias it neither gives a local linkage nor hides. That is each kernel,
--- layout reporter, registrar and detector a generated wrapper declares, and
--- each `@aot(export)` C name; every helper is `internal`.
export function publicSymbols(ir: string): {string}
    local names: {string} = {}
    for line in ir:gmatch("[^\n]+") do
        local head: string? = nil
        local name: string? = nil
        if line:sub(1, 7) == "define " then
            head, name = line:match("^define%s+(.-)@([%w_%.%$]+)%(")
        else
            name, head = line:match("^@([%w_%.%$]+)%s*=%s*(.-)alias%s")
        end
        if name ~= nil then
            local published = true
            for word in (head as string):gmatch("%S+") do
                if UNPUBLISHED[word] then
                    published = false
                end
            end
            if published then
                names[#names + 1] = name as string
            end
        end
    end

    return names
end

--- The data a unit's IR defines for other images to resolve: every global or
--- constant it neither gives a local linkage nor hides. A declaration, made
--- `external` and given no contents, is another image's.
export function publicData(ir: string): {[string]: boolean}
    local names: {[string]: boolean} = {}
    for line in ir:gmatch("[^\n]+") do
        local name, rest = line:match("^@([%w_%.%$]+)%s*=%s*(.*)$")
        if name ~= nil then
            local published = true
            local data = false
            for word in (rest as string):gmatch("%S+") do
                if not data then
                    if UNPUBLISHED[word] or word == "external" or word == "extern_weak" or word == "alias" or word == "ifunc" then
                        published = false
                    elseif word == "global" or word == "constant" then
                        data = true
                    end
                end
            end
            if published and data then
                names[name as string] = true
            end
        end
    end

    return names
end

--- The export list of a shared library publishing exactly `names`, in the form
--- `selected`'s linker reads: a version script for ld.lld, an exported-symbols
--- list for ld64.lld, a module definition file for lld-link. A name `data`
--- holds is marked `DATA` in a module definition, so its import library gives
--- it no code thunk, only the `__imp_` pointer `__declspec(dllimport)` reads.
export function exportList(selected: Profile, names: {string}, data: {[string]: boolean}?): string
    local sorted: {string} = {}
    local seen: {[string]: boolean} = {}
    for _, name in ipairs(names) do
        if not seen[name] then
            seen[name] = true
            sorted[#sorted + 1] = name
        end
    end
    table.sort(sorted)
    local lines: {string} = {}
    if selected.format == "macho" then
        for _, name in ipairs(sorted) do
            lines[#lines + 1] = "_" .. name
        end
    elseif selected.format == "elf" then
        lines[#lines + 1] = "{"
        if #sorted > 0 then
            lines[#lines + 1] = "  global:"
            for _, name in ipairs(sorted) do
                lines[#lines + 1] = "    " .. name .. ";"
            end
        end
        lines[#lines + 1] = "  local:"
        lines[#lines + 1] = "    *;"
        lines[#lines + 1] = "};"
    else
        local held = data or {}
        lines[#lines + 1] = "EXPORTS"
        for _, name in ipairs(sorted) do
            lines[#lines + 1] = "    " .. name .. (held[name] and " DATA" or "")
        end
    end

    return table.concat(lines, "\n") .. "\n"
end
