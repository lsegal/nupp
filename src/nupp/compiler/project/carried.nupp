    "nupp.array.internal.storage",
    "nupp.serde.internal.identity",
    "nupp.serde.internal.binarycodec",
    "nupp.io.internal.nativebuffer",
}

local function located(names: {string}, suffix: string, found: {[string]: string}): {[string]: string}
    for _, name in ipairs(names) do
        found[name] = "/" .. (name:gsub("%.", "/")) .. suffix
    end

    return found
end

export const implementations: {
    [string]: string
} = located(LUA_MODULES, ".lua", located(INIT_MODULES, "/init.nupp", located(MODULES, ".nupp", {})))

--- Returns every carried file named by either map, sorted.
---
--- @return the files, by the spelling `nupp.compiler.bundled` reads
export function files(): {string}
    local found: {string} = {}
    for _, file in pairs(declarations) do
        found[#found + 1] = file
    end
    for _, file in pairs(implementations) do
        found[#found + 1] = file
    end
    table.sort(found)

    return found
end
