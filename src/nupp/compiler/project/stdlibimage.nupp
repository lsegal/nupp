@!internal

--[[
The browser compiler's checked standard-library interfaces.

The prelude image covers what every program sees. A program that `require`s a
standard-library module used to pay for checking that module's whole graph from
source the first time it asked: `require("coroutine")` is the suspension, io and
time graph behind it, seconds of checking natively and a minute or more in a
browser guest. This image carries what those checks produce instead -- each module's
interface, exports, diagnostics and annotations -- as `nupp.compiler.project.interfaceimage`
already encodes them for semantic workers.

The interfaces are written against the prelude image's own graph. A type the prelude
image carries is not described again, it is referenced by its table number there, so
an imported interface that names `io.File` names the very nominal the checker is
already holding. That makes the image true only of the prelude image it was written
beside, and only of the settings the modules were checked under: `hydrate` refuses
anything else and the environment checks from source, as it always could.
]]
module nupp.compiler.project.stdlibimage

local bundled = require("nupp.compiler.bundled")
local codec = require("nupp.serde.internal.binarycodec")
local interfaceimage = require("nupp.compiler.project.interfaceimage")

export const SCHEMA = 1

--- Where the prelude image's tables are, by name, inside an interface image.
const PRELUDE_ARENA = "prelude"

--- The resource the browser compiler carries the image in.
const RESOURCE = "/stdlibimage.bin"

--- Modules the environment adjusts after checking, which an interface cannot carry.
const UNIMAGED: {[string]: boolean} = {lpeg = true}

--- What one imaged module is beside its interface.
export type Module = {
    declarationOnly: boolean,
    declared: boolean
}

--- What an environment needs to build the module records the image stands for.
export type Hydrated = {
    semantics: {[string]: any},
    modules: {[string]: Module}
}

local function settingsOf(env: any): any
    return {
        compat = env.compat,
        layoutTarget = env.layoutTarget,
        preludeTables = #(env.preludeArena or {}),
        preludeBytes = #(bundled.source("/preludeimage.bin") or ""),
    }
end

--- Encodes every module of `names` the environment checks cleanly.
---
--- The environment must have been built from the prelude image, because that is the
--- graph the interfaces refer into.
export function encode(env: any, names: {string}): (string?, string?)
    local arena = env.preludeArena
    if arena == nil then
        return nil, "the standard-library image needs an environment built from the prelude image"
    end
    local origins: {[any]: any} = {}
    for index, value in ipairs(arena) do
        if origins[value] == nil then
            origins[value] = {arena = PRELUDE_ARENA, node = index}
        end
    end
    local semantics: {[string]: any} = {}
    local modules: {[string]: Module} = {}
    for _, name in ipairs(names) do
        local loaded, record = pcall(function(): any
            return env.bundled[name]
        end)
        if not UNIMAGED[name] and loaded and record and record.type ~= nil then
            local exports = record.exports or {}
            semantics[
                name
            ] = {
                interface = {
                    type = record.type,
                    nominalEffectFingerprint = exports.nominalEffectFingerprint,
                    deriveInterfaceFingerprint = exports.deriveInterfaceFingerprint,
                },
                exports = exports,
                diags = record.compatDiagnostics or {},
                annotations = env.annotations:definedBy(record.path or name),
            }
            modules[name] = {declarationOnly = record.declarationOnly == true, declared = record.declared == true}
        end
    end
    local image, problem = interfaceimage.encode(semantics, {origins = origins, arenas = {[PRELUDE_ARENA] = arena}})
    if image == nil then
        return nil, problem
    end
    -- The arena is named only to be distinct, and this one is never encoded
    -- against, so a fixed name keeps the process id out of the bytes.
    image.fingerprint = "stdlib"

    return codec.encode({schema = SCHEMA, settings = settingsOf(env), modules = modules, image = image,}), nil
end

--- Decodes the carried image into `env`'s checker identity.
---
--- Nil when there is none, or when it was written for another prelude image or other
--- check settings; the caller then checks modules from source.
export function hydrate(env: any): (Hydrated?, string?)
    local data = bundled.source(RESOURCE)
    if data == nil or data == "" then
        return nil, "no standard-library image"
    end
    if env.preludeArena == nil then
        return nil, "the environment was not built from the prelude image"
    end
    local decoded, payload = pcall(codec.decode, data)
    if not decoded or type(payload) ~= "table" or payload.schema ~= SCHEMA or type(payload.settings) ~= "table" then
        return nil, "the standard-library image is malformed"
    end
    local expected = settingsOf(env)
    for _, key in ipairs({"compat", "layoutTarget", "preludeTables", "preludeBytes"}) do
        if payload.settings[key] ~= expected[key] then
            return nil, "the standard-library image was written for another " .. key
        end
    end
    local semantics, problem = interfaceimage.decode(payload.image, {
        nominals = {},
        arenas = {[PRELUDE_ARENA] = env.preludeArena},
    })
    if semantics == nil then
        return nil, problem
    end

    return {semantics = semantics, modules = payload.modules}, nil
end
