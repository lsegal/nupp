@!internal
--[[NIST P-256 and P-384: ECDH (SP 800-56A) and ECDSA (FIPS 186-4).

Points use Jacobian coordinates with field elements in Montgomery form, and
the formulas assume a = -3, which both curves have. Scalar multiplication is a
fixed four-bit window. Signing derives its nonce deterministically (RFC 6979),
so a weak random source cannot leak the key through a repeated nonce.

None of this is constant time; see #3 for why that was accepted.
]]
module nupp.io.tls.crypto.ecc

const bn = require("nupp.io.tls.crypto.bignum")
const hash = require("nupp.io.tls.crypto.hash")
const der = require("nupp.io.tls.crypto.der")

local type Int = bn.Int

--- A curve and its prepared moduli.
export record Curve
    @readonly name: string
    @readonly size: integer
    @readonly p: Int
    @readonly n: Int
    @readonly field: bn.Montgomery
    @readonly order: bn.Montgomery
    @readonly b: Int
    @readonly gx: Int
    @readonly gy: Int
end

-- A Jacobian point with Montgomery-form coordinates; z empty is infinity.
local record Point
    x: Int
    y: Int
    z: Int
end

local function unhex(text: string): string
    return (text:gsub("..", function(pair: string): string
        return string.char(tonumber(pair, 16) as integer)
    end))
end

local function define(name: string, size: integer, p: string, n: string, b: string, gx: string, gy: string): Curve
    local prime = bn.frombytes(unhex(p))
    local field = bn.montgomery(prime)

    return Curve(
        name = name,
        size = size,
        p = prime,
        n = bn.frombytes(unhex(n)),
        field = field,
        order = bn.montgomery(bn.frombytes(unhex(n))),
        b = bn.tomont(field, bn.frombytes(unhex(b))),
        gx = bn.tomont(field, bn.frombytes(unhex(gx))),
        gy = bn.tomont(field, bn.frombytes(unhex(gy)))
    )
end

local curves: {[string]: Curve} = {}

--- Looks a curve up by name ("p256" or "p384"), preparing it on first use.
export function curve(name: string): Curve?
    local found = curves[name]
    if found ~= nil then
        return found
    end
    if name == "p256" then
        found = define(
            "p256",
            32,
            "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff",
            "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551",
            "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b",
            "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296",
            "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"
        )
    elseif name == "p384" then
        found = define(
            "p384",
            48,
            "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff",
            "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973",
            "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef",
            "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7",
            "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f"
        )
    else
        return nil
    end
    curves[name] = found

    return found
end

local function double(c: Curve, point: Point): Point
    if #point.z == 0 or #point.y == 0 then
        return Point(x = {}, y = {}, z = {})
    end
    local f = c.field
    local p = c.p
    local function mul(a: Int, b: Int): Int
        return bn.montmul(f, a, b)
    end
    local function add(a: Int, b: Int): Int
        return bn.modadd(p, a, b)
    end
    local function sub(a: Int, b: Int): Int
        return bn.modsub(p, a, b)
    end
    local delta = mul(point.z, point.z)
    local gamma = mul(point.y, point.y)
    local beta = mul(point.x, gamma)
    local t = mul(sub(point.x, delta), add(point.x, delta))
    local alpha = add(add(t, t), t)
    local beta2 = add(beta, beta)
    local beta4 = add(beta2, beta2)
    local beta8 = add(beta4, beta4)
    local x3 = sub(mul(alpha, alpha), beta8)
    local yz = add(point.y, point.z)
    local z3 = sub(sub(mul(yz, yz), gamma), delta)
    local gamma2 = mul(gamma, gamma)
    local g2 = add(gamma2, gamma2)
    local g4 = add(g2, g2)
    local g8 = add(g4, g4)
    local y3 = sub(mul(alpha, sub(beta4, x3)), g8)

    return Point(x = x3, y = y3, z = z3)
end

local function addPoints(c: Curve, a: Point, b: Point): Point
    if #a.z == 0 then
        return b
    end
    if #b.z == 0 then
        return a
    end
    local f = c.field
    local p = c.p
    local function mul(x: Int, y: Int): Int
        return bn.montmul(f, x, y)
    end
    local function add(x: Int, y: Int): Int
        return bn.modadd(p, x, y)
    end
    local function sub(x: Int, y: Int): Int
        return bn.modsub(p, x, y)
    end
    local z1z1 = mul(a.z, a.z)
    local z2z2 = mul(b.z, b.z)
    local u1 = mul(a.x, z2z2)
    local u2 = mul(b.x, z1z1)
    local s1 = mul(mul(a.y, b.z), z2z2)
    local s2 = mul(mul(b.y, a.z), z1z1)
    local h = sub(u2, u1)
    local r = sub(s2, s1)
    if #h == 0 then
        if #r == 0 then
            return double(c, a)
        end

        return Point(x = {}, y = {}, z = {})
    end
    r = add(r, r)
    local h2 = add(h, h)
    local i = mul(h2, h2)
    local j = mul(h, i)
    local v = mul(u1, i)
    local x3 = sub(sub(mul(r, r), j), add(v, v))
    local s1j = mul(s1, j)
    local y3 = sub(mul(r, sub(v, x3)), add(s1j, s1j))
    local zz = add(a.z, b.z)
    local z3 = mul(sub(sub(mul(zz, zz), z1z1), z2z2), h)

    return Point(x = x3, y = y3, z = z3)
end

local function multiply(c: Curve, scalar: Int, point: Point): Point
    local table: {Point} = {}
    table[1] = point
    for index = 2, 15 do
        table[index] = index % 2 == 0 and double(c, table[index // 2]) or addPoints(c, table[index - 1], point)
    end
    local result = Point(x = {}, y = {}, z = {})
    local bits = bn.bitlength(scalar)
    local index: integer = ((bits + 3) // 4) * 4 - 1
    while index >= 0 do
        for _ = 1, 4 do
            result = double(c, result)
        end
        local window = bn.bit(scalar, index) * 8
            + bn.bit(scalar, index - 1) * 4
            + bn.bit(scalar, index - 2) * 2
            + bn.bit(scalar, index - 3)
        if window ~= 0 then
            result = addPoints(c, result, table[window])
        end
        index = index - 4
    end

    return result
end

-- Affine coordinates in plain form, or nil at infinity.
local function affine(c: Curve, point: Point): (Int?, Int?)
    if #point.z == 0 then
        return nil, nil
    end
    local f = c.field
    local zinverse = bn.tomont(f, bn.modinverse(f, bn.frommont(f, point.z)))
    local z2 = bn.montmul(f, zinverse, zinverse)
    local z3 = bn.montmul(f, z2, zinverse)

    return bn.frommont(f, bn.montmul(f, point.x, z2)), bn.frommont(f, bn.montmul(f, point.y, z3))
end

local function generator(c: Curve): Point
    return Point(x = c.gx, y = c.gy, z = c.field.one)
end

-- Decodes an uncompressed SEC 1 point, checking it lies on the curve.
local function decode(c: Curve, bytes: string): Point?
    if #bytes ~= 1 + 2 * c.size or bytes:byte(1) ~= 4 then
        return nil
    end
    local x = bn.frombytes(bytes:sub(2, 1 + c.size))
    local y = bn.frombytes(bytes:sub(2 + c.size))
    if bn.compare(x, c.p) >= 0 or bn.compare(y, c.p) >= 0 then
        return nil
    end
    local f = c.field
    local mx = bn.tomont(f, x)
    local my = bn.tomont(f, y)
    -- y^2 = x^3 - 3x + b
    local left = bn.montmul(f, my, my)
    local x3 = bn.montmul(f, bn.montmul(f, mx, mx), mx)
    local threeX = bn.modadd(c.p, bn.modadd(c.p, mx, mx), mx)
    local right = bn.modadd(c.p, bn.modsub(c.p, x3, threeX), c.b)
    if bn.compare(left, right) ~= 0 then
        return nil
    end

    return Point(x = mx, y = my, z = f.one)
end

local function encodePoint(c: Curve, x: Int, y: Int): string
    return "\4" .. bn.tobytes(x, c.size) .. bn.tobytes(y, c.size)
end

--- Derives the uncompressed public point for a private scalar.
export function publickey(c: Curve, private: string): string
    local x, y = affine(c, multiply(c, bn.frombytes(private), generator(c)))

    return encodePoint(c, x as Int, y as Int)
end

--- Makes a fresh key pair from `random`, a source of `c.size` random bytes,
--- returning the private scalar and uncompressed public point.
export function keypair(c: Curve, random: function(count: integer): string): (string, string)
    while true do
        local candidate = random(c.size)
        local scalar = bn.frombytes(candidate)
        if not bn.iszero(scalar) and bn.compare(scalar, c.n) < 0 then
            return bn.tobytes(scalar, c.size), publickey(c, candidate)
        end
    end
end

--- Computes the ECDH shared secret (the x coordinate), or nil when the peer's
--- point is invalid.
export function shared(c: Curve, private: string, peer: string): string?
    local point = decode(c, peer)
    if point == nil then
        return nil
    end
    local x = affine(c, multiply(c, bn.frombytes(private), point))
    if x == nil then
        return nil
    end

    return bn.tobytes(x, c.size)
end

-- The leftmost bits of a digest as an integer below n.
local function digestInteger(c: Curve, digest: string): Int
    if #digest > c.size then
        digest = digest:sub(1, c.size)
    end
    local e = bn.frombytes(digest)
    if bn.compare(e, c.n) >= 0 then
        e = bn.sub(e, c.n)
    end

    return e
end

local function ordermul(c: Curve, a: Int, b: Int): Int
    local o = c.order

    return bn.frommont(o, bn.montmul(o, bn.tomont(o, a), bn.tomont(o, b)))
end

--- Verifies a DER-encoded ECDSA signature over a message digest.
export function verify(c: Curve, publicPoint: string, digest: string, signature: string): boolean
    local q = decode(c, publicPoint)
    local node = der.parse(signature)
    if q == nil or node == nil or node.tag ~= der.SEQUENCE then
        return false
    end
    local parts = der.children(node)
    if parts == nil or #parts ~= 2 then
        return false
    end
    local rBytes = der.unsigned(parts[1])
    local sBytes = der.unsigned(parts[2])
    if rBytes == nil or sBytes == nil then
        return false
    end
    local r = bn.frombytes(rBytes)
    local s = bn.frombytes(sBytes)
    if bn.iszero(r) or bn.iszero(s) or bn.compare(r, c.n) >= 0 or bn.compare(s, c.n) >= 0 then
        return false
    end
    local e = digestInteger(c, digest)
    local w = bn.modinverse(c.order, s)
    local u1 = ordermul(c, e, w)
    local u2 = ordermul(c, r, w)
    local sum = addPoints(c, multiply(c, u1, generator(c)), multiply(c, u2, q))
    local x = affine(c, sum)
    if x == nil then
        return false
    end
    if bn.compare(x, c.n) >= 0 then
        x = bn.sub(x, c.n)
    end

    return bn.compare(x, r) == 0
end

--- Signs a message digest with a private scalar, returning DER. `hashName` is
--- the hash RFC 6979's nonce derivation runs on.
export function sign(c: Curve, private: string, digest: string, hashName: hash.Name): string
    local d = bn.frombytes(private)
    local e = digestInteger(c, digest)
    local size = c.size
    local x = bn.tobytes(d, size)
    local h1 = bn.tobytes(e, size)
    local length = hash.size(hashName)
    local v = string.rep("\1", length)
    local k = string.rep("\0", length)
    k = hash.hmac(hashName, k, v .. "\0" .. x .. h1)
    v = hash.hmac(hashName, k, v)
    k = hash.hmac(hashName, k, v .. "\1" .. x .. h1)
    v = hash.hmac(hashName, k, v)
    while true do
        local t = ""
        while #t < size do
            v = hash.hmac(hashName, k, v)
            t = t .. v
        end
        local nonce = bn.frombytes(t:sub(1, size))
        if not bn.iszero(nonce) and bn.compare(nonce, c.n) < 0 then
            local rx = affine(c, multiply(c, nonce, generator(c)))
            if rx ~= nil then
                local r = rx
                if bn.compare(r, c.n) >= 0 then
                    r = bn.sub(r, c.n)
                end
                if not bn.iszero(r) then
                    local kinverse = bn.modinverse(c.order, nonce)
                    local s = ordermul(c, kinverse, bn.modadd(c.n, e, ordermul(c, r, d)))
                    if not bn.iszero(s) then
                        return der.encode(
                            der.SEQUENCE,
                            der.encodeunsigned(bn.tobytes(r)) .. der.encodeunsigned(bn.tobytes(s))
                        )
                    end
                end
            end
        end
        k = hash.hmac(hashName, k, v .. "\0")
        v = hash.hmac(hashName, k, v)
    end
end
