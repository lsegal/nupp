@!internal
--[[Built-in Adler-32 and CRC algorithm descriptors.

Each descriptor creates independent state. CRC updates borrow byte spans without
retaining them; value finishes a copy of the register and leaves it resumable.
]]
module nupp.checksum.internal.builtin

const provider = require("nupp.digest.internal.checksumprovider")
const crc = require("nupp.checksum.internal.crc")
const span = require("bytes.span")

local record AdlerState is provider.State
    @private high: integer
    @private low: integer

    function update(exclusive self, borrows bytes: span.Span<uint8>): nil
        for index = 1, #bytes do
            self.low = (self.low + bytes[index]) % 65521
            self.high = (self.high + self.low) % 65521
        end
    end

    function value(self): uint64
        return 0ULL + self.high * 65536 + self.low
    end

    function close(takes self): nil
    end
end

local record CrcState is provider.State
    @private algorithm: crc.Algorithm
    @private register: uint64

    function update(exclusive self, borrows bytes: span.Span<uint8>): nil
        self.register = crc.update(self.algorithm, self.register, bytes)
    end

    function value(self): uint64
        return crc.finish(self.algorithm, self.register)
    end

    function close(takes self): nil
    end
end

local record Algorithm is provider.Algorithm
    @readonly name: string
    @readonly width: integer
    @private id: integer

    function create(self): provider.State
        if self.id == 0 then
            return AdlerState(high = 0, low = 1)
        end
        local algorithm = crc.lookup(self.id) as crc.Algorithm
        return CrcState(algorithm = algorithm, register = crc.initial(algorithm))
    end
end

const ALGORITHMS: {
    [string]: provider.Algorithm
} = {
    adler32 = Algorithm(name = "adler32", width = 32, id = 0),
    crc32 = Algorithm(name = "crc32", width = 32, id = 1),
    crc32c = Algorithm(name = "crc32c", width = 32, id = 2),
    ["crc64-ecma"] = Algorithm(name = "crc64-ecma", width = 64, id = 3),
    crc64nvme = Algorithm(name = "crc64nvme", width = 64, id = 4),
}

export function lookup(name: string): provider.Algorithm?
    return ALGORITHMS[name]
end

export function names(): {string}
    return {"adler32", "crc32", "crc32c", "crc64-ecma", "crc64nvme"}
end
