end

--- The layout facts the runtime table states, so a registrar can check its
--- blocks and the fields it reads.
export const BUILDER_BYTES = ffi.sizeof(Builder)
export const BUILDER_DEPTH = ffi.offsetof(Builder, "depth")
export const BUILDER_FRAMES = ffi.offsetof(Builder, "frames")
export const BUILDER_INLINE_FRAMES = ffi.offsetof(Builder, "inlineFrames")
export const FRAME_BYTES = ffi.sizeof(Frame)
export const FRAME_KIND = ffi.offsetof(Frame, "kind")
export const FRAME_COUNT = ffi.offsetof(Frame, "count")
