--- Finding the payload appended to a Nupp executable.
---
--- An unsigned executable ends with a 48-byte trailer. A signed thin
--- little-endian 64-bit Mach-O instead puts that trailer immediately before
--- the zero alignment padding and final code-signature blob.
module nupphost.payload

const {
    nuppHostBytesLe as le,
    nuppHostBytesSame as same,
    nuppHostBytesZero as zero,
    nuppHostBytesOffset as offset,
} = require("nupphost.bytes")
const {nuppHostXxh64 as xxh64} = require("nupphost.xxh64")

cdef function snprintf(borrows buffer: voidptr, size: uint64, borrows format: cstring, ...): int32

const TRAILER_LENGTH = 48
const FORMAT_VERSION = 1ULL
const PAYLOAD_FLAG_BYTECODE = 1ULL
const MACH_HEADER_LENGTH = 32
const LC_CODE_SIGNATURE = 29ULL
const MAX_SIGNATURE_PADDING = 4095

--- What `find` reports.
export const NONE = 0

export const FOUND = 1
export const DAMAGED = 2

local function magicAt(borrows bytes: uint8*, at: integer): boolean
    return same(offset(bytes, at), "NUPPLOAD" as uint8*, 8)
end

--- Where the code signature of a thin little-endian 64-bit Mach-O starts, when
--- it is the file's final blob, or -1.
local function signatureOffset(borrows bytes: uint8*, size: integer): integer
    if size < MACH_HEADER_LENGTH then
        return -1
    end
    @unsafe do
        if bytes[0] ~= 207 or bytes[1] ~= 250 or bytes[2] ~= 237 or bytes[3] ~= 254 then
            return -1
        end
    end
    local commands = le(bytes, 16, 4) as integer
    local commandBytes = le(bytes, 20, 4) as integer
    local commandEnd: integer = MACH_HEADER_LENGTH + commandBytes
    if commandEnd > size then
        return -1
    end
    local cursor: integer = MACH_HEADER_LENGTH
    local index: integer = 0
    while index < commands do
        if cursor + 8 > commandEnd then
            return -1
        end
        local command = le(bytes, cursor, 4)
        local commandSize = le(bytes, cursor + 4, 4) as integer
        local next: integer = cursor + commandSize
        if commandSize < 8 or next > commandEnd then
            return -1
        end
        if command == LC_CODE_SIGNATURE then
            if commandSize < 16 then
                return -1
            end
            local at = le(bytes, cursor + 8, 4) as integer
            local length = le(bytes, cursor + 12, 4) as integer
            if at + length ~= size then
                return -1
            end
            return at
        end
        cursor = next
        index = index + 1
    end

    return -1
end

local function signedTrailerStart(borrows bytes: uint8*, size: integer): integer
    local signatureAt = signatureOffset(bytes, size)
    if signatureAt < 0 then
        return -1
    end
    local maximum: integer = signatureAt
    if maximum > MAX_SIGNATURE_PADDING then
        maximum = MAX_SIGNATURE_PADDING
    end
    local padding: integer = 0
    while padding <= maximum do
        local trailerEnd: integer = signatureAt - padding
        local trailerStart: integer = trailerEnd - TRAILER_LENGTH
        if trailerStart < 0 then
            return -1
        end
        if magicAt(bytes, trailerStart) and zero(bytes, trailerEnd, padding) then
            return trailerStart
        end
        padding = padding + 1
    end

    return -1
end

--- Finds and checks the payload in the `size` bytes of an executable at
--- `bytes`. `NONE` means neither the unsigned nor the signed trailer position
--- carries the format magic. Once the magic is present, damage is `DAMAGED`,
--- with its account written to `message`, rather than a reason to fall back to
--- interpreting another file. `FOUND` writes the payload's offset, length and
--- whether it is bytecode (1 or 0) to `found[0..2]`.
export function nuppHostPayloadFind(
    borrows bytes: uint8*,
    size: integer,
    borrows found: int64*,
    borrows message: voidptr,
    capacity: uint64
): int32
    if size < TRAILER_LENGTH then
        return NONE
    end
    local trailerStart: integer = size - TRAILER_LENGTH
    if not magicAt(bytes, trailerStart) then
        trailerStart = signedTrailerStart(bytes, size)
        if trailerStart < 0 then
            return NONE
        end
    end
    local version = le(bytes, trailerStart + 8, 4)
    if version ~= FORMAT_VERSION then
        snprintf(
            message,
            capacity,
            "this executable carries a payload in format version %llu, and this host only knows version 1",
            version
        )
        return DAMAGED
    end
    local flags = le(bytes, trailerStart + 12, 4)
    if (flags & (0ULL - 1ULL - PAYLOAD_FLAG_BYTECODE)) ~= 0ULL then
        snprintf(
            message,
            capacity,
            "the payload's trailer sets unknown flags 0x%08llx, so it was written by something newer than this host",
            flags
        )
        return DAMAGED
    end
    local at = le(bytes, trailerStart + 16, 8)
    local length = le(bytes, trailerStart + 24, 8)
    local total = size as uint64
    local finish = at + length
    if finish < at or at > total or finish > (trailerStart as uint64) then
        snprintf(
            message,
            capacity,
            "the payload claims %llu bytes at %llu but the file is only %llu bytes; it was probably truncated in transit",
            length,
            at,
            total
        )
        return DAMAGED
    end
    local digest = xxh64(offset(bytes, at as integer), length as integer)
    if digest ~= le(bytes, trailerStart + 32, 8) then
        snprintf(
            message,
            capacity,
            "the payload does not match the digest recorded beside it; it was probably damaged in transit"
        )
        return DAMAGED
    end
    @unsafe do
        found[0] = at as int64
        found[1] = length as int64
        if (flags & PAYLOAD_FLAG_BYTECODE) ~= 0ULL then
            found[2] = 1LL
        else
            found[2] = 0LL
        end
    end

    return FOUND
end
